<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Deep blue-charcoal with subtle violet and teal material shifts. -->
    <LinearGradientBrush x:Key="WindowBackgroundBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FF171A20" Offset="0"/><GradientStop Color="#FF1D2229" Offset="0.55"/><GradientStop Color="#FF211D27" Offset="1"/></LinearGradientBrush>
    <LinearGradientBrush x:Key="NavBackgroundBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FF20242C" Offset="0"/><GradientStop Color="#FF252330" Offset="1"/></LinearGradientBrush>
    <LinearGradientBrush x:Key="SurfaceBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FF2B3038" Offset="0"/><GradientStop Color="#FF252A31" Offset="0.55"/><GradientStop Color="#FF292632" Offset="1"/></LinearGradientBrush>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#303640"/><SolidColorBrush x:Key="SurfaceMutedBrush" Color="#353B44"/><SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#323740"/><SolidColorBrush x:Key="SurfaceAlpha70Brush" Color="#B32B3038"/><SolidColorBrush x:Key="SurfaceAlpha25Brush" Color="#402B3038"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#48515C"/><SolidColorBrush x:Key="InputBorderBrush" Color="#5A6571"/><SolidColorBrush x:Key="DividerBrush" Color="#3E4650"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#A990C8"/><SolidColorBrush x:Key="AccentHoverBrush" Color="#BBA4D6"/><SolidColorBrush x:Key="AccentPressedBrush" Color="#8972A8"/><SolidColorBrush x:Key="OnAccentBrush" Color="#19161E"/>
    <!-- Local AI: luminous teal against the dark opal surfaces. -->
    <Color x:Key="AiGlowColor">#FF63A6B1</Color>
    <SolidColorBrush x:Key="AiAccentBrush" Color="#4F8791"/><SolidColorBrush x:Key="AiAccentHoverBrush" Color="#66A1AA"/><SolidColorBrush x:Key="AiAccentPressedBrush" Color="#376A73"/><SolidColorBrush x:Key="AiAccentSoftBrush" Color="#263F45"/><SolidColorBrush x:Key="AiAccentBorderBrush" Color="#5E919A"/><SolidColorBrush x:Key="OnAiAccentBrush" Color="#F4FBFC"/><SolidColorBrush x:Key="AiPanelTextBrush" Color="#C8E9ED"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#343B45"/><SolidColorBrush x:Key="HoverStrongBrush" Color="#46515D"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F1F3F5"/><SolidColorBrush x:Key="TextSecondaryBrush" Color="#BEC6CE"/><SolidColorBrush x:Key="TextMutedBrush" Color="#929CA7"/><SolidColorBrush x:Key="TextSubtleBrush" Color="#78838E"/><SolidColorBrush x:Key="NarrativeTextBrush" Color="#D0C5D6"/>
    <SolidColorBrush x:Key="PersonGroupBrush" Color="#292E36"/><SolidColorBrush x:Key="PersonGroupAltBrush" Color="#302C38"/>
    <Color x:Key="SurfaceAltColor">#FF303640</Color><Color x:Key="SurfaceRaisedColor">#FF323740</Color><Color x:Key="TextSubtleColor">#FF78838E</Color>
</ResourceDictionary>
