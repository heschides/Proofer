<Application x:Class="Sati.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:Sati.Converters"
             xmlns:children="clr-namespace:Sati.ViewModels.Children"
             xmlns:viewmodels="clr-namespace:Sati.ViewModels"
             xmlns:supervisor="clr-namespace:Sati.ViewModels.Supervisor"
             xmlns:supervisorVms="clr-namespace:Sati.ViewModels.Supervisor"
             xmlns:billingVms="clr-namespace:Sati.ViewModels.Billing"
             xmlns:adminVms="clr-namespace:Sati.ViewModels.Admin"
             xmlns:views="clr-namespace:Sati.Views"
             xmlns:billingViews="clr-namespace:Sati.Views.Billing">
    <Application.Resources>
        <ResourceDictionary>

            <!-- Theme + state colors. States is theme-independent; the second entry
                 is the ACTIVE theme — swap this one dictionary (or its Source) to
                 retheme. DynamicResource refs throughout the app re-resolve on swap. -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/States.xaml" />
                <ResourceDictionary Source="/Themes/SunlitShell.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Fonts -->
            <FontFamily x:Key="AppFont">Inter</FontFamily>
            <FontFamily x:Key="NarrativeFont">Cambria</FontFamily>

            <!-- Global styles -->
            <Style x:Key="LabelStyle"
                   TargetType="TextBlock">
                <Setter Property="FontSize"
                        Value="11" />
                <Setter Property="FontWeight"
                        Value="SemiBold" />
                <Setter Property="Foreground"
                        Value="{DynamicResource TextSecondaryBrush}" />
                <Setter Property="Margin"
                        Value="0,0,0,4" />
            </Style>

            <Style x:Key="SectionHeader"
                   TargetType="TextBlock">
                <Setter Property="FontSize"
                        Value="13" />
                <Setter Property="FontWeight"
                        Value="Bold" />
                <Setter Property="Foreground"
                        Value="{DynamicResource TextPrimaryBrush}" />
                <Setter Property="Margin"
                        Value="0,0,0,8" />
            </Style>

            <Style TargetType="TextBox">
                <Setter Property="Padding"
                        Value="8,4" />
                <Setter Property="FontSize"
                        Value="13" />
                <Setter Property="Background"
                        Value="{DynamicResource SurfaceBrush}" />
                <Setter Property="BorderBrush"
                        Value="{DynamicResource InputBorderBrush}" />
                <Setter Property="BorderThickness"
                        Value="1" />
                <Setter Property="Foreground"
                        Value="{DynamicResource TextPrimaryBrush}" />
                <Setter Property="Margin"
                        Value="0,0,0,10" />
            </Style>

            <Style TargetType="ComboBox">
                <Setter Property="Padding"
                        Value="6,4" />
                <Setter Property="FontSize"
                        Value="13" />
                <Setter Property="Background"
                        Value="{DynamicResource SurfaceBrush}" />
                <Setter Property="BorderBrush"
                        Value="{DynamicResource InputBorderBrush}" />
                <Setter Property="BorderThickness"
                        Value="1" />
                <Setter Property="Foreground"
                        Value="{DynamicResource TextPrimaryBrush}" />
                <Setter Property="Margin"
                        Value="0,0,0,10" />
            </Style>

            <!-- Global icon-free date entry. DatePickerTextBox keeps the parsing,
                 selection, validation, and keyboard behavior of DatePicker while
                 replacing the framework's white editor and calendar glyph. -->
            <Style TargetType="DatePickerTextBox">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="9,5" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DatePickerTextBox">
                            <Grid Background="Transparent">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center" />
                                <TextBlock x:Name="DatePlaceholder"
                                           Text="MM/DD/YYYY"
                                           Margin="{TemplateBinding Padding}"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontStyle="Italic"
                                           Opacity="0.48"
                                           IsHitTestVisible="False"
                                           Visibility="Collapsed" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter TargetName="DatePlaceholder" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.55" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="DatePicker">
                <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                <Setter Property="Margin" Value="0,0,0,10" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DatePicker">
                            <Grid x:Name="PART_Root">
                                <Border x:Name="DateBorder"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="4">
                                    <DatePickerTextBox x:Name="PART_TextBox"
                                                       Background="Transparent"
                                                       Foreground="{TemplateBinding Foreground}"
                                                       FontFamily="{TemplateBinding FontFamily}"
                                                       FontSize="{TemplateBinding FontSize}"
                                                       HorizontalContentAlignment="Stretch"
                                                       VerticalContentAlignment="Center" />
                                </Border>

                                <!-- Preserve the required part for keyboard behavior,
                                     but remove its mouse target and calendar chrome. -->
                                <Button x:Name="PART_Button"
                                        Width="0"
                                        Height="0"
                                        Padding="0"
                                        BorderThickness="0"
                                        Opacity="0"
                                        Focusable="False"
                                        IsHitTestVisible="False"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom" />

                                <Popup x:Name="PART_Popup"
                                       Placement="Bottom"
                                       PlacementTarget="{Binding ElementName=DateBorder}"
                                       AllowsTransparency="True"
                                       StaysOpen="False"
                                       PopupAnimation="Fade">
                                    <Border Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource InputBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="4">
                                        <Calendar x:Name="PART_Calendar"
                                                  Background="{DynamicResource SurfaceBrush}"
                                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                                  BorderThickness="0"
                                                  SelectedDate="{Binding SelectedDate, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                  DisplayDate="{Binding DisplayDate, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                  DisplayDateStart="{TemplateBinding DisplayDateStart}"
                                                  DisplayDateEnd="{TemplateBinding DisplayDateEnd}"
                                                  FirstDayOfWeek="{TemplateBinding FirstDayOfWeek}"
                                                  IsTodayHighlighted="{TemplateBinding IsTodayHighlighted}" />
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="DateBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="DateBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                    <Setter TargetName="DateBorder" Property="BorderThickness" Value="2" />
                                </Trigger>
                                <Trigger Property="Validation.HasError" Value="True">
                                    <Setter TargetName="DateBorder" Property="BorderBrush" Value="{DynamicResource OverdueBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="DateBorder" Property="Opacity" Value="0.55" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="Separator">
                <Setter Property="Background"
                        Value="{DynamicResource DividerBrush}" />
                <Setter Property="Margin"
                        Value="0,4,0,12" />
            </Style>

            <!-- Base spacing for all text buttons. New button styles should use
                 BasedOn="{StaticResource ButtonBaseStyle}" so their content
                 never sits against the left and right edges. -->
            <Style x:Key="ButtonBaseStyle"
                   TargetType="Button">
                <Setter Property="Padding"
                        Value="18,6" />
            </Style>

            <Style TargetType="Button"
                   BasedOn="{StaticResource ButtonBaseStyle}" />

            <Style x:Key="PrimaryButton"
                   TargetType="Button"
                   BasedOn="{StaticResource ButtonBaseStyle}">
                <Setter Property="Height"
                        Value="36" />
                <Setter Property="Background"
                        Value="{DynamicResource AccentBrush}" />
                <Setter Property="Foreground"
                        Value="{DynamicResource OnAccentBrush}" />
                <Setter Property="FontSize"
                        Value="13" />
                <Setter Property="FontWeight"
                        Value="SemiBold" />
                <Setter Property="BorderThickness"
                        Value="0" />
                <Setter Property="Cursor"
                        Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}"
                                    CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver"
                                         Value="True">
                                    <Setter Property="Background"
                                            Value="{DynamicResource AccentHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed"
                                         Value="True">
                                    <Setter Property="Background"
                                            Value="{DynamicResource AccentPressedBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="LocalAiButton"
                   TargetType="Button"
                   BasedOn="{StaticResource ButtonBaseStyle}">
                <Setter Property="Height"
                        Value="34" />
                <Setter Property="Padding"
                        Value="22,0" />
                <Setter Property="Background"
                        Value="{DynamicResource AiAccentBrush}" />
                <Setter Property="Foreground"
                        Value="{DynamicResource OnAiAccentBrush}" />
                <Setter Property="FontSize"
                        Value="13" />
                <Setter Property="FontWeight"
                        Value="SemiBold" />
                <Setter Property="BorderThickness"
                        Value="0" />
                <Setter Property="Cursor"
                        Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}"
                                    CornerRadius="5">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver"
                                         Value="True">
                                    <Setter Property="Background"
                                            Value="{DynamicResource AiAccentHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed"
                                         Value="True">
                                    <Setter Property="Background"
                                            Value="{DynamicResource AiAccentPressedBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled"
                                         Value="False">
                                    <Setter Property="Opacity"
                                            Value="0.55" />
                                    <Setter Property="Cursor"
                                            Value="Arrow" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="DangerButton"
                   TargetType="Button"
                   BasedOn="{StaticResource ButtonBaseStyle}">
                <Setter Property="Height"
                        Value="36" />
                <Setter Property="Background"
                        Value="{DynamicResource BorderBrush}" />
                <Setter Property="Foreground"
                        Value="{DynamicResource AccentPressedBrush}" />
                <Setter Property="FontSize"
                        Value="13" />
                <Setter Property="FontWeight"
                        Value="SemiBold" />
                <Setter Property="BorderThickness"
                        Value="0" />
                <Setter Property="Cursor"
                        Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}"
                                    CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver"
                                         Value="True">
                                    <Setter Property="Background"
                                            Value="{DynamicResource HoverStrongBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="IconButton"
                   TargetType="Button"
                   BasedOn="{StaticResource ButtonBaseStyle}">
                <Setter Property="Width"
                        Value="32" />
                <Setter Property="Height"
                        Value="32" />
                <Setter Property="Padding"
                        Value="0" />
                <Setter Property="Background"
                        Value="Transparent" />
                <Setter Property="BorderThickness"
                        Value="0" />
                <Setter Property="Cursor"
                        Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver"
                                         Value="True">
                                    <Setter Property="Background"
                                            Value="{DynamicResource BorderBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="SmallButton"
                   TargetType="Button"
                   BasedOn="{StaticResource ButtonBaseStyle}">
                <Setter Property="Height"
                        Value="28" />
                <Setter Property="Padding"
                        Value="12,0" />
                <Setter Property="Background"
                        Value="{DynamicResource HoverBrush}" />
                <Setter Property="Foreground"
                        Value="{DynamicResource TextPrimaryBrush}" />
                <Setter Property="FontSize"
                        Value="12" />
                <Setter Property="BorderThickness"
                        Value="0" />
                <Setter Property="Cursor"
                        Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}"
                                    CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver"
                                         Value="True">
                                    <Setter Property="Background"
                                            Value="{DynamicResource HoverStrongBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Converters -->
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
            <converters:EnumToBoolConverter x:Key="EnumToBoolConverter" />
            <converters:BoardTabConverter x:Key="BoardTabConverter" />
            <converters:EnumDescriptionConverter x:Key="EnumDescriptionConverter" />
            <converters:BoolToTileColorConverter x:Key="BoolToTileColorConverter" />
            <converters:BoolToWidthConverter x:Key="BoolToWidthConverter" />
            <converters:BoolToWidthConverter x:Key="SpacerWidthConverter"
                                             TrueWidth="16"
                                             FalseWidth="0" />
            <converters:FormCellStatusToBrushConverter x:Key="FormCellStatusToBrushConverter" />
            <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
            <!-- View → ViewModel DataTemplates -->
            <DataTemplate DataType="{x:Type viewmodels:CaseManagerDashboardViewModel}">
                <views:CaseManagerDashboardView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type children:NoteEntryViewModel}">
                <views:NoteEntryView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type supervisorVms:SupervisorDashboardViewModel}">
                <views:SupervisorDashboardWindow />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodels:NotesWindowViewModel}">
                <views:NotesLogView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewmodels:StatisticsViewModel}">
                <views:StatisticsView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewmodels:NewClientViewModel}">
                <views:ClientsView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewmodels:CaseloadMatrixViewModel}">
                <views:CaseloadMatrixView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewmodels:ReviewsViewModel}">
                <views:ReviewsView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type children:GuidanceViewModel}">
                <views:GuidanceView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type children:CalendarViewModel}">
                <views:CalendarView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type children:HelpersViewModel}">
                <views:HelpersView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type children:HelperReferenceViewModel}">
                <views:HelperReferenceView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type children:ATRequestViewModel}">
                <views:ATRequestView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type children:ProvidersViewModel}">
                <views:ProvidersView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type supervisorVms:TeamOverviewViewModel}">
                <views:TeamOverviewView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type supervisorVms:OverdueItemsViewModel}">
                <views:OverdueItemsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type supervisorVms:MonthlyProductivityViewModel}">
                <views:MonthlyProductivityView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type supervisorVms:UserManagementViewModel}">
                <views:UserManagementView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type supervisorVms:PendingApprovalsViewModel}">
                <views:PendingApprovalsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type adminVms:AdminDashboardViewModel}">
                <views:AdminDashboardView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type billingVms:BillingDashboardViewModel}">
                <billingViews:BillingDashboardView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type billingVms:BillingOverviewViewModel}">
                <billingViews:BillingOverviewView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type billingVms:BillingQueueViewModel}">
                <billingViews:BillingQueueView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type billingVms:BillingSubmissionsViewModel}">
                <billingViews:BillingSubmissionsView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type billingVms:BillingRemittancesViewModel}">
                <billingViews:BillingRemittancesView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type billingVms:BillingAlertsViewModel}">
                <billingViews:BillingAlertsView />
            </DataTemplate>

        </ResourceDictionary>
    </Application.Resources>
</Application>
