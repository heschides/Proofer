<UserControl x:Class="Sati.Views.PlatformHealthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource WindowBackgroundBrush}"
             TextElement.FontFamily="{StaticResource AppFont}">
    <Grid Margin="18,14,18,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="170" />
            <RowDefinition Height="10" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Platform health" FontSize="24" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="Cross-agency operational incidents; every view is audited"
                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock Text="{Binding LastRefreshedLabel}" VerticalAlignment="Center" Margin="0,0,12,0"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource SmallButton}" />
            </StackPanel>
        </Grid>
        <Border Grid.Row="1" Background="#FFFFEFEF" BorderBrush="#FFE8AAAA" BorderThickness="1"
                CornerRadius="5" Padding="10,7" Margin="0,10,0,10">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers><DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="#FF8D2929" />
        </Border>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="14">
                <StackPanel>
                    <TextBlock Text="OVERALL INCIDENT HEALTH / 30D" FontSize="9" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding OverallHealth.Score, TargetNullValue=&#x2014;}" FontSize="42" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock Text="{Binding OverallHealth.Grade, TargetNullValue=Not measured}" FontSize="14"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding OverallHealth.Explanation}" TextWrapping="Wrap" Margin="0,8,0,0"
                               FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>
            <DataGrid Grid.Column="2" ItemsSource="{Binding Agencies}" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" AutomationProperties.Name="Agency health scores">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="AGENCY" Binding="{Binding AgencyName}" Width="2*" />
                    <DataGridTextColumn Header="SCORE" Binding="{Binding Health.Score}" Width="70" />
                    <DataGridTextColumn Header="GRADE" Binding="{Binding Health.Grade}" Width="90" />
                    <DataGridTextColumn Header="OCCURRENCES" Binding="{Binding Health.TotalOccurrences}" Width="100" />
                    <DataGridTextColumn Header="UNRESOLVED" Binding="{Binding Health.UnresolvedGroups}" Width="90" />
                    <DataGridTextColumn Header="SEVERITY PENALTY" Binding="{Binding Health.SeverityPenalty}" Width="110" />
                    <DataGridTextColumn Header="RECURRENCE" Binding="{Binding Health.RecurrencePenalty}" Width="90" />
                    <DataGridTextColumn Header="AGE" Binding="{Binding Health.UnresolvedAgePenalty}" Width="60" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
        <DataGrid Grid.Row="4" ItemsSource="{Binding Incidents}" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" AutomationProperties.Name="Cross-agency incident groups">
            <DataGrid.Columns>
                <DataGridTextColumn Header="AGENCY ID" Binding="{Binding AgencyId}" Width="75" />
                <DataGridTextColumn Header="SEVERITY" Binding="{Binding Severity}" Width="85" />
                <DataGridTextColumn Header="FEATURE / OPERATION" Binding="{Binding Operation}" Width="2*" />
                <DataGridTextColumn Header="SOURCE" Binding="{Binding Source}" Width="75" />
                <DataGridTextColumn Header="COUNT" Binding="{Binding OccurrenceCount}" Width="60" />
                <DataGridTextColumn Header="LAST SEEN (UTC)" Binding="{Binding LastSeenUtc, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="130" />
                <DataGridTextColumn Header="RELEASE" Binding="{Binding LastRelease}" Width="75" />
                <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="85" />
                <DataGridTextColumn Header="REFERENCE" Binding="{Binding LastReference}" Width="130" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
