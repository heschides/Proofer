<UserControl x:Class="Sati.Views.CaseManagerDashboardView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="clr-namespace:Sati.Views"
 Background="{DynamicResource WindowBackgroundBrush}" TextElement.FontFamily="{StaticResource AppFont}">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border Background="{DynamicResource NavBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,8">
   <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
    <StackPanel Orientation="Horizontal" KeyboardNavigation.TabNavigation="Local">
                <Button Content="Overview" Style="{StaticResource NavTabButton}" AutomationProperties.Name="Overview"
                        views:NavTab.IsActive="{Binding IsDashboardSubActive}" Command="{Binding NavigateToOverviewCommand}" />
                <Button Content="Clients" Style="{StaticResource NavTabButton}" AutomationProperties.Name="Clients"
                        views:NavTab.IsActive="{Binding IsClientsSubActive}" Command="{Binding NavigateToClientsCommand}" />
                <Button Content="Notes" Style="{StaticResource NavTabButton}" AutomationProperties.Name="Notes"
                        views:NavTab.IsActive="{Binding IsNotesLogSubActive}" Command="{Binding NavigateToNotesLogCommand}" />
                <Button Content="Caseload Matrix" Style="{StaticResource NavTabButton}" AutomationProperties.Name="Caseload Matrix"
                        views:NavTab.IsActive="{Binding IsMatrixSubActive}" Command="{Binding NavigateToMatrixCommand}" />
                <Button Content="Calendar" Style="{StaticResource NavTabButton}" AutomationProperties.Name="Calendar"
                        views:NavTab.IsActive="{Binding IsCalendarSubActive}" Command="{Binding NavigateToCalendarCommand}" />
                <Button Content="Statistics" Style="{StaticResource NavTabButton}" AutomationProperties.Name="Statistics"
                        views:NavTab.IsActive="{Binding IsStatisticsSubActive}" Command="{Binding NavigateToStatisticsCommand}" />
                <Button Content="Reviews" Style="{StaticResource NavTabButton}" AutomationProperties.Name="Reviews"
                        views:NavTab.IsActive="{Binding IsReviewsSubActive}" Command="{Binding NavigateToReviewsCommand}" />
                <Button Content="Providers" Style="{StaticResource NavTabButton}" AutomationProperties.Name="Providers"
                        views:NavTab.IsActive="{Binding IsProvidersSubActive}" Command="{Binding NavigateToProvidersCommand}" />
                <Button Content="Help" Style="{StaticResource NavTabButton}" AutomationProperties.Name="Help"
                        views:NavTab.IsActive="{Binding IsHelpSubActive}" Command="{Binding NavigateToHelpCommand}" />
                <Button Content="Documents" Style="{StaticResource NavTabButton}" AutomationProperties.Name="Documents"
                        views:NavTab.IsActive="{Binding IsDocumentsSubActive}" Command="{Binding NavigateToDocumentsCommand}" />
    </StackPanel>
   </ScrollViewer>
  </Border>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="8"
           Visibility="{Binding IsHelpSubActive, Converter={StaticResource BoolToVisibilityConverter}}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel KeyboardNavigation.TabNavigation="Local" AutomationProperties.Name="Help navigation">
                <Button Content="Guidance" Style="{StaticResource NavTabButton}" AutomationProperties.Name="Guidance"
                        views:NavTab.IsActive="{Binding IsGuidanceSubActive}" Command="{Binding NavigateToGuidanceCommand}" />
                <Button Content="Reference" Style="{StaticResource NavTabButton}" AutomationProperties.Name="Reference"
                        views:NavTab.IsActive="{Binding IsReferenceSubActive}" Command="{Binding NavigateToReferenceCommand}" />
     </StackPanel>
    </ScrollViewer>
   </Border>
   <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="8"
           Visibility="{Binding IsDocumentsSubActive, Converter={StaticResource BoolToVisibilityConverter}}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel KeyboardNavigation.TabNavigation="Local" AutomationProperties.Name="Documents navigation">
                <Button Content="AT Requests" Style="{StaticResource NavTabButton}" AutomationProperties.Name="Assistive technology requests"
                        views:NavTab.IsActive="{Binding IsATRequestsSubActive}" Command="{Binding NavigateToATRequestsCommand}" />
                <Button Content="Authorized Rep" Style="{StaticResource NavTabButton}" AutomationProperties.Name="DHHS authorized representative form"
                        views:NavTab.IsActive="{Binding IsAuthorizedRepresentativeSubActive}" Command="{Binding NavigateToAuthorizedRepresentativeCommand}" />
                <Button Content="Releases" Style="{StaticResource NavTabButton}" AutomationProperties.Name="Release forms"
                        views:NavTab.IsActive="{Binding IsReleasesSubActive}" Command="{Binding NavigateToReleasesCommand}" />
     </StackPanel>
    </ScrollViewer>
   </Border>
   <views:CaseManagerDashboardContentView Grid.Column="1" Visibility="{Binding IsDashboardSubActive, Converter={StaticResource BoolToVisibilityConverter}}"/>
   <ContentControl Grid.Column="1" Content="{Binding CurrentSubViewModel}" Visibility="{Binding IsSubViewActive, Converter={StaticResource BoolToVisibilityConverter}}"/>
  </Grid>
 </Grid>
</UserControl>
