<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- SUNLIT SHELL: creamy shell with gentle coral and champagne light. -->
    <LinearGradientBrush x:Key="WindowBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFFDF5" Offset="0" />
        <GradientStop Color="#FFFFF5E6" Offset="0.4" />
        <GradientStop Color="#FFF8EEEA" Offset="0.72" />
        <GradientStop Color="#FFFFFAF0" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="NavBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFF9ECD9" Offset="0" />
        <GradientStop Color="#FFF2E1DD" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SurfaceBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFFFFF" Offset="0" />
        <GradientStop Color="#FFFFFAF2" Offset="0.48" />
        <GradientStop Color="#FFF5ECE8" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F6E9DD" />
    <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#ECDED3" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#FFFDF7" />
    <SolidColorBrush x:Key="SurfaceAlpha70Brush" Color="#B3FFFAF2" />
    <SolidColorBrush x:Key="SurfaceAlpha25Brush" Color="#40FFFAF2" />
    <SolidColorBrush x:Key="BorderBrush" Color="#E4CFC3" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#CDB2A5" />
    <SolidColorBrush x:Key="DividerBrush" Color="#EADBD2" />
    <SolidColorBrush x:Key="AccentBrush" Color="#A96053" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#894C42" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#703C35" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
    <!-- Local AI: muted plum against the coral and champagne shell. -->
    <Color x:Key="AiGlowColor">#FFA67A92</Color>
    <SolidColorBrush x:Key="AiAccentBrush" Color="#80536F" />
    <SolidColorBrush x:Key="AiAccentHoverBrush" Color="#94657F" />
    <SolidColorBrush x:Key="AiAccentPressedBrush" Color="#633D55" />
    <SolidColorBrush x:Key="AiAccentSoftBrush" Color="#F3E4EB" />
    <SolidColorBrush x:Key="AiAccentBorderBrush" Color="#D3ADBF" />
    <SolidColorBrush x:Key="OnAiAccentBrush" Color="#FFF9FC" />
    <SolidColorBrush x:Key="AiPanelTextBrush" Color="#59384C" />
    <SolidColorBrush x:Key="HoverBrush" Color="#F0DED4" />
    <SolidColorBrush x:Key="HoverStrongBrush" Color="#D9BFB4" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#443632" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#65534D" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#6E5C56" />
    <SolidColorBrush x:Key="TextSubtleBrush" Color="#725F59" />
    <SolidColorBrush x:Key="NarrativeTextBrush" Color="#695149" />
    <SolidColorBrush x:Key="PersonGroupBrush" Color="#FFF9F0" />
    <SolidColorBrush x:Key="PersonGroupAltBrush" Color="#F5E8E2" />
    <Color x:Key="SurfaceAltColor">#FFF6E9DD</Color>
    <Color x:Key="SurfaceRaisedColor">#FFFFFDF7</Color>
    <Color x:Key="TextSubtleColor">#FF725F59</Color>
</ResourceDictionary>
