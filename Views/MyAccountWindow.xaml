<Window x:Class="Sati.Views.MyAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="My Account"
        Height="660"
        Width="960"
        MinHeight="580"
        MinWidth="820"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="{StaticResource AppFont}">

    <Window.Resources>
        <Style x:Key="AccountLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>

        <Style x:Key="AccountSectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="AccountTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="Width" Value="360" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HoverStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <Style x:Key="AccountPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="Width" Value="360" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HoverStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <Style x:Key="AccountPrimaryButton"
               TargetType="Button"
               BasedOn="{StaticResource ButtonBaseStyle}">
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccountTabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBackground"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="14,11">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Left" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBackground" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBackground" Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentPressedBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccountTabControlStyle" TargetType="TabControl">
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <StackPanel IsItemsHost="True" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Background="{DynamicResource NavBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="0,0,1,0"
                                    Padding="18,24">
                                <StackPanel>
                                    <TextBlock Text="MY ACCOUNT"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Margin="12,0,0,6" />
                                    <TextBlock Text="Manage your account"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Margin="12,0,0,22" />
                                    <ItemsPresenter />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="{DynamicResource WindowBackgroundBrush}">
                                <ContentPresenter ContentSource="SelectedContent" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Style="{StaticResource AccountTabControlStyle}">
            <TabItem Header="Profile" Style="{StaticResource AccountTabItemStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="36,30" MaxWidth="620" HorizontalAlignment="Left">
                        <TextBlock Text="PROFILE" Style="{StaticResource AccountSectionHeader}" />
                        <Separator Background="{DynamicResource BorderBrush}" Margin="0,4,0,20" />

                        <TextBlock Text="Your identity and access details are managed by your agency."
                                   FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="0,0,0,20" />

                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,28,0">
                                <TextBlock Text="NAME" Style="{StaticResource AccountLabelStyle}" />
                                <TextBlock Text="{Binding DisplayName}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="14" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="USERNAME" Style="{StaticResource AccountLabelStyle}" />
                                <TextBlock Text="{Binding Username}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="14" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,26">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,28,0">
                                <TextBlock Text="ROLE" Style="{StaticResource AccountLabelStyle}" />
                                <TextBlock Text="{Binding Role}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="14" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="AGENCY" Style="{StaticResource AccountLabelStyle}" />
                                <TextBlock Text="{Binding AgencyName}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="14" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Margin="0,0,0,26">
                            <TextBlock Text="SUPERVISOR" Style="{StaticResource AccountLabelStyle}" />
                            <TextBlock Text="{Binding SupervisorName}"
                                       AutomationProperties.Name="Supervisor name"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="14" />
                        </StackPanel>

                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="CONTACT INFORMATION"
                                       Style="{StaticResource AccountSectionHeader}"
                                       VerticalAlignment="Center" />
                            <Button Content="Edit Information"
                                    Style="{StaticResource SmallButton}"
                                    HorizontalAlignment="Right"
                                    Command="{Binding BeginEditCommand}"
                                    Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                        </Grid>
                        <Separator Background="{DynamicResource BorderBrush}" Margin="0,4,0,20" />

                        <TextBlock Text="EMAIL" Style="{StaticResource AccountLabelStyle}" />
                        <TextBlock Text="{Binding Email, TargetNullValue=—}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="14"
                                   Margin="0,0,0,16"
                                   Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                        <TextBox AutomationProperties.Name="Email"
                                 Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource AccountTextBoxStyle}"
                                 Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <TextBlock Text="PHONE" Style="{StaticResource AccountLabelStyle}" />
                        <TextBlock Text="{Binding Phone, TargetNullValue=—}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="14"
                                   Margin="0,0,0,16"
                                   Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                        <TextBox AutomationProperties.Name="Phone"
                                 Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource AccountTextBoxStyle}"
                                 Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Left"
                                    Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Button Content="Save Changes"
                                    Style="{StaticResource AccountPrimaryButton}"
                                    Width="130"
                                    Command="{Binding SaveProfileCommand}" />
                            <Button Content="Cancel"
                                    Style="{StaticResource SmallButton}"
                                    Margin="10,0,0,0"
                                    Command="{Binding CancelEditCommand}" />
                        </StackPanel>

                        <TextBlock Text="{Binding ProfileMessage}"
                                   AutomationProperties.LiveSetting="Assertive"
                                   FontSize="12"
                                   Foreground="{DynamicResource CompliantBrush}"
                                   Margin="0,10,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Password &amp; Security" Style="{StaticResource AccountTabItemStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="36,30" MaxWidth="620" HorizontalAlignment="Left">
                        <TextBlock Text="CHANGE PASSWORD" Style="{StaticResource AccountSectionHeader}" />
                        <Separator Background="{DynamicResource BorderBrush}" Margin="0,4,0,20" />

                        <TextBlock Text="Use at least 8 characters for your new password."
                                   FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="0,0,0,20" />

                        <TextBlock Text="CURRENT PASSWORD" Style="{StaticResource AccountLabelStyle}" />
                        <PasswordBox AutomationProperties.Name="Current password"
                                     x:Name="CurrentPasswordBox"
                                     Style="{StaticResource AccountPasswordBoxStyle}"
                                     PasswordChanged="CurrentPasswordBox_PasswordChanged" />

                        <TextBlock Text="NEW PASSWORD" Style="{StaticResource AccountLabelStyle}" />
                        <PasswordBox AutomationProperties.Name="New password"
                                     x:Name="NewPasswordBox"
                                     Style="{StaticResource AccountPasswordBoxStyle}"
                                     PasswordChanged="NewPasswordBox_PasswordChanged" />

                        <TextBlock Text="CONFIRM NEW PASSWORD" Style="{StaticResource AccountLabelStyle}" />
                        <PasswordBox AutomationProperties.Name="Confirm new password"
                                     x:Name="ConfirmPasswordBox"
                                     Style="{StaticResource AccountPasswordBoxStyle}"
                                     PasswordChanged="ConfirmPasswordBox_PasswordChanged" />

                        <Button Content="Change Password"
                                Style="{StaticResource AccountPrimaryButton}"
                                Width="160"
                                HorizontalAlignment="Left"
                                Command="{Binding ChangePasswordCommand}" />

                        <TextBlock Text="{Binding PasswordMessage}"
                                   AutomationProperties.LiveSetting="Assertive"
                                   FontSize="12"
                                   Foreground="{DynamicResource CompliantBrush}"
                                   Margin="0,10,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="1"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="18,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="Need to use another account?"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMutedBrush}"
                           FontSize="11"
                           Margin="0,0,14,0" />
                <Button Content="Switch User"
                        Style="{StaticResource AccountPrimaryButton}"
                        Width="120"
                        Command="{Binding RequestSwitchUserCommand}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
