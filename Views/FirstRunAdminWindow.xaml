<Window x:Class="Sati.Views.FirstRunAdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Sati.Views"
        Title="Create the First Administrator"
        Height="620"
        Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="{StaticResource AppFont}">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>
        <Style x:Key="Field" TargetType="Control">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HoverStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
    </Window.Resources>

    <Border Padding="28,24">
        <StackPanel>

            <TextBlock Text="Create the first administrator"
                       FontSize="19"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Margin="0,0,0,6" />

            <!-- States plainly why this window exists and why it will not appear
                 again. Someone seeing it on a fresh install should not have to
                 guess whether it is a security prompt or a formality. -->
            <TextBlock TextWrapping="Wrap"
                       FontSize="12"
                       LineHeight="18"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,0,0,18"
                       Text="This installation has no administrator, so nobody can create supervisors or other accounts. Sati does not ship a default administrator account or a default password — you choose the password here, now, and this window closes for good once an administrator exists." />

            <TextBlock Text="USERNAME" Style="{StaticResource FieldLabel}" />
            <TextBox AutomationProperties.Name="Administrator username"
                     Style="{StaticResource Field}"
                     VerticalContentAlignment="Center"
                     Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="DISPLAY NAME" Style="{StaticResource FieldLabel}" />
            <TextBox AutomationProperties.Name="Administrator display name"
                     Style="{StaticResource Field}"
                     VerticalContentAlignment="Center"
                     Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="EMAIL (OPTIONAL)" Style="{StaticResource FieldLabel}" />
            <TextBox AutomationProperties.Name="Administrator email"
                     Style="{StaticResource Field}"
                     VerticalContentAlignment="Center"
                     Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="PASSWORD" Style="{StaticResource FieldLabel}" />
            <!-- Reveal toggle matters more here than on a sign-in screen: this is
                 a long password being typed blind, twice, once ever. -->
            <local:PasswordRevealBox x:Name="PasswordInput"
                                     AutomationProperties.Name="Administrator password"
                                     Margin="0,0,0,6" />

            <TextBlock Text="{Binding PasswordRequirement}"
                       TextWrapping="Wrap"
                       FontSize="11"
                       LineHeight="16"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,0,0,12" />

            <TextBlock Text="CONFIRM PASSWORD" Style="{StaticResource FieldLabel}" />
            <local:PasswordRevealBox x:Name="ConfirmInput"
                                     AutomationProperties.Name="Confirm administrator password"
                                     Margin="0,0,0,14" />

            <TextBlock Text="{Binding ProblemMessage}"
                       AutomationProperties.LiveSetting="Assertive"
                       TextWrapping="Wrap"
                       FontSize="12"
                       LineHeight="17"
                       Foreground="{DynamicResource OverdueBrush}"
                       Margin="0,0,0,12"
                       Visibility="{Binding HasProblem, Converter={StaticResource BoolToVisibilityConverter}}" />

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Style="{StaticResource SmallButton}"
                        Width="90"
                        Margin="0,0,8,0"
                        IsCancel="True"
                        AutomationProperties.Name="Cancel" />
                <Button x:Name="CreateButton"
                        Content="Create Administrator"
                        Style="{StaticResource PrimaryButton}"
                        Width="170"
                        Height="34"
                        IsDefault="True"
                        AutomationProperties.Name="Create administrator"
                        Click="OnCreate"
                        IsEnabled="{Binding IsWorking, Converter={StaticResource InverseBoolConverter}}" />
            </StackPanel>

        </StackPanel>
    </Border>
</Window>
