<Window x:Class="Sati.Views.MyAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="My Account"
        Height="620"
        Width="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FDF6EC"
        FontFamily="{StaticResource AppFont}">

    <Border Padding="28,24">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <TextBlock Text="My Account"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#3D2B1F"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20" />

                <!-- ═══ CONTEXT (read-only) ═══ -->
                <TextBlock Text="NAME"
                           Style="{StaticResource LabelStyle}" />
                <TextBlock Text="{Binding DisplayName}"
                           Foreground="#3D2B1F"
                           FontSize="14"
                           Margin="0,0,0,10" />

                <TextBlock Text="USERNAME"
                           Style="{StaticResource LabelStyle}" />
                <TextBlock Text="{Binding Username}"
                           Foreground="#3D2B1F"
                           FontSize="14"
                           Margin="0,0,0,10" />

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="ROLE"
                                   Style="{StaticResource LabelStyle}" />
                        <TextBlock Text="{Binding Role}"
                                   Foreground="#3D2B1F"
                                   FontSize="14" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="AGENCY"
                                   Style="{StaticResource LabelStyle}" />
                        <TextBlock Text="{Binding AgencyName}"
                                   Foreground="#3D2B1F"
                                   FontSize="14" />
                    </StackPanel>
                </Grid>

                <Separator Margin="0,8,0,14"
                           Background="#E8D0B8" />

                <!-- ═══ EDITABLE PROFILE ═══ -->
                <Grid Margin="0,0,0,10">
                    <TextBlock Text="CONTACT"
                               Style="{StaticResource SectionHeader}"
                               VerticalAlignment="Center" />
                    <Button Content="Edit Information"
                            Style="{StaticResource SmallButton}"
                            HorizontalAlignment="Right"
                            Command="{Binding BeginEditCommand}"
                            Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                </Grid>

                <TextBlock Text="EMAIL"
                           Style="{StaticResource LabelStyle}" />
                <!-- Read-only view -->
                <TextBlock Text="{Binding Email, TargetNullValue=—}"
                           Foreground="#3D2B1F"
                           FontSize="14"
                           Margin="0,0,0,10"
                           Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                <!-- Edit view -->
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}" />

                <TextBlock Text="PHONE"
                           Style="{StaticResource LabelStyle}" />
                <TextBlock Text="{Binding Phone, TargetNullValue=—}"
                           Foreground="#3D2B1F"
                           FontSize="14"
                           Margin="0,0,0,10"
                           Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}" />

                <!-- Save / Cancel (edit mode only) -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,4,0,0"
                            Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Button Content="Cancel"
                            Style="{StaticResource SmallButton}"
                            Margin="0,0,8,0"
                            Command="{Binding CancelEditCommand}" />
                    <Button Content="Save"
                            Style="{StaticResource PrimaryButton}"
                            Width="80"
                            Height="28"
                            Command="{Binding SaveProfileCommand}" />
                </StackPanel>

                <TextBlock Text="{Binding ProfileMessage}"
                           FontSize="12"
                           Foreground="#5A8A5A"
                           Margin="0,6,0,0"
                           HorizontalAlignment="Right" />

                <Separator Margin="0,14,0,14"
                           Background="#E8D0B8" />

                <!-- ═══ CHANGE PASSWORD ═══ -->
                <TextBlock Text="CHANGE PASSWORD"
                           Style="{StaticResource SectionHeader}" />

                <TextBlock Text="CURRENT PASSWORD"
                           Style="{StaticResource LabelStyle}" />
                <PasswordBox x:Name="CurrentPasswordBox"
                             Height="34"
                             Padding="10,0"
                             FontSize="14"
                             VerticalContentAlignment="Center"
                             Background="White"
                             BorderBrush="#D4A882"
                             BorderThickness="1"
                             Margin="0,0,0,10"
                             PasswordChanged="CurrentPasswordBox_PasswordChanged" />

                <TextBlock Text="NEW PASSWORD"
                           Style="{StaticResource LabelStyle}" />
                <PasswordBox x:Name="NewPasswordBox"
                             Height="34"
                             Padding="10,0"
                             FontSize="14"
                             VerticalContentAlignment="Center"
                             Background="White"
                             BorderBrush="#D4A882"
                             BorderThickness="1"
                             Margin="0,0,0,10"
                             PasswordChanged="NewPasswordBox_PasswordChanged" />

                <TextBlock Text="CONFIRM NEW PASSWORD"
                           Style="{StaticResource LabelStyle}" />
                <PasswordBox x:Name="ConfirmPasswordBox"
                             Height="34"
                             Padding="10,0"
                             FontSize="14"
                             VerticalContentAlignment="Center"
                             Background="White"
                             BorderBrush="#D4A882"
                             BorderThickness="1"
                             Margin="0,0,0,10"
                             PasswordChanged="ConfirmPasswordBox_PasswordChanged" />

                <Button Content="Change Password"
                        Style="{StaticResource PrimaryButton}"
                        Height="34"
                        Command="{Binding ChangePasswordCommand}" />

                <TextBlock Text="{Binding PasswordMessage}"
                           FontSize="12"
                           Foreground="#5A8A5A"
                           Margin="0,6,0,0"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center" />

                <Separator Margin="0,16,0,14"
                           Background="#E8D0B8" />

                <!-- ═══ SWITCH USER ═══ -->
                <Button Content="Switch to a different user →"
                        Style="{StaticResource SmallButton}"
                        Command="{Binding RequestSwitchUserCommand}" />

            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>