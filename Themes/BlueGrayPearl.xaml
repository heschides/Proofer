<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- BLUE-GRAY PEARL: warm slate, cloud light, and a faint champagne sheen. -->
    <LinearGradientBrush x:Key="WindowBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFF7F8F8" Offset="0" />
        <GradientStop Color="#FFE8EDF0" Offset="0.34" />
        <GradientStop Color="#FFF2EEE7" Offset="0.68" />
        <GradientStop Color="#FFE3E9ED" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="NavBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFD9E1E6" Offset="0" />
        <GradientStop Color="#FFE9E5DF" Offset="0.55" />
        <GradientStop Color="#FFD6E0E5" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SurfaceBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFFFFF" Offset="0" />
        <GradientStop Color="#FFF4F6F7" Offset="0.42" />
        <GradientStop Color="#FFE9EEF1" Offset="0.72" />
        <GradientStop Color="#FFF7F2EC" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#E3E9EC" />
    <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#D5DDE1" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#FCFDFD" />
    <SolidColorBrush x:Key="SurfaceAlpha70Brush" Color="#B3F3F6F7" />
    <SolidColorBrush x:Key="SurfaceAlpha25Brush" Color="#40F3F6F7" />
    <SolidColorBrush x:Key="BorderBrush" Color="#B8C5CC" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#8FA2AD" />
    <SolidColorBrush x:Key="DividerBrush" Color="#CBD5DA" />
    <SolidColorBrush x:Key="AccentBrush" Color="#E25507" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#EF6A24" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#D95B10" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#090705" />
    <!-- Button fill is its own token so a palette can lighten its buttons
         without lightening the accent used for type. -->
    <SolidColorBrush x:Key="AccentButtonBrush" Color="#FBA76B" />
    <SolidColorBrush x:Key="AccentButtonHoverBrush" Color="#FDBA88" />
    <SolidColorBrush x:Key="AccentButtonPressedBrush" Color="#F2914F" />
    <SolidColorBrush x:Key="OnAccentButtonBrush" Color="#3B1D06" />
    <!-- Local AI stays distinct from the orange action accent. -->
    <Color x:Key="AiGlowColor">#FF6B8FA3</Color>
    <SolidColorBrush x:Key="AiAccentBrush" Color="#426F86" />
    <SolidColorBrush x:Key="AiAccentHoverBrush" Color="#527F95" />
    <SolidColorBrush x:Key="AiAccentPressedBrush" Color="#31596D" />
    <SolidColorBrush x:Key="AiAccentSoftBrush" Color="#DDEAF0" />
    <SolidColorBrush x:Key="AiAccentBorderBrush" Color="#9BB6C3" />
    <SolidColorBrush x:Key="OnAiAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AiPanelTextBrush" Color="#294B5C" />
    <SolidColorBrush x:Key="HoverBrush" Color="#DCE5E9" />
    <SolidColorBrush x:Key="HoverStrongBrush" Color="#C1CFD6" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#263740" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#465A65" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#5D6F78" />
    <SolidColorBrush x:Key="TextSubtleBrush" Color="#687982" />
    <SolidColorBrush x:Key="NarrativeTextBrush" Color="#3E5662" />
    <SolidColorBrush x:Key="PersonGroupBrush" Color="#F3F6F7" />
    <SolidColorBrush x:Key="PersonGroupAltBrush" Color="#E5EBEE" />
    <Color x:Key="SurfaceAltColor">#FFE3E9EC</Color>
    <Color x:Key="SurfaceRaisedColor">#FFFCFDFD</Color>
    <Color x:Key="TextSubtleColor">#FF687982</Color>
</ResourceDictionary>
