<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Maine evergreen, sea glass, and pale coastal stone. -->
    <LinearGradientBrush x:Key="WindowBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFF5FAF6" Offset="0"/><GradientStop Color="#FFEAF4F0" Offset="0.55"/><GradientStop Color="#FFF4F1E8" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="NavBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFDDECE5" Offset="0"/><GradientStop Color="#FFE7EFE8" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SurfaceBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFFFFF" Offset="0"/><GradientStop Color="#FFF7FBF8" Offset="0.6"/><GradientStop Color="#FFEDF4EF" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#E5F0EA"/><SolidColorBrush x:Key="SurfaceMutedBrush" Color="#D7E5DE"/><SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#FFFFFF"/><SolidColorBrush x:Key="SurfaceAlpha70Brush" Color="#B3F7FBF8"/><SolidColorBrush x:Key="SurfaceAlpha25Brush" Color="#40F7FBF8"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#BDD2C8"/><SolidColorBrush x:Key="InputBorderBrush" Color="#91ADA0"/><SolidColorBrush x:Key="DividerBrush" Color="#CDDDD5"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#286B58"/><SolidColorBrush x:Key="AccentHoverBrush" Color="#205846"/><SolidColorBrush x:Key="AccentPressedBrush" Color="#184638"/><SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>
    <!-- Button fill is its own token so a palette can lighten its buttons
         without lightening the accent used for type. -->
    <SolidColorBrush x:Key="AccentButtonBrush" Color="#286B58" />
    <SolidColorBrush x:Key="AccentButtonHoverBrush" Color="#205846" />
    <SolidColorBrush x:Key="AccentButtonPressedBrush" Color="#184638" />
    <SolidColorBrush x:Key="OnAccentButtonBrush" Color="#FFFFFF" />
    <Color x:Key="AiGlowColor">#FF568FA2</Color><SolidColorBrush x:Key="AiAccentBrush" Color="#356F82"/><SolidColorBrush x:Key="AiAccentHoverBrush" Color="#2B5D6E"/><SolidColorBrush x:Key="AiAccentPressedBrush" Color="#214956"/><SolidColorBrush x:Key="AiAccentSoftBrush" Color="#DDEEF2"/><SolidColorBrush x:Key="AiAccentBorderBrush" Color="#93BAC4"/><SolidColorBrush x:Key="OnAiAccentBrush" Color="#FFFFFF"/><SolidColorBrush x:Key="AiPanelTextBrush" Color="#244F5A"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#DDEBE4"/><SolidColorBrush x:Key="HoverStrongBrush" Color="#C5D9CF"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#203C34"/><SolidColorBrush x:Key="TextSecondaryBrush" Color="#3C5A51"/><SolidColorBrush x:Key="TextMutedBrush" Color="#526B63"/><SolidColorBrush x:Key="TextSubtleBrush" Color="#5D746C"/><SolidColorBrush x:Key="NarrativeTextBrush" Color="#34564B"/>
    <SolidColorBrush x:Key="PersonGroupBrush" Color="#EDF7F1"/><SolidColorBrush x:Key="PersonGroupAltBrush" Color="#E2EFE8"/>
    <Color x:Key="SurfaceAltColor">#FFE5F0EA</Color><Color x:Key="SurfaceRaisedColor">#FFFFFFFF</Color><Color x:Key="TextSubtleColor">#FF5D746C</Color>
</ResourceDictionary>
