<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- WOODFORDS: warm cream, optimistic yellow light, and grounded brand purple. -->
    <LinearGradientBrush x:Key="WindowBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFFCF1" Offset="0" />
        <GradientStop Color="#FFFFF3C8" Offset="0.34" />
        <GradientStop Color="#FFF7F0FA" Offset="0.72" />
        <GradientStop Color="#FFFFF8E3" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="NavBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFF6D8" Offset="0" />
        <GradientStop Color="#FFF4EAF7" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SurfaceBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFFFFF" Offset="0" />
        <GradientStop Color="#FFFFFCF3" Offset="0.52" />
        <GradientStop Color="#FFF9F1FA" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#FBF1D7" />
    <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#F1E5C8" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#FFFEF8" />
    <SolidColorBrush x:Key="SurfaceAlpha70Brush" Color="#B3FFFCF2" />
    <SolidColorBrush x:Key="SurfaceAlpha25Brush" Color="#40FFFCF2" />
    <SolidColorBrush x:Key="BorderBrush" Color="#DCC9D9" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#BFA8BD" />
    <SolidColorBrush x:Key="DividerBrush" Color="#E7D9DE" />

    <!-- Brand purple is the primary action color; yellow remains the luminous accent. -->
    <SolidColorBrush x:Key="AccentBrush" Color="#57006D" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#460057" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#350042" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFDF8" />

    <Color x:Key="AiGlowColor">#FFFFD100</Color>
    <SolidColorBrush x:Key="AiAccentBrush" Color="#F2C400" />
    <SolidColorBrush x:Key="AiAccentHoverBrush" Color="#D9AE00" />
    <SolidColorBrush x:Key="AiAccentPressedBrush" Color="#B89000" />
    <SolidColorBrush x:Key="AiAccentSoftBrush" Color="#FFF3B3" />
    <SolidColorBrush x:Key="AiAccentBorderBrush" Color="#D8B100" />
    <SolidColorBrush x:Key="OnAiAccentBrush" Color="#3A1943" />
    <SolidColorBrush x:Key="AiPanelTextBrush" Color="#4C2057" />

    <SolidColorBrush x:Key="HoverBrush" Color="#F2E3B8" />
    <SolidColorBrush x:Key="HoverStrongBrush" Color="#E2C865" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#382C39" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5D4E5F" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#675769" />
    <SolidColorBrush x:Key="TextSubtleBrush" Color="#6C5B6E" />
    <SolidColorBrush x:Key="NarrativeTextBrush" Color="#5C485E" />
    <SolidColorBrush x:Key="PersonGroupBrush" Color="#FFFAEA" />
    <SolidColorBrush x:Key="PersonGroupAltBrush" Color="#F6ECF6" />

    <Color x:Key="SurfaceAltColor">#FFFBF1D7</Color>
    <Color x:Key="SurfaceRaisedColor">#FFFFFEF8</Color>
    <Color x:Key="TextSubtleColor">#FF6C5B6E</Color>
    <Visibility x:Key="BrandLogoVisibility">Visible</Visibility>
</ResourceDictionary>
