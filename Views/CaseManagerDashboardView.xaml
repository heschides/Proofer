<UserControl x:Class="Sati.Views.CaseManagerDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Sati.Views"
             Background="{DynamicResource WindowBackgroundBrush}"
             TextElement.FontFamily="{StaticResource AppFont}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══ SUB-NAV TOOLBAR ═══ -->
        <Border Grid.Row="0"
                Background="{DynamicResource NavBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,8">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          CanContentScroll="True">
            <StackPanel Orientation="Horizontal"
                        KeyboardNavigation.TabNavigation="Local">

                <Border Cursor="Hand"
                        CornerRadius="4"
                        Padding="12,4"
                        Margin="0,0,4,0">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick"
                                      Command="{Binding NavigateToOverviewCommand}" />
                    </Border.InputBindings>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background"
                                    Value="Transparent" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDashboardSubActive}"
                                             Value="True">
                                    <Setter Property="Background"
                                            Value="{DynamicResource AccentButtonBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="Overview"
                               FontSize="12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource TextSecondaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDashboardSubActive}"
                                                 Value="True">
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource OnAccentButtonBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <Border Cursor="Hand"
                        CornerRadius="4"
                        Padding="12,4"
                        Margin="0,0,4,0">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick"
                                      Command="{Binding NavigateToClientsCommand}" />
                    </Border.InputBindings>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background"
                                    Value="Transparent" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsClientsSubActive}"
                                             Value="True">
                                    <Setter Property="Background"
                                            Value="{DynamicResource AccentButtonBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="Clients"
                               FontSize="12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource TextSecondaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsClientsSubActive}"
                                                 Value="True">
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource OnAccentButtonBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <Border Cursor="Hand"
                        CornerRadius="4"
                        Padding="12,4"
                        Margin="0,0,4,0">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick"
                                      Command="{Binding NavigateToNotesLogCommand}" />
                    </Border.InputBindings>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background"
                                    Value="Transparent" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsNotesLogSubActive}"
                                             Value="True">
                                    <Setter Property="Background"
                                            Value="{DynamicResource AccentButtonBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="Notes"
                               FontSize="12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource TextSecondaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsNotesLogSubActive}"
                                                 Value="True">
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource OnAccentButtonBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <Border Cursor="Hand"
                        CornerRadius="4"
                        Padding="12,4"
                        Margin="0,0,4,0">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick"
                                      Command="{Binding NavigateToMatrixCommand}" />
                    </Border.InputBindings>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background"
                                    Value="Transparent" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMatrixSubActive}"
                                             Value="True">
                                    <Setter Property="Background"
                                            Value="{DynamicResource AccentButtonBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="Caseload Matrix"
                               FontSize="12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource TextSecondaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMatrixSubActive}"
                                                 Value="True">
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource OnAccentButtonBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
                <Border Cursor="Hand"
                        CornerRadius="4"
                        Padding="12,4"
                        Margin="0,0,4,0">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick"
                                      Command="{Binding NavigateToCalendarCommand}" />
                    </Border.InputBindings>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background"
                                    Value="Transparent" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCalendarSubActive}"
                                             Value="True">
                                    <Setter Property="Background"
                                            Value="{DynamicResource AccentButtonBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="Calendar"
                               FontSize="12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource TextSecondaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCalendarSubActive}"
                                                 Value="True">
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource OnAccentButtonBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <Border Cursor="Hand"
                        CornerRadius="4"
                        Padding="12,4"
                        Margin="0,0,4,0">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick"
                                      Command="{Binding NavigateToStatisticsCommand}" />
                    </Border.InputBindings>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background"
                                    Value="Transparent" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStatisticsSubActive}"
                                             Value="True">
                                    <Setter Property="Background"
                                            Value="{DynamicResource AccentButtonBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="Statistics"
                               FontSize="12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource TextSecondaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStatisticsSubActive}"
                                                 Value="True">
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource OnAccentButtonBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <Border Cursor="Hand"
                        CornerRadius="4"
                        Padding="12,4"
                        Margin="0,0,4,0">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick"
                                      Command="{Binding NavigateToReviewsCommand}" />
                    </Border.InputBindings>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background"
                                    Value="Transparent" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsReviewsSubActive}"
                                             Value="True">
                                    <Setter Property="Background"
                                            Value="{DynamicResource AccentButtonBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="Reviews"
                               FontSize="12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource TextSecondaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsReviewsSubActive}"
                                                 Value="True">
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource OnAccentButtonBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <Border Cursor="Hand"
                        CornerRadius="4"
                        Padding="12,4"
                        Margin="0,0,4,0">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick"
                                      Command="{Binding NavigateToProvidersCommand}" />
                    </Border.InputBindings>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background"
                                    Value="Transparent" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsProvidersSubActive}"
                                             Value="True">
                                    <Setter Property="Background"
                                            Value="{DynamicResource AccentButtonBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="Providers"
                               FontSize="12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource TextSecondaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsProvidersSubActive}"
                                                 Value="True">
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource OnAccentButtonBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <Button Content="AT Requests"
                        Style="{StaticResource NavTabButton}"
                        AutomationProperties.Name="Assistive technology requests"
                        views:NavTab.IsActive="{Binding IsATRequestsSubActive}"
                        Command="{Binding NavigateToATRequestsCommand}" />

                <Button Content="Authorized Rep"
                        Style="{StaticResource NavTabButton}"
                        AutomationProperties.Name="DHHS authorized representative form"
                        views:NavTab.IsActive="{Binding IsAuthorizedRepresentativeSubActive}"
                        Command="{Binding NavigateToAuthorizedRepresentativeCommand}" />

                <Button Content="Releases"
                        Style="{StaticResource NavTabButton}"
                        AutomationProperties.Name="Release forms"
                        views:NavTab.IsActive="{Binding IsReleasesSubActive}"
                        Command="{Binding NavigateToReleasesCommand}" />

            </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ═══ CONTENT AREA ═══ -->
        <Grid Grid.Row="1">

            <!-- Overview — shown when CurrentSubViewModel is null -->
            <views:CaseManagerDashboardContentView Visibility="{Binding IsDashboardSubActive,
                    Converter={StaticResource BoolToVisibilityConverter}}" />

            <!-- Other sub-tabs -->
            <ContentControl Content="{Binding CurrentSubViewModel}"
                            Visibility="{Binding IsSubViewActive,
                    Converter={StaticResource BoolToVisibilityConverter}}" />

        </Grid>
    </Grid>
</UserControl>
