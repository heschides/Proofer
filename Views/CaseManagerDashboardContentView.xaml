<UserControl x:Class="Sati.Views.CaseManagerDashboardContentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sati="clr-namespace:Sati"
             xmlns:vm="clr-namespace:Sati.ViewModels"
             xmlns:models="clr-namespace:Sati.Models"
             Background="#FDF6EC"
             TextElement.FontFamily="{StaticResource AppFont}">

    <!--
        LAYOUT: 5 columns (3 content + 2 spacers), 3 rows
        ┌─────────────┬───┬─────────────┬───┬─────────────┐
        │ Col 0       │   │ Col 2       │   │ Col 4       │
        ├─────────────┤   ├─────────────┤   ├─────────────┤
        │ Row 0       │   │ Row 0       │   │ Rows 0-1    │
        │ Toolbar     │   │ Filter bar  │   │ Productivity│
        ├─────────────┤   ├─────────────┤   ├─────────────┤
        │ Rows 1-2    │   │ Row 1       │   │ Row 2       │
        │ Note entry  │   │ Notes grid  │   │ Upcoming    │
        │ form        │   ├─────────────┤   │ Tasks       │
        │             │   │ Row 2       │   │             │
        │             │   │ Forms +     │   │             │
        │             │   │ Productivity│   │             │
        └─────────────┴───┴─────────────┴───┴─────────────┘
    -->
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="2*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width=".55*" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width=".65*" />
        </Grid.ColumnDefinitions>

        <!-- ═══ COL 0 ROWS 1-2: NOTE ENTRY FORM ═══ -->
        <Border Grid.Column="0"
                Grid.Row="1"
                Grid.RowSpan="2"
                Background="White"
                BorderBrush="#E8D0B8"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14"
                Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="NEW NOTE"
                           Grid.Row="0"
                           Style="{StaticResource SectionHeader}" />

                <TextBlock Text="CLIENT"
                           Grid.Row="1"
                           Style="{StaticResource LabelStyle}" />
                <ComboBox Grid.Row="2"
                          ItemsSource="{Binding People}"
                          SelectedItem="{Binding SelectedPerson}"
                          DisplayMemberPath="FullName" />

                <TextBlock Text="STATUS"
                           Grid.Row="3"
                           Style="{StaticResource LabelStyle}" />
                <ComboBox Grid.Row="4"
                          ItemsSource="{Binding NoteStatusOptions}"
                          SelectedItem="{Binding Status, Mode=TwoWay}" />

                <Grid Margin="0,0,0,10"
                      Grid.Row="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="75" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="NOTE TYPE"
                               Style="{StaticResource LabelStyle}"
                               Grid.Row="0"
                               Grid.Column="0"
                               Grid.ColumnSpan="2" />
                    <RadioButton Grid.Row="1"
                                 Grid.Column="1"
                                 Content="Visit"
                                 Margin="0,0,12,4"
                                 Foreground="#3D2B1F"
                                 GroupName="NoteType"
                                 IsChecked="{Binding SelectedNoteType,
                                     Converter={StaticResource BoardTabConverter},
                                     ConverterParameter=Visit}" />
                    <RadioButton Grid.Row="1"
                                 Grid.Column="3"
                                 Content="Contact"
                                 Margin="0,0,12,4"
                                 Foreground="#3D2B1F"
                                 GroupName="NoteType"
                                 IsChecked="{Binding SelectedNoteType,
                                     Converter={StaticResource EnumToBoolConverter},
                                     ConverterParameter=Contact}" />
                    <RadioButton Grid.Row="2"
                                 Grid.Column="1"
                                 Content="Other"
                                 Margin="0,0,12,4"
                                 Foreground="#3D2B1F"
                                 GroupName="NoteType"
                                 IsChecked="{Binding SelectedNoteType,
                                     Converter={StaticResource EnumToBoolConverter},
                                     ConverterParameter=Other}" />
                    <RadioButton Grid.Row="2"
                                 Grid.Column="3"
                                 Content="Form"
                                 Margin="0,0,8,4"
                                 Foreground="#3D2B1F"
                                 GroupName="NoteType"
                                 IsChecked="{Binding SelectedNoteType,
                                     Converter={StaticResource EnumToBoolConverter},
                                     ConverterParameter=Form}" />
                    <ComboBox Grid.Row="3"
                              Grid.ColumnSpan="4"
                              ItemsSource="{Binding FormTypes}"
                              SelectedItem="{Binding SelectedFormType, Mode=TwoWay}"
                              Visibility="{Binding IsFormNote,
                                  Converter={StaticResource BoolToVisibilityConverter}}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>

                <Grid Grid.Row="7">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="MINUTES"
                               Grid.Row="0"
                               Style="{StaticResource LabelStyle}" />
                    <TextBox Grid.Row="1"
                             Text="{Binding Minutes}" />

                    <TextBlock Text="DATE"
                               Grid.Row="2"
                               Style="{StaticResource LabelStyle}" />
                    <DatePicker Grid.Row="3"
                                SelectedDate="{Binding EventDate}" />

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="NARRATIVE"
                                   Style="{StaticResource LabelStyle}" />
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal">
                            <Button Command="{Binding DecreaseNarrativeFontCommand}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Padding="4,0">
                                <TextBlock Text="A"
                                           FontSize="11"
                                           Foreground="#9C7A5C" />
                            </Button>
                            <Button Command="{Binding IncreaseNarrativeFontCommand}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Padding="4,0">
                                <TextBlock Text="A"
                                           FontSize="16"
                                           Foreground="#9C7A5C"
                                           FontWeight="SemiBold" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <TextBox Grid.Row="5"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             SpellCheck.IsEnabled="True"
                             FontFamily="{StaticResource NarrativeFont}"
                             FontSize="{Binding NarrativeFontSize}"
                             Text="{Binding Narrative}" />
                </Grid>

                <Button Grid.Row="8"
                        Content="Submit Note"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding SubmitNoteCommand}"
                        Margin="0,10,0,0" />
            </Grid>
        </Border>

        <!-- ═══ COL 2 ROW 0: FILTER BAR ═══ -->
        <Grid Grid.Row="0"
              Grid.Column="2"
              Margin="0,0,0,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="160" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0"
                       Grid.Column="0"
                       Text="FILTER NOTES"
                       Style="{StaticResource LabelStyle}" />
            <TextBlock Grid.Row="0"
                       Grid.Column="2"
                       Text="FILTER STATUS"
                       Style="{StaticResource LabelStyle}" />

            <TextBox x:Name="SearchTextBox"
                     Grid.Row="1"
                     Grid.Column="0"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            <ComboBox Grid.Row="1"
                      Grid.Column="2"
                      Height="{Binding ActualHeight, ElementName=SearchTextBox}"
                      ItemsSource="{Binding NoteStatusOptions}"
                      SelectedItem="{Binding FilterStatus}" />
        </Grid>

        <!-- ═══ COL 2 ROW 1: NOTES DATAGRID ═══ -->
        <Border Grid.Column="2"
                Grid.Row="1"
                Background="White"
                BorderBrush="#E8D0B8"
                BorderThickness="1"
                CornerRadius="6"
                Margin="0,0,0,12">
            <DataGrid ItemsSource="{Binding NotesView}"
                      SelectedItem="{Binding SelectedNote, Mode=TwoWay}"
                      MouseDoubleClick="DataGrid_MouseDoubleClick"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      Background="Transparent"
                      BorderThickness="0"
                      RowBackground="White"
                      AlternatingRowBackground="#FDF6EC"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#F0E0D0"
                      HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date"
                                        Binding="{Binding EventDate, StringFormat={}{0:MM/dd}}"
                                        Width="60" />
                    <DataGridTextColumn Header="Status"
                                        Binding="{Binding Status}"
                                        Width="90" />
                    <DataGridTextColumn Header="Units"
                                        Binding="{Binding Units}"
                                        Width="50" />
                    <DataGridTextColumn Header="Type"
                                        Binding="{Binding NoteType}"
                                        Width="80" />
                </DataGrid.Columns>
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Delete Note"
                                  Command="{Binding DeleteNoteCommand}" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
            </DataGrid>
        </Border>

        <!-- ═══ COL 2 ROW 2: FORMS CHECKLIST + MONTHLY PRODUCTIVITY ═══ -->
        <Border Grid.Column="2"
                Grid.Row="2"
                Background="White"
                BorderBrush="#E8D0B8"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14"
                Margin="0,0,0,12">
            <StackPanel>

                <!-- Forms checklist -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Text="90-Day Reviews"
                               Style="{StaticResource SectionHeader}" />
                    <CheckBox Grid.Row="1"
                              Grid.Column="0"
                              Content="Quarter 1"
                              Foreground="#3D2B1F"
                              Margin="0,0,0,6"
                              IsChecked="{Binding Q1RCompliant, Mode=OneWay}"
                              Command="{Binding ToggleFormCommand}"
                              CommandParameter="{x:Static sati:FormType.Q1R}" />
                    <CheckBox Grid.Row="2"
                              Grid.Column="0"
                              Content="Quarter 2"
                              Foreground="#3D2B1F"
                              Margin="0,0,0,6"
                              IsChecked="{Binding Q2RCompliant, Mode=OneWay}"
                              Command="{Binding ToggleFormCommand}"
                              CommandParameter="{x:Static sati:FormType.Q2R}" />
                    <CheckBox Grid.Row="3"
                              Grid.Column="0"
                              Content="Quarter 3"
                              Foreground="#3D2B1F"
                              Margin="0,0,0,6"
                              IsChecked="{Binding Q3RCompliant, Mode=OneWay}"
                              Command="{Binding ToggleFormCommand}"
                              CommandParameter="{x:Static sati:FormType.Q3R}" />
                    <CheckBox Grid.Row="4"
                              Grid.Column="0"
                              Content="Quarter 4"
                              Foreground="#3D2B1F"
                              Margin="0,0,0,6"
                              IsChecked="{Binding Q4RCompliant, Mode=OneWay}"
                              Command="{Binding ToggleFormCommand}"
                              CommandParameter="{x:Static sati:FormType.Q4R}" />

                    <TextBlock Grid.Row="0"
                               Grid.Column="2"
                               Text="Annual Forms"
                               Style="{StaticResource SectionHeader}" />
                    <CheckBox Grid.Row="1"
                              Grid.Column="2"
                              Content="PCP"
                              Foreground="#3D2B1F"
                              Margin="0,0,0,6"
                              IsChecked="{Binding PcpCompliant, Mode=OneWay}"
                              Command="{Binding ToggleFormCommand}"
                              CommandParameter="{x:Static sati:FormType.PCP}" />
                    <CheckBox Grid.Row="2"
                              Grid.Column="2"
                              Content="Comp Assessment"
                              Foreground="#3D2B1F"
                              Margin="0,0,0,6"
                              IsChecked="{Binding CompAssessmentCompliant, Mode=OneWay}"
                              Command="{Binding ToggleFormCommand}"
                              CommandParameter="{x:Static sati:FormType.ComprehensiveAssessment}" />
                    <CheckBox Grid.Row="3"
                              Grid.Column="2"
                              Content="Reclassification"
                              Foreground="#3D2B1F"
                              Margin="0,0,0,6"
                              IsChecked="{Binding ReclassificationCompliant, Mode=OneWay}"
                              Command="{Binding ToggleFormCommand}"
                              CommandParameter="{x:Static sati:FormType.Reclassification}" />
                    <CheckBox Grid.Row="4"
                              Grid.Column="2"
                              Content="Safety Plan"
                              Foreground="#3D2B1F"
                              Margin="0,0,0,6"
                              IsChecked="{Binding SafetyPlanCompliant, Mode=OneWay}"
                              Command="{Binding ToggleFormCommand}"
                              CommandParameter="{x:Static sati:FormType.SafetyPlan}" />
                    <CheckBox Grid.Row="5"
                              Grid.Column="2"
                              Content="Privacy Practices"
                              Foreground="#3D2B1F"
                              Margin="0,0,0,6"
                              IsChecked="{Binding PrivacyPracticesCompliant, Mode=OneWay}"
                              Command="{Binding ToggleFormCommand}"
                              CommandParameter="{x:Static sati:FormType.PrivacyPractices}" />

                    <TextBlock Grid.Row="0"
                               Grid.Column="4"
                               Text="Releases"
                               Style="{StaticResource SectionHeader}" />
                    <CheckBox Grid.Row="1"
                              Grid.Column="4"
                              Content="DHHS"
                              Foreground="#3D2B1F"
                              Margin="0,0,0,6"
                              IsChecked="{Binding ReleaseDhhsCompliant, Mode=OneWay}"
                              Command="{Binding ToggleFormCommand}"
                              CommandParameter="{x:Static sati:FormType.Release_DHHS}" />
                    <CheckBox Grid.Row="2"
                              Grid.Column="4"
                              Content="Agency"
                              Foreground="#3D2B1F"
                              Margin="0,0,0,6"
                              IsChecked="{Binding ReleaseAgencyCompliant, Mode=OneWay}"
                              Command="{Binding ToggleFormCommand}"
                              CommandParameter="{x:Static sati:FormType.Release_Agency}" />
                    <CheckBox Grid.Row="3"
                              Grid.Column="4"
                              Content="Medical"
                              Foreground="#3D2B1F"
                              Margin="0,0,0,6"
                              IsChecked="{Binding ReleaseMedicalCompliant, Mode=OneWay}"
                              Command="{Binding ToggleFormCommand}"
                              CommandParameter="{x:Static sati:FormType.Release_Medical}" />
                </Grid>

                <Separator Margin="0,12,0,12" />

                <!-- Monthly productivity -->
                <TextBlock Text="MONTHLY PRODUCTIVITY"
                           Style="{StaticResource SectionHeader}" />
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="PENDING"
                                   Style="{StaticResource LabelStyle}" />
                        <TextBlock Text="{Binding PendingUnits}"
                                   FontSize="20"
                                   Foreground="#3D2B1F" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="LOGGED"
                                   Style="{StaticResource LabelStyle}" />
                        <TextBlock Text="{Binding LoggedUnits}"
                                   FontSize="20"
                                   Foreground="#3D2B1F" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="ABANDONED"
                                   Style="{StaticResource LabelStyle}" />
                        <TextBlock Text="{Binding AbandonedUnits}"
                                   FontSize="20"
                                   Foreground="#3D2B1F" />
                    </StackPanel>
                    <StackPanel Grid.Column="3">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="DAILY AVG"
                                       Style="{StaticResource LabelStyle}" />
                            <TextBlock Text="ⓘ"
                                       FontSize="12"
                                       Foreground="DarkSlateBlue"
                                       Margin="4,0,0,0"
                                       VerticalAlignment="Top"
                                       Cursor="Help">
                                <TextBlock.ToolTip>
                                    <ToolTip>
                                        <TextBlock MaxWidth="220"
                                                   TextWrapping="Wrap">
                                            <Run Text="Average units per day on days where notes have been logged.  When you enter your first note for a new day, this number will decrease significantly; it will continue to rise as you enter notes for that day."/>
                                            <LineBreak />
                                            <LineBreak />
                                            <Run Text="Days without logged notes are not included — they don't drag your average down. Use the calendar to mark non-working days as exempt, which removes them from your monthly target." />
                                             <LineBreak />
                                        </TextBlock>
                                    </ToolTip>
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Text="{Binding DailyAverageUnits, StringFormat={}{0:F1}}"
                                   FontSize="20"
                                   Foreground="#3D2B1F" />
                    </StackPanel>
                </Grid>

                <TextBlock Style="{StaticResource LabelStyle}">
                    <Run Text="{Binding LoggedUnits, Mode=OneWay}" />
                    <Run Text=" / " />
                    <Run Text="{Binding Threshold, Mode=OneWay}" />
                    <Run Text=" units" />
                </TextBlock>
                <ProgressBar Minimum="0"
                             Maximum="{Binding SafeThreshold, TargetNullValue=1, FallbackValue=1}"
                             Value="{Binding LoggedUnits, Mode=OneWay}"
                             Height="10"
                             Margin="0,4,0,8"
                             Foreground="#C87941"
                             Background="#E8D0B8"
                             BorderThickness="0" />

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="NEEDED / DAY"
                                   Style="{StaticResource LabelStyle}" />
                        <TextBlock Text="{Binding UnitsPerRemainingDay, StringFormat={}{0:F1}, TargetNullValue='—'}"
                                   FontSize="20"
                                   Foreground="#3D2B1F" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="DAYS LEFT"
                                       Style="{StaticResource LabelStyle}" />
                            <TextBlock Text="ⓘ"
                                       FontSize="12"
                                       Foreground="#9C7A5C"
                                       Margin="4,0,0,0"
                                       VerticalAlignment="Center"
                                       Cursor="Help">
                                <TextBlock.ToolTip>
                                    <ToolTip>
                                        <TextBlock MaxWidth="220"
                                                   TextWrapping="Wrap">
                                            <Run Text="Eligible workdays remaining in the month with no notes logged yet." />
                                            <LineBreak />
                                            <LineBreak />
                                            <Run Text="Excludes weekends, holidays, and days marked exempt in the calendar. Past days without notes are included — you can still log notes for them." />
                                        </TextBlock>
                                    </ToolTip>
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Text="{Binding RemainingEligibleDays}"
                                   FontSize="20"
                                   Foreground="#3D2B1F" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="ESTIMATED INCENTIVE"
                           Style="{StaticResource LabelStyle}" />
                <TextBlock Text="{Binding EstimatedIncentive, StringFormat=C}"
                           FontSize="20"
                           Foreground="#3D2B1F" />
            </StackPanel>
        </Border>

        <!-- ═══ COL 4 ROWS 0-2: TASK BOARD ═══ -->
        <Border Grid.Column="4"
                Grid.Row="0"
                Grid.RowSpan="3"
                Background="White"
                BorderBrush="#E8D0B8"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14"
                Margin="0,0,0,12">

            <Border.Resources>

                <!-- Tab pill: a RadioButton drawn as an underline pill. One GroupName
                     for the strip; each pill's IsChecked binds to SelectedTab through
                     EnumToBoolConverter — the same pattern the NoteType radios use, so
                     clicking a pill sets SelectedTab and the rest clear themselves. The
                     active styling lives on the IsChecked trigger, which is why one
                     shared style covers all eight. -->
                <Style x:Key="BoardPill"
                       TargetType="RadioButton">
                    <Setter Property="Margin"
                            Value="0,0,10,4" />
                    <Setter Property="Cursor"
                            Value="Hand" />
                    <Setter Property="Foreground"
                            Value="#9C7A5C" />
                    <Setter Property="FontSize"
                            Value="11" />
                    <Setter Property="FontWeight"
                            Value="SemiBold" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="RadioButton">
                                <Border x:Name="PillBorder"
                                        BorderThickness="0,0,0,2"
                                        BorderBrush="Transparent"
                                        Padding="0,0,0,3"
                                        Background="Transparent">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked"
                                             Value="True">
                                        <Setter TargetName="PillBorder"
                                                Property="BorderBrush"
                                                Value="#C87941" />
                                        <Setter Property="Foreground"
                                                Value="#3D2B1F" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <!-- Form row. Left bar colors by workflow state; the red triangle shows
                     only when overdue. The context menu reaches the VM through
                     PlacementTarget.Tag — the menu isn't in the visual tree, so it can't
                     inherit the VM as DataContext — and passes the row itself via
                     PlacementTarget.DataContext. -->
                <DataTemplate DataType="{x:Type vm:FormTaskRow}">
                    <Border Margin="0,2"
                            Padding="6,4"
                            CornerRadius="3"
                            BorderThickness="3,0,0,0"
                            Background="Transparent"
                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush"
                                        Value="#C9B79C" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding State}"
                                                 Value="{x:Static sati:FormWorkflowState.Opened}">
                                        <Setter Property="BorderBrush"
                                                Value="#E8730C" />
                                        <Setter Property="Background"
                                                Value="#FBEAD7" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}"
                                                 Value="{x:Static sati:FormWorkflowState.Completed}">
                                        <Setter Property="BorderBrush"
                                                Value="#6B8E6B" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Mark Opened"
                                          Command="{Binding PlacementTarget.Tag.MarkFormOpenedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="Mark Completed"
                                          Command="{Binding PlacementTarget.Tag.MarkFormCompletedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <Separator />
                                <MenuItem Header="Mark Not Started"
                                          Command="{Binding PlacementTarget.Tag.MarkFormNotStartedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            </ContextMenu>
                        </Border.ContextMenu>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding ClientName}"
                                           FontWeight="SemiBold"
                                           Foreground="#3D2B1F"
                                           FontSize="12"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding TypeLabel}"
                                           FontSize="11"
                                           Foreground="#9C7A5C" />
                                <TextBlock FontSize="10"
                                           Foreground="#9C7A5C"
                                           Margin="0,1,0,0">
                                    <Run Text="Open" />
                                    <Run Text="{Binding OpenByDate, StringFormat={}{0:MMM d}, Mode=OneWay}" />
                                    <Run Text="  ·  Due" />
                                    <Run Text="{Binding DueDate, StringFormat={}{0:MMM d}, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="▲"
                                       Foreground="#C0392B"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       Margin="6,0,2,0"
                                       Cursor="Help"
                                       ToolTip="{Binding OverdueTooltip}"
                                       Visibility="{Binding IsOverdue, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </Grid>
                    </Border>
                </DataTemplate>

                <!-- Appointment row (scheduled visits/contacts/forms). Read-only. -->
                <DataTemplate DataType="{x:Type models:UpcomingEvent}">
                    <Border Margin="0,2"
                            Padding="6,4"
                            CornerRadius="3"
                            BorderThickness="3,0,0,0"
                            BorderBrush="#6B8E6B">
                        <StackPanel>
                            <TextBlock Text="{Binding Title}"
                                       FontWeight="SemiBold"
                                       Foreground="#3D2B1F"
                                       FontSize="12"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Date, StringFormat={}{0:MMM d}}"
                                       FontSize="11"
                                       Foreground="#9C7A5C" />
                        </StackPanel>
                    </Border>
                </DataTemplate>

            </Border.Resources>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <WrapPanel Grid.Row="0"
                           Margin="0,0,0,4">
                    <RadioButton Content="Comp Assessments"
                                 Style="{StaticResource BoardPill}"
                                 GroupName="BoardTabs"
                                 IsChecked="{Binding SelectedTab, Converter={StaticResource BoardTabConverter}, ConverterParameter=CompAssessments}" />
                    <RadioButton Content="Reclasses"
                                 Style="{StaticResource BoardPill}"
                                 GroupName="BoardTabs"
                                 IsChecked="{Binding SelectedTab, Converter={StaticResource BoardTabConverter}, ConverterParameter=Reclasses}" />
                    <RadioButton Content="PCPs"
                                 Style="{StaticResource BoardPill}"
                                 GroupName="BoardTabs"
                                 IsChecked="{Binding SelectedTab, Converter={StaticResource BoardTabConverter}, ConverterParameter=Pcps}" />
                    <RadioButton Content="Releases"
                                 Style="{StaticResource BoardPill}"
                                 GroupName="BoardTabs"
                                 IsChecked="{Binding SelectedTab, Converter={StaticResource BoardTabConverter}, ConverterParameter=Releases}" />
                    <RadioButton Content="Appointments"
                                 Style="{StaticResource BoardPill}"
                                 GroupName="BoardTabs"
                                 IsChecked="{Binding SelectedTab, Converter={StaticResource BoardTabConverter}, ConverterParameter=Appointments}" />
                    <RadioButton Content="90-Day Reviews"
                                 Style="{StaticResource BoardPill}"
                                 GroupName="BoardTabs"
                                 IsChecked="{Binding SelectedTab, Converter={StaticResource BoardTabConverter}, ConverterParameter=Reviews}" />
                    <RadioButton Content="Effective Dates"
                                 Style="{StaticResource BoardPill}"
                                 GroupName="BoardTabs"
                                 IsChecked="{Binding SelectedTab, Converter={StaticResource BoardTabConverter}, ConverterParameter=EffectiveDates}" />
                    <RadioButton Content="All"
                                 Style="{StaticResource BoardPill}"
                                 GroupName="BoardTabs"
                                 IsChecked="{Binding SelectedTab, Converter={StaticResource BoardTabConverter}, ConverterParameter=All}" />
                </WrapPanel>

                <Separator Grid.Row="1" />

                <Grid Grid.Row="2">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding IsTaskListTab, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ItemsControl ItemsSource="{Binding BoardItems}" />
                    </ScrollViewer>

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding IsEffectiveDatesTab, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ItemsControl ItemsSource="{Binding EffectiveDateGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8"
                                            CornerRadius="4"
                                            Padding="8">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background"
                                                        Value="Transparent" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCurrent}"
                                                                 Value="True">
                                                        <Setter Property="Background"
                                                                Value="#EDD9C0" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Label}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="#9C7A5C"
                                                       Margin="0,0,0,4" />
                                            <ItemsControl ItemsSource="{Binding ClientNames}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}"
                                                                   FontSize="12"
                                                                   Foreground="#3D2B1F"
                                                                   Margin="0,2" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>

        <!-- Compliance dialog overlay -->
        <Grid Background="#80000000"
              Grid.RowSpan="3"
              Grid.ColumnSpan="5"
              Visibility="{Binding IsComplianceDialogVisible,
                  Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="#FDF6EC"
                    BorderBrush="#D9AEAE"
                    BorderThickness="1"
                    CornerRadius="6"
                    Width="460"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>

                    <TextBlock Text="CLIENT NOT BILLING COMPLIANT"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#7A3B3B"
                               Margin="0,0,0,8" />

                    <TextBlock TextWrapping="Wrap"
                               FontSize="12"
                               Foreground="#3D2B1F"
                               Margin="0,0,0,12">
                        <Run Text="{Binding SelectedPerson.FullName, FallbackValue='This client', Mode=OneWay}" />
                        <Run Text="does not currently meet billing compliance requirements. You may hold this note in your queue until compliance is resolved, or send it to your supervisor with a written justification." />
                    </TextBlock>

                    <Border Background="#FFF0E8"
                            BorderBrush="#D9AEAE"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10,8"
                            Margin="0,0,0,12">
                        <ItemsControl ItemsSource="{Binding ComplianceFailureReasons}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"
                                               FontSize="12"
                                               Foreground="#7A3B3B"
                                               Margin="0,2"
                                               TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <TextBlock Text="JUSTIFICATION"
                               FontSize="10"
                               Foreground="#9C7A5C"
                               Margin="0,0,0,4" />
                    <TextBlock Text="Required if sending to supervisor. Ignored if holding."
                               FontSize="10"
                               Foreground="#9C7A5C"
                               Margin="0,0,0,6" />
                    <TextBox Text="{Binding PendingJustification, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Height="90"
                             Padding="8"
                             FontSize="12"
                             Background="White"
                             BorderBrush="#D9AEAE"
                             VerticalScrollBarVisibility="Auto"
                             Margin="0,0,0,16" />

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Content="Cancel"
                                Padding="14,6"
                                FontSize="12"
                                Cursor="Hand"
                                BorderThickness="0"
                                Background="#9C7A5C"
                                Foreground="#FDF6EC"
                                Margin="0,0,6,0"
                                Command="{Binding CancelComplianceDialogCommand}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="4"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Content="Hold for Now"
                                Padding="14,6"
                                FontSize="12"
                                Cursor="Hand"
                                BorderThickness="0"
                                Background="#C87941"
                                Foreground="#FDF6EC"
                                Margin="0,0,6,0"
                                Command="{Binding HoldForComplianceCommand}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="4"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Content="Send to Supervisor"
                                Padding="14,6"
                                FontSize="12"
                                Cursor="Hand"
                                BorderThickness="0"
                                Background="#7A3B3B"
                                Foreground="#FDF6EC"
                                Command="{Binding SendToSupervisorCommand}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="4"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>

                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</UserControl>