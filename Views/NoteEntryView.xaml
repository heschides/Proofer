<UserControl x:Class="Sati.Views.NoteEntryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sati="clr-namespace:Sati"
             TextElement.FontFamily="{StaticResource AppFont}">

    <!-- Root grid stacks the form and the compliance overlay. The overlay dims
         the MODULE only, not the hosting screen — deliberate, one definition. -->
    <Grid>

        <!-- ═══ NOTE ENTRY FORM ═══
             DockPanel, not Grid: the Submit button docks to the bottom and claims
             its space FIRST (LastChildFill=False + explicit DockPanel.Dock), so a
             long narrative can never push it out of the module's clip bounds. The
             field grid fills what's left, inside a ScrollViewer — fields scroll,
             Submit stays put. This is the fix for the clipped-button bug. -->
        <Border Background="White"
                BorderBrush="#E8D0B8"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14">
            <DockPanel LastChildFill="True">

                <!-- Docked FIRST so it reserves bottom space before the fill child. -->
                <Button DockPanel.Dock="Bottom"
                        Command="{Binding SubmitNoteCommand}"
                        Margin="0,10,0,0">
                    <Button.Style>
                        <Style TargetType="Button"
                               BasedOn="{StaticResource PrimaryButton}">
                            <Setter Property="Content"
                                    Value="Submit Note" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEditing}"
                                             Value="True">
                                    <Setter Property="Content"
                                            Value="Update Note" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="NEW NOTE"
                                   Grid.Row="0"
                                   Style="{StaticResource SectionHeader}" />

                        <TextBlock Text="CLIENT"
                           Grid.Row="1"
                           Style="{StaticResource LabelStyle}" />
                <ComboBox Grid.Row="2"
                          ItemsSource="{Binding People}"
                          SelectedItem="{Binding SelectedPerson}"
                          DisplayMemberPath="FullName" />

                <TextBlock Text="STATUS"
                           Grid.Row="3"
                           Style="{StaticResource LabelStyle}" />
                <ComboBox Grid.Row="4"
                          ItemsSource="{Binding NoteStatusOptions}"
                          SelectedItem="{Binding Status, Mode=TwoWay}" />

                <Grid Margin="0,0,0,10"
                      Grid.Row="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="75" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="NOTE TYPE"
                               Style="{StaticResource LabelStyle}"
                               Grid.Row="0"
                               Grid.Column="0"
                               Grid.ColumnSpan="2" />
                    <RadioButton Grid.Row="1"
                                 Grid.Column="1"
                                 Content="Visit"
                                 Margin="0,0,12,4"
                                 Foreground="#3D2B1F"
                                 GroupName="NoteEntryNoteType"
                                 IsChecked="{Binding SelectedNoteType,
                                     Converter={StaticResource EnumToBoolConverter},
                                     ConverterParameter=Visit}" />
                    <RadioButton Grid.Row="1"
                                 Grid.Column="3"
                                 Content="Contact"
                                 Margin="0,0,12,4"
                                 Foreground="#3D2B1F"
                                 GroupName="NoteEntryNoteType"
                                 IsChecked="{Binding SelectedNoteType,
                                     Converter={StaticResource EnumToBoolConverter},
                                     ConverterParameter=Contact}" />
                    <RadioButton Grid.Row="2"
                                 Grid.Column="1"
                                 Content="Other"
                                 Margin="0,0,12,4"
                                 Foreground="#3D2B1F"
                                 GroupName="NoteEntryNoteType"
                                 IsChecked="{Binding SelectedNoteType,
                                     Converter={StaticResource EnumToBoolConverter},
                                     ConverterParameter=Other}" />
                    <RadioButton Grid.Row="2"
                                 Grid.Column="3"
                                 Content="Form"
                                 Margin="0,0,8,4"
                                 Foreground="#3D2B1F"
                                 GroupName="NoteEntryNoteType"
                                 IsChecked="{Binding SelectedNoteType,
                                     Converter={StaticResource EnumToBoolConverter},
                                     ConverterParameter=Form}" />
                    <ComboBox Grid.Row="3"
                              Grid.ColumnSpan="4"
                              ItemsSource="{Binding FormTypes}"
                              SelectedItem="{Binding SelectedFormType, Mode=TwoWay}"
                              Visibility="{Binding IsFormNote,
                                  Converter={StaticResource BoolToVisibilityConverter}}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>

                        <Grid Grid.Row="7">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="MINUTES"
                               Grid.Row="0"
                               Style="{StaticResource LabelStyle}" />
                    <TextBox Grid.Row="1"
                             Text="{Binding Minutes}" />

                    <TextBlock Text="DATE"
                               Grid.Row="2"
                               Style="{StaticResource LabelStyle}" />
                    <DatePicker Grid.Row="3"
                                SelectedDate="{Binding EventDate}" />

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="NARRATIVE"
                                   Style="{StaticResource LabelStyle}" />
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal">
                            <Button Command="{Binding DecreaseNarrativeFontCommand}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Padding="4,0">
                                <TextBlock Text="A"
                                           FontSize="11"
                                           Foreground="#9C7A5C" />
                            </Button>
                            <Button Command="{Binding IncreaseNarrativeFontCommand}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Padding="4,0">
                                <TextBlock Text="A"
                                           FontSize="16"
                                           Foreground="#9C7A5C"
                                           FontWeight="SemiBold" />
                            </Button>
                        </StackPanel>
                    </Grid>

                            <TextBox Grid.Row="5"
                                     MinHeight="160"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     SpellCheck.IsEnabled="True"
                                     FontFamily="{StaticResource NarrativeFont}"
                                     FontSize="{Binding NarrativeFontSize}"
                                     Text="{Binding Narrative}" />
                        </Grid>

                    </Grid>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ═══ COMPLIANCE DIALOG OVERLAY (module-scoped) ═══ -->
        <Grid Background="#80000000"
              Visibility="{Binding IsComplianceDialogVisible,
                  Converter={StaticResource BoolToVisibilityConverter}}">
            <!-- MaxHeight bound to the overlay Grid keeps the dialog inside the
                 module's clip bounds (module-only dimming). Inside, a DockPanel
                 pins the button row to the bottom and lets the message + reasons +
                 justification scroll — so buttons are reachable no matter how many
                 compliance reasons or how long the client name. -->
            <Border Background="#FDF6EC"
                    BorderBrush="#D9AEAE"
                    BorderThickness="1"
                    CornerRadius="6"
                    MaxWidth="460"
                    MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Grid}}"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <DockPanel LastChildFill="True">

                    <!-- Button row docked bottom, reserved before the scroll body. -->
                    <StackPanel DockPanel.Dock="Bottom"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,16,0,0">
                        <Button Content="Cancel"
                                Padding="14,6"
                                FontSize="12"
                                Cursor="Hand"
                                BorderThickness="0"
                                Background="#9C7A5C"
                                Foreground="#FDF6EC"
                                Margin="0,0,6,0"
                                Command="{Binding CancelComplianceDialogCommand}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="4"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Content="Hold for Now"
                                Padding="14,6"
                                FontSize="12"
                                Cursor="Hand"
                                BorderThickness="0"
                                Background="#C87941"
                                Foreground="#FDF6EC"
                                Margin="0,0,6,0"
                                Command="{Binding HoldForComplianceCommand}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="4"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Content="Send to Supervisor"
                                Padding="14,6"
                                FontSize="12"
                                Cursor="Hand"
                                BorderThickness="0"
                                Background="#7A3B3B"
                                Foreground="#FDF6EC"
                                Command="{Binding SendToSupervisorCommand}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="4"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>

                    <!-- Fill: everything above the buttons, scrolling as a unit. -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>

                            <TextBlock Text="CLIENT NOT BILLING COMPLIANT"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#7A3B3B"
                                       Margin="0,0,0,8" />

                            <TextBlock TextWrapping="Wrap"
                                       FontSize="12"
                                       Foreground="#3D2B1F"
                                       Margin="0,0,0,12">
                                <Run Text="{Binding SelectedPerson.FullName, FallbackValue='This client', Mode=OneWay}" />
                                <Run Text="does not currently meet billing compliance requirements. You may hold this note in your queue until compliance is resolved, or send it to your supervisor with a written justification." />
                            </TextBlock>

                            <Border Background="#FFF0E8"
                            BorderBrush="#D9AEAE"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10,8"
                            Margin="0,0,0,12">
                        <ScrollViewer MaxHeight="140"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ComplianceFailureReasons}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"
                                                   FontSize="12"
                                                   Foreground="#7A3B3B"
                                                   Margin="0,2"
                                                   TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <TextBlock Text="JUSTIFICATION"
                               FontSize="10"
                                   Foreground="#9C7A5C"
                                   Margin="0,0,0,4" />
                        <TextBlock Text="Required if sending to supervisor. Ignored if holding."
                                   FontSize="10"
                                   Foreground="#9C7A5C"
                                   Margin="0,0,0,6" />
                            <TextBox Text="{Binding PendingJustification, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Height="90"
                                     Padding="8"
                                     FontSize="12"
                                     Background="White"
                                     BorderBrush="#D9AEAE"
                                     VerticalScrollBarVisibility="Auto"
                                     Margin="0,0,0,0" />

                        </StackPanel>
                    </ScrollViewer>

                </DockPanel>
            </Border>
        </Grid>

    </Grid>
</UserControl>