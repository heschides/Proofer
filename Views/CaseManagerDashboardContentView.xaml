<UserControl x:Class="Sati.Views.CaseManagerDashboardContentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sati="clr-namespace:Sati;assembly=Sati.Persistence"
             xmlns:vm="clr-namespace:Sati.ViewModels"
             xmlns:models="clr-namespace:Sati.Models;assembly=Sati.Persistence"
             xmlns:views="clr-namespace:Sati.Views"
             Background="{DynamicResource WindowBackgroundBrush}"
             TextElement.FontFamily="{StaticResource AppFont}">

    <!-- Escape returns the note panel to a blank New Note and drops the notes
         grid's highlight with it. The selected CLIENT survives — it scopes this
         whole page. Declared here as well as on the module so the key works from
         the grid and the toolbar, not only from inside the form. -->
    <UserControl.InputBindings>
        <KeyBinding Key="Escape"
                    Command="{Binding NoteEntry.StartNewNoteCommand}" />
    </UserControl.InputBindings>

    <!--
        LAYOUT: 5 columns (3 content + 2 spacers), 3 rows
        ┌─────────────┬───┬─────────────┬───┬─────────────┐
        │ Col 0       │   │ Col 2       │   │ Col 4       │
        ├─────────────┤   ├─────────────┤   ├─────────────┤
        │ Row 0       │   │ Row 0       │   │ Rows 0-1    │
        │ Toolbar     │   │ Filter bar  │   │ Productivity│
        ├─────────────┤   ├─────────────┤   ├─────────────┤
        │ Rows 1-2    │   │ Row 1       │   │ Row 2       │
        │ Note entry  │   │ Notes grid  │   │ Upcoming    │
        │ form        │   ├─────────────┤   │ Tasks       │
        │             │   │ Row 2       │   │             │
        │             │   │ Forms +     │   │             │
        │             │   │ Productivity│   │             │
        └─────────────┴───┴─────────────┴───┴─────────────┘
    -->
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="2*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width=".55*" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width=".65*" />
        </Grid.ColumnDefinitions>

        <!-- ═══ COL 0 ROWS 1-2: NOTE ENTRY MODULE ═══
             Shared UserControl, rendered via the NoteEntryViewModel DataTemplate.
             The module carries its own border, padding, and compliance overlay. -->
        <ContentControl Grid.Column="0"
                        Grid.Row="1"
                        Grid.RowSpan="2"
                        Margin="0,0,0,12"
                        Content="{Binding NoteEntry}" />

        <!-- ═══ COL 2 ROW 0: FILTER BAR ═══ -->
        <Grid Grid.Row="0"
              Grid.Column="2"
              Margin="0,0,0,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="160" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0"
                       Grid.Column="0"
                       Text="FILTER NOTES"
                       Style="{StaticResource LabelStyle}" />
            <TextBlock Grid.Row="0"
                       Grid.Column="2"
                       Text="FILTER STATUS"
                       Style="{StaticResource LabelStyle}" />

            <TextBox AutomationProperties.Name="Search Text" x:Name="SearchTextBox"
                     Grid.Row="1"
                     Grid.Column="0"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            <ComboBox AutomationProperties.Name="Filter by note status" Grid.Row="1"
                      Grid.Column="2"
                      Height="{Binding ActualHeight, ElementName=SearchTextBox}"
                      ItemsSource="{Binding NoteStatusOptions}"
                      SelectedItem="{Binding FilterStatus}" />
        </Grid>

        <!-- ═══ COL 2 ROW 1: NOTES DATAGRID ═══ -->
        <Border Grid.Column="2"
                Grid.Row="1"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Margin="0,0,0,12">
            <DataGrid AutomationProperties.Name="Notes" ItemsSource="{Binding NotesView}"
                      SelectedItem="{Binding SelectedNote, Mode=TwoWay}"
                      MouseDoubleClick="DataGrid_MouseDoubleClick"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      Background="Transparent"
                      BorderThickness="0"
                      RowBackground="{DynamicResource SurfaceBrush}"
                      AlternatingRowBackground="{DynamicResource WindowBackgroundBrush}"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{DynamicResource DividerBrush}"
                      HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date"
                                        Binding="{Binding EventDate, StringFormat={}{0:MM/dd}}"
                                        Width="60" />
                    <DataGridTextColumn Header="Status"
                                        Binding="{Binding Status}"
                                        Width="90" />
                    <DataGridTextColumn Header="Units"
                                        Binding="{Binding Units}"
                                        Width="50" />
                    <DataGridTextColumn Header="Type"
                                        Binding="{Binding NoteType}"
                                        Width="80" />
                </DataGrid.Columns>
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Delete Note"
                                  Command="{Binding DeleteNoteCommand}" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
            </DataGrid>
        </Border>

        <!-- ═══ COL 2 ROW 2: FORMS CHECKLIST + MONTHLY PRODUCTIVITY ═══ -->
        <Border Grid.Column="2"
                Grid.Row="2"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14"
                Margin="0,0,0,12">
            <StackPanel>

                <!-- Forms checklist -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Text="90-Day Reviews"
                               Style="{StaticResource SectionHeader}" />
                    <CheckBox Grid.Row="1"
                              Grid.Column="0"
                              Content="Quarter 1"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              Margin="0,0,0,6"
                              IsChecked="{Binding Q1RCompliant, Mode=OneWay}"
                              Command="{Binding ToggleFormCommand}"
                              CommandParameter="{x:Static sati:FormType.Q1R}" />
                    <CheckBox Grid.Row="2"
                              Grid.Column="0"
                              Content="Quarter 2"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              Margin="0,0,0,6"
                              IsChecked="{Binding Q2RCompliant, Mode=OneWay}"
                              Command="{Binding ToggleFormCommand}"
                              CommandParameter="{x:Static sati:FormType.Q2R}" />
                    <CheckBox Grid.Row="3"
                              Grid.Column="0"
                              Content="Quarter 3"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              Margin="0,0,0,6"
                              IsChecked="{Binding Q3RCompliant, Mode=OneWay}"
                              Command="{Binding ToggleFormCommand}"
                              CommandParameter="{x:Static sati:FormType.Q3R}" />
                    <CheckBox Grid.Row="4"
                              Grid.Column="0"
                              Content="Quarter 4"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              Margin="0,0,0,6"
                              IsChecked="{Binding Q4RCompliant, Mode=OneWay}"
                              Command="{Binding ToggleFormCommand}"
                              CommandParameter="{x:Static sati:FormType.Q4R}" />

                    <TextBlock Grid.Row="0"
                               Grid.Column="2"
                               Text="Annual Forms"
                               Style="{StaticResource SectionHeader}" />
                    <CheckBox Grid.Row="1"
                              Grid.Column="2"
                              Content="PCP"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              Margin="0,0,0,6"
                              IsChecked="{Binding PcpCompliant, Mode=OneWay}"
                              Command="{Binding ToggleFormCommand}"
                              CommandParameter="{x:Static sati:FormType.PCP}" />
                    <CheckBox Grid.Row="2"
                              Grid.Column="2"
                              Content="Comp Assessment"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              Margin="0,0,0,6"
                              IsChecked="{Binding CompAssessmentCompliant, Mode=OneWay}"
                              Command="{Binding ToggleFormCommand}"
                              CommandParameter="{x:Static sati:FormType.ComprehensiveAssessment}" />
                    <CheckBox Grid.Row="3"
                              Grid.Column="2"
                              Content="Reclassification"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              Margin="0,0,0,6"
                              IsChecked="{Binding ReclassificationCompliant, Mode=OneWay}"
                              Command="{Binding ToggleFormCommand}"
                              CommandParameter="{x:Static sati:FormType.Reclassification}" />
                    <CheckBox Grid.Row="4"
                              Grid.Column="2"
                              Content="Safety Plan"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              Margin="0,0,0,6"
                              IsChecked="{Binding SafetyPlanCompliant, Mode=OneWay}"
                              Command="{Binding ToggleFormCommand}"
                              CommandParameter="{x:Static sati:FormType.SafetyPlan}" />
                    <CheckBox Grid.Row="5"
                              Grid.Column="2"
                              Content="Privacy Practices"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              Margin="0,0,0,6"
                              IsChecked="{Binding PrivacyPracticesCompliant, Mode=OneWay}"
                              Command="{Binding ToggleFormCommand}"
                              CommandParameter="{x:Static sati:FormType.PrivacyPractices}" />

                    <TextBlock Grid.Row="0"
                               Grid.Column="4"
                               Text="Releases"
                               Style="{StaticResource SectionHeader}" />
                    <CheckBox Grid.Row="1"
                              Grid.Column="4"
                              Content="DHHS"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              Margin="0,0,0,6"
                              IsChecked="{Binding ReleaseDhhsCompliant, Mode=OneWay}"
                              Command="{Binding ToggleFormCommand}"
                              CommandParameter="{x:Static sati:FormType.Release_DHHS}" />
                    <CheckBox Grid.Row="2"
                              Grid.Column="4"
                              Content="Agency"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              Margin="0,0,0,6"
                              IsChecked="{Binding ReleaseAgencyCompliant, Mode=OneWay}"
                              Command="{Binding ToggleFormCommand}"
                              CommandParameter="{x:Static sati:FormType.Release_Agency}" />
                    <CheckBox Grid.Row="3"
                              Grid.Column="4"
                              Content="Medical"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              Margin="0,0,0,6"
                              IsChecked="{Binding ReleaseMedicalCompliant, Mode=OneWay}"
                              Command="{Binding ToggleFormCommand}"
                              CommandParameter="{x:Static sati:FormType.Release_Medical}" />
                </Grid>

                <TextBlock Text="{Binding AnnualDocumentReminderText}" TextWrapping="Wrap" Margin="0,6,0,0"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           AutomationProperties.Name="Annual document preparation beside pending attestations" />
                <Border Margin="0,8,0,0"
                        Padding="8"
                        Background="{DynamicResource SurfaceRaisedBrush}"
                        CornerRadius="4"
                        Visibility="{Binding HasPendingAttestations, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="DOCUMENTED, WAITING FOR ATTESTATION"
                                   Style="{StaticResource LabelStyle}" />
                        <ItemsControl ItemsSource="{Binding PendingAttestations}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.SelectPendingAttestationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            HorizontalContentAlignment="Left"
                                            Margin="0,2,0,0"
                                            Padding="8,5"
                                            AutomationProperties.Name="Open pending form attestation">
                                        <TextBlock>
                                            <Run Text="{Binding FormType, Mode=OneWay}" />
                                            <Run Text=" documented " />
                                            <Run Text="{Binding EvidenceDate, StringFormat={}{0:MMM d, yyyy}, Mode=OneWay}" />
                                            <Run Text=" — cycle began " />
                                            <Run Text="{Binding CycleStart, StringFormat={}{0:MMM d, yyyy}, Mode=OneWay}" />
                                            <Run Text="; due " />
                                            <Run Text="{Binding DueDate, StringFormat={}{0:MMM d, yyyy}, Mode=OneWay}" />
                                        </TextBlock>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <views:FormAttestationControl DataContext="{Binding Attestation}" />

                <Separator Margin="0,12,0,12" />

                <!-- Monthly productivity -->
                <TextBlock Text="MONTHLY PRODUCTIVITY"
                           Style="{StaticResource SectionHeader}" />
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="PENDING"
                                   Style="{StaticResource LabelStyle}" />
                        <TextBlock Text="{Binding PendingUnits}"
                                   FontSize="20"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="LOGGED"
                                   Style="{StaticResource LabelStyle}" />
                        <TextBlock Text="{Binding LoggedUnits}"
                                   FontSize="20"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="ABANDONED"
                                   Style="{StaticResource LabelStyle}" />
                        <TextBlock Text="{Binding AbandonedUnits}"
                                   FontSize="20"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="3">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="DAILY AVG"
                                       Style="{StaticResource LabelStyle}" />
                            <TextBlock Text="ⓘ"
                                       FontSize="12"
                                       Foreground="DarkSlateBlue"
                                       Margin="4,0,0,0"
                                       VerticalAlignment="Top"
                                       Cursor="Help">
                                <TextBlock.ToolTip>
                                    <ToolTip>
                                        <TextBlock MaxWidth="220"
                                                   TextWrapping="Wrap">
                                            <Run Text="Average units per day on days where notes have been logged.  When you enter your first note for a new day, this number will decrease significantly; it will continue to rise as you enter notes for that day."/>
                                            <LineBreak />
                                            <LineBreak />
                                            <Run Text="Days without logged notes are not included — they don't drag your average down. Use the calendar to mark non-working days as exempt, which removes them from your monthly target." />
                                             <LineBreak />
                                        </TextBlock>
                                    </ToolTip>
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Text="{Binding DailyAverageUnits, StringFormat={}{0:F1}}"
                                   FontSize="20"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                </Grid>

                <TextBlock Style="{StaticResource LabelStyle}">
                    <Run Text="{Binding LoggedUnits, Mode=OneWay}" />
                    <Run Text=" / " />
                    <Run Text="{Binding Threshold, Mode=OneWay}" />
                    <Run Text=" units" />
                </TextBlock>
                <ProgressBar Minimum="0"
                             Maximum="{Binding SafeThreshold, TargetNullValue=1, FallbackValue=1}"
                             Value="{Binding LoggedUnits, Mode=OneWay}"
                             Height="10"
                             Margin="0,4,0,8"
                             Foreground="{DynamicResource AccentBrush}"
                             Background="{DynamicResource BorderBrush}"
                             BorderThickness="0" />

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="NEEDED / DAY"
                                   Style="{StaticResource LabelStyle}" />
                        <TextBlock Text="{Binding UnitsPerRemainingDay, StringFormat={}{0:F1}, TargetNullValue='—'}"
                                   FontSize="20"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="DAYS LEFT"
                                       Style="{StaticResource LabelStyle}" />
                            <TextBlock Text="ⓘ"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="4,0,0,0"
                                       VerticalAlignment="Center"
                                       Cursor="Help">
                                <TextBlock.ToolTip>
                                    <ToolTip>
                                        <TextBlock MaxWidth="220"
                                                   TextWrapping="Wrap">
                                            <Run Text="Eligible workdays remaining in the month with no notes logged yet." />
                                            <LineBreak />
                                            <LineBreak />
                                            <Run Text="Excludes weekends, holidays, and days marked exempt in the calendar. Past days without notes are included — you can still log notes for them." />
                                        </TextBlock>
                                    </ToolTip>
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Text="{Binding RemainingEligibleDays}"
                                   FontSize="20"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="ESTIMATED INCENTIVE"
                           Style="{StaticResource LabelStyle}" />
                <TextBlock Text="{Binding EstimatedIncentive, StringFormat=C}"
                           FontSize="20"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
            </StackPanel>
        </Border>

        <!-- ═══ COL 4 ROWS 0-2: TASK BOARD ═══ -->
        <Border Grid.Column="4"
                Grid.Row="0"
                Grid.RowSpan="3"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14"
                Margin="0,0,0,12">

            <Border.Resources>

                <!-- Tab pill: a RadioButton drawn as an underline pill. One GroupName
                     for the strip; each pill's IsChecked binds to SelectedTab through
                     EnumToBoolConverter — the same pattern the NoteType radios use, so
                     clicking a pill sets SelectedTab and the rest clear themselves. The
                     active styling lives on the IsChecked trigger, which is why one
                     shared style covers all eight. -->
                <Style x:Key="BoardPill"
                       TargetType="RadioButton">
                    <Setter Property="Margin"
                            Value="0,0,10,4" />
                    <Setter Property="Cursor"
                            Value="Hand" />
                    <Setter Property="Foreground"
                            Value="{DynamicResource TextSecondaryBrush}" />
                    <Setter Property="FontSize"
                            Value="11" />
                    <Setter Property="FontWeight"
                            Value="SemiBold" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="RadioButton">
                                <Border x:Name="PillBorder"
                                        BorderThickness="0,0,0,2"
                                        BorderBrush="Transparent"
                                        Padding="0,0,0,3"
                                        Background="Transparent">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked"
                                             Value="True">
                                        <Setter TargetName="PillBorder"
                                                Property="BorderBrush"
                                                Value="{DynamicResource AccentBrush}" />
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource TextPrimaryBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <!-- Form row. Left bar colors by workflow state; the red triangle shows
                     only when overdue. The context menu reaches the VM through
                     PlacementTarget.Tag — the menu isn't in the visual tree, so it can't
                     inherit the VM as DataContext — and passes the row itself via
                     PlacementTarget.DataContext. -->
                <DataTemplate DataType="{x:Type vm:FormTaskRow}">
                    <Border Margin="0,2"
                            Padding="6,4"
                            CornerRadius="3"
                            BorderThickness="3,0,0,0"
                            Background="Transparent"
                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush"
                                        Value="{DynamicResource InputBorderBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding State}"
                                                 Value="{x:Static sati:FormWorkflowState.Opened}">
                                        <Setter Property="BorderBrush"
                                                Value="{DynamicResource OpenedFormBrush}" />
                                        <Setter Property="Background"
                                                Value="{DynamicResource OpenedFormFillBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}"
                                                 Value="{x:Static sati:FormWorkflowState.Completed}">
                                        <Setter Property="BorderBrush"
                                                Value="{DynamicResource CompliantBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Mark Opened"
                                          Command="{Binding PlacementTarget.Tag.MarkFormOpenedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="Mark Completed"
                                          Command="{Binding PlacementTarget.Tag.MarkFormCompletedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <Separator />
                                <MenuItem Header="Mark Not Started"
                                          Command="{Binding PlacementTarget.Tag.MarkFormNotStartedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            </ContextMenu>
                        </Border.ContextMenu>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- One line: name · type · dates. StackPanel aligns children
                                 by box, not baseline, so the mixed font sizes need explicit
                                 VerticalAlignment="Center" to sit level. -->
                            <StackPanel Grid.Column="0"
                                        Orientation="Horizontal">
                                <TextBlock Text="{Binding ClientName}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="13"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="·"
                                           FontSize="12"
                                           Foreground="{DynamicResource InputBorderBrush}"
                                           Margin="7,0,7,0"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding TypeLabel}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="·"
                                           FontSize="12"
                                           Foreground="{DynamicResource InputBorderBrush}"
                                           Margin="7,0,7,0"
                                           VerticalAlignment="Center" />
                                <TextBlock FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center">
                                    <Run Text="Open" />
                                    <Run Text="{Binding OpenByDate, StringFormat={}{0:MMM d}, Mode=OneWay}" />
                                    <Run Text="  ·  Due" />
                                    <Run Text="{Binding DueDate, StringFormat={}{0:MMM d}, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="▲"
                                       Foreground="{DynamicResource OverdueBrush}"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       Margin="6,0,2,0"
                                       Cursor="Help"
                                       ToolTip="{Binding OverdueTooltip}"
                                       Visibility="{Binding IsOverdue, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </Grid>
                    </Border>
                </DataTemplate>

                <!-- Appointment row (scheduled visits/contacts/forms). Read-only. -->
                <DataTemplate DataType="{x:Type models:UpcomingEvent}">
                    <Border Margin="0,2"
                            Padding="6,4"
                            CornerRadius="3"
                            BorderThickness="3,0,0,0"
                            BorderBrush="{DynamicResource CompliantBrush}">
                        <StackPanel>
                            <TextBlock Text="{Binding Title}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="12"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Date, StringFormat={}{0:MMM d}}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>

            </Border.Resources>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <WrapPanel Grid.Column="0">
                        <RadioButton Content="Comp Assessments"
                                     Style="{StaticResource BoardPill}"
                                 GroupName="BoardTabs"
                                 IsChecked="{Binding SelectedTab, Converter={StaticResource BoardTabConverter}, ConverterParameter=CompAssessments}" />
                    <RadioButton Content="Reclasses"
                                 Style="{StaticResource BoardPill}"
                                 GroupName="BoardTabs"
                                 IsChecked="{Binding SelectedTab, Converter={StaticResource BoardTabConverter}, ConverterParameter=Reclasses}" />
                    <RadioButton Content="PCPs"
                                 Style="{StaticResource BoardPill}"
                                 GroupName="BoardTabs"
                                 IsChecked="{Binding SelectedTab, Converter={StaticResource BoardTabConverter}, ConverterParameter=Pcps}" />
                    <RadioButton Content="Releases"
                                 Style="{StaticResource BoardPill}"
                                 GroupName="BoardTabs"
                                 IsChecked="{Binding SelectedTab, Converter={StaticResource BoardTabConverter}, ConverterParameter=Releases}" />
                    <RadioButton Content="Appointments"
                                 Style="{StaticResource BoardPill}"
                                 GroupName="BoardTabs"
                                 IsChecked="{Binding SelectedTab, Converter={StaticResource BoardTabConverter}, ConverterParameter=Appointments}" />
                    <RadioButton Content="90-Day Reviews"
                                 Style="{StaticResource BoardPill}"
                                 GroupName="BoardTabs"
                                 IsChecked="{Binding SelectedTab, Converter={StaticResource BoardTabConverter}, ConverterParameter=Reviews}" />
                    <RadioButton Content="Effective Dates"
                                 Style="{StaticResource BoardPill}"
                                 GroupName="BoardTabs"
                                 IsChecked="{Binding SelectedTab, Converter={StaticResource BoardTabConverter}, ConverterParameter=EffectiveDates}" />
                    <RadioButton Content="All"
                                 Style="{StaticResource BoardPill}"
                                 GroupName="BoardTabs"
                                 IsChecked="{Binding SelectedTab, Converter={StaticResource BoardTabConverter}, ConverterParameter=All}" />
                    </WrapPanel>

                    <!-- Date filter. One click advances the ring
                         (Overdue → 2/4/6/8/10/12 wks → All); the label is there because
                         eight states behind one glyph is a memory game. The dot binds to
                         TabHasOverdue, which counts the unfiltered tab — so it stays lit
                         while you're in a narrow window that hides the overdue items.
                         Hidden on Effective Dates, which has no date axis to narrow. -->
                    <Button Grid.Column="1"
                            AutomationProperties.Name="Change upcoming items date range"
                            AutomationProperties.HelpText="Cycles through overdue, two through twelve weeks, and all dates"
                            VerticalAlignment="Top"
                            Cursor="Hand"
                            Padding="6,0,0,0"
                            Command="{Binding CycleDateFilterCommand}"
                            Visibility="{Binding IsTaskListTab, Converter={StaticResource BoolToVisibilityConverter}}"
                            ToolTip="Click to change the date window">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal">
                            <Grid>
                                <TextBlock Text="&#xE71C;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" />
                                <Ellipse Width="6"
                                         Height="6"
                                         Fill="{DynamicResource OverdueBrush}"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Top"
                                         Margin="0,-1,-3,0"
                                         Visibility="{Binding TabHasOverdue, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </Grid>
                            <TextBlock Text="{Binding DateFilterLabel, Mode=OneWay}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="5,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Separator Grid.Row="1" />

                <Grid Grid.Row="2">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding IsTaskListTab, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ItemsControl ItemsSource="{Binding BoardGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8"
                                            Padding="8,7"
                                            CornerRadius="6">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background"
                                                        Value="{DynamicResource PersonGroupBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAlternate}"
                                                                 Value="True">
                                                        <Setter Property="Background"
                                                                Value="{DynamicResource PersonGroupAltBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock Text="{Binding ClientName}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Margin="3,0,0,4" />
                                            <ItemsControl ItemsSource="{Binding Items}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding IsEffectiveDatesTab, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ItemsControl ItemsSource="{Binding EffectiveDateGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8"
                                            CornerRadius="4"
                                            Padding="8">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background"
                                                        Value="Transparent" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCurrent}"
                                                                 Value="True">
                                                        <Setter Property="Background"
                                                                Value="{DynamicResource HoverBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Label}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Margin="0,0,0,4" />
                                            <ItemsControl ItemsSource="{Binding ClientNames}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   Margin="0,2" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>

      

    </Grid>
</UserControl>
