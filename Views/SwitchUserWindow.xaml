<Window x:Class="Sati.Views.SwitchUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Sati.Views"
        Title="Switch User"
        Height="380"
        Width="340"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="{StaticResource AppFont}">

    <Border Padding="32">
        <StackPanel>

            <TextBlock Text="Switch User"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,4" />

            <TextBlock Text="Select your name and enter your password to continue."
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="0,0,0,24" />

            <TextBlock Text="USERNAME"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,0,0,5" />
            <ComboBox AutomationProperties.Name="User" ItemsSource="{Binding Users}"
                      SelectedItem="{Binding SelectedUser}"
                      DisplayMemberPath="DisplayName"
                      Height="36"
                      Padding="10,0"
                      FontSize="14"
                      VerticalContentAlignment="Center"
                      Background="{DynamicResource SurfaceBrush}"
                      BorderBrush="{DynamicResource HoverStrongBrush}"
                      BorderThickness="1"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      Margin="0,0,0,16" />

            <TextBlock Text="PASSWORD"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,0,0,5" />
            <local:PasswordRevealBox AutomationProperties.Name="Password"
                                     x:Name="PasswordBox"
                                     Margin="0,0,0,16"
                                     PasswordChanged="PasswordBox_PasswordChanged" />

            <!-- Visibility is decided by the style alone. A local Visibility binding
                 outranks every setter and trigger below it, and BoolToVisibility
                 collapses anything that is not a bool, so a string routed through it
                 could never appear however the view model was set. -->
            <TextBlock Text="{Binding ErrorMessage}"
                       AutomationProperties.LiveSetting="Assertive"
                       FontSize="12"
                       Foreground="{DynamicResource OverdueBrush}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility"
                                Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ErrorMessage}"
                                         Value="">
                                <Setter Property="Visibility"
                                        Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ErrorMessage}"
                                         Value="{x:Null}">
                                <Setter Property="Visibility"
                                        Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <Button Content="Switch User"
                    IsDefault="True"
                    Height="40"
                    Background="{DynamicResource AccentBrush}"
                    Foreground="{DynamicResource SurfaceBrush}"
                    FontSize="14"
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    Cursor="Hand"
                    Command="{Binding SwitchUserCommand}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter Property="Background"
                                        Value="{DynamicResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter Property="Background"
                                        Value="{DynamicResource AccentPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

        </StackPanel>
    </Border>
</Window>
