<Window x:Class="Sati.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Settings"
        Height="720"
        Width="1060"
        MinHeight="620"
        MinWidth="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Window.Resources>
        <Style x:Key="LabelStyle"
               TargetType="TextBlock">
            <Setter Property="FontSize"
                    Value="11" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="Foreground"
                    Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Margin"
                    Value="0,0,0,5" />
        </Style>

        <Style x:Key="SectionHeader"
               TargetType="TextBlock">
            <Setter Property="FontSize"
                    Value="13" />
            <Setter Property="FontWeight"
                    Value="Bold" />
            <Setter Property="Foreground"
                    Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Margin"
                    Value="0,0,0,8" />
        </Style>

        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Padding"
                    Value="8,4" />
            <Setter Property="Width"
                    Value="100" />
            <Setter Property="FontSize"
                    Value="13" />
            <Setter Property="HorizontalAlignment"
                    Value="Left" />
            <Setter Property="Background"
                    Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource HoverStrongBrush}" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="Foreground"
                    Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Margin"
                    Value="0,0,0,12" />
        </Style>

        <Style TargetType="Separator">
            <Setter Property="Background"
                    Value="{DynamicResource BorderBrush}" />
            <Setter Property="Margin"
                    Value="0,4,0,16" />
        </Style>

        <Style x:Key="PrimaryButton"
               TargetType="Button"
               BasedOn="{StaticResource ButtonBaseStyle}">
            <Setter Property="Height"
                    Value="36" />
            <Setter Property="Background"
                    Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground"
                    Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="FontSize"
                    Value="13" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="BorderThickness"
                    Value="0" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter Property="Background"
                                        Value="{DynamicResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter Property="Background"
                                        Value="{DynamicResource AccentPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsTabItemStyle"
               TargetType="TabItem">
            <Setter Property="Foreground"
                    Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="FontSize"
                    Value="13" />
            <Setter Property="Margin"
                    Value="0,0,0,4" />
            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBackground"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="14,11">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Left" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="TabBackground"
                                        Property="Background"
                                        Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected"
                                     Value="True">
                                <Setter TargetName="TabBackground"
                                        Property="Background"
                                        Value="{DynamicResource SurfaceAltBrush}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource AccentPressedBrush}" />
                                <Setter Property="FontWeight"
                                        Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsTabControlStyle"
               TargetType="TabControl">
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <StackPanel IsItemsHost="True" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Background="{DynamicResource NavBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="0,0,1,0"
                                    Padding="18,24">
                                <StackPanel>
                                    <TextBlock Text="SETTINGS"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Margin="12,0,0,6" />
                                    <TextBlock Text="Choose a category"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Margin="12,0,0,22" />
                                    <ItemsPresenter />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1"
                                    Background="{DynamicResource WindowBackgroundBrush}">
                                <ContentPresenter ContentSource="SelectedContent" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.LayoutTransform>
            <ScaleTransform ScaleX="{Binding EasyEyesScale}"
                            ScaleY="{Binding EasyEyesScale}" />
        </Grid.LayoutTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Style="{StaticResource SettingsTabControlStyle}">
            <TabItem Header="Appearance"
                     Style="{StaticResource SettingsTabItemStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="36,30">

                <!-- APPEARANCE -->
                <TextBlock Text="APPEARANCE"
                           Style="{StaticResource SectionHeader}" />
                <Separator />

                <TextBlock Text="THEME"
                           Style="{StaticResource LabelStyle}" />
                <ComboBox AutomationProperties.Name="Theme" ItemsSource="{Binding ThemeOptions}"
                          SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                          DisplayMemberPath="DisplayName"
                          Width="250"
                          HorizontalAlignment="Left"
                          Margin="0,0,0,16" />

                <TextBlock Text="Changes are previewed immediately and remembered for this Windows user."
                           FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,20" />

                <TextBlock Text="EASY EYES"
                           Style="{StaticResource LabelStyle}" />
                <CheckBox Content="Use Easy Eyes mode"
                          AutomationProperties.Name="Use Easy Eyes mode"
                          AutomationProperties.HelpText="Makes the interface about thirty percent larger, hides note narrative columns, and uses the horizontal client selector."
                          IsChecked="{Binding EasyEyesMode, Mode=TwoWay}"
                          Margin="0,0,0,6" />
                <TextBlock Text="Makes the working interface about 30% larger, hides the narrative column in note lists, and uses the horizontal client selector."
                           FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}"
                           TextWrapping="Wrap"
                           Margin="24,0,0,4" />
                <TextBlock Text="{Binding EasyEyesPreferenceStatus}"
                           AutomationProperties.LiveSetting="Polite"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="24,0,0,20" />

                <CheckBox Content="Sort client lists by last name"
                          AutomationProperties.Name="Sort client lists by last name"
                          AutomationProperties.HelpText="Sorts the client combo boxes in Notes, AT requests, and client documents by last name instead of first name."
                          IsChecked="{Binding SortConsumerPickersByLastName, Mode=TwoWay}"
                          Margin="0,0,0,6" />
                <TextBlock Text="Sorts the client combo boxes in Notes, AT requests, and client documents by last name instead of first name."
                           FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}"
                           TextWrapping="Wrap"
                           Margin="24,0,0,4" />
                <TextBlock Text="{Binding ConsumerPickerSortPreferenceStatus}"
                           AutomationProperties.LiveSetting="Polite"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="24,0,0,20" />

                <CheckBox Content="Display Scratchpad in the center of the display"
                          AutomationProperties.Name="Display Scratchpad in the center of the display"
                          AutomationProperties.HelpText="Swaps the Overview's layout: the Scratchpad (Today's Work and Tomorrow's Agenda) becomes the main panel, and the dashboard moves to the collapsible side panel."
                          IsChecked="{Binding IsScratchpadCentered, Mode=TwoWay}"
                          Margin="0,0,0,6" />
                <TextBlock Text="Swaps the Overview's layout so the Scratchpad is the main panel and the dashboard collapses to the side instead."
                           FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}"
                           TextWrapping="Wrap"
                           Margin="24,0,0,4" />
                <TextBlock Text="{Binding ScratchpadLayoutPreferenceStatus}"
                           AutomationProperties.LiveSetting="Polite"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="24,0,0,20" />

                <TextBlock Text="INACTIVITY SCREEN"
                           Style="{StaticResource LabelStyle}" />
                <ComboBox ItemsSource="{Binding IdleTimeoutChoices}"
                          SelectedItem="{Binding SelectedIdleTimeout, Mode=TwoWay}"
                          DisplayMemberPath="Label"
                          Width="220"
                          HorizontalAlignment="Left"
                          AutomationProperties.Name="Cover the screen after this much inactivity"
                          AutomationProperties.HelpText="Blurs the Sati window after this long with no keyboard or mouse activity. Any key or click brings it back."
                          Margin="0,0,0,6" />
                <TextBlock Text="Blurs the Sati window after this long with no keyboard or mouse activity, so a screen left open is not readable across the room. Any key or click brings it straight back."
                           FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}"
                           TextWrapping="Wrap"
                           Margin="24,0,0,4" />
                <TextBlock Text="It hides the screen only. It does not lock Windows and asks for no password."
                           FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}"
                           TextWrapping="Wrap"
                           Margin="24,0,0,4" />
                <TextBlock Text="{Binding IdlePreferenceStatus}"
                           AutomationProperties.LiveSetting="Polite"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="24,0,0,20" />

                <TextBlock Text="DAILY AGENDA"
                           Style="{StaticResource LabelStyle}" />
                <CheckBox Content="Show the daily agenda window at sign-in"
                          AutomationProperties.Name="Show the daily agenda window at sign-in"
                          IsChecked="{Binding ShowDailyAgendaAtSignIn, Mode=TwoWay}"
                          Margin="0,0,0,6" />
                <TextBlock Text="The agenda appears at most once per calendar day for this Sati account on this computer."
                           FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}"
                           TextWrapping="Wrap"
                           Margin="24,0,0,4" />
                <TextBlock Text="{Binding DailyAgendaPreferenceStatus}"
                           AutomationProperties.LiveSetting="Polite"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="24,0,0,20" />

                <TextBlock Text="LOADING INDICATOR TEST"
                           Style="{StaticResource SectionHeader}"
                           Margin="0,10,0,0" />
                <Separator />

                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="18"
                        MaxWidth="620"
                        HorizontalAlignment="Left">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="82" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Width="66"
                                Height="66"
                                CornerRadius="33"
                                Background="#1F3E8F83"
                                VerticalAlignment="Top">
                            <Image Source="pack://application:,,,/Sati;component/images/sati-watercolor-leaf.png"
                                   Width="52"
                                   Height="52"
                                   Stretch="Uniform"
                                   RenderTransformOrigin="0.5,0.5"
                                   AutomationProperties.Name="Loading indicator preview">
                                <Image.RenderTransform>
                                    <RotateTransform />
                                </Image.RenderTransform>
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DatabaseActivity.IsBusy}"
                                                         Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="SettingsPreviewLeafSpin">
                                                        <Storyboard RepeatBehavior="Forever">
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                             From="0"
                                                                             To="360"
                                                                             Duration="0:0:0.42" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="SettingsPreviewLeafSpin" />
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                        </Border>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Preview the database-waiting experience"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Runs for 12 seconds: the leaf spins immediately and the patience window appears after eight seconds. This is a visual test only and does not query the database or access client records."
                                       Margin="0,6,0,14"
                                       TextWrapping="Wrap"
                                       FontSize="11"
                                       LineHeight="17"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Button Content="Test loading indicator"
                                    AutomationProperties.Name="Test loading indicator"
                                    AutomationProperties.HelpText="Starts a 12-second visual preview without accessing the database or client records"
                                    Style="{StaticResource PrimaryButton}"
                                    Command="{Binding PreviewLoadingIndicatorCommand}"
                                    Width="190"
                                    HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding LoadingIndicatorPreviewStatus}"
                                       AutomationProperties.LiveSetting="Polite"
                                       Margin="0,10,0,0"
                                       TextWrapping="Wrap"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Text shortcuts"
                     Style="{StaticResource SettingsTabItemStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="36,30">
                        <TextBlock Text="PERSONAL TEXT SHORTCUTS"
                                   Style="{StaticResource SectionHeader}" />
                        <Separator />

                        <TextBlock Text="Assign up to 200 characters to each shortcut. While the cursor is in a note narrative or either Scratchpad tab, press Win+Shift and the number to insert that text at the cursor."
                                   MaxWidth="680"
                                   HorizontalAlignment="Left"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   LineHeight="18"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,8" />
                        <TextBlock Text="Keep shortcuts general. Do not save names or other client-specific information here. Outside those Sati text boxes, Windows keeps its usual Win+Shift+number behavior."
                                   MaxWidth="680"
                                   HorizontalAlignment="Left"
                                   TextWrapping="Wrap"
                                   FontSize="11"
                                   LineHeight="17"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="0,0,0,18" />

                        <ItemsControl ItemsSource="{Binding TextShortcuts}"
                                      MaxWidth="720"
                                      HorizontalAlignment="Left">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="7"
                                            Padding="12"
                                            Margin="0,0,12,12">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,6">
                                                <TextBlock DockPanel.Dock="Right"
                                                           Text="{Binding CharacterCount}"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding GestureLabel}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AccentBrush}" />
                                            </DockPanel>
                                            <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.Name="{Binding GestureLabel, StringFormat=Text inserted by {0}}"
                                                     MaxLength="200"
                                                     Width="320"
                                                     MinHeight="58"
                                                     Margin="0"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"
                                                     VerticalScrollBarVisibility="Auto" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="Save Personal Shortcuts"
                                    Command="{Binding SaveTextShortcutsCommand}"
                                    AutomationProperties.Name="Save personal text shortcuts"
                                    Style="{StaticResource PrimaryButton}"
                                    Width="210" />
                            <TextBlock Text="{Binding TextShortcutStatus}"
                                       AutomationProperties.LiveSetting="Polite"
                                       Margin="14,0,0,0"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"
                                       MaxWidth="430"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Billing &amp; Requests"
                     Visibility="{Binding CanManageAgencySettings, Converter={StaticResource BoolToVisibilityConverter}}"
                     Style="{StaticResource SettingsTabItemStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="36,30">

                <!-- BILLING -->
                <TextBlock Text="BILLING"
                           Style="{StaticResource SectionHeader}" />
                <Separator />

                <TextBlock Text="DAYS BEFORE NOTE IS ABANDONED"
                           Style="{StaticResource LabelStyle}" />
                <TextBox AutomationProperties.Name="Days before note is abandoned" Text="{Binding AbandonedAfterDays, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="PRODUCTIVITY THRESHOLD (UNITS/DAY)"
                           Style="{StaticResource LabelStyle}" />
                <TextBox AutomationProperties.Name="Productivity threshold" Text="{Binding ProductivityThreshold, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="BASE INCENTIVE ($)"
                           Style="{StaticResource LabelStyle}" />
                <TextBox AutomationProperties.Name="Base incentive" Text="{Binding BaseIncentive, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="PER-UNIT INCENTIVE ($)"
                           Style="{StaticResource LabelStyle}" />
                <TextBox AutomationProperties.Name="Per-unit incentive" Text="{Binding PerUnitIncentive, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="BILLING COMPLIANCE REQUIREMENTS"
                           Style="{StaticResource SectionHeader}"
                           Margin="0,8,0,8" />
                <Separator />
                <TextBlock Text="An enabled requirement blocks billing only when that document is incomplete and its due date has passed. Changes apply to the whole agency."
                           TextWrapping="Wrap"
                           MaxWidth="620"
                           HorizontalAlignment="Left"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,0,12" />
                <WrapPanel Margin="0,0,0,12">
                    <CheckBox Content="90-day reviews"
                              AutomationProperties.Name="Count 90-day reviews for billing compliance"
                              IsChecked="{Binding ComplianceQuarterlyReviews}"
                              Margin="0,0,22,10" />
                    <CheckBox Content="PCPs"
                              AutomationProperties.Name="Count PCPs for billing compliance"
                              IsChecked="{Binding CompliancePcp}"
                              Margin="0,0,22,10" />
                    <CheckBox Content="Comprehensive assessments"
                              AutomationProperties.Name="Count comprehensive assessments for billing compliance"
                              IsChecked="{Binding ComplianceComprehensiveAssessment}"
                              Margin="0,0,22,10" />
                    <CheckBox Content="Reclassifications"
                              AutomationProperties.Name="Count reclassifications for billing compliance"
                              IsChecked="{Binding ComplianceReclassification}"
                              Margin="0,0,22,10" />
                    <CheckBox Content="Safety plans"
                              AutomationProperties.Name="Count safety plans for billing compliance"
                              IsChecked="{Binding ComplianceSafetyPlan}"
                              Margin="0,0,22,10" />
                    <CheckBox Content="Privacy practices"
                              AutomationProperties.Name="Count privacy practices for billing compliance"
                              IsChecked="{Binding CompliancePrivacyPractices}"
                              Margin="0,0,22,10" />
                    <CheckBox Content="Agency releases"
                              AutomationProperties.Name="Count agency releases for billing compliance"
                              IsChecked="{Binding ComplianceAgencyRelease}"
                              Margin="0,0,22,10" />
                    <CheckBox Content="DHHS releases"
                              AutomationProperties.Name="Count DHHS releases for billing compliance"
                              IsChecked="{Binding ComplianceDhhsRelease}"
                              Margin="0,0,22,10" />
                    <CheckBox Content="Medical releases"
                              AutomationProperties.Name="Count medical releases for billing compliance"
                              IsChecked="{Binding ComplianceMedicalRelease}"
                              Margin="0,0,22,10" />
                </WrapPanel>

                <!-- CREDIBLE IMPORT -->
                <TextBlock Text="CREDIBLE IMPORT"
                           Style="{StaticResource SectionHeader}"
                           Margin="0,8,0,8" />
                <Separator />
                <CheckBox Content="Allow Credible imports to update existing consumer profiles"
                          AutomationProperties.Name="Allow Credible imports to update existing consumer profiles"
                          IsChecked="{Binding AllowCredibleProfileUpdates}"
                          Margin="0,4,0,4" />
                <TextBlock Text="Off by default. When enabled, staff can open one consumer, review a saved Credible export field by field, and save accepted values over that profile. Different Credible client IDs are always refused. Bulk imports still skip existing consumers."
                           TextWrapping="Wrap"
                           MaxWidth="620"
                           HorizontalAlignment="Left"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="22,0,0,12" />

                <!-- AT / PAYMENT REQUESTS -->
                <TextBlock Text="AT / PAYMENT REQUESTS"
                           Style="{StaticResource SectionHeader}"
                           Margin="0,8,0,8" />
                <Separator />

                <TextBlock Text="SALES TAX RATE (e.g. 0.055 = 5.5%)"
                           Style="{StaticResource LabelStyle}" />
                <TextBox AutomationProperties.Name="Sales tax rate" Text="{Binding SalesTaxRate, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="DEFAULT PASSTHROUGH PROVIDER"
                           Style="{StaticResource LabelStyle}" />
                <!-- SelectedValue round-trips the int? FK: SelectedValuePath=Id maps
                     the chosen Provider to DefaultPassthroughProviderId without needing
                     the bound value to be the same object instance the list holds. -->
                <ComboBox AutomationProperties.Name="Default passthrough provider" ItemsSource="{Binding PassthroughProviders}"
                          SelectedValue="{Binding DefaultPassthroughProviderId}"
                          SelectedValuePath="Id"
                          DisplayMemberPath="Name"
                          Width="250"
                          HorizontalAlignment="Left" />

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Schedule"
                     Visibility="{Binding CanManageAgencySettings, Converter={StaticResource BoolToVisibilityConverter}}"
                     Style="{StaticResource SettingsTabItemStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="36,30">

                <!-- SCHEDULE EXCLUSIONS -->
                <TextBlock Text="EXCLUDED WEEKDAYS"
                           Style="{StaticResource SectionHeader}"
                           Margin="0,8,0,8" />
                <Separator />

                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,12">
                    <CheckBox Content="Monday"
                              IsChecked="{Binding ExcludeMonday}"
                              Margin="0,0,16,0"
                              Foreground="{DynamicResource TextPrimaryBrush}" />
                    <CheckBox Content="Tuesday"
                              IsChecked="{Binding ExcludeTuesday}"
                              Margin="0,0,16,0"
                              Foreground="{DynamicResource TextPrimaryBrush}" />
                    <CheckBox Content="Wednesday"
                              IsChecked="{Binding ExcludeWednesday}"
                              Margin="0,0,16,0"
                              Foreground="{DynamicResource TextPrimaryBrush}" />
                    <CheckBox Content="Thursday"
                              IsChecked="{Binding ExcludeThursday}"
                              Margin="0,0,16,0"
                              Foreground="{DynamicResource TextPrimaryBrush}" />
                    <CheckBox Content="Friday"
                              IsChecked="{Binding ExcludeFriday}"
                              Foreground="{DynamicResource TextPrimaryBrush}" />
                </StackPanel>

                <!-- FEDERAL HOLIDAYS -->
                <TextBlock Text="FEDERAL HOLIDAYS"
                           Style="{StaticResource SectionHeader}"
                           Margin="0,8,0,8" />
                <Separator />

                <WrapPanel Margin="0,0,0,12">
                    <CheckBox Content="New Year's Day"
                              IsChecked="{Binding ExcludeNewYearsDay}"
                              Margin="0,0,16,8"
                              Foreground="{DynamicResource TextPrimaryBrush}" />
                    <CheckBox Content="MLK Day"
                              IsChecked="{Binding ExcludeMLKDay}"
                              Margin="0,0,16,8"
                              Foreground="{DynamicResource TextPrimaryBrush}" />
                    <CheckBox Content="Presidents Day"
                              IsChecked="{Binding ExcludePresidentsDay}"
                              Margin="0,0,16,8"
                              Foreground="{DynamicResource TextPrimaryBrush}" />
                    <CheckBox Content="Memorial Day"
                              IsChecked="{Binding ExcludeMemorialDay}"
                              Margin="0,0,16,8"
                              Foreground="{DynamicResource TextPrimaryBrush}" />
                    <CheckBox Content="Juneteenth"
                              IsChecked="{Binding ExcludeJuneteenth}"
                              Margin="0,0,16,8"
                              Foreground="{DynamicResource TextPrimaryBrush}" />
                    <CheckBox Content="Independence Day"
                              IsChecked="{Binding ExcludeIndependenceDay}"
                              Margin="0,0,16,8"
                              Foreground="{DynamicResource TextPrimaryBrush}" />
                    <CheckBox Content="Labor Day"
                              IsChecked="{Binding ExcludeLaborDay}"
                              Margin="0,0,16,8"
                              Foreground="{DynamicResource TextPrimaryBrush}" />
                    <CheckBox Content="Indigenous Peoples Day"
                              IsChecked="{Binding ExcludeIndigenousPeoplesDay}"
                              Margin="0,0,16,8"
                              Foreground="{DynamicResource TextPrimaryBrush}" />
                    <CheckBox Content="Veterans Day"
                              IsChecked="{Binding ExcludeVeteransDay}"
                              Margin="0,0,16,8"
                              Foreground="{DynamicResource TextPrimaryBrush}" />
                    <CheckBox Content="Thanksgiving"
                              IsChecked="{Binding ExcludeThanksgiving}"
                              Margin="0,0,16,8"
                              Foreground="{DynamicResource TextPrimaryBrush}" />
                    <CheckBox Content="Day After Thanksgiving"
                              IsChecked="{Binding ExcludeDayAfterThanksgiving}"
                              Margin="0,0,16,8"
                              Foreground="{DynamicResource TextPrimaryBrush}" />
                    <CheckBox Content="Christmas"
                              IsChecked="{Binding ExcludeChristmas}"
                              Margin="0,0,16,8"
                              Foreground="{DynamicResource TextPrimaryBrush}" />
                </WrapPanel>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Templates &amp; Forms"
                     Visibility="{Binding CanManageAgencySettings, Converter={StaticResource BoolToVisibilityConverter}}"
                     Style="{StaticResource SettingsTabItemStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="36,30">

                <!-- NOTE TEMPLATES -->
                <TextBlock Text="NOTE TEMPLATES"
                           Style="{StaticResource SectionHeader}"
                           Margin="0,8,0,8" />
                <Separator />

                <TextBlock Text="VISIT TEMPLATE"
                           Style="{StaticResource LabelStyle}" />
                <TextBox AutomationProperties.Name="Visit Template" Text="{Binding VisitTemplate, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         Height="190"
                         VerticalScrollBarVisibility="Auto"
                         Width="361" />

                <TextBlock Text="CONTACT TEMPLATE"
                           Style="{StaticResource LabelStyle}" />
                <TextBox AutomationProperties.Name="Contact Template" Text="{Binding ContactTemplate, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         Height="247"
                         VerticalScrollBarVisibility="Auto"
                         Width="354" />

                <TextBlock Text="DOCUMENTATION TEMPLATE"
                           Style="{StaticResource LabelStyle}" />
                <TextBox AutomationProperties.Name="Documentation Template" Text="{Binding DocumentationTemplate, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         Height="294"
                         VerticalScrollBarVisibility="Auto"
                         Width="351" />
                
                <!-- Form Deadline Windows -->
<TextBlock Text="FORM DEADLINE WINDOWS"
           Style="{StaticResource SectionHeader}"
           Margin="0,16,0,8"/>

<Grid>
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="180"/>
        <ColumnDefinition Width="120"/>
        <ColumnDefinition Width="120"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />

                    </Grid.RowDefinitions>

    <!-- Column headers -->
    <TextBlock Grid.Row="0" Grid.Column="1"
               Text="Open Days Before"
               Style="{StaticResource LabelStyle}"
               HorizontalAlignment="Center"/>
    <TextBlock Grid.Row="0" Grid.Column="2"
               Text="Days After Due"
               Style="{StaticResource LabelStyle}"
               HorizontalAlignment="Center"/>

    <!-- Reviews -->
    <TextBlock Grid.Row="1" Grid.Column="0"
               Text="Reviews"
               Style="{StaticResource LabelStyle}"
               VerticalAlignment="Center"/>
    <TextBox AutomationProperties.Name="Reviews open days before due" Grid.Row="1" Grid.Column="1"
             Text="{Binding ReviewOpenDaysBefore, UpdateSourceTrigger=PropertyChanged}"
             Margin="4,0,4,8"/>
    <TextBox AutomationProperties.Name="Reviews days after due" Grid.Row="1" Grid.Column="2"
             Text="{Binding ReviewDaysAfterDue, UpdateSourceTrigger=PropertyChanged}"
             Margin="4,0,0,8"/>

    <!-- PCP -->
    <TextBlock Grid.Row="2" Grid.Column="0"
               Text="PCP"
               Style="{StaticResource LabelStyle}"
               VerticalAlignment="Center"/>
    <TextBox AutomationProperties.Name="PCP open days before due" Grid.Row="2" Grid.Column="1"
             Text="{Binding PcpOpenDaysBefore, UpdateSourceTrigger=PropertyChanged}"
             Margin="4,0,4,8"/>
    <TextBox AutomationProperties.Name="PCP days after due" Grid.Row="2" Grid.Column="2"
             Text="{Binding PcpDaysAfterDue, UpdateSourceTrigger=PropertyChanged}"
             Margin="4,0,0,8"/>

    <!-- Comprehensive Assessment -->
    <TextBlock Grid.Row="3" Grid.Column="0"
               Text="Comp. Assessment"
               Style="{StaticResource LabelStyle}"
               VerticalAlignment="Center"/>
    <TextBox AutomationProperties.Name="Comprehensive assessment open days before due" Grid.Row="3" Grid.Column="1"
             Text="{Binding CompAssessmentOpenDaysBefore, UpdateSourceTrigger=PropertyChanged}"
             Margin="4,0,4,8"/>
    <TextBox AutomationProperties.Name="Comprehensive assessment days after due" Grid.Row="3" Grid.Column="2"
             Text="{Binding CompAssessmentDaysAfterDue, UpdateSourceTrigger=PropertyChanged}"
             Margin="4,0,0,8"/>

    <!-- Reclassification -->
    <TextBlock Grid.Row="4" Grid.Column="0"
               Text="Reclassification"
               Style="{StaticResource LabelStyle}"
               VerticalAlignment="Center"/>
    <TextBox AutomationProperties.Name="Reclassification open days before due" Grid.Row="4" Grid.Column="1"
             Text="{Binding ReclassificationOpenDaysBefore, UpdateSourceTrigger=PropertyChanged}"
             Margin="4,0,4,8"/>
    <TextBox AutomationProperties.Name="Reclassification days after due" Grid.Row="4" Grid.Column="2"
             Text="{Binding ReclassificationDaysAfterDue, UpdateSourceTrigger=PropertyChanged}"
             Margin="4,0,0,8"/>

    <!-- Safety Plan -->
    <TextBlock Grid.Row="5" Grid.Column="0"
               Text="Safety Plan"
               Style="{StaticResource LabelStyle}"
               VerticalAlignment="Center"/>
    <TextBox AutomationProperties.Name="Safety plan open days before due" Grid.Row="5" Grid.Column="1"
             Text="{Binding SafetyPlanOpenDaysBefore, UpdateSourceTrigger=PropertyChanged}"
             Margin="4,0,4,8"/>
    <TextBox AutomationProperties.Name="Safety plan days after due" Grid.Row="5" Grid.Column="2"
             Text="{Binding SafetyPlanDaysAfterDue, UpdateSourceTrigger=PropertyChanged}"
             Margin="4,0,0,8"/>

    <!-- Privacy Practices -->
    <TextBlock Grid.Row="6" Grid.Column="0"
               Text="Privacy Practices"
               Style="{StaticResource LabelStyle}"
               VerticalAlignment="Center"/>
    <TextBox AutomationProperties.Name="Privacy practices open days before due" Grid.Row="6" Grid.Column="1"
             Text="{Binding PrivacyPracticesOpenDaysBefore, UpdateSourceTrigger=PropertyChanged}"
             Margin="4,0,4,8"/>
    <TextBox AutomationProperties.Name="Privacy practices days after due" Grid.Row="6" Grid.Column="2"
             Text="{Binding PrivacyPracticesDaysAfterDue, UpdateSourceTrigger=PropertyChanged}"
             Margin="4,0,0,8"/>

    <!-- Release Agency -->
    <TextBlock Grid.Row="7" Grid.Column="0"
               Text="Release — Agency"
               Style="{StaticResource LabelStyle}"
               VerticalAlignment="Center"/>
    <TextBox AutomationProperties.Name="Agency release open days before due" Grid.Row="7" Grid.Column="1"
             Text="{Binding ReleaseAgencyOpenDaysBefore, UpdateSourceTrigger=PropertyChanged}"
             Margin="4,0,4,8"/>
    <TextBox AutomationProperties.Name="Agency release days after due" Grid.Row="7" Grid.Column="2"
             Text="{Binding ReleaseAgencyDaysAfterDue, UpdateSourceTrigger=PropertyChanged}"
             Margin="4,0,0,8"/>

    <!-- Release DHHS -->
    <TextBlock Grid.Row="8" Grid.Column="0"
               Text="Release — DHHS"
               Style="{StaticResource LabelStyle}"
               VerticalAlignment="Center"/>
    <TextBox AutomationProperties.Name="DHHS release open days before due" Grid.Row="8" Grid.Column="1"
             Text="{Binding ReleaseDhhsOpenDaysBefore, UpdateSourceTrigger=PropertyChanged}"
             Margin="4,0,4,8"/>
    <TextBox AutomationProperties.Name="DHHS release days after due" Grid.Row="8" Grid.Column="2"
             Text="{Binding ReleaseDhhsDaysAfterDue, UpdateSourceTrigger=PropertyChanged}"
             Margin="4,0,0,8"/>

    <!-- Release Medical -->
    <TextBlock Grid.Row="9" Grid.Column="0"
               Text="Release — Medical"
               Style="{StaticResource LabelStyle}"
               VerticalAlignment="Center"/>
    <TextBox AutomationProperties.Name="Medical release open days before due" Grid.Row="9" Grid.Column="1"
             Text="{Binding ReleaseMedicalOpenDaysBefore, UpdateSourceTrigger=PropertyChanged}"
             Margin="4,0,4,8"/>
    <TextBox AutomationProperties.Name="Medical release days after due" Grid.Row="9" Grid.Column="2"
             Text="{Binding ReleaseMedicalDaysAfterDue, UpdateSourceTrigger=PropertyChanged}"
             Margin="4,0,0,8"/>
</Grid>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Reference Data"
                     Visibility="{Binding CanManageAgencySettings, Converter={StaticResource BoolToVisibilityConverter}}"
                     Style="{StaticResource SettingsTabItemStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="36,30">

                <!-- VOCATIONAL REHABILITATION -->
                <TextBlock Text="ANNUAL DOCUMENT PREPARATION" Style="{StaticResource SectionHeader}"/>
                <TextBlock Text="Days before the anniversary to open the annual packet (0–180)" TextWrapping="Wrap"/>
                <TextBox Text="{Binding AnnualPacketOpenDaysBefore, UpdateSourceTrigger=PropertyChanged}" Width="100"
                         AutomationProperties.Name="Annual packet opening days before anniversary"/>
                <TextBlock Text="VOCATIONAL REHABILITATION"
                           Style="{StaticResource SectionHeader}"
                           Margin="0,0,0,8" />
                <Separator />
                <TextBlock Text="ASSISTANT TITLE"
                           Style="{StaticResource LabelStyle}" />
                <TextBox Text="{Binding VrAssistantTitle, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Vocational Rehabilitation assistant title"
                         MaxLength="100"
                         Width="300" />
                <TextBlock Text="This agency-wide label appears beside the assistant assigned to a consumer who is open with VR. Changing the title does not change the assigned person's name."
                           TextWrapping="Wrap"
                           MaxWidth="620"
                           HorizontalAlignment="Left"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,0,20" />

                <!-- HEALTHCARE SYSTEMS -->
                <TextBlock Text="HEALTHCARE SYSTEMS"
                           Style="{StaticResource SectionHeader}"
                           Margin="0,16,0,8" />
                <Separator />

                <ListBox AutomationProperties.Name="Healthcare System" ItemsSource="{Binding HealthcareSystems}"
                         SelectedItem="{Binding SelectedHealthcareSystem, Mode=TwoWay}"
                         Height="140"
                         Width="361"
                         HorizontalAlignment="Left"
                         Margin="0,0,0,8"
                         Background="{DynamicResource SurfaceBrush}"
                         BorderBrush="{DynamicResource HoverStrongBrush}"
                         BorderThickness="1"
                         Foreground="{DynamicResource TextPrimaryBrush}" />

                <!-- Add row. Width is set locally to override the implicit TextBox
                     style's 100px default; everything else (padding, border, colors)
                     is inherited from that style. -->
                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,8">
                    <TextBox AutomationProperties.Name="New healthcare system" Text="{Binding NewHealthcareSystem, UpdateSourceTrigger=PropertyChanged}"
                             Width="250"
                             Margin="0,0,8,0"
                             VerticalAlignment="Center" />
                    <Button Content="Add"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding AddHealthcareSystemCommand}"
                            Width="100" />
                </StackPanel>

                <!-- Action row -->
                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,8">
                    <Button Content="Remove Selected"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding RemoveHealthcareSystemCommand}"
                            Width="140"
                            Margin="0,0,8,0" />
                    <Button Content="Default Maine Options"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding ApplyMaineDefaultsCommand}"
                            Width="200" />
                </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Release notes"
                     Style="{StaticResource SettingsTabItemStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="36,30">
                        <TextBlock Text="RELEASE NOTES"
                                   Style="{StaticResource SectionHeader}" />
                        <Separator />

                        <TextBlock Text="{Binding ReleaseVersion}"
                                   AutomationProperties.Name="Installed Sati version"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding ReleaseName}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Margin="0,4,0,0" />
                        <TextBlock Text="{Binding ReleaseDate}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="0,2,0,22" />

                        <ItemsControl ItemsSource="{Binding ReleaseNoteSections}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="14"
                                            Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       Margin="0,0,0,7" />
                                            <ItemsControl ItemsSource="{Binding Items}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,3,0,3">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="16" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="&#x2022;"
                                                                       Foreground="{DynamicResource AccentBrush}" />
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding}"
                                                                       TextWrapping="Wrap"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Maintenance"
                     Visibility="{Binding CanManageAgencySettings, Converter={StaticResource BoolToVisibilityConverter}}"
                     Style="{StaticResource SettingsTabItemStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="36,30">

                <!-- ============================================================ -->
                <!-- TEMPORARY MAINTENANCE — DUE-DATE BACKFILL                    -->
                <!-- Remove this whole block (and the matching region in          -->
                <!-- SettingsViewModel.cs) once the backfill has been run.        -->
                <!-- ============================================================ -->
                <TextBlock Text="MAINTENANCE — DUE-DATE BACKFILL"
                           Style="{StaticResource SectionHeader}"
                           Margin="0,32,0,8" />
                <Separator />

                <TextBlock Text="Run the dry run first. It writes a full report to your Desktop and changes nothing. Read it, then type the exact 'forms changed' count below and press Commit to apply."
                           TextWrapping="Wrap"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,0,12" />

                <Button Content="Dry Run (safe — writes report only)"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding BackfillDryRunCommand}"
                        HorizontalAlignment="Left"
                        Width="300"
                        Margin="0,0,0,12" />

                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,12">
                    <TextBox AutomationProperties.Name="Backfill confirmation count" Text="{Binding BackfillConfirmCount, UpdateSourceTrigger=PropertyChanged}"
                             Width="120"
                             VerticalAlignment="Center"
                             Margin="0,0,8,0" />
                    <Button Content="Commit Backfill"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding BackfillCommitCommand}"
                            Width="160" />
                </StackPanel>

                <TextBlock Text="{Binding BackfillStatus}"
                           AutomationProperties.LiveSetting="Assertive"
                           TextWrapping="Wrap"
                           FontSize="11"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,8" />

                <!-- ============================================================ -->
                <!-- TEMPORARY MAINTENANCE — BULK FORM COMPLETION                 -->
                <!-- Remove this whole block (and the matching region in          -->
                <!-- SettingsViewModel.cs) once completion has been run.          -->
                <!-- ============================================================ -->
                <TextBlock Text="MAINTENANCE — BULK FORM COMPLETION"
                           Style="{StaticResource SectionHeader}"
                           Margin="0,32,0,8" />
                <Separator />

                <TextBlock Text="Marks every form due on or before the cutoff that has no completion date as complete using the one completion date entered below. Dry run first — it writes a report to your Desktop and changes nothing — then type the exact count and press Commit."
                           TextWrapping="Wrap"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,0,12" />

                <TextBlock Text="CUTOFF DATE (inclusive, yyyy-MM-dd)"
                           Style="{StaticResource LabelStyle}" />
                <TextBox AutomationProperties.Name="Bulk completion cutoff date" Text="{Binding BulkCompleteCutoff, UpdateSourceTrigger=PropertyChanged}"
                         Width="140"
                         HorizontalAlignment="Left"
                         Margin="0,0,0,12" />

                <TextBlock Text="ACTUAL COMPLETION DATE (yyyy-MM-dd)"
                           Style="{StaticResource LabelStyle}" />
                <TextBox AutomationProperties.Name="Bulk completion actual completion date"
                         Text="{Binding BulkCompleteCompletionDate, UpdateSourceTrigger=PropertyChanged}"
                         Width="140"
                         HorizontalAlignment="Left"
                         Margin="0,0,0,12" />

                <Button Content="Dry Run (safe — writes report only)"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding BulkCompleteDryRunCommand}"
                        HorizontalAlignment="Left"
                        Width="300"
                        Margin="0,0,0,12" />

                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,12">
                    <TextBox AutomationProperties.Name="Bulk completion confirmation count" Text="{Binding BulkCompleteConfirmCount, UpdateSourceTrigger=PropertyChanged}"
                             Width="120"
                             VerticalAlignment="Center"
                             Margin="0,0,8,0" />
                    <Button Content="Commit Completion"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding BulkCompleteCommitCommand}"
                            Width="160" />
                </StackPanel>

                <TextBlock Text="{Binding BulkCompleteStatus}"
                           AutomationProperties.LiveSetting="Assertive"
                           TextWrapping="Wrap"
                           FontSize="11"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,8" />

                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="1"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="18,12">
            <Grid>
                <TextBlock Text="Appearance changes are remembered immediately. Personal text shortcuts are saved from their own tab. Agency settings remain Admin-only."
                           Visibility="{Binding CanManageAgencySettings, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMutedBrush}"
                           FontSize="11"
                           TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Visibility="{Binding CanManageAgencySettings, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{Binding SaveStatus}"
                               AutomationProperties.LiveSetting="Polite"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="11"
                               Margin="0,0,18,0" />
                    <TextBlock Text="Operational changes are applied together when you save."
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="11"
                               Margin="0,0,18,0" />
                    <Button Content="Save Settings"
                            AutomationProperties.Name="Save agency settings"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding SaveSettingsCommand}"
                            Width="150" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
