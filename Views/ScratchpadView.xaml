<UserControl x:Class="Sati.Views.ScratchpadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:Sati.Services">
    <UserControl.Resources>
        <Style x:Key="AgendaTabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBackground"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Margin="2"
                                Padding="8,7">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBackground" Property="Background"
                                        Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBackground" Property="Background"
                                        Value="{DynamicResource SurfaceBrush}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource AccentPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AgendaTabControlStyle" TargetType="TabControl">
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <UniformGrid IsItemsHost="True" Rows="1" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Background="{DynamicResource SurfaceAltBrush}"
                                    CornerRadius="8"
                                    Padding="2">
                                <ItemsPresenter />
                            </Border>
                            <ContentPresenter Grid.Row="1"
                                              Margin="0,10,0,0"
                                              Content="{TemplateBinding SelectedContent}"
                                              ContentTemplate="{TemplateBinding SelectedContentTemplate}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AgendaTextBoxStyle" TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource NarrativeFont}" />
            <Setter Property="FontSize" Value="{Binding ScratchpadFontSize}" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="SpellCheck.IsEnabled" Value="True" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <Style x:Key="ScheduledWorkHeadingStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="2,8,0,5" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="AutomationProperties.HeadingLevel" Value="Level2" />
        </Style>

        <Style x:Key="ScheduledWorkListStyle" TargetType="ListBox">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <EventSetter Event="MouseDoubleClick" Handler="ScheduledWorkList_MouseDoubleClick" />
            <EventSetter Event="PreviewKeyDown" Handler="ScheduledWorkList_PreviewKeyDown" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ScheduledWorkItemTemplate">
            <Border Margin="0,0,0,5"
                    Padding="8,7"
                    Background="{DynamicResource SurfaceAltBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="5"
                    ToolTip="{Binding Summary}"
                    AutomationProperties.Name="{Binding AutomationName}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding Summary}"
                                   FontSize="{Binding DataContext.ScratchpadFontSize,
                                       RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Margin="0,3,0,0"
                                   FontSize="10"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding ClientName, Mode=OneWay}" />
                            <Run Text=" · " />
                            <Run Text="{Binding TypeLabel, Mode=OneWay}" />
                            <Run Text=" · " />
                            <Run Text="{Binding DurationText, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Margin="8,0,0,0"
                            Padding="8,4"
                            VerticalAlignment="Center"
                            Content="Start"
                            Command="{Binding DataContext.OpenScheduledWorkCommand,
                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            AutomationProperties.Name="{Binding AutomationName}" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="WORK AGENDA"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           AutomationProperties.HeadingLevel="Level1"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Command="{Binding OpenScratchpadHistoryCommand}"
                            AutomationProperties.Name="Open scratchpad history"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Padding="4"
                            ToolTip="Browse scratchpad history">
                        <TextBlock Text="&#xE721;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Button>
                    <Button Command="{Binding DecreaseScratchpadFontCommand}"
                            AutomationProperties.Name="Decrease agenda text size"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Padding="4,0"
                            Margin="6,0,0,0">
                        <TextBlock Text="A" FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Button>
                    <Button Command="{Binding IncreaseScratchpadFontCommand}"
                            AutomationProperties.Name="Increase agenda text size"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Padding="4,0">
                        <TextBlock Text="A" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Button>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1"
                    Margin="0,0,0,10"
                    Padding="9"
                    Background="{DynamicResource WarningFillBrush}"
                    BorderBrush="{DynamicResource WarningBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    AutomationProperties.LiveSetting="Assertive"
                    Visibility="{Binding HasScratchpadSessionExpired,
                                         Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="{Binding ScratchpadSessionExpiredMessage}"
                           Foreground="{DynamicResource WarningBrush}"
                           TextWrapping="Wrap" />
            </Border>

            <TabControl Grid.Row="2" Style="{StaticResource AgendaTabControlStyle}">
                <TabItem Header="TODAY'S WORK"
                         AutomationProperties.Name="Today's Work"
                         Style="{StaticResource AgendaTabItemStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <Border Margin="0,0,0,8"
                                    Padding="8"
                                    Background="{DynamicResource WarningFillBrush}"
                                    BorderBrush="{DynamicResource WarningBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    AutomationProperties.LiveSetting="Assertive"
                                    Visibility="{Binding HasScratchpadLoadError,
                                                         Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding ScratchpadLoadErrorMessage}"
                                               Foreground="{DynamicResource WarningBrush}"
                                               TextWrapping="Wrap" />
                                    <Button Margin="0,8,0,0"
                                            Padding="8,4"
                                            HorizontalAlignment="Left"
                                            Content="Retry"
                                            Command="{Binding ReloadLatestScratchpadCommand}"
                                            AutomationProperties.Name="Retry loading Today's Work" />
                                </StackPanel>
                            </Border>
                            <Border Margin="0,0,0,8"
                                    Padding="8"
                                    Background="{DynamicResource WarningFillBrush}"
                                    BorderBrush="{DynamicResource WarningBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Visibility="{Binding HasScratchpadConflict,
                                                         Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding ScratchpadConflictMessage}"
                                               Foreground="{DynamicResource WarningBrush}"
                                               TextWrapping="Wrap" />
                                    <Button Margin="0,8,0,0"
                                            Padding="8,4"
                                            HorizontalAlignment="Left"
                                            Content="Reload Latest"
                                            Command="{Binding ReloadLatestScratchpadCommand}"
                                    AutomationProperties.Name="Reload latest Today's Work" />
                                </StackPanel>
                            </Border>
                            <Border Margin="0,0,0,8"
                                    Padding="8"
                                    Background="{DynamicResource WarningFillBrush}"
                                    BorderBrush="{DynamicResource WarningBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    AutomationProperties.LiveSetting="Assertive"
                                    Visibility="{Binding HasScheduledWorkLoadError,
                                                         Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding ScheduledWorkLoadErrorMessage}"
                                               Foreground="{DynamicResource WarningBrush}"
                                               TextWrapping="Wrap" />
                                    <Button Margin="0,8,0,0"
                                            Padding="8,4"
                                            HorizontalAlignment="Left"
                                            Content="Retry"
                                            Command="{Binding ReloadLatestScratchpadCommand}"
                                            AutomationProperties.Name="Retry loading scheduled work" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <TextBlock Grid.Row="1"
                                   Margin="2,0,0,4"
                                   Text="{Binding ScheduledWorkSummary}"
                                   TextWrapping="Wrap"
                                   FontSize="10"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   AutomationProperties.LiveSetting="Polite" />

                        <ScrollViewer Grid.Row="2"
                                      MaxHeight="360"
                                      Margin="0,0,0,4"
                                      VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding HasScheduledWorkItems,
                                          Converter={StaticResource BoolToVisibilityConverter}}"
                                      AutomationProperties.Name="Today's scheduled work by type">
                            <StackPanel>
                                <StackPanel Visibility="{Binding HasPaperworkItems,
                                    Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="PAPERWORK"
                                               Style="{StaticResource ScheduledWorkHeadingStyle}" />
                                    <ListBox ItemsSource="{Binding PaperworkItems}"
                                             ItemTemplate="{StaticResource ScheduledWorkItemTemplate}"
                                             Style="{StaticResource ScheduledWorkListStyle}"
                                             AutomationProperties.Name="Scheduled paperwork" />
                                </StackPanel>
                                <StackPanel Visibility="{Binding HasVisitItems,
                                    Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="VISITS"
                                               Style="{StaticResource ScheduledWorkHeadingStyle}" />
                                    <ListBox ItemsSource="{Binding VisitItems}"
                                             ItemTemplate="{StaticResource ScheduledWorkItemTemplate}"
                                             Style="{StaticResource ScheduledWorkListStyle}"
                                             AutomationProperties.Name="Scheduled visits" />
                                </StackPanel>
                                <StackPanel Visibility="{Binding HasCallItems,
                                    Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="CALLS"
                                               Style="{StaticResource ScheduledWorkHeadingStyle}" />
                                    <ListBox ItemsSource="{Binding CallItems}"
                                             ItemTemplate="{StaticResource ScheduledWorkItemTemplate}"
                                             Style="{StaticResource ScheduledWorkListStyle}"
                                             AutomationProperties.Name="Scheduled calls" />
                                </StackPanel>
                                <StackPanel Visibility="{Binding HasEmailItems,
                                    Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="EMAILS"
                                               Style="{StaticResource ScheduledWorkHeadingStyle}" />
                                    <ListBox ItemsSource="{Binding EmailItems}"
                                             ItemTemplate="{StaticResource ScheduledWorkItemTemplate}"
                                             Style="{StaticResource ScheduledWorkListStyle}"
                                             AutomationProperties.Name="Scheduled emails" />
                                </StackPanel>
                                <StackPanel Visibility="{Binding HasFreeformItems,
                                    Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="FREEFORM"
                                               Style="{StaticResource ScheduledWorkHeadingStyle}" />
                                    <ListBox ItemsSource="{Binding FreeformItems}"
                                             ItemTemplate="{StaticResource ScheduledWorkItemTemplate}"
                                             Style="{StaticResource ScheduledWorkListStyle}"
                                             AutomationProperties.Name="Scheduled freeform work" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <TextBlock Grid.Row="3"
                                   Text="SCRATCHPAD"
                                   Style="{StaticResource ScheduledWorkHeadingStyle}" />

                        <Border Grid.Row="4"
                                MinHeight="120"
                                Padding="7"
                                Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="5">
                            <TextBox x:Name="TodaysWorkBox"
                                     services:TextShortcutTarget.IsEnabled="True"
                                     AutomationProperties.Name="Today's Work freeform scratchpad"
                                     AutomationProperties.HelpText="Unstructured notes for today. Scheduled client work is listed above."
                                     Style="{StaticResource AgendaTextBoxStyle}"
                                     Text="{Binding ScratchpadContent, UpdateSourceTrigger=PropertyChanged}"
                                     KeyDown="AgendaBox_KeyDown" />
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="TOMORROW'S AGENDA"
                         AutomationProperties.Name="Tomorrow's Agenda"
                         Style="{StaticResource AgendaTabItemStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding TomorrowAgendaDateLabel}"
                                   Margin="2,0,0,8"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                        <StackPanel Grid.Row="1">
                            <Border Margin="0,0,0,8"
                                    Padding="8"
                                    Background="{DynamicResource WarningFillBrush}"
                                    BorderBrush="{DynamicResource WarningBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    AutomationProperties.LiveSetting="Assertive"
                                    Visibility="{Binding HasTomorrowAgendaLoadError,
                                                         Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding TomorrowAgendaLoadErrorMessage}"
                                               Foreground="{DynamicResource WarningBrush}"
                                               TextWrapping="Wrap" />
                                    <Button Margin="0,8,0,0"
                                            Padding="8,4"
                                            HorizontalAlignment="Left"
                                            Content="Retry"
                                            Command="{Binding ReloadLatestTomorrowAgendaCommand}"
                                            AutomationProperties.Name="Retry loading Tomorrow's Agenda" />
                                </StackPanel>
                            </Border>
                            <Border Margin="0,0,0,8"
                                    Padding="8"
                                    Background="{DynamicResource WarningFillBrush}"
                                    BorderBrush="{DynamicResource WarningBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Visibility="{Binding HasTomorrowAgendaConflict,
                                                         Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding TomorrowAgendaConflictMessage}"
                                               Foreground="{DynamicResource WarningBrush}"
                                               TextWrapping="Wrap" />
                                    <Button Margin="0,8,0,0"
                                            Padding="8,4"
                                            HorizontalAlignment="Left"
                                            Content="Reload Latest"
                                            Command="{Binding ReloadLatestTomorrowAgendaCommand}"
                                            AutomationProperties.Name="Reload latest Tomorrow's Agenda" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <TextBox x:Name="TomorrowAgendaBox"
                                 services:TextShortcutTarget.IsEnabled="True"
                                 Grid.Row="2"
                                 AutomationProperties.Name="Tomorrow's Agenda for the next workday"
                                 Style="{StaticResource AgendaTextBoxStyle}"
                                 Text="{Binding TomorrowAgendaContent, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="AgendaBox_KeyDown" />
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</UserControl>
