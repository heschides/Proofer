<UserControl x:Class="Sati.Views.NotesLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">

    <!-- Escape returns the note panel to a blank New Note and drops the grid's
         highlight with it. Declared here as well as on the module so the key works
         from the grid and the filters, not only from inside the form. -->
    <UserControl.InputBindings>
        <KeyBinding Key="Escape"
                    Command="{Binding NoteEntry.StartNewNoteCommand}" />
    </UserControl.InputBindings>

    <!--
        Two columns. The note panel runs full height on the left and is the only
        place a note is read or written — selecting a row in the grid shows that
        note there, locked, and the padlock in its header opens it for editing.
        There is no separate detail panel: one note, one panel, one set of fields.
        On the right the filters sit directly above the grid they filter.
    -->
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*"
                              MinWidth="340" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="7*"
                              MinWidth="380" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*"
                           MinHeight="200" />
        </Grid.RowDefinitions>

        <!-- ═══ NOTE ENTRY MODULE ═══
             Second host of the shared entry module. Its own instance — drafts
             here are independent of the dashboard's copy. It is also the detail
             view: the grid selection loads the note into it, locked. -->
        <ContentControl x:Name="NoteEntryPanel"
                        Grid.Row="0"
                        Grid.RowSpan="3"
                        Grid.Column="0"
                        Content="{Binding NoteEntry}" />

        <!-- ═══ FILTERS ═══
             A horizontal band directly above the grid it scopes. The groups sit
             in a WrapPanel rather than fixed columns so a narrow window reflows
             them onto a second line instead of clipping a date picker. -->
        <Border x:Name="NotesFilterPanel"
                Grid.Column="2"
                Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- No Deselect Note button here any more. It existed to stop the
                     old detail panel showing a note while the editor beside it held
                     something else; with one panel, "un-highlight the row but keep
                     showing its note" describes nothing a case manager wants. The
                     New Note button in the note panel clears the row and the panel
                     together, and Escape does the same. -->
                <TextBlock Grid.Row="0"
                           Text="FILTERS"
                           Style="{StaticResource SectionHeader}" />

                <WrapPanel Grid.Row="1">

                    <StackPanel Width="180"
                                Margin="0,0,14,6">
                        <TextBlock Text="CLIENT"
                                   Style="{StaticResource LabelStyle}" />
                        <ComboBox AutomationProperties.Name="Filter by person"
                                  ItemsSource="{Binding FilterPeople}"
                                  SelectedItem="{Binding SelectedFilterPerson, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FullName, FallbackValue='All Clients'}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Width="150"
                                Margin="0,0,14,6">
                        <TextBlock Text="STATUS"
                                   Style="{StaticResource LabelStyle}" />
                        <ComboBox AutomationProperties.Name="Filter by status"
                                  ItemsSource="{Binding StatusOptions}"
                                  SelectedItem="{Binding SelectedStatusOption, Mode=TwoWay}"
                                  DisplayMemberPath="Display" />
                    </StackPanel>

                    <StackPanel Width="220"
                                Margin="0,0,14,6">
                        <TextBlock Text="SEARCH"
                                   Style="{StaticResource LabelStyle}" />
                        <TextBox AutomationProperties.Name="Search Text"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="6,4" />
                    </StackPanel>

                    <StackPanel Margin="0,0,14,6">
                        <TextBlock Text="DATE RANGE"
                                   Style="{StaticResource LabelStyle}" />
                        <StackPanel Orientation="Horizontal">
                            <DatePicker Width="128"
                                        SelectedDate="{Binding RangeStart, Mode=TwoWay}"
                                        AutomationProperties.Name="Range start date" />
                            <DatePicker Width="128"
                                        Margin="6,0,0,0"
                                        SelectedDate="{Binding RangeEnd, Mode=TwoWay}"
                                        AutomationProperties.Name="Range end date" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Units summary — scoped by the filters beside it, fixed to Pending/Logged -->
                    <StackPanel Margin="0,0,14,6">
                        <TextBlock Text="UNITS IN RANGE"
                                   Style="{StaticResource LabelStyle}" />
                        <Border Background="{DynamicResource WindowBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="10,5">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Pending"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding RangePendingUnits}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Margin="5,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           AutomationProperties.Name="Pending units in range" />
                                <TextBlock Text="Logged"
                                           FontSize="12"
                                           Margin="14,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding RangeLoggedUnits}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Margin="5,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           AutomationProperties.Name="Logged units in range" />
                                <TextBlock Text="Total"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Margin="16,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock Text="{Binding RangeTotalUnits}"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Margin="5,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource AccentBrush}"
                                           AutomationProperties.Name="Total units in range" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Attention section — hidden when nothing needs action -->
                    <StackPanel Margin="0,0,0,6"
                                Visibility="{Binding HasAttentionItems,
                                    Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="ATTENTION NEEDED"
                                   Style="{StaticResource LabelStyle}" />
                        <StackPanel Orientation="Horizontal">

                            <!-- Returned notes link -->
                            <Button AutomationProperties.Name="Show returned notes"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Command="{Binding ShowReturnedCommand}"
                                    Visibility="{Binding HasReturned,
                                        Converter={StaticResource BoolToVisibilityConverter}}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="4"
                                                Padding="6,5">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver"
                                                     Value="True">
                                                <Setter Property="Background"
                                                        Value="{DynamicResource SurfaceRaisedBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="{DynamicResource AccentBrush}"
                                            CornerRadius="10"
                                            MinWidth="20"
                                            Height="20"
                                            Padding="5,0"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ReturnedCount}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource SurfaceBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="Returned"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Held for compliance link -->
                            <Button Background="Transparent"
                                    AutomationProperties.Name="Show notes held for compliance"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Margin="6,0,0,0"
                                    Command="{Binding ShowHeldCommand}"
                                    Visibility="{Binding HasHeld,
                                        Converter={StaticResource BoolToVisibilityConverter}}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="4"
                                                Padding="6,5">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver"
                                                     Value="True">
                                                <Setter Property="Background"
                                                        Value="{DynamicResource SurfaceRaisedBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="{DynamicResource DangerStrongBrush}"
                                            CornerRadius="10"
                                            MinWidth="20"
                                            Height="20"
                                            Padding="5,0"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding HeldCount}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource SurfaceBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="Held for Compliance"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- ═══ NOTES DATAGRID ═══
             Single click shows the row's note in the entry panel, locked.
             Double click opens it there for editing. -->
        <Border x:Name="NotesDataGridPanel"
                Grid.Row="2"
                Grid.Column="2"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
            <DataGrid AutomationProperties.Name="Notes" ItemsSource="{Binding NotesView}"
                      SelectedItem="{Binding SelectedNote, Mode=TwoWay}"
                      MouseDoubleClick="DataGrid_MouseDoubleClick"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      Background="Transparent"
                      BorderThickness="0"
                      RowBackground="{DynamicResource SurfaceBrush}"
                      AlternatingRowBackground="{DynamicResource WindowBackgroundBrush}"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{DynamicResource DividerBrush}"
                      HeadersVisibility="Column"
                      SelectionMode="Single">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Mark Note Logged"
                                  Command="{Binding PlacementTarget.DataContext.MarkNoteLoggedCommand,
                                      RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Client"
                                        Binding="{Binding Person.FullName}"
                                        Width="*" />
                    <DataGridTextColumn Header="Date"
                                        Binding="{Binding EventDate, StringFormat={}{0:MM/dd}}"
                                        Width="60" />
                    <DataGridTextColumn Header="Status"
                                        Binding="{Binding Status}"
                                        Width="80" />
                    <DataGridTextColumn Header="Type"
                                        Binding="{Binding NoteType}"
                                        Width="80" />
                    <DataGridTextColumn Header="Units"
                                        Binding="{Binding Units}"
                                        Width="50" />
                    <DataGridTextColumn Header="Narrative"
                                        Binding="{Binding Narrative}"
                                        Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Compliance dialog overlay — spans the full grid (all 3 cols, all 3 rows)
             so the scrim covers the whole view, note panel included. -->
        <Grid Background="{DynamicResource ScrimBrush}"
              Grid.Column="0"
              Grid.ColumnSpan="3"
              Grid.Row="0"
              Grid.RowSpan="3"
              Visibility="{Binding IsComplianceDialogVisible,
                  Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="{DynamicResource WindowBackgroundBrush}"
                    BorderBrush="{DynamicResource OverdueBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Width="460"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>

                    <TextBlock Text="CLIENT NOT BILLING COMPLIANT"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource DangerStrongBrush}"
                               Margin="0,0,0,8" />

                    <TextBlock TextWrapping="Wrap"
                               FontSize="12"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,12">
                        <Run Text="{Binding SelectedNote.Person.FullName, FallbackValue='This client', Mode=OneWay}" />
                        <Run Text="does not currently meet billing compliance requirements. You may hold this note in your queue until compliance is resolved, or send it to your supervisor with a written justification." />
                    </TextBlock>

                    <Border Background="{DynamicResource SurfaceRaisedBrush}"
                            BorderBrush="{DynamicResource OverdueBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10,8"
                            Margin="0,0,0,12">
                        <ItemsControl ItemsSource="{Binding ComplianceFailureReasons}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"
                                               FontSize="12"
                                               Foreground="{DynamicResource DangerStrongBrush}"
                                               Margin="0,2"
                                               TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <TextBlock Text="JUSTIFICATION"
                               FontSize="10"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,0,4" />
                    <TextBlock Text="Required if sending to supervisor. Ignored if holding."
                               FontSize="10"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,0,6" />
                    <TextBox AutomationProperties.Name="Pending note justification" Text="{Binding PendingJustification, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Height="90"
                             Padding="8"
                             FontSize="12"
                             Background="{DynamicResource SurfaceBrush}"
                             BorderBrush="{DynamicResource OverdueBorderBrush}"
                             VerticalScrollBarVisibility="Auto"
                             Margin="0,0,0,16" />

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Content="Cancel"
                                Padding="14,6"
                                FontSize="12"
                                Cursor="Hand"
                                BorderThickness="0"
                                Background="{DynamicResource TextSecondaryBrush}"
                                Foreground="{DynamicResource WindowBackgroundBrush}"
                                Margin="0,0,6,0"
                                Command="{Binding CancelComplianceDialogCommand}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="4"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Content="Hold for Now"
                                Padding="14,6"
                                FontSize="12"
                                Cursor="Hand"
                                BorderThickness="0"
                                Background="{DynamicResource AccentBrush}"
                                Foreground="{DynamicResource WindowBackgroundBrush}"
                                Margin="0,0,6,0"
                                Command="{Binding HoldForComplianceCommand}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="4"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Content="Send to Supervisor"
                                Padding="14,6"
                                FontSize="12"
                                Cursor="Hand"
                                BorderThickness="0"
                                Background="{DynamicResource DangerStrongBrush}"
                                Foreground="{DynamicResource WindowBackgroundBrush}"
                                Command="{Binding SendToSupervisorCommand}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="4"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>

                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</UserControl>
