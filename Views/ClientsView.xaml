<UserControl x:Class="Sati.Views.ClientsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Sati"
        xmlns:converters="clr-namespace:Sati.Converters"
        xmlns:clientDocuments="clr-namespace:Sati.Views.ClientDocuments"
        Background="{DynamicResource WindowBackgroundBrush}">

    <UserControl.Resources>
        <converters:BoolToWidthConverter x:Key="BoolToWidthConverter" />
        <converters:BoolToWidthConverter x:Key="SpacerWidthConverter"
                                         TrueWidth="16"
                                         FalseWidth="0" />
        <!-- Dot-grid fill for the Journal. A DrawingBrush tiling a single 2px dot in
             the palette's border tone at a 16px pitch. Viewport is absolute (Viewport
             + ViewportUnits=Absolute), so the dot stays a fixed size and the grid
             density doesn't stretch with the box. TileMode=Tile repeats it. Faint by
             color choice, not opacity, so it doesn't dim text drawn over it. -->
        <DrawingBrush x:Key="JournalDotBrush"
                      TileMode="Tile"
                      Viewport="0,0,16,16"
                      ViewportUnits="Absolute"
                      Stretch="None">
            <DrawingBrush.Drawing>
                <GeometryDrawing Brush="{DynamicResource BorderBrush}">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="8,8"
                                         RadiusX="1"
                                         RadiusY="1" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <Style x:Key="LabelStyle"
               TargetType="TextBlock">
            <Setter Property="FontSize"
                    Value="11" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="Foreground"
                    Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Margin"
                    Value="0,0,0,5" />
        </Style>

        <Style x:Key="SectionHeader"
               TargetType="TextBlock">
            <Setter Property="FontSize"
                    Value="13" />
            <Setter Property="FontWeight"
                    Value="Bold" />
            <Setter Property="Foreground"
                    Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Margin"
                    Value="0,0,0,8" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground"
                    Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Margin"
                    Value="0,0,0,6" />
        </Style>


        <Style x:Key="IconButton"
               TargetType="Button">
            <Setter Property="Width"
                    Value="32" />
            <Setter Property="Height"
                    Value="32" />
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="BorderThickness"
                    Value="0" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter Property="Background"
                                        Value="{DynamicResource BorderBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Client document navigation. The identity rail remains outside this
             control so changing workspaces never loses consumer context. -->
        <Style x:Key="ClientWorkspaceTabItemStyle"
               TargetType="TabItem">
            <Setter Property="Foreground"
                    Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="FontSize"
                    Value="12" />
            <Setter Property="Margin"
                    Value="0,0,0,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="WorkspaceTabBackground"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="12,10">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Left" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="WorkspaceTabBackground"
                                        Property="Background"
                                        Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected"
                                     Value="True">
                                <Setter TargetName="WorkspaceTabBackground"
                                        Property="Background"
                                        Value="{DynamicResource SurfaceBrush}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource AccentPressedBrush}" />
                                <Setter Property="FontWeight"
                                        Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ClientWorkspaceTabControlStyle"
               TargetType="TabControl">
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <StackPanel IsItemsHost="True" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10">
                                <StackPanel>
                                    <TextBlock Text="CONSUMER RECORD"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Margin="10,4,0,12" />
                                    <ItemsPresenter />
                                </StackPanel>
                            </Border>

                            <ContentPresenter Grid.Column="2"
                                              ContentSource="SelectedContent" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0" />
            <ColumnDefinition Width="0" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ═══ ENTRY FORM (left) ═══ -->
        <Border Grid.Column="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="16"
                Visibility="{Binding IsEntryPanelOpen, 
  Converter={StaticResource BoolToVisibilityConverter}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{Binding EntryPanelHeader}"
                               FontSize="13"
                               FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,16" />

                <TextBlock Text="FIRST NAME"
                           Style="{StaticResource LabelStyle}" />
                <TextBox AutomationProperties.Name="First Name" Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="LAST NAME"
                           Style="{StaticResource LabelStyle}" />
                <TextBox AutomationProperties.Name="Last Name" Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="BIRTHDAY"
                           Style="{StaticResource LabelStyle}" />
                <DatePicker AutomationProperties.Name="Date of birth" SelectedDate="{Binding BirthDate, Mode=TwoWay}" />

                <TextBlock Text="GENDER / PRONOUNS"
                           Style="{StaticResource LabelStyle}" />
                <ComboBox AutomationProperties.Name="Gender and pronouns" ItemsSource="{Binding Genders}"
                          SelectedItem="{Binding Gender, Mode=TwoWay}" />

                <TextBlock Text="WAIVER"
                           Style="{StaticResource LabelStyle}" />
                <ComboBox AutomationProperties.Name="Waiver" ItemsSource="{Binding Waivers}"
                          SelectedItem="{Binding Waiver, Mode=TwoWay}" />

                <TextBlock Text="EFFECTIVE DATE"
                           Style="{StaticResource LabelStyle}" />
                <Grid Margin="0,0,0,10"
                      IsEnabled="{Binding HasWaiver}">
                    <TextBox AutomationProperties.Name="Effective date" Text="{Binding EffectiveDateText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="MM/DD"
                               Foreground="{DynamicResource InputBorderBrush}"
                               FontSize="13"
                               Margin="9,4"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility"
                                        Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EffectiveDateText}"
                                                 Value="">
                                        <Setter Property="Visibility"
                                                Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    </Grid>

                    <TextBlock Text="BIO"
                               Style="{StaticResource LabelStyle}" />
                    <TextBox AutomationProperties.Name="Bio" Text="{Binding Bio, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Height="100" />

                    <TextBlock Text="EVERGREEN ID"
                               Style="{StaticResource LabelStyle}" />
                    <TextBox AutomationProperties.Name="Evergreen " Text="{Binding EvergreenId, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="PHONE"
                               Style="{StaticResource LabelStyle}" />
                    <TextBox AutomationProperties.Name="Phone Number" Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="ADDRESS"
                           Style="{StaticResource LabelStyle}" />
                <TextBox AutomationProperties.Name="Address" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="PRIMARY CARE PROVIDER"
                           Style="{StaticResource LabelStyle}" />
                <TextBox AutomationProperties.Name="Primary Care Provider" Text="{Binding PrimaryCareProvider, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="HEALTHCARE SYSTEM"
                           Style="{StaticResource LabelStyle}" />
                <ComboBox AutomationProperties.Name="Healthcare System Name" ItemsSource="{Binding HealthcareSystems}"
                          DisplayMemberPath="Name"
                          SelectedValuePath="Name"
                          SelectedValue="{Binding HealthcareSystemName, Mode=TwoWay}" />

                <CheckBox Content="Open with VR"
                          IsChecked="{Binding OpenWithVR}"
                          Margin="0,12,0,6" />

                    <CheckBox Content="Has guardian"
                              IsChecked="{Binding HasGuardian}" />
                    <TextBox AutomationProperties.Name="Guardian Name" Text="{Binding GuardianName, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding HasGuardian, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <TextBlock Text="WAIVER SERVICES"
                               Style="{StaticResource LabelStyle}"
                               Margin="0,16,0,6" />

                    <CheckBox Content="Home support"
                              IsChecked="{Binding HasHomeSupport}" />
                    <CheckBox Content="Self-directed home support"
                              IsChecked="{Binding HasSelfDirectedHomeSupport}" />
                    <CheckBox Content="Shared living"
                              IsChecked="{Binding HasSharedLiving}" />
                    <CheckBox Content="Community support 1:1"
                              IsChecked="{Binding HasCommunitySupport1To1}" />
                    <CheckBox Content="Community support self-directed"
                              IsChecked="{Binding HasCommunitySupportSelfDirected}" />
                    <CheckBox Content="Day program"
                              IsChecked="{Binding HasCommunitySupportDayProgram}" />

                    <!-- Reveal pattern borrowed from HasGuardian/GuardianName. Bound
                     LostFocus rather than PropertyChanged: the VM clamps values
                     below 1 up to 1, and clamping on every keystroke makes the
                     field impossible to clear and retype. -->
                    <StackPanel Orientation="Horizontal"
                                Margin="20,0,0,6"
                                Visibility="{Binding HasCommunitySupportDayProgram, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="How many?"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <TextBox AutomationProperties.Name="Day Program Count" Text="{Binding DayProgramCount, UpdateSourceTrigger=LostFocus}"
                                 Width="48" />
                    </StackPanel>

                    <CheckBox Content="Employed"
                              IsChecked="{Binding IsEmployed}"
                              Margin="0,12,0,6" />

                    <CheckBox Content="Employment specialist"
                              IsChecked="{Binding HasEmploymentSpecialist}"
                              IsEnabled="{Binding IsEmployed}"
                              Margin="20,0,0,6" />
                    <CheckBox Content="Work supports"
                              IsChecked="{Binding HasWorkSupports}"
                              IsEnabled="{Binding IsEmployed}"
                              Margin="20,0,0,6" />

                <Button Content="{Binding SubmitButtonLabel}"
                        AutomationProperties.Name="{Binding SubmitButtonLabel}"
                            Style="{StaticResource PrimaryButton}"
                        Command="{Binding SubmitCommand}" 
                            Margin="0,0,0,10"/>

            </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Chevron rail — always visible; toggles the entry panel. Mirrors the
             Today's Work rail in ShellWindow, but sits to the right of its panel
             rather than the left, so the chevron directions are reversed: the arrow
             points the way the panel's outer edge will move. -->
        <Border Grid.Column="1"
                BorderThickness="1,0,1,0"
                Margin="0,0,8,0">
            <Button Command="{Binding ToggleEntryPanelCommand}"
                    AutomationProperties.Name="Show or hide client form"
                    Width="24"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    VerticalAlignment="Center"
                    ToolTip="Show or hide the client form">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <TextBlock FontFamily="Segoe MDL2 Assets"
                           FontSize="14"
                           Foreground="{DynamicResource TextSecondaryBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <!-- Closed: points right = expand outward from the edge -->
                            <Setter Property="Text"
                                    Value="&#xE76C;" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEntryPanelOpen}"
                                             Value="True">
                                    <!-- Open: points left = collapse toward the edge -->
                                    <Setter Property="Text"
                                            Value="&#xE76B;" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Button>
        </Border>

        <!-- ═══ RIGHT PANEL ═══ -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition>
                    <ColumnDefinition.Style>
                        <Style TargetType="ColumnDefinition">
                            <Setter Property="Width" Value="250" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsClientListCompact}" Value="True">
                                    <Setter Property="Width" Value="0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ColumnDefinition.Style>
                </ColumnDefinition>
                <ColumnDefinition>
                    <ColumnDefinition.Style>
                        <Style TargetType="ColumnDefinition">
                            <Setter Property="Width" Value="12" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsClientListCompact}" Value="True">
                                    <Setter Property="Width" Value="0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ColumnDefinition.Style>
                </ColumnDefinition>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ═══ CLIENT ROSTER ═══ -->
            <Border Grid.Column="0"
                    Grid.RowSpan="2"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Visibility="{Binding IsClientListCompact, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="14,12,10,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="CLIENTS"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding People.Count, StringFormat={}{0} people}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource IconButton}"
                                    AutomationProperties.Name="Collapse client list"
                                    Command="{Binding ToggleClientListCommand}"
                                    ToolTip="Use compact client selector">
                                <TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Button>
                            <Button Style="{StaticResource IconButton}"
                                    AutomationProperties.Name="Add a new client"
                                    Command="{Binding OpenEntryPanelCommand}"
                                    ToolTip="Add a new client">
                                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <ListBox AutomationProperties.Name="Clients"
                             Grid.Row="1"
                             ItemsSource="{Binding People}"
                             SelectedItem="{Binding SelectedPerson, Mode=TwoWay}"
                             MouseDoubleClick="ClientList_MouseDoubleClick"
                             IsEnabled="{Binding IsClientEditorOpen, Converter={StaticResource InverseBoolConverter}}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Padding="6,0,6,8">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,4" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ClientCard"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="Transparent"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="10,7.2">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ClientCard" Property="Background" Value="{DynamicResource HoverBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                    <Setter TargetName="ClientCard" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ClientCard" Property="Background" Value="{DynamicResource PersonGroupBrush}" />
                                                    <Setter TargetName="ClientCard" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding FullName}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="0,3,0,0">
                                                            <Run Text="{Binding Waiver, Mode=OneWay}" />
                                            <Run Text=" · " />
                                                            <Run Text="{Binding EffectiveDate, Mode=OneWay, StringFormat={}{0:MM/dd/yyyy}}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="&#xE76C;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               VerticalAlignment="Center"
                                               Margin="8,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- ═══ CLIENT DETAIL PANEL ═══ -->
            <!-- Always-visible compact selector. It remains available even when
                 no consumer workspace is currently shown. -->
            <Border Grid.Column="2"
                    Grid.Row="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10,8"
                    Margin="0,0,0,10"
                    Visibility="{Binding IsClientListCompact, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="250" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="4"
                            Style="{StaticResource IconButton}"
                            AutomationProperties.Name="Expand client list"
                            Command="{Binding ToggleClientListCommand}"
                            ToolTip="Show full client list">
                        <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Button>
                    <TextBlock Grid.Column="0" Text="CLIENT" FontSize="11" FontWeight="Bold"
                               Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"
                               Margin="0,0,10,0" />
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding People}"
                              SelectedItem="{Binding SelectedPerson, Mode=TwoWay}"
                              DisplayMemberPath="FullName"
                              IsEnabled="{Binding IsClientEditorOpen, Converter={StaticResource InverseBoolConverter}}"
                              AutomationProperties.Name="Select client" />
                    <ItemsControl Grid.Column="3"
                                  ItemsSource="{Binding SelectedPersonUpcomingItems}"
                                  VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource DividerBrush}"
                                        BorderThickness="1,0,0,0"
                                        Padding="12,0"
                                        Margin="0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Date, StringFormat={}{0:MMM d}}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Grid.Column="3"
                               Text="No upcoming items in the current work window"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Visibility="{Binding HasSelectedPersonUpcomingItems, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Grid.Row="1"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="16">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowClientWorkspace}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0" />
                        <ColumnDefinition Width="0" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- CLIENT INFO -->
                    <ScrollViewer Grid.Column="0"
                                  Grid.Row="0"
                                  Grid.RowSpan="3"
                                  Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,12">
                            <TextBlock Text="{Binding SelectedPerson.FullName}"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>

                        <TextBlock Text="WAIVER"
                                   Style="{StaticResource LabelStyle}" />
                        <TextBlock Text="{Binding SelectedPerson.Waiver}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="13"
                                   Margin="0,0,0,10" />

                        <TextBlock Text="EFFECTIVE DATE"
                                   Style="{StaticResource LabelStyle}" />
                        <TextBlock Text="{Binding SelectedPerson.EffectiveDate, StringFormat={}{0:MM/dd/yyyy}}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="13"
                                   Margin="0,0,0,10" />

                        <TextBlock Text="DATE OF BIRTH"
                                   Style="{StaticResource LabelStyle}" />
                        <TextBlock Text="{Binding SelectedPerson.BirthDate, StringFormat={}{0:MM/dd/yyyy}}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="13"
                                   Margin="0,0,0,10" />

                        <TextBlock Text="LAST CONTACT"
                                   Style="{StaticResource LabelStyle}" />
                        <TextBlock Text="{Binding LastContact, StringFormat={}{0:MM/dd/yyyy}, TargetNullValue=—}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="13"
                                   Margin="0,0,0,10" />

                        <TextBlock Text="EVERGREEN ID"
                                   Style="{StaticResource LabelStyle}" />
                        <TextBlock Text="{Binding SelectedPerson.EvergreenId}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="13"
                                   Margin="0,0,0,10" />

                        <TextBlock Text="PHONE"
                                   Style="{StaticResource LabelStyle}" />
                        <TextBlock Text="{Binding SelectedPerson.PhoneNumber}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="13"
                                   Margin="0,0,0,10" />
                        
                        <TextBlock Text="ADDRESS"
                                   Style="{StaticResource LabelStyle}" />
                        <TextBlock Text="{Binding SelectedPerson.Address}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10" />

                        <TextBlock Text="PRIMARY CARE PROVIDER"
                                   Style="{StaticResource LabelStyle}" />
                        <TextBlock Text="{Binding SelectedPerson.PrimaryCareProvider}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="13"
                                   Margin="0,0,0,10" />

                        <TextBlock Text="HEALTHCARE SYSTEM"
                                   Style="{StaticResource LabelStyle}" />
                        <TextBlock Text="{Binding SelectedPerson.HealthcareSystemName}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="13"
                                   Margin="0,0,0,10" />

                        <TextBlock Text="GUARDIAN"
                                   Style="{StaticResource LabelStyle}"
                                   Visibility="{Binding SelectedPerson.HasGuardian, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <TextBlock Text="{Binding SelectedPerson.GuardianName}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="13"
                                   Margin="0,0,0,10"
                                   Visibility="{Binding SelectedPerson.HasGuardian, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <TextBlock Text="Open with VR"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,10"
                                   Visibility="{Binding SelectedPerson.OpenWithVR, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <TextBlock Text="SERVICES"
                                   Style="{StaticResource LabelStyle}"
                                   Visibility="{Binding HasSelectedPersonServices, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <TextBlock Text="{Binding SelectedPersonServices}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10"
                                   Visibility="{Binding HasSelectedPersonServices, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <TextBlock Text="Employment tracking required"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10"
                                   Visibility="{Binding ShowsEmploymentTracking, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <TextBlock Text="BIO"
                                   Style="{StaticResource LabelStyle}" />
                        <TextBlock Text="{Binding SelectedPerson.Bio}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="13"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    </ScrollViewer>

                    <TabControl Grid.Column="2"
                                Grid.Row="0"
                                Grid.RowSpan="3"
                                SelectedIndex="{Binding ClientWorkspaceTabIndex}"
                                Style="{StaticResource ClientWorkspaceTabControlStyle}"
                                AutomationProperties.Name="Consumer record sections">
                        <TabItem Header="Overview"
                                 Style="{StaticResource ClientWorkspaceTabItemStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="12" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="12" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="12" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                    <!-- Landscape consumer summary. This replaces the former vertical
                         identity rail so Overview retains substantially more height. -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource PersonGroupAltBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="14"
                            Visibility="{Binding IsClientEditorOpen, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                            AutomationProperties.Name="Selected consumer details">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.ColumnSpan="4"
                                       Text="{Binding SelectedPerson.FullName}"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Margin="0,0,0,10"
                                       AutomationProperties.HeadingLevel="Level2" />
                            <Button Grid.Row="0" Grid.Column="3"
                                    Style="{StaticResource IconButton}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Command="{Binding BeginClientEditCommand}"
                                    AutomationProperties.Name="Unlock client details for editing"
                                    ToolTip="Edit client details">
                                <TextBlock Text="&#xE72E;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="14"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Button>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,14,10">
                                <TextBlock Text="WAIVER" Style="{StaticResource LabelStyle}" />
                                <TextBlock Text="{Binding SelectedPerson.Waiver}" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,14,10">
                                <TextBlock Text="EFFECTIVE DATE" Style="{StaticResource LabelStyle}" />
                                <TextBlock Text="{Binding SelectedPerson.EffectiveDate, StringFormat={}{0:MM/dd/yyyy}, TargetNullValue=—}"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,14,10">
                                <TextBlock Text="DATE OF BIRTH" Style="{StaticResource LabelStyle}" />
                                <TextBlock Text="{Binding SelectedPerson.BirthDate, StringFormat={}{0:MM/dd/yyyy}}"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="3" Margin="0,0,0,10">
                                <TextBlock Text="LAST CONTACT" Style="{StaticResource LabelStyle}" />
                                <TextBlock Text="{Binding LastContact, StringFormat={}{0:MM/dd/yyyy}, TargetNullValue=—}"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,14,10">
                                <TextBlock Text="EVERGREEN ID" Style="{StaticResource LabelStyle}" />
                                <TextBlock Text="{Binding SelectedPerson.EvergreenId, TargetNullValue=—}"
                                           Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,14,10">
                                <TextBlock Text="PHONE" Style="{StaticResource LabelStyle}" />
                                <TextBlock Text="{Binding SelectedPerson.PhoneNumber, TargetNullValue=—}"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,14,10">
                                <TextBlock Text="PRIMARY CARE PROVIDER" Style="{StaticResource LabelStyle}" />
                                <TextBlock Text="{Binding SelectedPerson.PrimaryCareProvider, TargetNullValue=—}"
                                           Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="3" Margin="0,0,0,10">
                                <TextBlock Text="HEALTHCARE SYSTEM" Style="{StaticResource LabelStyle}" />
                                <TextBlock Text="{Binding SelectedPerson.HealthcareSystemName, TargetNullValue=—}"
                                           Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,18,0">
                                <TextBlock Text="ADDRESS" Style="{StaticResource LabelStyle}" />
                                <TextBlock Text="{Binding SelectedPerson.Address, TargetNullValue=—}"
                                           Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,14,0">
                                <TextBlock Text="GUARDIAN / STATUS" Style="{StaticResource LabelStyle}" />
                                <TextBlock Text="{Binding SelectedPerson.GuardianName}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding SelectedPerson.HasGuardian, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <TextBlock Text="No guardian recorded"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Visibility="{Binding SelectedPerson.HasGuardian, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                <TextBlock Text="Open with VR"
                                           Foreground="{DynamicResource AccentPressedBrush}"
                                           FontWeight="SemiBold"
                                           Visibility="{Binding SelectedPerson.OpenWithVR, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <TextBlock Text="Employment tracking required"
                                           Foreground="{DynamicResource WarningBrush}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding ShowsEmploymentTracking, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </StackPanel>
                            <StackPanel Grid.Row="3" Grid.Column="3">
                                <TextBlock Text="SERVICES" Style="{StaticResource LabelStyle}" />
                                <TextBlock Text="{Binding SelectedPersonServices, TargetNullValue=No services recorded}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Row="4" Grid.ColumnSpan="4" Margin="0,10,0,0">
                                <TextBlock Text="BIO" Style="{StaticResource LabelStyle}" />
                                <TextBlock Text="{Binding SelectedPerson.Bio, TargetNullValue=No biography recorded}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextWrapping="Wrap"
                                           MaxHeight="42" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- The same information becomes an inline editor when unlocked.
                         No secondary edit panel or detached copy of the client exists. -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource PersonGroupAltBrush}"
                            BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="14"
                            Visibility="{Binding IsClientEditorOpen, Converter={StaticResource BoolToVisibilityConverter}}"
                            AutomationProperties.Name="Client details edit mode">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="390">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE785;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="14"
                                               Foreground="{DynamicResource AccentPressedBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"
                                               AutomationProperties.Name="Client details unlocked" />
                                    <TextBlock Text="{Binding EntryPanelHeader}"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               VerticalAlignment="Center"
                                               AutomationProperties.HeadingLevel="Level2" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="2"
                                            Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Cancel"
                                            Command="{Binding CancelClientEditCommand}"
                                            Padding="12,5" Margin="0,0,8,0"
                                            Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <Button Content="{Binding SubmitButtonLabel}"
                                            Command="{Binding SubmitCommand}"
                                            Padding="14,5"
                                            Background="{DynamicResource AccentBrush}"
                                            BorderThickness="0"
                                            Foreground="{DynamicResource SurfaceBrush}"
                                            AutomationProperties.Name="{Binding SubmitButtonLabel}" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,12,14,0">
                                    <TextBlock Text="FIRST NAME" Style="{StaticResource LabelStyle}" />
                                    <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="First name" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,12,14,0">
                                    <TextBlock Text="LAST NAME" Style="{StaticResource LabelStyle}" />
                                    <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Last name" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,12,14,0">
                                    <TextBlock Text="DATE OF BIRTH" Style="{StaticResource LabelStyle}" />
                                    <DatePicker SelectedDate="{Binding BirthDate}" AutomationProperties.Name="Date of birth" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="3" Margin="0,12,0,0">
                                    <TextBlock Text="WAIVER" Style="{StaticResource LabelStyle}" />
                                    <ComboBox ItemsSource="{Binding Waivers}" SelectedItem="{Binding Waiver}" AutomationProperties.Name="Waiver" />
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,10,14,0" IsEnabled="{Binding HasWaiver}">
                                    <TextBlock Text="EFFECTIVE DATE (MM/DD)" Style="{StaticResource LabelStyle}" />
                                    <TextBox Text="{Binding EffectiveDateText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Effective date" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,10,14,0">
                                    <TextBlock Text="EVERGREEN ID" Style="{StaticResource LabelStyle}" />
                                    <TextBox Text="{Binding EvergreenId, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Evergreen ID" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,10,14,0">
                                    <TextBlock Text="GENDER / PRONOUNS" Style="{StaticResource LabelStyle}" />
                                    <ComboBox ItemsSource="{Binding Genders}" SelectedItem="{Binding Gender}"
                                              AutomationProperties.Name="Gender and pronouns" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="3" Margin="0,10,0,0">
                                    <TextBlock Text="HEALTHCARE SYSTEM" Style="{StaticResource LabelStyle}" />
                                    <ComboBox ItemsSource="{Binding HealthcareSystems}"
                                              DisplayMemberPath="Name" SelectedValuePath="Name"
                                              SelectedValue="{Binding HealthcareSystemName}"
                                              AutomationProperties.Name="Healthcare system" />
                                </StackPanel>

                                <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,10,14,0">
                                    <TextBlock Text="ADDRESS" Style="{StaticResource LabelStyle}" />
                                    <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Address" />
                                    <TextBlock Text="BIO" Style="{StaticResource LabelStyle}" Margin="0,10,0,5" />
                                    <TextBox Text="{Binding Bio, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="62"
                                             SpellCheck.IsEnabled="True" AutomationProperties.Name="Biography" />
                                </StackPanel>
                                <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,10,14,0">
                                    <TextBlock Text="PHONE" Style="{StaticResource LabelStyle}" />
                                    <TextBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Phone number" />
                                    <TextBlock Text="PRIMARY CARE PROVIDER" Style="{StaticResource LabelStyle}" />
                                    <TextBox Text="{Binding PrimaryCareProvider, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Primary care provider" />
                                    <CheckBox Content="Has guardian" IsChecked="{Binding HasGuardian}" Margin="0,10,0,4" />
                                    <TextBox Text="{Binding GuardianName, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding HasGuardian}" AutomationProperties.Name="Guardian name" />
                                    <CheckBox Content="Open with VR" IsChecked="{Binding OpenWithVR}" Margin="0,10,0,4" />
                                    <CheckBox Content="Employed" IsChecked="{Binding IsEmployed}" />
                                    <CheckBox Content="Employment specialist" IsChecked="{Binding HasEmploymentSpecialist}" IsEnabled="{Binding IsEmployed}" />
                                    <CheckBox Content="Work supports" IsChecked="{Binding HasWorkSupports}" IsEnabled="{Binding IsEmployed}" />
                                </StackPanel>
                                <StackPanel Grid.Row="3" Grid.Column="3" Margin="0,10,0,0">
                                    <TextBlock Text="WAIVER SERVICES" Style="{StaticResource LabelStyle}" />
                                    <CheckBox Content="Home support" IsChecked="{Binding HasHomeSupport}" />
                                    <CheckBox Content="Self-directed home support" IsChecked="{Binding HasSelfDirectedHomeSupport}" />
                                    <CheckBox Content="Shared living" IsChecked="{Binding HasSharedLiving}" />
                                    <CheckBox Content="Community support 1:1" IsChecked="{Binding HasCommunitySupport1To1}" />
                                    <CheckBox Content="Community support self-directed" IsChecked="{Binding HasCommunitySupportSelfDirected}" />
                                    <CheckBox Content="Day program" IsChecked="{Binding HasCommunitySupportDayProgram}" />
                                    <StackPanel Orientation="Horizontal" Margin="20,0,0,0"
                                                Visibility="{Binding HasCommunitySupportDayProgram, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="Programs" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBox Text="{Binding DayProgramCount, UpdateSourceTrigger=LostFocus}" Width="42" AutomationProperties.Name="Day program count" />
                                    </StackPanel>
                                </StackPanel>

                                <Grid Grid.Row="4" Grid.ColumnSpan="4" Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="0.8*" />
                                        <ColumnDefinition Width="0.7*" />
                                        <ColumnDefinition Width="1.5*" />
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="0.45*" />
                                        <ColumnDefinition Width="0.75*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="MAINECARE ID" Style="{StaticResource LabelStyle}" />
                                        <TextBox Text="{Binding MaineCareId, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="MaineCare member ID" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                        <TextBlock Text="DIAGNOSIS" Style="{StaticResource LabelStyle}" />
                                        <TextBox Text="{Binding DiagnosisCode, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="Billing diagnosis code" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                        <TextBlock Text="PLACE" Style="{StaticResource LabelStyle}" />
                                        <TextBox Text="{Binding PlaceOfService, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="Two digit place of service" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Margin="0,0,10,0">
                                        <TextBlock Text="CLAIM STREET" Style="{StaticResource LabelStyle}" />
                                        <TextBox Text="{Binding BillingStreet, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="Subscriber claim street" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4" Margin="0,0,10,0">
                                        <TextBlock Text="CITY" Style="{StaticResource LabelStyle}" />
                                        <TextBox Text="{Binding BillingCity, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="Subscriber claim city" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="5" Margin="0,0,10,0">
                                        <TextBlock Text="STATE" Style="{StaticResource LabelStyle}" />
                                        <TextBox Text="{Binding BillingState, UpdateSourceTrigger=PropertyChanged}" MaxLength="2"
                                                 AutomationProperties.Name="Subscriber claim state" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="6">
                                        <TextBlock Text="ZIP" Style="{StaticResource LabelStyle}" />
                                        <TextBox Text="{Binding BillingZip, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="Subscriber claim ZIP code" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </ScrollViewer>
                    </Border>

                    <!-- Live support-network profile. Notes snapshot selected
                         attendees, so edits here never rewrite historical visits. -->
                    <Border Grid.Row="2"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="12"
                            AutomationProperties.Name="Consumer contacts and support team">
                        <Expander IsExpanded="True">
                            <Expander.Header>
                                <DockPanel LastChildFill="True">
                                    <Button DockPanel.Dock="Right"
                                            Content="Add Contact"
                                            Command="{Binding BeginAddContactCommand}"
                                            Style="{StaticResource PrimaryButton}"
                                            Padding="14,5"
                                            Margin="12,0,0,0"
                                            AutomationProperties.Name="Add a consumer contact" />
                                    <StackPanel>
                                        <TextBlock Text="CONTACTS &amp; SUPPORT TEAM"
                                                   Style="{StaticResource SectionHeader}"
                                                   Margin="0" />
                                        <TextBlock Text="People recorded here can be selected as attendees when documenting a visit."
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </DockPanel>
                            </Expander.Header>

                            <StackPanel Margin="0,10,0,0">
                                <ScrollViewer MaxHeight="150"
                                              VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Contacts}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,6"
                                                        Padding="9,7"
                                                        Background="{DynamicResource PersonGroupAltBrush}"
                                                        BorderBrush="{DynamicResource DividerBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="5">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="2*" />
                                                            <ColumnDefinition Width="2*" />
                                                            <ColumnDefinition Width="2*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                            <TextBlock Text="{Binding FullName}"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                                            <TextBlock Text="{Binding Kind, Converter={StaticResource EnumDescriptionConverter}}"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                                            <TextBlock Text="{Binding Relationship, TargetNullValue=Relationship not specified}"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Organization}"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Margin="0,0,12,0">
                                                            <TextBlock Text="{Binding Phone}"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                                            <TextBlock Text="{Binding Email}"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <Button Grid.Column="3"
                                                                Content="Edit"
                                                                Padding="12,4"
                                                                VerticalAlignment="Center"
                                                                Command="{Binding DataContext.BeginEditContactCommand,
                                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                AutomationProperties.Name="Edit this contact" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <Border Margin="0,4,0,0"
                                        Padding="10"
                                        Background="{DynamicResource SurfaceAltBrush}"
                                        BorderBrush="{DynamicResource AccentBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Visibility="{Binding IsContactEditorOpen,
                                            Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0" Grid.ColumnSpan="3"
                                                   Text="{Binding ContactEditorHeader}"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center" />
                                        <StackPanel Grid.Row="0" Grid.Column="4" Grid.ColumnSpan="3"
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Right">
                                            <Button Content="Cancel"
                                                    Command="{Binding CancelContactEditCommand}"
                                                    Padding="12,4"
                                                    Margin="0,0,8,0" />
                                            <Button Content="{Binding ContactSaveButtonLabel}"
                                                    Command="{Binding SaveContactCommand}"
                                                    Style="{StaticResource PrimaryButton}"
                                                    Padding="14,4" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,8,0,0">
                                            <TextBlock Text="FIRST NAME" Style="{StaticResource LabelStyle}" />
                                            <TextBox Text="{Binding ContactFirstName, UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.Name="Contact first name" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,8,0,0">
                                            <TextBlock Text="LAST NAME" Style="{StaticResource LabelStyle}" />
                                            <TextBox Text="{Binding ContactLastName, UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.Name="Contact last name" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="4" Margin="0,8,0,0">
                                            <TextBlock Text="CONTACT TYPE" Style="{StaticResource LabelStyle}" />
                                            <ComboBox ItemsSource="{Binding ContactKinds}"
                                                      SelectedItem="{Binding ContactKind}"
                                                      AutomationProperties.Name="Contact type">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="6" Margin="0,8,0,0">
                                            <TextBlock Text="RELATIONSHIP / ROLE" Style="{StaticResource LabelStyle}" />
                                            <TextBox Text="{Binding ContactRelationship, UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.Name="Contact relationship or role" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,8,0,0">
                                            <TextBlock Text="ORGANIZATION" Style="{StaticResource LabelStyle}" />
                                            <TextBox Text="{Binding ContactOrganization, UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.Name="Contact organization" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,8,0,0">
                                            <TextBlock Text="PHONE" Style="{StaticResource LabelStyle}" />
                                            <TextBox Text="{Binding ContactPhone, UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.Name="Contact phone" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="4" Margin="0,8,0,0">
                                            <TextBlock Text="EMAIL" Style="{StaticResource LabelStyle}" />
                                            <TextBox Text="{Binding ContactEmail, UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.Name="Contact email" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="6" Margin="0,8,0,0">
                                            <CheckBox Content="Emergency contact"
                                                      IsChecked="{Binding ContactIsEmergencyContact}" />
                                            <CheckBox Content="Active information release"
                                                      IsChecked="{Binding ContactHasActiveRelease}" />
                                        </StackPanel>
                                        <TextBlock Grid.Row="3" Grid.ColumnSpan="7"
                                                   Margin="0,7,0,0"
                                                   Text="{Binding ContactStatusMessage}"
                                                   Foreground="{DynamicResource DangerStrongBrush}"
                                                   AutomationProperties.LiveSetting="Polite" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Expander>
                    </Border>

                    <!-- FORMS COMPLIANCE -->
                    <Grid Grid.Row="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0"
                                    Orientation="Horizontal"
                                    Margin="0,0,0,8">
                            <TextBlock Text="FORMS"
                                       Style="{StaticResource SectionHeader}"
                                       Margin="0,0,12,0"
                                       VerticalAlignment="Center" />
                        <Button Style="{StaticResource IconButton}"
                                AutomationProperties.Name="Toggle compliance editing"
                                    Command="{Binding ToggleComplianceOverrideCommand}"
                                    ToolTip="Toggle compliance editing">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           FontSize="14"
                                           Foreground="{DynamicResource TextSecondaryBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text"
                                                    Value="&#xE72E;" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AllowComplianceOverride}"
                                                             Value="True">
                                                    <Setter Property="Text"
                                                            Value="&#xE785;" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                        </StackPanel>

                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           Text="90-Day Reviews"
                                           Style="{StaticResource SectionHeader}" />
                                <StackPanel Grid.Row="1"
                                            Grid.Column="0">
                                    <CheckBox Content="Quarter 1"
                                              IsChecked="{Binding Q1RCompliant, Mode=OneWay}"
                                              IsEnabled="{Binding AllowComplianceOverride}"
                                              Command="{Binding ToggleFormCommand}"
                                              CommandParameter="{x:Static local:FormType.Q1R}" />
                                    <TextBlock Text="{Binding Q1RDueDate, StringFormat={}{0:MM/dd/yy}}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="11"
                                               Margin="20,1,0,4" />
                                </StackPanel>
                                <StackPanel Grid.Row="2"
                                            Grid.Column="0">
                                    <CheckBox Content="Quarter 2"
                                              IsChecked="{Binding Q2RCompliant, Mode=OneWay}"
                                              IsEnabled="{Binding AllowComplianceOverride}"
                                              Command="{Binding ToggleFormCommand}"
                                              CommandParameter="{x:Static local:FormType.Q2R}" />
                                    <TextBlock Text="{Binding Q2RDueDate, StringFormat={}{0:MM/dd/yy}}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="11"
                                               Margin="20,1,0,4" />
                                </StackPanel>
                                <StackPanel Grid.Row="3"
                                            Grid.Column="0">
                                    <CheckBox Content="Quarter 3"
                                              IsChecked="{Binding Q3RCompliant, Mode=OneWay}"
                                              IsEnabled="{Binding AllowComplianceOverride}"
                                              Command="{Binding ToggleFormCommand}"
                                              CommandParameter="{x:Static local:FormType.Q3R}" />
                                    <TextBlock Text="{Binding Q3RDueDate, StringFormat={}{0:MM/dd/yy}}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="11"
                                               Margin="20,1,0,4" />
                                </StackPanel>
                                <StackPanel Grid.Row="4"
                                            Grid.Column="0">
                                    <CheckBox Content="Quarter 4"
                                              IsChecked="{Binding Q4RCompliant, Mode=OneWay}"
                                              IsEnabled="{Binding AllowComplianceOverride}"
                                              Command="{Binding ToggleFormCommand}"
                                              CommandParameter="{x:Static local:FormType.Q4R}" />
                                    <TextBlock Text="{Binding Q4RDueDate, StringFormat={}{0:MM/dd/yy}}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="11"
                                               Margin="20,1,0,4" />
                                </StackPanel>

                                <TextBlock Grid.Row="0"
                                           Grid.Column="2"
                                           Text="Annual Forms"
                                           Style="{StaticResource SectionHeader}" />
                                <StackPanel Grid.Row="1"
                                            Grid.Column="2">
                                    <CheckBox Content="PCP"
                                              IsChecked="{Binding PcpCompliant, Mode=OneWay}"
                                              IsEnabled="{Binding AllowComplianceOverride}"
                                              Command="{Binding ToggleFormCommand}"
                                              CommandParameter="{x:Static local:FormType.PCP}" />
                                    <TextBlock Text="{Binding PcpDueDate, StringFormat={}{0:MM/dd/yy}}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="11"
                                               Margin="20,1,0,4" />
                                </StackPanel>
                                <StackPanel Grid.Row="2"
                                            Grid.Column="2">
                                    <CheckBox Content="Comp Assessment"
                                              IsChecked="{Binding CompAssessmentCompliant, Mode=OneWay}"
                                              IsEnabled="{Binding AllowComplianceOverride}"
                                              Command="{Binding ToggleFormCommand}"
                                              CommandParameter="{x:Static local:FormType.ComprehensiveAssessment}" />
                                    <TextBlock Text="{Binding CompAssessmentDueDate, StringFormat={}{0:MM/dd/yy}}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="11"
                                               Margin="20,1,0,4" />
                                </StackPanel>
                                <StackPanel Grid.Row="3"
                                            Grid.Column="2">
                                    <CheckBox Content="Reclassification"
                                              IsChecked="{Binding ReclassificationCompliant, Mode=OneWay}"
                                              IsEnabled="{Binding AllowComplianceOverride}"
                                              Command="{Binding ToggleFormCommand}"
                                              CommandParameter="{x:Static local:FormType.Reclassification}" />
                                    <TextBlock Text="{Binding ReclassificationDueDate, StringFormat={}{0:MM/dd/yy}}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="11"
                                               Margin="20,1,0,4" />
                                </StackPanel>
                                <StackPanel Grid.Row="4"
                                            Grid.Column="2">
                                    <CheckBox Content="Safety Plan"
                                              IsChecked="{Binding SafetyPlanCompliant, Mode=OneWay}"
                                              IsEnabled="{Binding AllowComplianceOverride}"
                                              Command="{Binding ToggleFormCommand}"
                                              CommandParameter="{x:Static local:FormType.SafetyPlan}" />
                                    <TextBlock Text="{Binding SafetyPlanDueDate, StringFormat={}{0:MM/dd/yy}}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="11"
                                               Margin="20,1,0,4" />
                                </StackPanel>
                                <StackPanel Grid.Row="5"
                                            Grid.Column="2">
                                    <CheckBox Content="Privacy Practices"
                                              IsChecked="{Binding PrivacyPracticesCompliant, Mode=OneWay}"
                                              IsEnabled="{Binding AllowComplianceOverride}"
                                              Command="{Binding ToggleFormCommand}"
                                              CommandParameter="{x:Static local:FormType.PrivacyPractices}" />
                                    <TextBlock Text="{Binding PrivacyPracticesDueDate, StringFormat={}{0:MM/dd/yy}}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="11"
                                               Margin="20,1,0,4" />
                                </StackPanel>

                                <TextBlock Grid.Row="0"
                                           Grid.Column="4"
                                           Text="Releases"
                                           Style="{StaticResource SectionHeader}" />
                                <StackPanel Grid.Row="1"
                                            Grid.Column="4">
                                    <CheckBox Content="DHHS"
                                              IsChecked="{Binding ReleaseDhhsCompliant, Mode=OneWay}"
                                              IsEnabled="{Binding AllowComplianceOverride}"
                                              Command="{Binding ToggleFormCommand}"
                                              CommandParameter="{x:Static local:FormType.Release_DHHS}" />
                                    <TextBlock Text="{Binding ReleaseDhhsDueDate, StringFormat={}{0:MM/dd/yy}}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="11"
                                               Margin="20,1,0,4" />
                                </StackPanel>
                                <StackPanel Grid.Row="2"
                                            Grid.Column="4">
                                    <CheckBox Content="Agency"
                                              IsChecked="{Binding ReleaseAgencyCompliant, Mode=OneWay}"
                                              IsEnabled="{Binding AllowComplianceOverride}"
                                              Command="{Binding ToggleFormCommand}"
                                              CommandParameter="{x:Static local:FormType.Release_Agency}" />
                                    <TextBlock Text="{Binding ReleaseAgencyDueDate, StringFormat={}{0:MM/dd/yy}}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="11"
                                               Margin="20,1,0,4" />
                                </StackPanel>
                                <StackPanel Grid.Row="3"
                                            Grid.Column="4">
                                    <CheckBox Content="Medical"
                                              IsChecked="{Binding ReleaseMedicalCompliant, Mode=OneWay}"
                                              IsEnabled="{Binding AllowComplianceOverride}"
                                              Command="{Binding ToggleFormCommand}"
                                              CommandParameter="{x:Static local:FormType.Release_Medical}" />
                                    <TextBlock Text="{Binding ReleaseMedicalDueDate, StringFormat={}{0:MM/dd/yy}}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="11"
                                               Margin="20,1,0,4" />
                                </StackPanel>

                                <!-- Appointments: latest doctor/dentist for the
                                     selected client. Date uses OverdueBrush when >365 days
                                     stale (per category); dash when none on record.
                                     Read on selection, not from the caseload load. -->
                                <TextBlock Grid.Row="0"
                                           Grid.Column="6"
                                           Text="Appointments"
                                           Style="{StaticResource SectionHeader}" />
                                <StackPanel Grid.Row="1"
                                            Grid.Column="6">
                                    <TextBlock Text="Doctor"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontSize="13" />
                                    <TextBlock Text="{Binding LastDoctorDate, StringFormat={}{0:MM/dd/yy}, TargetNullValue=—}"
                                               FontSize="11"
                                               Margin="20,1,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDoctorOverdue}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource OverdueBrush}" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding DoctorName}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Margin="20,0,0,4" />
                                </StackPanel>
                                <StackPanel Grid.Row="2"
                                            Grid.Column="6">
                                    <TextBlock Text="Dentist"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontSize="13" />
                                    <TextBlock Text="{Binding LastDentistDate, StringFormat={}{0:MM/dd/yy}, TargetNullValue=—}"
                                               FontSize="11"
                                               Margin="20,1,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDentistOverdue}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource OverdueBrush}" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding DentistName}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Margin="20,0,0,4" />
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </Grid>

                    <!-- NOTES HISTORY + JOURNAL — split the bottom-right cell so the
                         per-consumer journal sits beside the read-only notes list. The
                         3*/2* split gives notes the larger share; both scale with the
                         panel. Journal auto-saves 2s after typing stops (debounced in
                         the VM), plus on client-switch and shutdown — no Save button,
                         matching the app's auto-save-over-dialogs convention. -->
                    <Grid Grid.Row="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>

                        <!-- NOTES HISTORY -->
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="NOTES"
                                       Style="{StaticResource SectionHeader}" />

                            <DataGrid AutomationProperties.Name="Selected person notes" Grid.Row="1"
                                      ItemsSource="{Binding SelectedPersonNotes}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      RowBackground="{DynamicResource SurfaceBrush}"
                                      AlternatingRowBackground="{DynamicResource WindowBackgroundBrush}"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="{DynamicResource DividerBrush}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Date"
                                                        Binding="{Binding EventDate, StringFormat={}{0:MM/dd}}"
                                                        Width="60" />
                                    <DataGridTextColumn Header="Status"
                                                        Binding="{Binding Status}"
                                                        Width="80" />
                                    <DataGridTextColumn Header="Narrative"
                                                        Binding="{Binding Narrative}"
                                                        Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>

                        <!-- JOURNAL -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="JOURNAL"
                                       Style="{StaticResource SectionHeader}" />

                            <!-- Pattern layer sits UNDER the TextBox in the same cell:
                                 the dot brush fills a Border, the TextBox draws over it
                                 with the theme's translucent SurfaceAlpha70Brush so the
                                 dots read faintly through the fill without dimming text.
                                 The Border carries the visible frame now, so the TextBox
                                 drops its own border to avoid a double edge. -->
                            <Border Grid.Row="1"
                                    Background="{StaticResource JournalDotBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="2" />

                            <!-- UpdateSourceTrigger=PropertyChanged so the debounce
                                 timer sees each keystroke; without it the VM's Journal
                                 wouldn't update until focus loss and the 2s save
                                 wouldn't fire mid-typing. Indefinitely long: wraps and
                                 scrolls vertically, no height cap of its own — the row's
                                 * share bounds it and the ScrollViewer takes overflow. -->
                            <TextBox AutomationProperties.Name="Journal" Grid.Row="1"
                                     Text="{Binding Journal, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     SpellCheck.IsEnabled="True"
                                     FontFamily="{StaticResource NarrativeFont}"
                                     Background="{DynamicResource SurfaceAlpha25Brush}"
                                     BorderThickness="0"
                                     Padding="8" />
                        </Grid>
                    </Grid>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Comprehensive Assessment"
                                 Style="{StaticResource ClientWorkspaceTabItemStyle}">
                            <clientDocuments:ComprehensiveAssessmentWorkspace />
                        </TabItem>

                        <TabItem Header="Person-Centered Plan"
                                 Style="{StaticResource ClientWorkspaceTabItemStyle}">
                            <clientDocuments:PersonCenteredPlanWorkspace />
                        </TabItem>

                        <TabItem Header="Classification"
                                 Style="{StaticResource ClientWorkspaceTabItemStyle}">
                            <clientDocuments:ClassificationWorkspace />
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
