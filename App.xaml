            <!-- ============================================================ -->
            <!-- NAVIGATION TABS                                              -->
            <!--                                                              -->
            <!-- THE one owner of what a navigation tab looks like, for the    -->
            <!-- shell's top bar and for the sub-navigation inside a section.  -->
            <!-- Selection state arrives through views:NavTab.IsActive, so a   -->
            <!-- tab binds its own view model property and this style decides  -->
            <!-- how selection is rendered. Change it here, once.              -->
            <!--                                                              -->
            <!-- Selection is shown with FOREGROUND COLOUR AND FONT WEIGHT,    -->
            <!-- never a filled background. Two reasons: a filled block forces -->
            <!-- the label to invert to the window background colour, which is -->
            <!-- where the dark-on-dark legibility bugs kept coming from; and  -->
            <!-- weight is a non-colour cue, so selection survives for a user  -->
            <!-- who cannot distinguish the accent hue. Hover and keyboard     -->
            <!-- focus still use background and border, because those are      -->
            <!-- transient states rather than status.                          -->
            <!-- ============================================================ -->
            <Style x:Key="NavTabButton"
                   TargetType="Button">
                <Setter Property="Foreground"
                        Value="{DynamicResource TextSecondaryBrush}" />
                <Setter Property="Background"
                        Value="Transparent" />
                <Setter Property="FontSize"
                        Value="13" />
                <Setter Property="FontWeight"
                        Value="Normal" />
                <Setter Property="Padding"
                        Value="10,4" />
                <Setter Property="Margin"
                        Value="0,0,4,0" />
                <Setter Property="Cursor"
                        Value="Hand" />
                <Setter Property="HorizontalContentAlignment"
                        Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="TabSurface"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="Transparent"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <!-- Width reservation. Selecting a tab makes its
                                         label bold, and bold text is wider, so without
                                         this every click would shove the rest of the
                                         navigation bar sideways. This hidden copy is
                                         always bold, so the tab is always as wide as
                                         its widest state. Assumes string content,
                                         which every navigation tab uses. -->
                                    <TextBlock Text="{TemplateBinding Content}"
                                               FontWeight="SemiBold"
                                               Visibility="Hidden"
                                               IsHitTestVisible="False" />
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver"
                                         Value="True">
                                    <Setter TargetName="TabSurface"
                                            Property="Background"
                                            Value="{DynamicResource HoverBrush}" />
                                </Trigger>
                                <!-- Keyboard focus must be visible, not only hover. -->
                                <Trigger Property="IsKeyboardFocused"
                                         Value="True">
                                    <Setter TargetName="TabSurface"
                                            Property="BorderBrush"
                                            Value="{DynamicResource AccentBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="views:NavTab.IsActive"
                             Value="True">
                        <Setter Property="Foreground"
                                Value="{DynamicResource AccentBrush}" />
                        <Setter Property="FontWeight"
                                Value="SemiBold" />
                        <!-- Announced to screen readers, which cannot see either
                             the colour or the weight. -->
                        <Setter Property="AutomationProperties.ItemStatus"
                                Value="Selected" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Converters -->
            <converters:PngBytesToImageConverter x:Key="PngBytesToImageConverter" />
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
