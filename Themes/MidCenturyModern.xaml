<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- MID-CENTURY MODERN: warm paper, atomic geometry, teal, ochre, and coral. -->
    <DrawingBrush x:Key="NavigableContentPatternSourceBrush" TileMode="Tile"
                  Viewport="0,0,132,96" ViewportUnits="Absolute"
                  Viewbox="0,0,132,96" ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#F3E8D3" Geometry="M 0,0 L 132,0 132,96 0,96 Z" />
                <GeometryDrawing Brush="#22608B87">
                    <GeometryDrawing.Geometry><EllipseGeometry Center="25,24" RadiusX="18" RadiusY="18" /></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#24D29B3D" Geometry="M 67,2 L 91,2 79,31 Z" />
                <GeometryDrawing Brush="#22B85E4D" Geometry="M 102,50 C 122,50 132,65 132,82 L 102,82 Z" />
                <GeometryDrawing Geometry="M 5,78 C 22,58 42,58 59,78 M 50,18 L 60,18 M 55,13 L 55,23">
                    <GeometryDrawing.Pen><Pen Brush="#3283564A" Thickness="2" /></GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Brush="#3083564A">
                    <GeometryDrawing.Geometry><EllipseGeometry Center="79,65" RadiusX="3" RadiusY="3" /></GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <VisualBrush x:Key="WindowBackgroundBrush" TileMode="Tile"
                 Viewport="0,0,132,96" ViewportUnits="Absolute"
                 Viewbox="0,0,132,96" ViewboxUnits="Absolute">
        <VisualBrush.Visual>
            <Border Width="132" Height="96"
                    Background="{StaticResource NavigableContentPatternSourceBrush}">
                <Border.Effect>
                    <BlurEffect Radius="2.5" RenderingBias="Performance" />
                </Border.Effect>
            </Border>
        </VisualBrush.Visual>
    </VisualBrush>
    <DrawingBrush x:Key="NavBackgroundBrush" TileMode="Tile"
                  Viewport="0,0,88,64" ViewportUnits="Absolute"
                  Viewbox="0,0,88,64" ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#E9DCC5" Geometry="M 0,0 L 88,0 88,64 0,64 Z" />
                <GeometryDrawing Brush="#28608B87">
                    <GeometryDrawing.Geometry><EllipseGeometry Center="18,18" RadiusX="12" RadiusY="12" /></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#28D29B3D" Geometry="M 52,7 L 76,7 64,34 Z" />
                <GeometryDrawing Geometry="M 6,51 L 82,51"><GeometryDrawing.Pen><Pen Brush="#3083564A" Thickness="2" /></GeometryDrawing.Pen></GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
