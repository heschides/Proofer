<UserControl x:Class="Sati.Views.CaseloadImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource WindowBackgroundBrush}"
             TextElement.FontFamily="{StaticResource AppFont}">

    <UserControl.Resources>
        <!-- Disposition is carried by its own text as well as colour, and repeated in each
             row's automation description. -->
        <Style x:Key="DispositionText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Disposition}" Value="Refused">
                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Disposition}" Value="Incomplete">
                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RowOutcome" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Failed}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource DangerStrongBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Import a caseload from Credible"
                       FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="Choose a folder of Credible print views saved as web pages. Sati reads them here on this machine — nothing is uploaded. You will see what it found before anything is created." />
        </StackPanel>

        <Border Grid.Row="1"
                Background="{DynamicResource SurfaceMutedBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <Button Content="Choose folder…"
                        Command="{Binding ChooseFolderCommand}"
                        AutomationProperties.Name="Choose a folder of saved Credible exports"
                        Padding="12,4" Margin="0,0,12,0" />
                <Button Content="Import the ready consumers"
                        Command="{Binding CommitCommand}"
                        AutomationProperties.Name="Create the consumers that are ready to import"
                        Style="{StaticResource PrimaryButton}"
                        Padding="14,4" Margin="0,0,12,0" />
                <TextBlock Text="{Binding ProgressMessage}"
                           VerticalAlignment="Center" FontSize="11"
                           AutomationProperties.LiveSetting="Polite"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="6">
            <ListBox ItemsSource="{Binding Rows}"
                     BorderThickness="0" Background="Transparent"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     AutomationProperties.Name="Files found in the folder">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="Padding" Value="0" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="12,8"
                                    AutomationProperties.Name="{Binding AutomationDescription, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding FileName}" FontSize="12"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding DispositionText}"
                                           Style="{StaticResource DispositionText}"
                                           Margin="8,2,0,0" />
                            </StackPanel>
                            <TextBlock Text="{Binding Detail}" FontSize="10" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding Outcome}"
                                       Style="{StaticResource RowOutcome}"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding HasOutcome, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}"
                   Margin="0,12,0,0" FontSize="12" TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite"
                   Foreground="{DynamicResource TextSecondaryBrush}" />
    </Grid>
</UserControl>
