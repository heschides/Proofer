<Window x:Class="Sati.Views.NewUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Sati.Views"
        mc:Ignorable="d"
        Title="Create Account"
        Height="760"
        Width="360"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Window.Resources>
        <Style x:Key="LabelStyle"
               TargetType="TextBlock">
            <Setter Property="FontSize"
                    Value="11" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="Foreground"
                    Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Margin"
                    Value="0,0,0,5" />
        </Style>

        <Style x:Key="InputStyle"
               TargetType="Control">
            <Setter Property="Height"
                    Value="36" />
            <Setter Property="Padding"
                    Value="10,0" />
            <Setter Property="FontSize"
                    Value="14" />
            <Setter Property="Background"
                    Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource HoverStrongBrush}" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="Foreground"
                    Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Margin"
                    Value="0,0,0,16" />
        </Style>

        <Style x:Key="PrimaryButton"
               TargetType="Button">
            <Setter Property="Height"
                    Value="40" />
            <Setter Property="Background"
                    Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground"
                    Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="FontSize"
                    Value="14" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="BorderThickness"
                    Value="0" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter Property="Background"
                                        Value="{DynamicResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter Property="Background"
                                        Value="{DynamicResource AccentPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Padding="40">
        <StackPanel VerticalAlignment="Center">

            <TextBlock Text="Create User"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,4" />
            <TextBlock Text="Sati Case Management"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,32" />

            <TextBlock Text="USERNAME"
                       Style="{StaticResource LabelStyle}" />
            <TextBox AutomationProperties.Name="Username" Style="{StaticResource InputStyle}"
                     Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center" />

            <TextBlock Text="DISPLAY NAME"
                       Style="{StaticResource LabelStyle}" />
            <TextBox AutomationProperties.Name="Display Name" Style="{StaticResource InputStyle}"
                     Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center" />

            <TextBlock Text="PASSWORD"
                       Style="{StaticResource LabelStyle}" />
            <PasswordBox AutomationProperties.Name="Password" x:Name="PasswordInit"
                         Style="{StaticResource InputStyle}"
                         PasswordChanged="PasswordInit_PasswordChanged"
                         VerticalContentAlignment="Center" />

            <TextBlock Text="CONFIRM PASSWORD"
                       Style="{StaticResource LabelStyle}" />
            <PasswordBox AutomationProperties.Name="Confirm password" x:Name="PasswordConfirm"
                         Style="{StaticResource InputStyle}"
                         PasswordChanged="PasswordConfirm_PasswordChanged"
                         VerticalContentAlignment="Center" />

            <TextBlock Text="SUPERVISOR"
                       Style="{StaticResource LabelStyle}" />
            <ComboBox AutomationProperties.Name="Supervisor" Style="{StaticResource InputStyle}"
                      IsEnabled="{Binding CanAssignExpandedPermissions}"
                      ItemsSource="{Binding Supervisors}"
                      SelectedItem="{Binding SelectedSupervisor}"
                      DisplayMemberPath="DisplayName"
                      VerticalContentAlignment="Center" />

            <TextBlock Text="PERMISSIONS"
                       Style="{StaticResource LabelStyle}" />
            <WrapPanel Margin="0,0,0,16"
                       IsEnabled="{Binding CanAssignExpandedPermissions}">
                <CheckBox Content="Case management"
                          AutomationProperties.Name="Case management permission"
                          IsChecked="{Binding HasCaseManagerPermissions}"
                          Margin="0,0,12,6" />
                <CheckBox Content="Supervision"
                          AutomationProperties.Name="Supervision permission"
                          IsChecked="{Binding HasSupervisorPermissions}"
                          Margin="0,0,12,6" />
                <CheckBox Content="Agency-wide supervision"
                          AutomationProperties.Name="Agency-wide supervision permission"
                          AutomationProperties.HelpText="Review every case manager in the agency, not only assigned ones. Does not grant administration."
                          IsChecked="{Binding HasAgencyWideSupervision}"
                          Margin="0,0,12,6" />
                <CheckBox Content="Administration"
                          AutomationProperties.Name="Administration permission"
                          IsChecked="{Binding HasAdminPermissions}"
                          Margin="0,0,12,6" />
                <CheckBox Content="Billing"
                          AutomationProperties.Name="Billing permission"
                          IsChecked="{Binding HasBillingPermissions}"
                          Margin="0,0,12,6" />
            </WrapPanel>

            <Button Content="Create Account"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding CreateUserCommand}" />

        </StackPanel>
    </Border>
</Window>
