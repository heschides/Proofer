<UserControl x:Class="Sati.Views.ClientDocuments.DhhsFormsWorkspace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource WindowBackgroundBrush}"
             DataContextChanged="OnDataContextChanged">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="16"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{DynamicResource BorderBrush}"
                Background="{DynamicResource SurfaceBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="3*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="OFFICIAL MAINE DHHS FORM"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccentPressedBrush}" />
                    <TextBlock Text="{Binding PersonName}"
                               Margin="0,4,0,10"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock Text="Form"
                               Style="{StaticResource LabelStyle}" />
                    <ComboBox ItemsSource="{Binding FormChoices}"
                              SelectedItem="{Binding SelectedFormChoice}"
                              DisplayMemberPath="DisplayName"
                              MinWidth="320"
                              HorizontalAlignment="Stretch"
                              AutomationProperties.Name="DHHS form to prepare" />
                    <TextBlock Text="{Binding FormDescription}"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>

                <Border Grid.Column="2"
                        Padding="12"
                        CornerRadius="6"
                        Background="{DynamicResource WarningSoftBrush}"
                        BorderBrush="{DynamicResource WarningBrush}"
                        BorderThickness="1"
                        AutomationProperties.Name="Consent safeguard">
                    <StackPanel>
                        <TextBlock Text="CONSUMER DIRECTION REQUIRED"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Margin="0,5,0,0"
                                   Text="Select only choices the consumer explicitly instructed you to record. Sati does not infer consent from the profile. Signatures, signing dates, and signer authority remain blank on the official PDF."
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      AutomationProperties.Name="DHHS form choices">
            <StackPanel>
                <Border Padding="14"
                        Margin="0,0,0,12"
                        CornerRadius="7"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        Background="{DynamicResource PersonGroupAltBrush}"
                        Visibility="{Binding ShowSsnPanel, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="SOCIAL SECURITY NUMBER"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Margin="0,4,0,0"
                                       Text="{Binding SsnMasked}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       AutomationProperties.Name="Masked Social Security number status" />
                            <TextBlock Margin="0,3,0,0"
                                       Text="{Binding SsnStorageExplanation}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Margin="0,5,0,0"
                                       Text="{Binding SsnStatusMessage}"
                                       TextWrapping="Wrap"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    MinWidth="250"
                                    IsEnabled="{Binding CanUpdateSsn}">
                            <TextBlock Text="Enter a replacement SSN"
                                       Style="{StaticResource LabelStyle}" />
                            <PasswordBox x:Name="SsnPasswordBox"
                                         MaxLength="11"
                                         PasswordChar="●"
                                         Padding="8,6"
                                         AutomationProperties.Name="New Social Security number"
                                         AutomationProperties.HelpText="Enter nine digits. The value is sent for encryption and is never displayed again." />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="Encrypt and save"
                                        Click="SaveSsn_Click"
                                        Padding="12,6"
                                        AutomationProperties.Name="Encrypt and save Social Security number" />
                                <Button Content="Remove"
                                        Click="ClearSsn_Click"
                                        Margin="8,0,0,0"
                                        Padding="12,6"
                                        Background="{DynamicResource SurfaceBrush}"
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        AutomationProperties.Name="Remove encrypted Social Security number" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <ItemsControl ItemsSource="{Binding ActiveConsentGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,12"
                                    Padding="14"
                                    CornerRadius="7"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    Background="{DynamicResource SurfaceBrush}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               AutomationProperties.HeadingLevel="Level3" />
                                    <TextBlock Text="{Binding Description}"
                                               Margin="0,3,0,10"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />

                                    <ItemsControl ItemsSource="{Binding Checks}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding Label}"
                                                          IsChecked="{Binding IsSelected}"
                                                          Margin="0,3"
                                                          Padding="2"
                                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                                          AutomationProperties.Name="{Binding Label}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <ItemsControl ItemsSource="{Binding Text}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,8,0,0">
                                                    <TextBlock Text="{Binding Label}"
                                                               Style="{StaticResource LabelStyle}" />
                                                    <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                             Padding="8,6"
                                                             MinWidth="280"
                                                             HorizontalAlignment="Stretch"
                                                             AutomationProperties.Name="{Binding Label}"
                                                             AutomationProperties.HelpText="{Binding Hint}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="4"
                Padding="12"
                CornerRadius="7"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusMessage}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontWeight="SemiBold"
                               AutomationProperties.LiveSetting="Polite" />
                    <TextBlock Text="{Binding BlankFieldsMessage}"
                               Margin="0,3,12,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource WarningBrush}"
                               AutomationProperties.LiveSetting="Polite" />
                    <ProgressBar Height="3"
                                 Margin="0,8,12,0"
                                 IsIndeterminate="True"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                                 AutomationProperties.Name="Preparing DHHS form" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Clear choices"
                            Command="{Binding ClearSelectionsCommand}"
                            Padding="13,7"
                            Margin="0,0,8,0"
                            Background="{DynamicResource SurfaceBrush}"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" />
                    <Button Content="Generate official PDF"
                            Command="{Binding GenerateCommand}"
                            IsEnabled="{Binding CanGenerate}"
                            Padding="16,7"
                            FontWeight="SemiBold"
                            AutomationProperties.Name="Generate and save official DHHS PDF" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
