<Window x:Class="Sati.Views.DisplayAdjustmentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Display adjusted"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="1"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        AutomationProperties.Name="Compact display mode notice">

    <StackPanel Margin="24">
        <TextBlock Text="COMPACT DISPLAY MODE"
                   FontSize="11"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Margin="0,0,0,8"
                   AutomationProperties.HeadingLevel="Level1" />
        <TextBlock Text="{Binding Notice}"
                   FontSize="13"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   TextWrapping="Wrap"
                   LineHeight="21"
                   Margin="0,0,0,20" />
        <Button Content="Continue"
                AutomationProperties.Name="Continue with compact display mode"
                HorizontalAlignment="Right"
                Padding="20,6"
                FontSize="13"
                Background="{DynamicResource AccentBrush}"
                Foreground="{DynamicResource OnAccentBrush}"
                BorderThickness="0"
                Cursor="Hand"
                IsDefault="True"
                Click="ContinueButton_Click" />
    </StackPanel>
</Window>
