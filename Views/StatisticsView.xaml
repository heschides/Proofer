<UserControl x:Class="Sati.Views.StatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:oxy="http://oxyplot.org/wpf"
             Background="#FDF6EC">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,32">

            <!-- ── Header ── -->
            <TextBlock Text="PRODUCTIVITY HISTORY"
                       FontFamily="Inter"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="#8A7A6A"
                       Margin="0,0,0,2" />
            <TextBlock Text="{Binding WindowLabel}"
                       FontFamily="Inter"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="#3D2B1F"
                       Margin="0,0,0,20" />

            <!-- ── Summary cards ── -->
            <UniformGrid Columns="2"
                         Margin="0,0,0,24">
                <Border Margin="0,0,6,0"
                        Background="White"
                        BorderBrush="#EDD9C0"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="{Binding TotalUnits}"
                                   FontFamily="Inter"
                                   FontSize="36"
                                   FontWeight="Bold"
                                   Foreground="#3D2B1F" />
                        <TextBlock Text="Units logged + approved (12 mo)"
                                   FontFamily="Inter"
                                   FontSize="11"
                                   Foreground="#8A7A6A"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
                <Border Margin="6,0,0,0"
                        Background="White"
                        BorderBrush="#EDD9C0"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="{Binding TotalIncentive, StringFormat=C0}"
                                   FontFamily="Inter"
                                   FontSize="36"
                                   FontWeight="Bold"
                                   Foreground="#5A8A5A" />
                        <TextBlock Text="Incentive earned (12 mo)"
                                   FontFamily="Inter"
                                   FontSize="11"
                                   Foreground="#8A7A6A"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- ── Empty state ── -->
            <Border Background="White"
                    BorderBrush="#EDD9C0"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="24"
                    Visibility="{Binding HasData,
                        Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <TextBlock Text="No productivity history yet. Logged and approved units appear here as months complete."
                           FontFamily="Inter"
                           FontSize="13"
                           Foreground="#8A7A6A"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center" />
            </Border>

            <!-- ── Chart + table (only when there's data) ── -->
            <StackPanel Visibility="{Binding HasData,
                            Converter={StaticResource BoolToVisibilityConverter}}">

                <TextBlock Text="UNITS BY MONTH"
                           FontFamily="Inter"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="#8A7A6A"
                           Margin="0,0,0,8" />
                <Border Background="White"
                        BorderBrush="#EDD9C0"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12"
                        Margin="0,0,0,28">
                    <oxy:PlotView Model="{Binding UnitsChartModel}"
                                  Height="320"
                                  Background="Transparent" />
                </Border>

                <TextBlock Text="MONTHLY DETAIL"
                           FontFamily="Inter"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="#8A7A6A"
                           Margin="0,0,0,8" />
                <DataGrid ItemsSource="{Binding Months}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserReorderColumns="False"
                          CanUserResizeRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          SelectionUnit="FullRow"
                          SelectionMode="Single"
                          Background="Transparent"
                          BorderThickness="0"
                          RowBackground="Transparent"
                          AlternatingRowBackground="#FAF0E4"
                          HorizontalGridLinesBrush="#EDD9C0">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background"
                                    Value="Transparent" />
                            <Setter Property="Foreground"
                                    Value="#8A7A6A" />
                            <Setter Property="FontFamily"
                                    Value="Inter" />
                            <Setter Property="FontSize"
                                    Value="11" />
                            <Setter Property="FontWeight"
                                    Value="SemiBold" />
                            <Setter Property="Padding"
                                    Value="8,8" />
                            <Setter Property="BorderThickness"
                                    Value="0,0,0,1" />
                            <Setter Property="BorderBrush"
                                    Value="#EDD9C0" />
                            <Setter Property="SeparatorVisibility"
                                    Value="Collapsed" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness"
                                    Value="0" />
                            <Setter Property="Padding"
                                    Value="8,6" />
                            <Setter Property="Foreground"
                                    Value="#3D2B1F" />
                            <Setter Property="FontFamily"
                                    Value="Inter" />
                            <Setter Property="Background"
                                    Value="Transparent" />
                            <Setter Property="FocusVisualStyle"
                                    Value="{x:Null}" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected"
                                         Value="True">
                                    <Setter Property="Background"
                                            Value="#EDD9C0" />
                                    <Setter Property="Foreground"
                                            Value="#3D2B1F" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="BorderThickness"
                                    Value="0" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected"
                                         Value="True">
                                    <Setter Property="Background"
                                            Value="#EDD9C0" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Month"
                                            Binding="{Binding MonthLabel}"
                                            Width="*" />
                        <DataGridTextColumn Header="Units"
                                            Binding="{Binding Units}"
                                            Width="90" />
                        <DataGridTextColumn Header="Threshold"
                                            Binding="{Binding Threshold, TargetNullValue=—}"
                                            Width="90" />
                        <DataGridTextColumn Header="Attainment"
                                            Binding="{Binding AttainmentPercent, StringFormat={}{0:0}%, TargetNullValue=—}"
                                            Width="110" />
                        <DataGridTextColumn Header="Incentive"
                                            Binding="{Binding Incentive, StringFormat=C0, TargetNullValue=—}"
                                            Width="110" />
                    </DataGrid.Columns>
                </DataGrid>

            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>