<UserControl x:Class="Sati.Views.NoteEntryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sati="clr-namespace:Sati"
             xmlns:services="clr-namespace:Sati.Services"
             TextElement.FontFamily="{StaticResource AppFont}"
             SizeChanged="NoteEntryView_SizeChanged">

    <!-- Escape returns the panel to a blank New Note, the same command the New
         Note button runs. Declared on the MODULE so both hosts inherit it while
         focus is anywhere in the form; each host repeats it at page level so the
         key also works from its grid. -->
    <UserControl.InputBindings>
        <KeyBinding Key="Escape"
                    Command="{Binding StartNewNoteCommand}" />
    </UserControl.InputBindings>

    <UserControl.Resources>
        <!-- Three staggered, gently pulsing pearls. The animations start only while
             the local assistant is busy and are removed as soon as it finishes. -->
        <Style x:Key="AiThinkingPearlBase"
               TargetType="Ellipse">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="Fill" Value="{DynamicResource AiAccentBrush}" />
            <Setter Property="Opacity" Value="0.3" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="0.72" ScaleY="0.72" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AiThinkingPearlOne"
               TargetType="Ellipse"
               BasedOn="{StaticResource AiThinkingPearlBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAiBusy}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="AiPearlPulseOne">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 BeginTime="0:0:0"
                                                 From="0.3" To="1"
                                                 Duration="0:0:0.55"
                                                 AutoReverse="True"
                                                 RepeatBehavior="Forever" />
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 BeginTime="0:0:0"
                                                 From="0.72" To="1.18"
                                                 Duration="0:0:0.55"
                                                 AutoReverse="True"
                                                 RepeatBehavior="Forever" />
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 BeginTime="0:0:0"
                                                 From="0.72" To="1.18"
                                                 Duration="0:0:0.55"
                                                 AutoReverse="True"
                                                 RepeatBehavior="Forever" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <RemoveStoryboard BeginStoryboardName="AiPearlPulseOne" />
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AiThinkingPearlTwo"
               TargetType="Ellipse"
               BasedOn="{StaticResource AiThinkingPearlBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAiBusy}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="AiPearlPulseTwo">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 BeginTime="0:0:0.18"
                                                 From="0.3" To="1"
                                                 Duration="0:0:0.55"
                                                 AutoReverse="True"
                                                 RepeatBehavior="Forever" />
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 BeginTime="0:0:0.18"
                                                 From="0.72" To="1.18"
                                                 Duration="0:0:0.55"
                                                 AutoReverse="True"
                                                 RepeatBehavior="Forever" />
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 BeginTime="0:0:0.18"
                                                 From="0.72" To="1.18"
                                                 Duration="0:0:0.55"
                                                 AutoReverse="True"
                                                 RepeatBehavior="Forever" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <RemoveStoryboard BeginStoryboardName="AiPearlPulseTwo" />
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AiThinkingPearlThree"
               TargetType="Ellipse"
               BasedOn="{StaticResource AiThinkingPearlBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAiBusy}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="AiPearlPulseThree">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 BeginTime="0:0:0.36"
                                                 From="0.3" To="1"
                                                 Duration="0:0:0.55"
                                                 AutoReverse="True"
                                                 RepeatBehavior="Forever" />
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 BeginTime="0:0:0.36"
                                                 From="0.72" To="1.18"
                                                 Duration="0:0:0.55"
                                                 AutoReverse="True"
                                                 RepeatBehavior="Forever" />
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 BeginTime="0:0:0.36"
                                                 From="0.72" To="1.18"
                                                 Duration="0:0:0.55"
                                                 AutoReverse="True"
                                                 RepeatBehavior="Forever" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <RemoveStoryboard BeginStoryboardName="AiPearlPulseThree" />
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!-- Root grid stacks the form and the compliance overlay. The overlay dims
         the MODULE only, not the hosting screen — deliberate, one definition. -->
    <Grid>

        <!-- ═══ NOTE ENTRY FORM ═══
             DockPanel, not Grid: the Submit button docks to the bottom and claims
             its space FIRST (LastChildFill=False + explicit DockPanel.Dock), so a
             long narrative can never push it out of the module's clip bounds. The
             field grid fills what's left, inside a ScrollViewer — fields scroll,
             Submit stays put. This is the fix for the clipped-button bug. -->
        <Border Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14">

            <!-- ═══ READ-ONLY MODE ═══
                 Scoped to the FORM subtree, so the compliance overlay below is
                 unaffected. Two different mechanisms, chosen deliberately:

                   TextBox  -> IsReadOnly. A locked note must still be fully
                               legible, selectable, scrollable and copyable, and
                               a disabled TextBox is none of those.
                   Pickers  -> IsEnabled=False. Nothing here should change the
                               saved record while the note is locked.

                 Controls that already bind IsEnabled locally (to
                 AreNoteFieldsEnabled) keep their local value, which folds the
                 lock in through that property instead — same outcome, one owner.

                 IsLocked is read off the UserControl's DataContext rather than
                 the local one: these styles also apply inside ItemsControls whose
                 items are attendee view models with no such property. -->
            <Border.Resources>
                <Style TargetType="TextBox"
                       BasedOn="{StaticResource {x:Type TextBox}}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding DataContext.IsLocked,
                                         RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     Value="True">
                            <Setter Property="IsReadOnly" Value="True" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
                <Style TargetType="ComboBox"
                       BasedOn="{StaticResource {x:Type ComboBox}}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding DataContext.IsLocked,
                                         RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
                <Style TargetType="RadioButton">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding DataContext.IsLocked,
                                         RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
                <Style TargetType="CheckBox">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding DataContext.IsLocked,
                                         RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Resources>

            <DockPanel LastChildFill="True">

                <!-- Docked FIRST so it reserves bottom space before the fill child.
                     Hidden while the note is locked: there is nothing to save from
                     a view of the saved record, and a disabled Save button would
                     only invite the question. The command refuses it as well. -->
                <Button DockPanel.Dock="Bottom"
                        Command="{Binding SubmitNoteCommand}"
                        Visibility="{Binding IsUnlocked,
                            Converter={StaticResource BoolToVisibilityConverter}}"
                        Margin="0,10,0,0">
                    <Button.Style>
                        <Style TargetType="Button"
                               BasedOn="{StaticResource PrimaryButton}">
                            <Setter Property="Content"
                                    Value="{Binding SaveActionLabel}" />
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Short windows keep the note identity and section choice above
                     the scrolling fields. The ordinary heading below remains the
                     single tall-layout owner; this compact header uses the same VM
                     commands and disappears when the full form fits. -->
                <Border x:Name="ShortEditorHeader"
                        DockPanel.Dock="Top"
                        Margin="0,0,0,10"
                        Padding="0,0,0,8"
                        BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="0,0,0,1"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Text="{Binding EditorHeading}"
                                   Style="{StaticResource SectionHeader}"
                                   VerticalAlignment="Center"
                                   AutomationProperties.Name="Compact note panel mode"
                                   AutomationProperties.LiveSetting="Polite" />
                        <Button Grid.Row="0"
                                Grid.Column="1"
                                Style="{StaticResource IconButton}"
                                Width="28"
                                Height="28"
                                Margin="8,0,0,4"
                                Command="{Binding ToggleLockCommand}"
                                ToolTip="{Binding LockToggleTooltip}"
                                AutomationProperties.Name="{Binding LockToggleLabel}"
                                AutomationProperties.HelpText="{Binding LockToggleTooltip}"
                                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding LockGlyph}"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="15"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Button>
                        <Button Grid.Row="0"
                                Grid.Column="2"
                                Style="{StaticResource SmallButton}"
                                Margin="8,0,0,4"
                                Command="{Binding StartNewNoteCommand}"
                                ToolTip="Start a new note (Esc). Clears the selected note and keeps the client."
                                AutomationProperties.Name="Start a new note from compact editor">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="11"
                                           Margin="0,0,6,0" />
                                <TextBlock Text="New Note" />
                            </StackPanel>
                        </Button>

                        <TextBlock Grid.Row="1"
                                   Grid.ColumnSpan="3"
                                   Margin="0,0,0,7"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.Name="Selected client for compact note editor">
                            <Run Text="CLIENT: " FontWeight="SemiBold" />
                            <Run Text="{Binding SelectedPerson.FullName, Mode=OneWay, TargetNullValue=Not selected}" />
                        </TextBlock>

                        <StackPanel Grid.Row="2"
                                    Grid.ColumnSpan="3"
                                    Orientation="Horizontal">
                            <Button x:Name="WriteSectionButton"
                                    Content="Write"
                                    Style="{StaticResource SmallButton}"
                                    Margin="0,0,6,0"
                                    AutomationProperties.Name="Show note writing section"
                                    Click="WriteSection_Click" />
                            <Button x:Name="DetailsSectionButton"
                                    Content="Details"
                                    Style="{StaticResource SmallButton}"
                                    AutomationProperties.Name="Show note details section"
                                    Click="DetailsSection_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer x:Name="FormScrollViewer"
                              VerticalScrollBarVisibility="Auto">
                    <Grid x:Name="FormFieldsGrid">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- ═══ HEADING AND LOCK ═══
                             The heading is the authoritative mode cue — New Note,
                             View Note, or Edit Note — and it is a polite live
                             region, so the mode change is announced and not only
                             seen. The padlock is a second cue, never the only one. -->
                        <Grid x:Name="TallEditorHeadingPanel"
                              Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition x:Name="TallEditorHeadingRow"
                                               Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Text="{Binding EditorHeading}"
                                       Style="{StaticResource SectionHeader}"
                                       VerticalAlignment="Center"
                                       AutomationProperties.Name="Note panel mode"
                                       AutomationProperties.LiveSetting="Polite" />

                            <!-- Only meaningful once a saved note is loaded: a new
                                 note has no record behind it to protect. -->
                            <Button Grid.Row="0"
                                    Grid.Column="1"
                                    Style="{StaticResource IconButton}"
                                    Width="28"
                                    Height="28"
                                    Margin="8,0,0,8"
                                    Command="{Binding ToggleLockCommand}"
                                    ToolTip="{Binding LockToggleTooltip}"
                                    AutomationProperties.Name="{Binding LockToggleLabel}"
                                    AutomationProperties.HelpText="{Binding LockToggleTooltip}"
                                    Visibility="{Binding IsEditing,
                                        Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{Binding LockGlyph}"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="15"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Button>

                            <!-- ═══ BACK TO A NEW NOTE ═══
                                 The way out, present in both hosts because it lives
                                 in the module rather than in either page. Always
                                 visible, and merely DISABLED when the panel is
                                 already a blank new note: an affordance that comes
                                 and goes is one the case manager has to discover
                                 again each time, and a control that appears mid-form
                                 also reorders keyboard focus. Escape runs the same
                                 command. The label names the destination rather than
                                 the mechanism, because the destination is the part
                                 worth recognising. -->
                            <Button Grid.Row="0"
                                    Grid.Column="2"
                                    Style="{StaticResource SmallButton}"
                                    Margin="8,0,0,8"
                                    Command="{Binding StartNewNoteCommand}"
                                    ToolTip="Start a new note (Esc). Clears the selected note and keeps the client."
                                    AutomationProperties.Name="Start a new note"
                                    AutomationProperties.HelpText="Returns this panel to a blank new note and clears the selected row. The client stays selected. Unsaved changes are confirmed first. Keyboard shortcut: Escape.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="11"
                                               Margin="0,0,6,0"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="New Note"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- The supervisor's return reason travelled with the
                                 note; it belongs beside the note it is about. -->
                            <Border Grid.Row="1"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="3"
                                    Background="{DynamicResource SurfaceRaisedBrush}"
                                    BorderBrush="{DynamicResource HoverBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="10,8"
                                    Margin="0,0,0,10"
                                    Visibility="{Binding HasReturnReason,
                                        Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="RETURNED BY SUPERVISOR"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentBrush}"
                                               Margin="0,0,0,4" />
                                    <TextBlock Text="{Binding ReturnReason}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextWrapping="Wrap"
                                               AutomationProperties.Name="Reason this note was returned" />
                                </StackPanel>
                            </Border>

                            <!-- ═══ THIS NOTE MOVED UNDER YOU ═══
                                 Raised by the freshness read taken when the note is
                                 unlocked. Assertive rather than polite: the case
                                 manager is about to type into this record, and the
                                 news that it is not the record they think it is
                                 should not wait for a pause in their work. The
                                 heading carries the meaning, so the warning colour
                                 is never the only cue. -->
                            <Border Grid.Row="2"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="3"
                                    Background="{DynamicResource OverdueFillBrush}"
                                    BorderBrush="{DynamicResource OverdueBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="10,8"
                                    Margin="0,0,0,10"
                                    Visibility="{Binding HasStaleNoteMessage,
                                        Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="NOTE CHANGED ON THE SERVER"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource DangerStrongBrush}"
                                               Margin="0,0,0,4" />
                                    <TextBlock Text="{Binding StaleNoteMessage}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextWrapping="Wrap"
                                               AutomationProperties.Name="Note changed on the server"
                                               AutomationProperties.LiveSetting="Assertive" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <TextBlock Text="CLIENT"
                           Grid.Row="1"
                           Style="{StaticResource LabelStyle}" />
                <ComboBox x:Name="PersonSelector"
                          AutomationProperties.Name="Person"
                          AutomationProperties.HelpText="When editing a saved note, changing the client asks you to confirm the reassignment."
                          Grid.Row="2"
                          ItemsSource="{Binding People}"
                          SelectedItem="{Binding SelectedPerson}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource PersonNameFormatConverter}">
                                        <Binding />
                                        <Binding Path="DataContext.SortsPickersByLastName"
                                                 RelativeSource="{RelativeSource AncestorType={x:Type ComboBox}}" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Text="STATUS"
                           Grid.Row="3"
                           Style="{StaticResource LabelStyle}" />
                <!-- Disabled for a Reminder. Future dates assign Scheduled
                     automatically; undated reminders take the journal path. -->
                <ComboBox AutomationProperties.Name="Status" Grid.Row="4"
                          ItemsSource="{Binding NoteStatusOptions}"
                          SelectedItem="{Binding Status, Mode=TwoWay}"
                          IsEnabled="{Binding AreNoteFieldsEnabled}"
                          AutomationProperties.HelpText="{Binding StatusGuidance}" />
                <TextBlock Grid.Row="5"
                           Margin="0,5,0,10"
                           Text="{Binding StatusGuidance}"
                           TextWrapping="Wrap"
                           FontSize="11"
                           LineHeight="16"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           AutomationProperties.Name="Selected status workflow explanation"
                           AutomationProperties.LiveSetting="Polite" />

                <Grid Margin="0,0,0,10"
                      Grid.Row="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <!-- Reminder sits on its own row because it is not service
                             documentation. With no date it is a journal entry;
                             with a future date it is a calendar reminder. -->
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="75" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="NOTE TYPE"
                               Style="{StaticResource LabelStyle}"
                               Grid.Row="0"
                               Grid.Column="0"
                               Grid.ColumnSpan="2" />
                    <RadioButton Grid.Row="1"
                                 Grid.Column="1"
                                 Content="Visit"
                                 Margin="0,0,12,4"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 GroupName="NoteEntryNoteType"
                                 IsChecked="{Binding SelectedNoteType,
                                     Converter={StaticResource EnumToBoolConverter},
                                     ConverterParameter=Visit}" />
                    <RadioButton Grid.Row="1"
                                 Grid.Column="3"
                                 Content="Contact"
                                 Margin="0,0,12,4"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 GroupName="NoteEntryNoteType"
                                 IsChecked="{Binding SelectedNoteType,
                                     Converter={StaticResource EnumToBoolConverter},
                                     ConverterParameter=Contact}" />
                    <RadioButton Grid.Row="2"
                                 Grid.Column="1"
                                 Content="Other"
                                 Margin="0,0,12,4"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 GroupName="NoteEntryNoteType"
                                 IsChecked="{Binding SelectedNoteType,
                                     Converter={StaticResource EnumToBoolConverter},
                                     ConverterParameter=Other}" />
                    <RadioButton Grid.Row="2"
                                 Grid.Column="3"
                                 Content="Form"
                                 Margin="0,0,8,4"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 GroupName="NoteEntryNoteType"
                                 IsChecked="{Binding SelectedNoteType,
                                     Converter={StaticResource EnumToBoolConverter},
                                     ConverterParameter=Form}" />
                    <RadioButton Grid.Row="3"
                                 Grid.Column="1"
                                 Grid.ColumnSpan="3"
                                 Content="Reminder"
                                 Margin="0,0,12,4"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 GroupName="NoteEntryNoteType"
                                 ToolTip="Without a date, adds a journal reminder. Choosing a future date saves it on that calendar day. Never billable."
                                 IsChecked="{Binding SelectedNoteType,
                                     Converter={StaticResource EnumToBoolConverter},
                                     ConverterParameter=Reminder}" />
                    <ComboBox AutomationProperties.Name="Form Type" Grid.Row="4"
                              Grid.ColumnSpan="4"
                              ItemsSource="{Binding FormTypes}"
                              SelectedItem="{Binding SelectedFormType, Mode=TwoWay}"
                              Visibility="{Binding IsFormNote,
                                  Converter={StaticResource BoolToVisibilityConverter}}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>

                        <Grid x:Name="NoteBodyGrid"
                              Grid.Row="7">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Carries the unit count the removed detail panel
                                 used to show. Units are derived from minutes by
                                 Note.CalculateUnits — one owner, not a second
                                 rounding rule written here. -->
                            <TextBlock Text="{Binding MinutesLabel}"
                               Grid.Row="0"
                               AutomationProperties.Name="Minutes and resulting billable units"
                               Style="{StaticResource LabelStyle}" />
                    <TextBox AutomationProperties.Name="Minutes" Grid.Row="1"
                             IsEnabled="{Binding AreNoteFieldsEnabled}"
                             Text="{Binding Minutes}" />

                    <TextBlock Text="DATE"
                               Grid.Row="2"
                               Style="{StaticResource LabelStyle}" />
                    <DatePicker AutomationProperties.Name="Event date" Grid.Row="3"
                                IsEnabled="{Binding IsDateEnabled}"
                                SelectedDate="{Binding EventDate}"
                                ToolTip="Choosing a future date automatically changes this entry to a non-billable calendar Reminder." />

                    <!-- ═══ SERVICE DAY ═══
                         A case manager cannot bill the same minute twice, so the
                         draft's start time and minutes are drawn against the rest
                         of that day's notes and checked before the note is saved.
                         The rule lives in Sati.Contracts ServiceTimeline and is
                         enforced again by the API; this panel is the preview.
                         A Reminder claims no service time, so the whole panel —
                         start time, bar, and verdict — disables with it. -->
                    <Border Grid.Row="4"
                            Margin="0,2,0,10"
                            Padding="11"
                            CornerRadius="6"
                            IsEnabled="{Binding AreNoteFieldsEnabled}"
                            Background="{DynamicResource PersonGroupBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="{Binding ServiceDayHeading}"
                                       Style="{StaticResource LabelStyle}"
                                       AutomationProperties.LiveSetting="Polite" />

                            <TextBlock Text="SERVICE START TIME"
                                       Style="{StaticResource LabelStyle}"
                                       Margin="0,4,0,4" />
                            <ComboBox AutomationProperties.Name="Service start time"
                                      ItemsSource="{Binding StartTimeOptions}"
                                      SelectedItem="{Binding SelectedStartTime, Mode=TwoWay}"
                                      DisplayMemberPath="Display"
                                      MaxDropDownHeight="260"
                                      ToolTip="Optional. When set, this note reserves its minutes on your day and cannot overlap another note." />

                            <!-- The 7:00 AM to 7:00 PM track. Bands are placed as a
                                 fraction of the track's MEASURED width, so the bar
                                 reflows with the panel instead of assuming a size. -->
                            <Border Height="26"
                                    CornerRadius="4"
                                    Background="{DynamicResource SurfaceMutedBrush}"
                                    BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="1"
                                    ClipToBounds="True"
                                    AutomationProperties.Name="Service day from 7 AM to 7 PM">
                                <ItemsControl ItemsSource="{Binding ServiceDaySegments}"
                                              HorizontalAlignment="Stretch">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <!-- Only the constant sits here. The horizontal
                                             offset is a margin on the band below, because
                                             a container style is applied before the
                                             container joins the tree and an ancestor
                                             binding has nothing to bind to yet. -->
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Top" Value="1" />
                                            <Setter Property="Canvas.Left" Value="0" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Height="22"
                                                    CornerRadius="2"
                                                    HorizontalAlignment="Left"
                                                    ToolTip="{Binding Description}"
                                                    AutomationProperties.Name="{Binding Description}">
                                                <Border.Margin>
                                                    <MultiBinding Converter="{StaticResource TimelineOffsetMarginConverter}">
                                                        <Binding Path="StartFraction" />
                                                        <Binding Path="ActualWidth"
                                                                 RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                    </MultiBinding>
                                                </Border.Margin>
                                                <Border.Width>
                                                    <MultiBinding Converter="{StaticResource TimelineWidthConverter}">
                                                        <Binding Path="WidthFraction" />
                                                        <Binding Path="ActualWidth"
                                                                 RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                    </MultiBinding>
                                                </Border.Width>
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <!-- Recorded time is the default band. -->
                                                        <Setter Property="Background" Value="{DynamicResource InfoFillBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource InfoBrush}" />
                                                        <Setter Property="BorderThickness" Value="1" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Kind}" Value="Draft">
                                                                <Setter Property="Background" Value="{DynamicResource CompliantFillBrush}" />
                                                                <Setter Property="BorderBrush" Value="{DynamicResource SuccessBorderBrush}" />
                                                                <Setter Property="BorderThickness" Value="2" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Kind}" Value="Conflict">
                                                                <Setter Property="Background" Value="{DynamicResource OverdueFillBrush}" />
                                                                <Setter Property="BorderBrush" Value="{DynamicResource OverdueBrush}" />
                                                                <Setter Property="BorderThickness" Value="2" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>

                            <!-- Twelve equal hours. Static columns keep the scale
                                 honest without a second measured layout pass. -->
                            <Grid Margin="0,3,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="7a" FontSize="10"
                                           Foreground="{DynamicResource TextSubtleBrush}" />
                                <TextBlock Grid.Column="2" Text="9a" FontSize="10"
                                           Foreground="{DynamicResource TextSubtleBrush}" />
                                <TextBlock Grid.Column="4" Text="11a" FontSize="10"
                                           Foreground="{DynamicResource TextSubtleBrush}" />
                                <TextBlock Grid.Column="6" Text="1p" FontSize="10"
                                           Foreground="{DynamicResource TextSubtleBrush}" />
                                <TextBlock Grid.Column="8" Text="3p" FontSize="10"
                                           Foreground="{DynamicResource TextSubtleBrush}" />
                                <TextBlock Grid.Column="10" Text="5p" FontSize="10"
                                           Foreground="{DynamicResource TextSubtleBrush}" />
                                <TextBlock Grid.Column="11" Text="7p" FontSize="10"
                                           HorizontalAlignment="Right"
                                           Foreground="{DynamicResource TextSubtleBrush}" />
                            </Grid>

                            <!-- The verdict in words. Color is never the only cue. -->
                            <TextBlock Text="{Binding ServiceTimeMessage}"
                                       Margin="0,7,0,0"
                                       FontSize="11"
                                       LineHeight="16"
                                       TextWrapping="Wrap"
                                       AutomationProperties.Name="Service time check"
                                       AutomationProperties.LiveSetting="Assertive">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasServiceTimeConflict}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource OverdueBrush}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Expander Grid.Row="5"
                              Header="IN-PERSON MEETING DETAILS"
                              IsExpanded="True"
                              Margin="0,2,0,10"
                              Visibility="{Binding IsVisitNote,
                                  Converter={StaticResource BoolToVisibilityConverter}}"
                              AutomationProperties.Name="In-person meeting details">
                        <Border Margin="0,6,0,0"
                                Padding="11"
                                Background="{DynamicResource PersonGroupAltBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <StackPanel>
                                <TextBlock Text="Check every fact you personally observed or verified. Sati saves these selections with the note, and Build Case Note Template writes them into the narrative."
                                           Margin="0,0,0,10"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <TextBlock Text="MEETING SETTING"
                                                   Style="{StaticResource LabelStyle}" />
                                        <ItemsControl ItemsSource="{Binding VisitSettingOptions}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox Content="{Binding DisplayLabel}"
                                                              IsChecked="{Binding IsSelected}"
                                                              Margin="0,0,14,6"
                                                              AutomationProperties.Name="{Binding DisplayLabel, StringFormat=Meeting setting: {0}}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="2">
                                        <TextBlock Text="APPEARANCE"
                                                   Style="{StaticResource LabelStyle}" />
                                        <ItemsControl ItemsSource="{Binding VisitAppearanceOptions}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox Content="{Binding DisplayLabel}"
                                                              IsChecked="{Binding IsSelected}"
                                                              Margin="0,0,14,6"
                                                              AutomationProperties.Name="{Binding DisplayLabel, StringFormat=Observed appearance: {0}}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,8,0,0">
                                        <TextBlock Text="PARTICIPATION"
                                                   Style="{StaticResource LabelStyle}" />
                                        <ItemsControl ItemsSource="{Binding VisitParticipationOptions}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox Content="{Binding DisplayLabel}"
                                                              IsChecked="{Binding IsSelected}"
                                                              Margin="0,0,14,6"
                                                              AutomationProperties.Name="{Binding DisplayLabel, StringFormat=Consumer participation: {0}}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,8,0,0">
                                        <TextBlock Text="HEALTH / SAFETY"
                                                   Style="{StaticResource LabelStyle}" />
                                        <ItemsControl ItemsSource="{Binding VisitSafetyObservationOptions}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox Content="{Binding DisplayLabel}"
                                                              IsChecked="{Binding IsSelected}"
                                                              Margin="0,0,14,6"
                                                              AutomationProperties.Name="{Binding DisplayLabel, StringFormat=Health and safety observation: {0}}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="SETTING DETAILS"
                                           Style="{StaticResource LabelStyle}"
                                           Margin="0,10,0,5" />
                                <TextBox Text="{Binding VisitSettingDetails, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Meeting setting details"
                                         ToolTip="Optional location or setting details. Enter only what should appear in the record." />

                                <DockPanel Margin="0,11,0,5">
                                    <ComboBox DockPanel.Dock="Right"
                                              Width="170"
                                              ItemsSource="{Binding VisitPresences}"
                                              SelectedItem="{Binding VisitPresence}"
                                              Margin="12,0,0,0"
                                              AutomationProperties.Name="Consumer attendance status">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Text="ATTENDEES FROM THE CONSUMER PROFILE"
                                               Style="{StaticResource LabelStyle}"
                                               Margin="0" />
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding VisitAttendees}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding DisplayLabel}"
                                                      IsChecked="{Binding IsSelected}"
                                                      Margin="0,0,14,6"
                                                      AutomationProperties.Name="{Binding DisplayLabel}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="ADDITIONAL ATTENDEES"
                                           Style="{StaticResource LabelStyle}"
                                           Margin="0,4,0,5" />
                                <TextBox Text="{Binding VisitAdditionalAttendees, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Additional meeting attendees"
                                         ToolTip="For a one-time attendee who is not in the consumer profile. Include the person's name and role." />

                                <TextBlock Text="VERIFIED MEETING FACTS"
                                           Style="{StaticResource LabelStyle}"
                                           Margin="0,11,0,5" />
                                <WrapPanel>
                                    <CheckBox Content="Expressed preferences"
                                              IsChecked="{Binding VisitExpressedPreferences}" />
                                    <CheckBox Content="Asked questions"
                                              IsChecked="{Binding VisitAskedQuestions}"
                                              Margin="14,0,0,6" />
                                    <CheckBox Content="Made choices"
                                              IsChecked="{Binding VisitMadeChoices}"
                                              Margin="14,0,0,6" />
                                    <CheckBox Content="Communication support used"
                                              IsChecked="{Binding VisitCommunicationSupportUsed}"
                                              Margin="14,0,0,6" />
                                    <CheckBox Content="Goals reviewed"
                                              IsChecked="{Binding VisitGoalsReviewed}"
                                              Margin="14,0,0,6" />
                                    <CheckBox Content="Services discussed"
                                              IsChecked="{Binding VisitServicesDiscussed}"
                                              Margin="14,0,0,6" />
                                    <CheckBox Content="Documents reviewed"
                                              IsChecked="{Binding VisitDocumentsReviewed}"
                                              Margin="14,0,0,6" />
                                </WrapPanel>

                                <TextBlock Text="OBSERVATION DETAILS"
                                           Style="{StaticResource LabelStyle}"
                                           Margin="0,6,0,5" />
                                <TextBox Text="{Binding VisitObservationDetails, UpdateSourceTrigger=PropertyChanged}"
                                         MinHeight="58"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         SpellCheck.IsEnabled="True"
                                         AutomationProperties.Name="Visit observation details"
                                         ToolTip="Required when an appearance, health, or safety concern is selected." />
                            </StackPanel>
                        </Border>
                    </Expander>

                    <Grid Grid.Row="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- Reads REMINDER when that type is selected: the box below
                             is the only input a reminder has, so it says what it is. -->
                        <TextBlock Grid.Column="0"
                                   Text="{Binding NarrativeLabel}"
                                   Style="{StaticResource LabelStyle}" />
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal">
                            <Button Command="{Binding CopyNarrativeCommand}"
                                    Style="{StaticResource IconButton}"
                                    Width="26"
                                    Height="26"
                                    Margin="0,0,4,0"
                                    ToolTip="Copy this narrative to the clipboard"
                                    AutomationProperties.Name="Copy narrative to clipboard">
                                <TextBlock Text="&#xE8C8;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="14"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Button>
                <Button Command="{Binding DecreaseNarrativeFontCommand}"
                        AutomationProperties.Name="Decrease note text size"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Padding="4,0">
                                <TextBlock Text="A"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Button>
                <Button Command="{Binding IncreaseNarrativeFontCommand}"
                        AutomationProperties.Name="Increase note text size"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Padding="4,0">
                                <TextBlock Text="A"
                                           FontSize="16"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontWeight="SemiBold" />
                            </Button>
                        </StackPanel>
                    </Grid>

                            <TextBox x:Name="NarrativeTextBox"
                                     AutomationProperties.Name="Note narrative" Grid.Row="7"
                                     services:TextShortcutTarget.IsEnabled="True"
                                     MinHeight="160"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     SpellCheck.IsEnabled="True"
                                     FontFamily="{StaticResource NarrativeFont}"
                                     FontSize="{Binding NarrativeFontSize}"
                                     Text="{Binding Narrative, UpdateSourceTrigger=PropertyChanged}" />

                            <Border Grid.Row="8"
                                    Margin="0,6,0,10"
                                    Padding="10,8"
                                    CornerRadius="6"
                                    Background="{DynamicResource SurfaceMutedBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    Visibility="{Binding IsSuggestedFollowUpVisible,
                                        Converter={StaticResource BoolToVisibilityConverter}}">
                                <DockPanel LastChildFill="True">
                                    <Button DockPanel.Dock="Right"
                                            Margin="12,0,0,0"
                                            Padding="12,5"
                                            VerticalAlignment="Center"
                                            Content="Accept suggestion"
                                            Command="{Binding AcceptSuggestedFollowUpCommand}"
                                            AutomationProperties.Name="{Binding SuggestedFollowUpAutomationName}"
                                            ToolTip="{Binding SuggestedFollowUpToolTip}"
                                            ToolTipService.ShowOnDisabled="True" />
                                    <TextBlock VerticalAlignment="Center"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               AutomationProperties.Name="{Binding SuggestedFollowUpText,
                                                   StringFormat=Suggested follow-up: {0}}">
                                        <Run Text="Suggested follow-up: " FontWeight="SemiBold" />
                                        <Run Text="{Binding SuggestedFollowUpText, Mode=OneWay}" />
                                    </TextBlock>
                                </DockPanel>
                            </Border>

                            <!-- The Local AI trigger is withdrawn for now. The drafting
                                 pipeline and its review panel below are untouched, so the
                                 button can return; with no trigger, IsAiBusy and
                                 IsAiReviewVisible simply never become true.

                                 Gated on IsVisitNote, not IsLocalAiEnabled: the template is
                                 built from the meeting checkboxes, which only a Visit note
                                 has, and it needs no model. -->
                            <StackPanel Grid.Row="9"
                                        Margin="0,2,0,10"
                                        IsEnabled="{Binding AreNoteFieldsEnabled}"
                                        Visibility="{Binding IsVisitNote,
                                            Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0"
                                            Command="{Binding BuildCaseNoteTemplateCommand}"
                                            AutomationProperties.Name="Build a case note template from the checked meeting facts"
                                            ToolTip="Writes the checked meeting facts as a structured note and moves anything already in the narrative below a Meeting Narrative header. Nothing is removed."
                                            ToolTipService.ShowOnDisabled="True"
                                            Style="{StaticResource PrimaryButton}"
                                            Content="Build Case Note Template" />

                                    <TextBlock Grid.Column="1"
                                               Margin="12,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Text="Your own text is kept and moved below a Meeting Narrative header." />
                                </Grid>

                                <Border Margin="0,8,0,0"
                                        Padding="12,9"
                                        CornerRadius="7"
                                        Background="{DynamicResource AiAccentSoftBrush}"
                                        BorderBrush="{DynamicResource AiAccentBorderBrush}"
                                        BorderThickness="1"
                                        Visibility="{Binding IsAiBusy,
                                            Converter={StaticResource BoolToVisibilityConverter}}"
                                        AutomationProperties.Name="Local AI is thinking"
                                        AutomationProperties.LiveSetting="Polite">
                                    <Border.Effect>
                                        <DropShadowEffect Color="{DynamicResource AiGlowColor}"
                                                          BlurRadius="14"
                                                          ShadowDepth="0"
                                                          Opacity="0.38" />
                                    </Border.Effect>
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center">
                                        <StackPanel Orientation="Horizontal"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,10,0">
                                            <Ellipse Style="{StaticResource AiThinkingPearlOne}" />
                                            <Ellipse Style="{StaticResource AiThinkingPearlTwo}" />
                                            <Ellipse Style="{StaticResource AiThinkingPearlThree}" />
                                        </StackPanel>
                                        <TextBlock Text="Sati is checking current facts and shaping the draft…"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource AiPanelTextBrush}"
                                                   FontWeight="SemiBold"
                                                   FontSize="11"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <ProgressBar Height="4"
                                             Margin="0,8,0,0"
                                             Minimum="0"
                                             Maximum="100"
                                             Value="{Binding AiDownloadProgress, TargetNullValue=0}"
                                             Visibility="{Binding AiDownloadProgress,
                                                Converter={StaticResource NullToVisibilityConverter}}"
                                             AutomationProperties.Name="Local AI model download progress" />
                            </StackPanel>

                            <Border Grid.Row="10"
                                    Margin="0,2,0,10"
                                    Padding="12"
                                    CornerRadius="6"
                                    Background="{DynamicResource SurfaceRaisedBrush}"
                                    BorderBrush="{DynamicResource AiAccentBorderBrush}"
                                    BorderThickness="1"
                                    Visibility="{Binding IsAiReviewVisible,
                                        Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="LOCAL AI DRAFT - REVIEW REQUIRED"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Margin="0,3,0,8"
                                               Text="Compare this draft with your original. Sati has not changed or submitted the note."
                                               TextWrapping="Wrap"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />

                                    <ItemsControl ItemsSource="{Binding AiWarnings}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Margin="0,0,0,5"
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource DangerStrongBrush}"
                                                           FontSize="11">
                                                    <Run Text="Warning: " />
                                    <Run Text="{Binding Mode=OneWay}" />
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Expander Margin="0,2,0,8"
                                              Header="{Binding AiContextSummary}"
                                              AutomationProperties.Name="Show current note inputs used by local AI">
                                        <Border Margin="0,5,0,0"
                                                Padding="9"
                                                Background="{DynamicResource SurfaceBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4">
                                            <StackPanel>
                                                <TextBlock Margin="0,0,0,6"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           TextWrapping="Wrap"
                                                           Text="Only the selected client identity and the current note inputs shown below were supplied. No prior records were used." />
                                                <ItemsControl ItemsSource="{Binding AiContextSources}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Margin="0,0,0,3"
                                                                       FontSize="11"
                                                                       TextWrapping="Wrap"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}">
                                    <Run Text="{Binding Category, Mode=OneWay}" FontWeight="SemiBold" />
                                                                <Run Text=" — " />
                                    <Run Text="{Binding Description, Mode=OneWay}" />
                                                            </TextBlock>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </Expander>

                                    <TextBox AutomationProperties.Name="Proposed local AI case note draft"
                                             Text="{Binding AiDraftNarrative, Mode=OneWay}"
                                             IsReadOnly="True"
                                             MinHeight="130"
                                             MaxHeight="260"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Auto"
                                             FontFamily="{StaticResource NarrativeFont}"
                                             FontSize="{Binding NarrativeFontSize}" />

                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right">
                                        <Button Content="Discard Draft"
                                                Command="{Binding DiscardAiDraftCommand}"
                                                AutomationProperties.Name="Discard local AI draft"
                                                Height="32"
                                                Padding="14,0"
                                                Margin="0,0,8,0" />
                                        <Button Content="Accept as Narrative"
                                                Command="{Binding AcceptAiDraftCommand}"
                                                AutomationProperties.Name="Accept local AI draft as note narrative"
                                                Style="{StaticResource LocalAiButton}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                    </Grid>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ═══ COMPLIANCE DIALOG OVERLAY (module-scoped) ═══ -->
        <Grid Background="{DynamicResource ScrimBrush}"
              Visibility="{Binding IsComplianceDialogVisible,
                  Converter={StaticResource BoolToVisibilityConverter}}">
            <!-- MaxHeight bound to the overlay Grid keeps the dialog inside the
                 module's clip bounds (module-only dimming). Inside, a DockPanel
                 pins the button row to the bottom and lets the message + reasons +
                 justification scroll — so buttons are reachable no matter how many
                 compliance reasons or how long the client name. -->
            <Border Background="{DynamicResource WindowBackgroundBrush}"
                    BorderBrush="{DynamicResource OverdueBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    MaxWidth="460"
                    MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Grid}}"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <DockPanel LastChildFill="True">

                    <!-- Button row docked bottom, reserved before the scroll body. -->
                    <StackPanel DockPanel.Dock="Bottom"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,16,0,0">
                        <Button Content="Cancel"
                                Padding="14,6"
                                FontSize="12"
                                Cursor="Hand"
                                BorderThickness="0"
                                Background="{DynamicResource TextSecondaryBrush}"
                                Foreground="{DynamicResource WindowBackgroundBrush}"
                                Margin="0,0,6,0"
                                Command="{Binding CancelComplianceDialogCommand}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="4"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Content="Hold for Now"
                                Padding="14,6"
                                FontSize="12"
                                Cursor="Hand"
                                BorderThickness="0"
                                Background="{DynamicResource AccentBrush}"
                                Foreground="{DynamicResource WindowBackgroundBrush}"
                                Margin="0,0,6,0"
                                Command="{Binding HoldForComplianceCommand}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="4"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Content="Send to Supervisor"
                                Padding="14,6"
                                FontSize="12"
                                Cursor="Hand"
                                BorderThickness="0"
                                Background="{DynamicResource DangerStrongBrush}"
                                Foreground="{DynamicResource WindowBackgroundBrush}"
                                Command="{Binding SendToSupervisorCommand}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="4"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>

                    <!-- Fill: everything above the buttons, scrolling as a unit. -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>

                            <TextBlock Text="CLIENT NOT BILLING COMPLIANT"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource DangerStrongBrush}"
                                       Margin="0,0,0,8" />

                            <TextBlock TextWrapping="Wrap"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Margin="0,0,0,12">
                                <Run Text="{Binding SelectedPerson.FullName, FallbackValue='This client', Mode=OneWay}" />
                                <Run Text="does not currently meet billing compliance requirements. You may hold this note in your queue until compliance is resolved, or send it to your supervisor with a written justification." />
                            </TextBlock>

                            <Border Background="{DynamicResource SurfaceRaisedBrush}"
                            BorderBrush="{DynamicResource OverdueBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10,8"
                            Margin="0,0,0,12">
                        <ScrollViewer MaxHeight="140"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ComplianceFailureReasons}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource DangerStrongBrush}"
                                                   Margin="0,2"
                                                   TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <TextBlock Text="JUSTIFICATION"
                               FontSize="10"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,4" />
                        <TextBlock Text="Required if sending to supervisor. Ignored if holding."
                                   FontSize="10"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,6" />
                            <TextBox AutomationProperties.Name="Pending note justification" Text="{Binding PendingJustification, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Height="90"
                                     Padding="8"
                                     FontSize="12"
                                     Background="{DynamicResource SurfaceBrush}"
                                     BorderBrush="{DynamicResource OverdueBorderBrush}"
                                     VerticalScrollBarVisibility="Auto"
                                     Margin="0,0,0,0" />

                        </StackPanel>
                    </ScrollViewer>

                </DockPanel>
            </Border>
        </Grid>

    </Grid>
</UserControl>
