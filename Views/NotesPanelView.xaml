<UserControl x:Class="Sati.Views.NotesPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             TextElement.FontFamily="{StaticResource AppFont}">

    <!-- The filter bar and notes grid, extracted from the Overview so the same
         control can render either in the Overview's middle column or in the
         shell's collapsible side panel. Which one it occupies is decided by the
         "Display Scratchpad in the center of the display" preference; this
         control does not know or care which host it is in.

         DataContext is CaseManagerDashboardViewModel in both hosts. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══ FILTER BAR ═══ -->
        <Grid Grid.Row="0"
              Margin="0,0,0,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="160" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0"
                       Grid.Column="0"
                       Text="FILTER NOTES"
                       Style="{StaticResource LabelStyle}" />
            <TextBlock Grid.Row="0"
                       Grid.Column="2"
                       Text="FILTER STATUS"
                       Style="{StaticResource LabelStyle}" />

            <TextBox AutomationProperties.Name="Search Text" x:Name="SearchTextBox"
                     Grid.Row="1"
                     Grid.Column="0"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            <ComboBox AutomationProperties.Name="Filter by note status" Grid.Row="1"
                      Grid.Column="2"
                      Height="{Binding ActualHeight, ElementName=SearchTextBox}"
                      ItemsSource="{Binding NoteStatusOptions}"
                      SelectedItem="{Binding FilterStatus}" />
        </Grid>

        <!-- ═══ NOTES DATAGRID ═══ -->
        <Border Grid.Row="1"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Margin="0,0,0,12">
            <DataGrid AutomationProperties.Name="Notes" ItemsSource="{Binding NotesView}"
                      SelectedItem="{Binding SelectedNote, Mode=TwoWay}"
                      MouseDoubleClick="DataGrid_MouseDoubleClick"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      Background="Transparent"
                      BorderThickness="0"
                      RowBackground="{DynamicResource SurfaceBrush}"
                      AlternatingRowBackground="{DynamicResource WindowBackgroundBrush}"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{DynamicResource DividerBrush}"
                      HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date"
                                        Binding="{Binding EventDate, StringFormat={}{0:MM/dd}}"
                                        Width="60" />
                    <DataGridTextColumn Header="Status"
                                        Binding="{Binding Status}"
                                        Width="90" />
                    <DataGridTextColumn Header="Units"
                                        Binding="{Binding Units}"
                                        Width="50" />
                    <DataGridTextColumn Header="Type"
                                        Binding="{Binding NoteType}"
                                        Width="80" />
                </DataGrid.Columns>
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Delete Note"
                                  Command="{Binding DeleteNoteCommand}" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
