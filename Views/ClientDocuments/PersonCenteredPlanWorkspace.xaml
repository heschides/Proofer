<UserControl x:Class="Sati.Views.ClientDocuments.PersonCenteredPlanWorkspace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:Sati.Converters"
             x:Name="PlanControl"
             Background="Transparent"
             AutomationProperties.Name="Person-centered plan workspace">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <Style x:Key="PlanSectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  DataContext="{Binding Workspace, ElementName=PlanControl}">
        <StackPanel>
            <TextBlock Text="PERSON-CENTERED PLAN"
                       FontSize="15"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="{Binding PersonName}"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,3,0,18" />

            <Border Background="{DynamicResource PersonGroupAltBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="7"
                    Padding="18"
                    Visibility="{Binding HasPerson, Converter={StaticResource InverseBoolToVisibility}}">
                <TextBlock Text="Select a consumer to begin building their person-centered plan."
                           Foreground="{DynamicResource TextMutedBrush}"
                           FontStyle="Italic" />
            </Border>

            <StackPanel Visibility="{Binding HasPerson, Converter={StaticResource BoolToVisibility}}">
                <Border Background="{DynamicResource SurfaceRaisedBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="7"
                        Padding="16"
                        Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Planning source"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding SourceTitle}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       Margin="0,4,0,0" />
                            <TextBlock Text="{Binding SourceNotice}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,5,20,0" />
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding SourceUpdatedText}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="11"
                                   VerticalAlignment="Top" />
                    </Grid>
                </Border>

                <Border Background="{DynamicResource PersonGroupAltBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="7"
                        Padding="18"
                        Visibility="{Binding HasSource, Converter={StaticResource InverseBoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="No Comprehensive Assessment is available yet."
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding SourceNotice}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <StackPanel Visibility="{Binding HasSource, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Margin="0,0,0,18"
                                Visibility="{Binding HasOutcomeCandidates, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Outcomes to refine" Style="{StaticResource PlanSectionTitle}" />
                        <TextBlock Text="These candidates come from Identified Needs in the assessment. Review them with the person and planning team before they become plan outcomes."
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,10" />
                        <ItemsControl ItemsSource="{Binding OutcomeCandidates}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="7"
                                            Padding="14"
                                            Margin="0,0,0,9">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Type}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentBrush}" />
                                            <TextBlock Text="{Binding Need}"
                                                       TextWrapping="Wrap"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       Margin="0,4,0,0"
                                                       Visibility="{Binding HasNeed, Converter={StaticResource BoolToVisibility}}" />
                                            <TextBlock Text="{Binding DesiredResult, StringFormat='Desired result: {0}'}"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Margin="0,5,0,0"
                                                       Visibility="{Binding HasDesiredResult, Converter={StaticResource BoolToVisibility}}" />
                                            <TextBlock Text="{Binding ProviderName, StringFormat='Provider noted in assessment: {0}'}"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       Margin="0,5,0,0"
                                                       Visibility="{Binding HasProvider, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,18"
                                Visibility="{Binding HasFoundations, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Person-centered foundation" Style="{StaticResource PlanSectionTitle}" />
                        <TextBlock Text="Key answered narratives carried forward from the assessment."
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,10" />
                        <ItemsControl ItemsSource="{Binding Foundations}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="7"
                                            Padding="14"
                                            Margin="0,0,0,9">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding Narrative}"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Margin="0,5,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,18"
                                Visibility="{Binding HasContributors, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Assessment contributors" Style="{StaticResource PlanSectionTitle}" />
                        <TextBlock Text="Potential planning participants carried forward for review; attendance and invitation status are not yet recorded."
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,10" />
                        <ItemsControl ItemsSource="{Binding Contributors}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Relationship}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <Border Background="{DynamicResource PersonGroupAltBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="16"
                            Visibility="{Binding HasPlanningContent, Converter={StaticResource InverseBoolToVisibility}}">
                        <TextBlock Text="The assessment exists, but no identified needs, contributors, or completed person-centered narratives are ready to carry forward yet."
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontStyle="Italic" />
                    </Border>

                    <Border Background="{DynamicResource AiAccentSoftBrush}"
                            BorderBrush="{DynamicResource AiAccentBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="14">
                        <TextBlock Text="This first PCP slice is a reviewable planning foundation. Outcome editing, meeting attendance, authorized services, versioning, signatures, and approval actions will be added as separate workflow steps."
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource AiPanelTextBrush}" />
                    </Border>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
