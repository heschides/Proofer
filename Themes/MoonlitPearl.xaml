<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Cool porcelain, mist blue and a quiet indigo accent. -->
    <LinearGradientBrush x:Key="WindowBackgroundBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FFF8FAFC" Offset="0"/><GradientStop Color="#FFEEF3F6" Offset="0.52"/><GradientStop Color="#FFF5F2F7" Offset="1"/></LinearGradientBrush>
    <LinearGradientBrush x:Key="NavBackgroundBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FFECF2F6" Offset="0"/><GradientStop Color="#FFE4E8F0" Offset="1"/></LinearGradientBrush>
    <LinearGradientBrush x:Key="SurfaceBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FFFFFFFF" Offset="0"/><GradientStop Color="#FFF6F9FA" Offset="0.5"/><GradientStop Color="#FFEEF1F6" Offset="1"/></LinearGradientBrush>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#EAF0F4"/><SolidColorBrush x:Key="SurfaceMutedBrush" Color="#E1E8ED"/><SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#FFFFFF"/><SolidColorBrush x:Key="SurfaceAlpha70Brush" Color="#B3F6F9FB"/><SolidColorBrush x:Key="SurfaceAlpha25Brush" Color="#40F6F9FB"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#D4DDE4"/><SolidColorBrush x:Key="InputBorderBrush" Color="#BAC7D1"/><SolidColorBrush x:Key="DividerBrush" Color="#E0E7EC"/>
<SolidColorBrush x:Key="AccentBrush" Color="#52618F"/><SolidColorBrush x:Key="AccentHoverBrush" Color="#414E76"/><SolidColorBrush x:Key="AccentPressedBrush" Color="#323D5E"/><SolidColorBrush x:Key="OnAccentBrush" Color="#FAFCFF"/>
    <!-- Button fill is its own token so a palette can lighten its buttons
         without lightening the accent used for type. -->
    <SolidColorBrush x:Key="AccentButtonBrush" Color="#52618F" />
    <SolidColorBrush x:Key="AccentButtonHoverBrush" Color="#414E76" />
    <SolidColorBrush x:Key="AccentButtonPressedBrush" Color="#323D5E" />
    <SolidColorBrush x:Key="OnAccentButtonBrush" Color="#FAFCFF" />
    <!-- Local AI: misted teal to complement the moonlit indigo. -->
    <Color x:Key="AiGlowColor">#FF75AEB0</Color>
    <SolidColorBrush x:Key="AiAccentBrush" Color="#3F7F80"/><SolidColorBrush x:Key="AiAccentHoverBrush" Color="#528F90"/><SolidColorBrush x:Key="AiAccentPressedBrush" Color="#2F6667"/><SolidColorBrush x:Key="AiAccentSoftBrush" Color="#E0F0F0"/><SolidColorBrush x:Key="AiAccentBorderBrush" Color="#A6CACA"/><SolidColorBrush x:Key="OnAiAccentBrush" Color="#F8FFFF"/><SolidColorBrush x:Key="AiPanelTextBrush" Color="#28595A"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#E4EAF1"/><SolidColorBrush x:Key="HoverStrongBrush" Color="#CCD6E2"/>
<SolidColorBrush x:Key="TextPrimaryBrush" Color="#303640"/><SolidColorBrush x:Key="TextSecondaryBrush" Color="#56626E"/><SolidColorBrush x:Key="TextMutedBrush" Color="#5B6873"/><SolidColorBrush x:Key="TextSubtleBrush" Color="#5D6975"/><SolidColorBrush x:Key="NarrativeTextBrush" Color="#505B68"/>
    <SolidColorBrush x:Key="PersonGroupBrush" Color="#F8FAFC"/><SolidColorBrush x:Key="PersonGroupAltBrush" Color="#EEF3F7"/>
    <Color x:Key="SurfaceAltColor">#FFEAF0F4</Color><Color x:Key="SurfaceRaisedColor">#FFFFFFFF</Color><Color x:Key="TextSubtleColor">#FF5D6975</Color>
</ResourceDictionary>
