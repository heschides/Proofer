<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>false</InvariantGlobalization>
    <Version>1.2.33</Version>
    <AssemblyVersion>1.2.33.0</AssemblyVersion>
    <FileVersion>1.2.33.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Security.KeyVault.Keys" Version="4.10.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.10" />
    <PackageReference Include="PDFsharp-MigraDoc" Version="6.2.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sati.Contracts\Sati.Contracts.csproj" />
    <ProjectReference Include="..\Sati.Forms\Sati.Forms.csproj" />
    <ProjectReference Include="..\Sati.Persistence\Sati.Persistence.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sati.Tests" />
    <InternalsVisibleTo Include="Sati.Api.Tests" />
  </ItemGroup>

  <!--
    Ships the triggered WebJob inside the API package, at the App_Data path App Service scans.
    Co-located, not merged: the job is a separate process with its own trigger and its own
    fail-safe gate, and the API host never invokes it. The API still does not migrate.

    Packaging it here rather than deploying it through Kudu keeps it versioned with the API and
    avoids handling publishing credentials. `Link` sets the path inside the publish output.
  -->
  <ItemGroup>
    <Content Include="WebJobs\demo-history-reconciliation\run.ps1"
             Link="App_Data\jobs\triggered\demo-history-reconciliation\run.ps1"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\scripts\Apply-DemoHistoryReconciliation.ps1"
             Link="App_Data\jobs\triggered\demo-history-reconciliation\Apply-DemoHistoryReconciliation.ps1"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
