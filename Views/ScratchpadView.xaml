<UserControl x:Class="Sati.Views.ScratchpadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        Margin="0,0,0,8">
                <TextBlock Text="TODAY'S WORK"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center" />
            <Button Command="{Binding OpenScratchpadHistoryCommand}"
                    AutomationProperties.Name="Open scratchpad history"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Margin="8,0,0,0"
                        Padding="4"
                        ToolTip="Browse scratchpad history">
                    <TextBlock Text="&#xE721;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="14"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </Button>
            <Button Command="{Binding DecreaseScratchpadFontCommand}"
                    AutomationProperties.Name="Decrease scratchpad text size"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Padding="4,0"
                        Margin="8,0,0,0">
                    <TextBlock Text="A"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </Button>
            <Button Command="{Binding IncreaseScratchpadFontCommand}"
                    AutomationProperties.Name="Increase scratchpad text size"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Padding="4,0">
                    <TextBlock Text="A"
                               FontSize="16"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontWeight="SemiBold" />
                </Button>
            </StackPanel>

            <Border Grid.Row="1"
                    Margin="0,0,0,8"
                    Padding="8"
                    Background="{DynamicResource WarningFillBrush}"
                    BorderBrush="{DynamicResource WarningBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Visibility="{Binding HasScratchpadConflict,
                                         Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding ScratchpadConflictMessage}"
                               Foreground="{DynamicResource WarningBrush}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            Margin="8,0,0,0"
                            Padding="8,4"
                            Content="Reload Latest"
                            Command="{Binding ReloadLatestScratchpadCommand}"
                            AutomationProperties.Name="Reload latest saved scratchpad" />
                </Grid>
            </Border>

            <!-- Scratchpad text area -->
            <TextBox AutomationProperties.Name="Today's scratchpad" x:Name="TodaysWorkBox"
                     Grid.Row="2"
                     FontFamily="{StaticResource NarrativeFont}"
                     FontSize="{Binding ScratchpadFontSize}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     SpellCheck.IsEnabled="True"
                     VerticalScrollBarVisibility="Auto"
                     VerticalAlignment="Stretch"
                     Text="{Binding ScratchpadContent, UpdateSourceTrigger=PropertyChanged}"
                     BorderThickness="0"
                     Margin="0"
                     Background="Transparent"
                     KeyDown="TodaysWorkBox_KeyDown" />
        </Grid>
    </Border>
</UserControl>
