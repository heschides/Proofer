<UserControl x:Class="Sati.Views.ATRequestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Sati.Views"
             Background="{DynamicResource WindowBackgroundBrush}"
             TextElement.FontFamily="{StaticResource AppFont}">

    <Grid>

        <!-- QUEUE REGION — visible when not editing -->
        <Grid Margin="24,20"
              Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- New-request bar -->
            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        Margin="0,0,0,16">
                <TextBlock Text="Client:"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <ComboBox AutomationProperties.Name="Client" Width="240"
                          VerticalAlignment="Center"
                          ItemsSource="{Binding Clients}"
                          SelectedItem="{Binding SelectedClient}"
                          DisplayMemberPath="FullName" />
                <Button Content="New Request"
                        Style="{StaticResource PrimaryButton}"
                        Width="120"
                        Margin="12,0,0,0"
                        Command="{Binding NewRequestCommand}" />
            </StackPanel>

            <!-- Queue list -->
            <Border Grid.Row="1"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Requests}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,8"
                                        BorderBrush="{DynamicResource SurfaceMutedBrush}"
                                        BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="2*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding ClientName}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Status}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding TotalCost, StringFormat=C}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding CaseManagerName}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- EDITOR REGION — inputs left, live-preview right. Visible when editing. -->
        <Grid Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"
                                  MinWidth="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: input pane -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SurfaceAltBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Padding="20,16">
                    <StackPanel>

                        <Button Content="← Back to list"
                                Style="{StaticResource SmallButton}"
                                Width="120"
                                HorizontalAlignment="Left"
                                Command="{Binding CloseEditorCommand}" />

                        <TextBlock Margin="0,16,0,16"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextWrapping="Wrap"
                                   Text="{Binding CurrentEditor.ClientName, StringFormat='Request for {0}'}" />

                        <TextBlock Text="VENDOR / PROVIDER"
                                   Style="{StaticResource SectionHeader}" />

                        <TextBlock Text="Name (not program name)"
                                   Style="{StaticResource LabelStyle}" />
                        <TextBox AutomationProperties.Name="Vendor name" Text="{Binding CurrentEditor.VendorName, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Billing Location (EIS Location)"
                                   Style="{StaticResource LabelStyle}" />
                        <TextBox AutomationProperties.Name="Vendor billing location" Text="{Binding CurrentEditor.VendorBillingLocation, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Program Contact (Name &amp; Email)"
                                   Style="{StaticResource LabelStyle}" />
                        <TextBox AutomationProperties.Name="Vendor program contact" Text="{Binding CurrentEditor.VendorProgramContact, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Billing Contact (Name &amp; Email)"
                                   Style="{StaticResource LabelStyle}" />
                        <TextBox AutomationProperties.Name="Vendor billing contact" Text="{Binding CurrentEditor.VendorBillingContact, UpdateSourceTrigger=PropertyChanged}" />

                        <Separator />

                        <TextBlock Text="ITEMS OR SERVICES"
                                   Style="{StaticResource SectionHeader}" />

                        <!-- One card per item. DataContext inside the template is the
                             item's editor VM, so Name/Url/ItemCost/Quantity bind to it. -->
                        <ItemsControl ItemsSource="{Binding CurrentEditor.Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SurfaceRaisedBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            Padding="10"
                                            Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="Item Name"
                                                       Style="{StaticResource LabelStyle}" />
                                            <TextBox AutomationProperties.Name="Name" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                                            <TextBlock Text="URL"
                                                       Style="{StaticResource LabelStyle}" />
                                            <TextBox AutomationProperties.Name="Url" Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" />

                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Item Cost"
                                                               Style="{StaticResource LabelStyle}" />
                                                    <!-- LostFocus (default): per-keystroke
                                                         decimal parse chokes on "1." — same
                                                         reason as Sales Tax below. -->
                                                    <TextBox AutomationProperties.Name="Item Cost" Text="{Binding ItemCost, StringFormat=F2}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Quantity"
                                                               Style="{StaticResource LabelStyle}" />
                                                    <TextBox AutomationProperties.Name="Quantity" Text="{Binding Quantity}" />
                                                </StackPanel>
                                            </Grid>

                                            <!-- RemoveItem lives on the editor VM, not the
                                                 item VM. AncestorType reaches the ItemsControl,
                                                 whose DataContext is the page VM; hence
                                                 DataContext.CurrentEditor.RemoveItemCommand.
                                                 CommandParameter {Binding} = this item VM. -->
                                            <Button Content="Remove"
                                                    Style="{StaticResource SmallButton}"
                                                    HorizontalAlignment="Right"
                                                    Margin="0,8,0,0"
                                                    Command="{Binding DataContext.CurrentEditor.RemoveItemCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Content="+ Add Item"
                                Style="{StaticResource SmallButton}"
                                HorizontalAlignment="Left"
                                Margin="0,4,0,0"
                                Command="{Binding CurrentEditor.AddItemCommand}" />

                        <Separator />

                        <TextBlock Text="TOTALS"
                                   Style="{StaticResource SectionHeader}" />

                        <TextBlock Text="Sales Tax"
                                   Style="{StaticResource LabelStyle}" />
                        <!-- Decimal: default LostFocus trigger, not PropertyChanged —
                             per-keystroke parsing chokes on partial input ("1."). Preview
                             tax updates on focus-loss, which is fine. -->
                        <TextBox AutomationProperties.Name="Sales tax" Text="{Binding CurrentEditor.SalesTax, StringFormat=F2}" />

                        <!-- Live readout — mirrors the preview so the math sits next
                             to the tax box. Bound to the editor VM's computed totals,
                             which re-raise on every item/tax change. -->
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="Items Subtotal"
                                       Foreground="{DynamicResource NarrativeTextBrush}" />
                            <TextBlock Grid.Row="0" Grid.Column="1"
                                       Text="{Binding CurrentEditor.ItemsTotal, StringFormat=C}"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />

                            <TextBlock Grid.Row="1" Grid.Column="0"
                                       Text="15% Passthrough"
                                       Foreground="{DynamicResource NarrativeTextBrush}"
                                       Margin="0,4,0,0" />
                            <TextBlock Grid.Row="1" Grid.Column="1"
                                       Text="{Binding CurrentEditor.PassthroughFee, StringFormat=C}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Margin="0,4,0,0" />

                            <TextBlock Grid.Row="2" Grid.Column="0"
                                       Text="Total Cost"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Margin="0,4,0,0" />
                            <TextBlock Grid.Row="2" Grid.Column="1"
                                       Text="{Binding CurrentEditor.TotalCost, StringFormat=C}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Margin="0,4,0,0" />
                        </Grid>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- RIGHT: live form preview -->
            <Border Grid.Column="1"
                    Background="{DynamicResource SurfaceMutedBrush}"
                    Padding="24">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                    <views:ATFormDocument DataContext="{Binding CurrentEditor}"
                                          VerticalAlignment="Top"
                                          HorizontalAlignment="Center" />
                </ScrollViewer>
            </Border>
        </Grid>

    </Grid>
</UserControl>