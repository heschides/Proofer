<Window x:Class="Sati.Views.DatabasePatienceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sati is retrieving information"
        Width="470"
        Height="310"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource AppFont}"
        AutomationProperties.Name="Sati is retrieving information">
    <Border Margin="18"
            Padding="30,26"
            CornerRadius="24"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="#5576B8A4"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28"
                              ShadowDepth="7"
                              Opacity="0.28"
                              Color="#273B4A" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Width="94"
                    Height="94"
                    CornerRadius="47"
                    HorizontalAlignment="Center"
                    Background="#FFF8FBF7"
                    BorderBrush="#4476B8A4"
                    BorderThickness="1">
                <Image Source="pack://application:,,,/Sati;component/images/sati-watercolor-leaf.png"
                       Width="74"
                       Height="74"
                       Stretch="Uniform"
                       RenderTransformOrigin="0.5,0.5"
                       AutomationProperties.Name="Retrieving information">
                    <Image.RenderTransform>
                        <RotateTransform />
                    </Image.RenderTransform>
                    <Image.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                     From="0"
                                                     To="360"
                                                     Duration="0:0:0.42" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Image.Triggers>
                </Image>
            </Border>

            <TextBlock Grid.Row="1"
                       Margin="0,18,0,0"
                       Text="Thank you for your patience"
                       TextAlignment="Center"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Grid.Row="2"
                       Margin="24,10,24,0"
                       Text="Sati is still retrieving your information. Your request is active, and this window will close automatically when it is ready."
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       FontSize="14"
                       LineHeight="21"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <StackPanel Grid.Row="3"
                        Margin="0,18,0,0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center">
                <Ellipse Width="7" Height="7" Fill="#FF3E8F83" Margin="0,0,8,0" />
                <TextBlock Text="Still working — no action is needed"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#FF28746A" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
