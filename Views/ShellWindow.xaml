<Window x:Class="Sati.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Sati.Views"
        Title="Sati"
        Icon="/images/sati.ico"
        WindowState="Maximized"
        MinWidth="900"
        MinHeight="600"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="{StaticResource AppFont}">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="300"
                              MinWidth="250" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- ================================================================ -->
        <!-- NAVIGATION BAR                                                   -->
        <!-- ================================================================ -->
        <Border Grid.Row="0"
                Grid.ColumnSpan="4"
                Background="{DynamicResource SurfaceAltBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- Tab navigation — left side -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal">
                    <Border Background="#FFFFF6D8"
                            BorderBrush="#FFE2C94B"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="5,2"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            Visibility="{DynamicResource BrandLogoVisibility}">
                        <Image Source="pack://application:,,,/Images/woodfords-logo.png"
                               Width="104"
                               Height="40"
                               Stretch="Uniform"
                               AutomationProperties.Name="Woodfords Family Services" />
                    </Border>
                    <Border Background="#FF7A2E8E"
                            BorderBrush="#FFE5B8F0"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="9,4"
                            Margin="0,0,8,0"
                            Visibility="{Binding IsDemoEnvironment, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="DEMO"
                                   Foreground="White"
                                   FontSize="12"
                                   FontWeight="Bold" />
                    </Border>
                    <Border Cursor="Hand"
                            CornerRadius="4"
                            Padding="10,4"
                            Margin="0,0,4,0"
                            Visibility="{Binding IsAdminAvailable,
                                Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick"
                                          Command="{Binding NavigateToAdminCommand}" />
                        </Border.InputBindings>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAdminActive}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource TextPrimaryBrush}" />
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="Admin" FontSize="13">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAdminActive}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource WindowBackgroundBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <Border Cursor="Hand"
                            CornerRadius="4"
                            Padding="10,4"
                            Margin="0,0,4,0">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick"
                                          Command="{Binding NavigateToCaseManagementCommand}" />
                        </Border.InputBindings>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background"
                                        Value="Transparent" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsNotesActive}"
                                                 Value="True">
                                        <Setter Property="Background"
                                                Value="{DynamicResource TextPrimaryBrush}" />
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver"
                                             Value="True">
                                        <Setter Property="Background"
                                                Value="{DynamicResource HoverBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="Case Management"
                                   FontSize="13">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource TextSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsNotesActive}"
                                                     Value="True">
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource WindowBackgroundBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <Border Cursor="Hand"
                            CornerRadius="4"
                            Padding="10,4"
                            Margin="0,0,4,0"
                            Visibility="{Binding IsSupervisionAvailable,
                                Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick"
                                          Command="{Binding NavigateToSupervisorDashboardCommand}" />
                        </Border.InputBindings>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background"
                                        Value="Transparent" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSupervisorActive}"
                                                 Value="True">
                                        <Setter Property="Background"
                                                Value="{DynamicResource TextPrimaryBrush}" />
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver"
                                             Value="True">
                                        <Setter Property="Background"
                                                Value="{DynamicResource HoverBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="Supervisor"
                                   FontSize="13">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource TextSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSupervisorActive}"
                                                     Value="True">
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource WindowBackgroundBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <Border Cursor="Hand"
                            CornerRadius="4"
                            Padding="10,4"
                            Margin="0,0,4,0"
                            Visibility="{Binding IsBillingAvailable,
            Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick"
                                          Command="{Binding NavigateToBillingCommand}" />
                        </Border.InputBindings>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background"
                                        Value="Transparent" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBillingActive}"
                                                 Value="True">
                                        <Setter Property="Background"
                                                Value="{DynamicResource TextPrimaryBrush}" />
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver"
                                             Value="True">
                                        <Setter Property="Background"
                                                Value="{DynamicResource HoverBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="Billing"
                                   FontSize="13">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource TextSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBillingActive}"
                                                     Value="True">
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource WindowBackgroundBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    

                    <Border Cursor="Hand"
                            CornerRadius="4"
                            Padding="10,4"
                            Margin="0,0,4,0">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick"
                                          Command="{Binding NavigateToGuidanceCommand}" />
                        </Border.InputBindings>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background"
                                        Value="Transparent" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGuidanceActive}"
                                                 Value="True">
                                        <Setter Property="Background"
                                                Value="{DynamicResource TextPrimaryBrush}" />
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver"
                                             Value="True">
                                        <Setter Property="Background"
                                                Value="{DynamicResource HoverBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="Guidance"
                                   FontSize="13">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource TextSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsGuidanceActive}"
                                                     Value="True">
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource WindowBackgroundBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <Border Cursor="Hand"
                            CornerRadius="4"
                            Padding="10,4"
                            Margin="0,0,4,0">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick"
                                          Command="{Binding NavigateToHelpersCommand}" />
                        </Border.InputBindings>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background"
                                        Value="Transparent" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHelpersActive}"
                                                 Value="True">
                                        <Setter Property="Background"
                                                Value="{DynamicResource TextPrimaryBrush}" />
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver"
                                             Value="True">
                                        <Setter Property="Background"
                                                Value="{DynamicResource HoverBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="Helpers"
                                   FontSize="13">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource TextSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsHelpersActive}"
                                                     Value="True">
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource WindowBackgroundBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                </StackPanel>

                <!-- User info — right side -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <!-- Settings -->
                <Button Grid.Column="0"
                        AutomationProperties.Name="Open settings"
                            Style="{StaticResource SmallButton}"
                            ToolTip="Settings"
                            Width="28"
                            Command="{Binding OpenSettingsWindowCommand}"
                            Background="Transparent"
                            Padding="0">
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   Text="&#xE713;"
                                   FontSize="14"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center" />
                    </Button>

                    <!-- User greeting -->
                    <Border Cursor="Hand"
                            CornerRadius="4"
                            Padding="8,4"
                            VerticalAlignment="Center"
                            Background="{Binding AvatarBrush}">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick"
                                          Command="{Binding RequestSwitchUserCommand}" />
                        </Border.InputBindings>
                        <TextBlock Text="{Binding UserGreeting}"
                                   FontSize="12"
                                   Foreground="{DynamicResource WindowBackgroundBrush}"
                                   VerticalAlignment="Center" />
                    </Border>

                </StackPanel>

            </Grid>
        </Border>

        <!-- ================================================================ -->
        <!-- MAIN CONTENT AREA                                                -->
        <!-- ================================================================ -->
        <ContentControl Grid.Row="1"
                        Grid.Column="0"
                        Content="{Binding CurrentViewModel}" />

        <!-- GridSplitter -->
        <GridSplitter Grid.Row="1"
                      Grid.Column="1"
                      Width="5"
                      HorizontalAlignment="Stretch"
                      Background="{DynamicResource BorderBrush}" />

        <!-- Scratchpad panel -->
        <Border Grid.Row="1"
                Grid.Column="2"
                BorderBrush="{DynamicResource BorderBrush}"
                Margin="8,12,12,20"
                BorderThickness="0"
                MinWidth="250"
                Visibility="{Binding IsScratchpadVisible,
                             Converter={StaticResource BoolToVisibilityConverter}}">
            <views:ScratchpadView DataContext="{Binding Scratchpad}" />
        </Border>

        <!-- Chevron rail — always visible; toggles the Today's Work panel -->
        <Border Grid.Row="1"
                Grid.Column="3"
                Background="{DynamicResource SurfaceAltBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1,0,0,0">
            <Button Command="{Binding ToggleScratchpadCommand}"
                    AutomationProperties.Name="Show or hide Today's Work"
                    Width="24"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    VerticalAlignment="Center"
                    ToolTip="Show or hide Today's Work">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <TextBlock FontFamily="Segoe MDL2 Assets"
                           FontSize="14"
                           Foreground="{DynamicResource TextSecondaryBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <!-- Closed: points left = bring the panel back in -->
                            <Setter Property="Text"
                                    Value="&#xE76B;" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsScratchpadVisible}"
                                             Value="True">
                                    <!-- Open: points right = collapse toward the edge -->
                                    <Setter Property="Text"
                                            Value="&#xE76C;" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Button>
        </Border>
    </Grid>
</Window>
