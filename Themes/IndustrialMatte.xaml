<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- IRONWORKS MATTE: graphite, oxidized copper, and a restrained drafting grid. -->
    <DrawingBrush x:Key="WindowBackgroundBrush" TileMode="Tile"
                  Viewport="0,0,72,72" ViewportUnits="Absolute"
                  Viewbox="0,0,72,72" ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#1E2425" Geometry="M 0,0 L 72,0 72,72 0,72 Z" />
                <GeometryDrawing Geometry="M 0,18 L 72,18 M 0,54 L 72,54 M 18,0 L 18,72 M 54,0 L 54,72">
                    <GeometryDrawing.Pen><Pen Brush="#283132" Thickness="1" /></GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Brush="#354041">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <EllipseGeometry Center="18,18" RadiusX="1.5" RadiusY="1.5" />
                            <EllipseGeometry Center="54,54" RadiusX="1.5" RadiusY="1.5" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <DrawingBrush x:Key="NavBackgroundBrush" TileMode="Tile"
                  Viewport="0,0,48,48" ViewportUnits="Absolute"
                  Viewbox="0,0,48,48" ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#252C2D" Geometry="M 0,0 L 48,0 48,48 0,48 Z" />
                <GeometryDrawing Geometry="M 0,24 L 48,24 M 24,0 L 24,48">
                    <GeometryDrawing.Pen><Pen Brush="#344041" Thickness="1" /></GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
