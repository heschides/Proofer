{
  // Copy this file to `appsettings.json` in the project root and fill in the
  // real connection string. `appsettings.json` is gitignored so that database
  // credentials never reach the repository — each machine keeps its own copy.
  //
  // The value is read by:
  //   App.xaml.cs             (runtime, via Host.CreateDefaultBuilder)
  //   Data/SatiContextFactory (design time, for `dotnet ef` migrations)
  //
  // Get the exact server name from the Azure Portal:
  //   SQL database -> Connection strings -> ADO.NET
  //
  // Entra ID (preferred - no password stored on disk):
  //   Server=tcp:YOUR-SERVER.database.windows.net,1433;Initial Catalog=Sati;Authentication=Active Directory Default;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;
  //
  // SQL authentication:
  //   Server=tcp:YOUR-SERVER.database.windows.net,1433;Initial Catalog=Sati;User ID=YOUR-USER;Password=YOUR-PASSWORD;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;

  "ConnectionStrings": {
    "SatiDb": ""
  }
}
