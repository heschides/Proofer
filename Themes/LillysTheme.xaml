<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- LILLY'S THEME: pearlescent cream with blush-pink and lavender shifts. -->
    <LinearGradientBrush x:Key="WindowBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFFDF5" Offset="0" />
        <GradientStop Color="#FFFCECF3" Offset="0.38" />
        <GradientStop Color="#FFF1ECFA" Offset="0.72" />
        <GradientStop Color="#FFFFF8ED" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="NavBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFF8E5EE" Offset="0" />
        <GradientStop Color="#FFEDE4F6" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SurfaceBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFFFFF" Offset="0" />
        <GradientStop Color="#FFFFF9F3" Offset="0.48" />
        <GradientStop Color="#FFF5EFFA" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F7EDF2" />
    <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#EEE2EA" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#FFFCF8" />
    <SolidColorBrush x:Key="SurfaceAlpha70Brush" Color="#B3FFFAF5" />
    <SolidColorBrush x:Key="SurfaceAlpha25Brush" Color="#40FFFAF5" />
    <SolidColorBrush x:Key="BorderBrush" Color="#DFC9D7" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#C9AFC0" />
    <SolidColorBrush x:Key="DividerBrush" Color="#E9DCE4" />

    <!-- Berry-pink controls anchor the pastel surfaces with accessible contrast. -->
    <SolidColorBrush x:Key="AccentBrush" Color="#95506F" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#7D405C" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#653248" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFAFC" />

    <!-- Local AI: a calm violet counterpoint to Lilly's blush accent. -->
    <Color x:Key="AiGlowColor">#FFAA8BC5</Color>
    <SolidColorBrush x:Key="AiAccentBrush" Color="#68558E" />
    <SolidColorBrush x:Key="AiAccentHoverBrush" Color="#7A66A2" />
    <SolidColorBrush x:Key="AiAccentPressedBrush" Color="#50406F" />
    <SolidColorBrush x:Key="AiAccentSoftBrush" Color="#EEE7F7" />
    <SolidColorBrush x:Key="AiAccentBorderBrush" Color="#C6B4D9" />
    <SolidColorBrush x:Key="OnAiAccentBrush" Color="#FDFBFF" />
    <SolidColorBrush x:Key="AiPanelTextBrush" Color="#4E3F6B" />

    <SolidColorBrush x:Key="HoverBrush" Color="#F1E3EC" />
    <SolidColorBrush x:Key="HoverStrongBrush" Color="#DEC8D7" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#3D313B" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#625360" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#6B5A68" />
    <SolidColorBrush x:Key="TextSubtleBrush" Color="#705F6D" />
    <SolidColorBrush x:Key="NarrativeTextBrush" Color="#64515F" />
    <SolidColorBrush x:Key="PersonGroupBrush" Color="#FFF9F6" />
    <SolidColorBrush x:Key="PersonGroupAltBrush" Color="#F5EAF2" />

    <Color x:Key="SurfaceAltColor">#FFF7EDF2</Color>
    <Color x:Key="SurfaceRaisedColor">#FFFFFCF8</Color>
    <Color x:Key="TextSubtleColor">#FF705F6D</Color>
</ResourceDictionary>
