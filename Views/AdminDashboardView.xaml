<UserControl x:Class="Sati.Views.AdminDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource WindowBackgroundBrush}"
             TextElement.FontFamily="{StaticResource AppFont}">
    <UserControl.Resources>
        <Style x:Key="AdminMetricCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,8,8" />
        </Style>
        <Style x:Key="AdminMetricLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="18,14,18,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Admin"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Overview.AgencyName, TargetNullValue=Agency overview}"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="  |  " Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBlock Text="{Binding LastRefreshedLabel}"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
            <Button Grid.Column="1"
                    Content="Refresh"
                    Command="{Binding RefreshCommand}"
                    Style="{StaticResource SmallButton}"
                    MinWidth="82"
                    AutomationProperties.Name="Refresh Admin dashboard" />
        </Grid>

        <StackPanel Grid.Row="1">
            <Border Background="#FFFFEFEF"
                    BorderBrush="#FFE8AAAA"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="10,7"
                    Margin="0,0,0,10"
                    AutomationProperties.LiveSetting="Assertive">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding StatusMessage}"
                           TextWrapping="Wrap"
                           Foreground="#FF8D2929" />
            </Border>
            <Border Background="{DynamicResource SuccessSoftBrush}"
                    BorderBrush="{DynamicResource SuccessBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="10,7"
                    Margin="0,0,0,10"
                    AutomationProperties.LiveSetting="Polite">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasNotice}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding NoticeMessage}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource SuccessStrongBrush}" />
            </Border>
        </StackPanel>

        <UniformGrid Grid.Row="2" Rows="2" Columns="4" Margin="0,0,0,4">
            <Border Style="{StaticResource AdminMetricCard}">
                <StackPanel>
                    <TextBlock Text="USERS" Style="{StaticResource AdminMetricLabel}" />
                    <TextBlock Text="{Binding Overview.UserCount, TargetNullValue=&#x2014;}"
                               FontSize="21" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource AdminMetricCard}">
                <StackPanel>
                    <TextBlock Text="CASE MANAGERS" Style="{StaticResource AdminMetricLabel}" />
                    <TextBlock Text="{Binding Overview.CaseManagerCount, TargetNullValue=&#x2014;}"
                               FontSize="21" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource AdminMetricCard}">
                <StackPanel>
                    <TextBlock Text="PEOPLE" Style="{StaticResource AdminMetricLabel}" />
                    <TextBlock Text="{Binding Overview.PersonCount, TargetNullValue=&#x2014;}"
                               FontSize="21" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource AdminMetricCard}">
                <StackPanel>
                    <TextBlock Text="NOTES THIS MONTH" Style="{StaticResource AdminMetricLabel}" />
                    <TextBlock Text="{Binding Overview.NotesThisMonth, TargetNullValue=&#x2014;}"
                               FontSize="21" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource AdminMetricCard}">
                <StackPanel>
                    <TextBlock Text="ACTIVE USERS / 30D" Style="{StaticResource AdminMetricLabel}" />
                    <TextBlock Text="{Binding Overview.ActiveUsersLast30Days, TargetNullValue=&#x2014;}"
                               FontSize="21" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource AdminMetricCard}">
                <StackPanel>
                    <TextBlock Text="SIGN-INS / 30D" Style="{StaticResource AdminMetricLabel}" />
                    <TextBlock Text="{Binding Overview.SuccessfulSignInsLast30Days, TargetNullValue=&#x2014;}"
                               FontSize="21" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource AdminMetricCard}">
                <StackPanel>
                    <TextBlock Text="PERSON CHANGES / 30D" Style="{StaticResource AdminMetricLabel}" />
                    <TextBlock Text="{Binding Overview.PersonChangesLast30Days, TargetNullValue=&#x2014;}"
                               FontSize="21" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource AdminMetricCard}">
                <StackPanel>
                    <TextBlock Text="AUDIT EVENTS TODAY" Style="{StaticResource AdminMetricLabel}" />
                    <TextBlock Text="{Binding Overview.AuditEventsToday, TargetNullValue=&#x2014;}"
                               FontSize="21" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="3"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="6" Padding="10"
                Margin="0,0,8,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,22,0">
                    <TextBlock Text="DATABASE" Style="{StaticResource AdminMetricLabel}" />
                    <TextBlock Text="{Binding Operations.DatabaseStatus, TargetNullValue=Not checked}"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,22,0">
                    <TextBlock Text="AUDIT RETENTION" Style="{StaticResource AdminMetricLabel}" />
                    <TextBlock FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}">
                        <Run Text="{Binding Operations.AuditRetentionDays, Mode=OneWay, TargetNullValue=&#x2014;}" />
                        <Run Text=" days" />
                    </TextBlock>
                    <TextBlock FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}">
                        <Run Text="{Binding Operations.AuditEventCount, Mode=OneWay, TargetNullValue=&#x2014;}" />
                        <Run Text=" retained" />
                    </TextBlock>
                    <TextBlock Text="{Binding Operations.OldestAuditEventUtc, StringFormat={}Oldest {0:yyyy-MM-dd}, TargetNullValue=No records}"
                               FontSize="9" Foreground="{DynamicResource TextMutedBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,22,0">
                    <TextBlock Text="EDI REPLAY RETENTION" Style="{StaticResource AdminMetricLabel}" />
                    <TextBlock FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}">
                        <Run Text="{Binding Operations.EdiReplayRetentionDays, Mode=OneWay, TargetNullValue=&#x2014;}" />
                        <Run Text=" days" />
                    </TextBlock>
                    <TextBlock FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}">
                        <Run Text="{Binding Operations.EdiReplayCount, Mode=OneWay, TargetNullValue=&#x2014;}" />
                        <Run Text=" files / " />
                        <Run Text="{Binding Operations.EdiReplayCharacters, Mode=OneWay, TargetNullValue=&#x2014;}" />
                        <Run Text=" chars" />
                    </TextBlock>
                    <TextBlock Text="{Binding Operations.OldestEdiReplayUtc, StringFormat={}Oldest {0:yyyy-MM-dd}, TargetNullValue=No records}"
                               FontSize="9" Foreground="{DynamicResource TextMutedBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="0,0,22,0">
                    <TextBlock Text="ENFORCEMENT" Style="{StaticResource AdminMetricLabel}" />
                    <TextBlock Text="{Binding Operations.RetentionEnforcementMode, TargetNullValue=Not checked}"
                               FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="4" Margin="0,0,10,0">
                    <TextBlock Text="EXPORT REASON (required; last 30 days)"
                               Style="{StaticResource AdminMetricLabel}" />
                    <TextBox Text="{Binding AuditExportReason, UpdateSourceTrigger=PropertyChanged}"
                             MinWidth="240" Padding="6,4"
                             AutomationProperties.Name="Audit export reason" />
                </StackPanel>
                <Button Grid.Column="5" Content="Download CSV"
                        Command="{Binding ExportAuditCsvCommand}"
                        Style="{StaticResource SmallButton}"
                        VerticalAlignment="Bottom"
                        AutomationProperties.Name="Download agency audit activity CSV" />
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="175" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="AGENCY INCIDENT HEALTH / 30D" Style="{StaticResource AdminMetricLabel}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Health.Score, TargetNullValue=&#x2014;}"
                                       FontSize="30" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Text="{Binding Health.Grade, TargetNullValue=Not measured}"
                                       Margin="10,10,0,0" FontSize="12"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>
                        <TextBlock FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}">
                            <Run Text="{Binding Health.TotalOccurrences, Mode=OneWay, TargetNullValue=0}" />
                            <Run Text=" occurrences | " />
                            <Run Text="{Binding Health.UnresolvedGroups, Mode=OneWay, TargetNullValue=0}" />
                            <Run Text=" unresolved groups" />
                        </TextBlock>
                        <TextBlock Text="{Binding Health.AlertLevel, TargetNullValue=Not evaluated}"
                                   Margin="0,7,0,0" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Text="{Binding Health.AlertReason}" TextWrapping="Wrap"
                                   FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="120" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding Health.Explanation}"
                                   FontSize="9" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Grid Grid.Row="1" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="125" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding IncidentSearch, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="5,3" Margin="0,0,6,0"
                                     AutomationProperties.Name="Search agency incidents" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding IncidentSeverityFilters}"
                                      SelectedItem="{Binding IncidentSeverityFilter}" Margin="0,0,6,0"
                                      AutomationProperties.Name="Filter incidents by severity" />
                            <ComboBox Grid.Column="2" ItemsSource="{Binding IncidentStatusFilters}"
                                      SelectedItem="{Binding IncidentStatusFilter}"
                                      AutomationProperties.Name="Filter incidents by status" />
                            <ComboBox Grid.Column="4" ItemsSource="{Binding IncidentStatuses}"
                                      SelectedItem="{Binding SelectedIncidentStatus}"
                                      AutomationProperties.Name="New incident status" />
                            <Button Grid.Column="5" Content="Update status" Margin="6,0,0,0"
                                    Command="{Binding UpdateIncidentStatusCommand}"
                                    Style="{StaticResource SmallButton}"
                                    AutomationProperties.Name="Update selected incident status" />
                        </Grid>
                        <DataGrid Grid.Row="2" ItemsSource="{Binding FilteredIncidents}"
                                  SelectedItem="{Binding SelectedIncident}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" CanUserAddRows="False"
                                  Margin="0,7,0,0"
                                  AutomationProperties.Name="Agency incident groups">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="SEVERITY" Binding="{Binding Severity}" Width="82" />
                                <DataGridTextColumn Header="FEATURE / OPERATION" Binding="{Binding Operation}" Width="2*" />
                                <DataGridTextColumn Header="SOURCE" Binding="{Binding Source}" Width="72" />
                                <DataGridTextColumn Header="COUNT" Binding="{Binding OccurrenceCount}" Width="60" />
                                <DataGridTextColumn Header="LAST SEEN (UTC)" Binding="{Binding LastSeenUtc, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="125" />
                                <DataGridTextColumn Header="RELEASE" Binding="{Binding LastRelease}" Width="72" />
                                <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="78" />
                                <DataGridTextColumn Header="REFERENCE" Binding="{Binding LastReference}" Width="120" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </Border>
            <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*" MinWidth="260" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="0.8*" MinWidth="210" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="1.35*" MinWidth="330" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="Recent activity" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="Successful protected actions during the last 30 days"
                                   FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding RecentActivity}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="0,0,0,1" Padding="0,7">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding ActionLabel}" FontWeight="SemiBold"
                                                           FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBlock FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}">
                                      <Run Text="{Binding ActorDisplayName, Mode=OneWay}" />
                                                    <Run Text="  |  " />
                                      <Run Text="{Binding ResourceLabel, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding OccurredAtLocal, StringFormat={}{0:MMM d, h:mm tt}}"
                                                       FontSize="9" Foreground="{DynamicResource TextMutedBrush}"
                                                       Margin="8,1,0,0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="People" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="Select a Person to inspect their lifecycle"
                                   FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding People}"
                             SelectedItem="{Binding SelectedPerson}"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,5">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <Border Margin="7,0,0,0"
                                                Padding="5,1"
                                                CornerRadius="3"
                                                Background="{DynamicResource WarningFillBrush}"
                                                BorderBrush="{DynamicResource WarningBrush}"
                                                BorderThickness="1"
                                                Visibility="{Binding IsTestData, Converter={StaticResource BoolToVisibilityConverter}}"
                                                AutomationProperties.Name="Test consumer">
                                            <TextBlock Text="TEST"
                                                       FontSize="8"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource WarningBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}">
                                        <Run Text="Revision " />
                                      <Run Text="{Binding Revision, Mode=OneWay}" />
                                        <Run Text="  |  " />
                                      <Run Text="{Binding AssignedUserDisplayName, Mode=OneWay}" />
                                        <Run Text="  |  " />
                                      <Run Text="{Binding Status, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="{Binding CreatedAtUtc, Converter={StaticResource CreatedAtLabelConverter}, Mode=OneWay}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="2">
                        <Border Visibility="{Binding HasSelectedPerson, Converter={StaticResource BoolToVisibilityConverter}}"
                                Padding="0,0,0,7">
                            <StackPanel>
                                <TextBlock Text="STATUS"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock FontSize="9"
                                           TextWrapping="Wrap"
                                           Margin="0,2,0,7"
                                           Foreground="{DynamicResource TextSecondaryBrush}">
                                    <Run Text="Archiving takes a consumer off the active caseload without deleting anything — reversible, and the only tool here that reaches a record outside the delete window. Currently: " />
                                    <Run Text="{Binding SelectedPerson.Status, Mode=OneWay}" FontWeight="SemiBold" />
                                    <Run Text="." />
                                </TextBlock>
                                <ComboBox ItemsSource="{Binding StatusChoices}"
                                          SelectedItem="{Binding SelectedTargetStatus, Mode=TwoWay}"
                                          HorizontalAlignment="Left"
                                          MinWidth="150"
                                          Margin="0,0,0,7"
                                          AutomationProperties.Name="New status for this consumer" />
                                <TextBlock Text="NOTE (optional)"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBox Text="{Binding StatusChangeNote, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="11"
                                         Margin="0,2,0,7"
                                         AutomationProperties.Name="Note for this status change" />
                                <Button Content="Set status"
                                        Command="{Binding SetPersonStatusCommand}"
                                        Style="{StaticResource SmallButton}"
                                        HorizontalAlignment="Left"
                                        AutomationProperties.HelpText="Changes the selected consumer's status. Non-destructive and reversible."
                                        AutomationProperties.Name="Set consumer status" />
                            </StackPanel>
                        </Border>
                        <Border BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,1,0,0"
                                Padding="0,9,0,7"
                                Margin="0,8,0,0"
                                Visibility="{Binding NoDeletionPathAvailableReason, Converter={StaticResource NullToVisibilityConverter}}">
                            <TextBlock Text="{Binding NoDeletionPathAvailableReason}"
                                       FontSize="9"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       AutomationProperties.Name="Why deletion is unavailable for this consumer" />
                        </Border>
                        <Border BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,1,0,0"
                                Padding="0,9,0,0"
                                Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="TEST DATA ONLY"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="Available only when the selected consumer was marked Test at creation. This cannot be undone."
                                           FontSize="9"
                                           TextWrapping="Wrap"
                                           Margin="0,2,0,7"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <Button Content="Delete test consumer"
                                        Command="{Binding DeleteTestConsumerCommand}"
                                        Style="{StaticResource SmallButton}"
                                        Background="#FF7A3B3B"
                                        Foreground="White"
                                        HorizontalAlignment="Left"
                                        AutomationProperties.HelpText="Permanently deletes the selected consumer and their test records after confirmation."
                                        AutomationProperties.Name="Delete selected test consumer" />
                            </StackPanel>
                        </Border>
                        <Border Visibility="{Binding IsSelectedPersonWithinDeletionWindow, Converter={StaticResource BoolToVisibilityConverter}}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,1,0,0"
                                Padding="0,9,0,0"
                                Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="RECENTLY CREATED"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="Created within the last 20 days. May be permanently deleted with a reason and a legal-hold and billing check. This cannot be undone."
                                           FontSize="9"
                                           TextWrapping="Wrap"
                                           Margin="0,2,0,7"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="REASON (kept permanently in the audit record — do not include the client's name or other identifying detail)"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBox Text="{Binding ConsumerDeletionReason, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="11"
                                         Margin="0,2,0,7"
                                         AutomationProperties.Name="Reason for deleting this consumer"
                                         AutomationProperties.HelpText="Kept permanently in the audit record. Do not include the client's name or other identifying detail." />
                                <Button Content="Delete consumer (created in error)"
                                        Command="{Binding DeleteConsumerInWindowCommand}"
                                        Style="{StaticResource SmallButton}"
                                        Background="#FF7A3B3B"
                                        Foreground="White"
                                        HorizontalAlignment="Left"
                                        AutomationProperties.HelpText="Permanently deletes the selected consumer, created within the last 20 days, after confirmation."
                                        AutomationProperties.Name="Delete selected recently created consumer" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="4"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Person lifecycle" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding SelectedPerson.DisplayName, TargetNullValue=Select a Person}"
                                       FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Download PDF"
                                Command="{Binding ExportPersonAuditPdfCommand}"
                                Style="{StaticResource SmallButton}"
                                AutomationProperties.Name="Download Person lifecycle audit PDF" />
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding PersonHistory}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="4"
                                            Margin="0,0,0,9" Padding="9">
                                        <StackPanel>
                                            <Border Background="{DynamicResource TextPrimaryBrush}"
                                                    CornerRadius="3" Padding="7,4" Margin="0,0,0,5">
                                                <TextBlock Foreground="{DynamicResource WindowBackgroundBrush}"
                                                           FontSize="11" FontWeight="SemiBold">
                                                    <Run Text="Version " />
                                      <Run Text="{Binding Version, Mode=OneWay}" />
                                                    <Run Text="  &#x2014;  " />
                                      <Run Text="{Binding ChangeKind, Mode=OneWay}" />
                                                </TextBlock>
                                            </Border>
                                            <TextBlock FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Margin="0,0,0,5">
                                      <Run Text="{Binding ActorDisplayName, Mode=OneWay}" />
                                                <Run Text="  |  " />
                                      <Run Text="{Binding ChangedAtUtc, Mode=OneWay, StringFormat={}{0:yyyy-MM-dd HH:mm} UTC}" />
                                            </TextBlock>
                                            <ItemsControl ItemsSource="{Binding Changes}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="0,3,0,4">
                                                            <TextBlock Text="{Binding Label}" FontSize="10" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource AccentBrush}" />
                                                            <TextBlock FontSize="10" TextWrapping="Wrap"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}">
                                                                <Run Text="Previous: " FontWeight="SemiBold" />
                                      <Run Text="{Binding PreviousValue, Mode=OneWay, TargetNullValue=Not recorded}" />
                                                            </TextBlock>
                                                            <TextBlock FontSize="10" TextWrapping="Wrap"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}">
                                                                <Run Text="New value: " FontWeight="SemiBold" />
                                      <Run Text="{Binding NewValue, Mode=OneWay, TargetNullValue=Not recorded}" />
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
