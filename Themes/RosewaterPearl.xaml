<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ROSEWATER PEARL: milky blush balanced with a trace of cool lavender. -->
    <LinearGradientBrush x:Key="WindowBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFFCFA" Offset="0" />
        <GradientStop Color="#FFFBEFF0" Offset="0.44" />
        <GradientStop Color="#FFF3F1F5" Offset="0.75" />
        <GradientStop Color="#FFFFF7F3" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="NavBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFF8E9EA" Offset="0" />
        <GradientStop Color="#FFEEE8ED" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SurfaceBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFFFFF" Offset="0" />
        <GradientStop Color="#FFFFF9F8" Offset="0.5" />
        <GradientStop Color="#FFF4EFF2" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F5E9EA" />
    <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#EDDFE1" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#FFFBFA" />
    <SolidColorBrush x:Key="SurfaceAlpha70Brush" Color="#B3FFF9F8" />
    <SolidColorBrush x:Key="SurfaceAlpha25Brush" Color="#40FFF9F8" />
    <SolidColorBrush x:Key="BorderBrush" Color="#E2D2D5" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#CCB8BD" />
    <SolidColorBrush x:Key="DividerBrush" Color="#EBDDE0" />
    <SolidColorBrush x:Key="AccentBrush" Color="#B87482" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#9D5E6C" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#814B58" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFF9FA" />
    <!-- Local AI: soft aubergine, distinct but harmonious with rosewater. -->
    <Color x:Key="AiGlowColor">#FF9B7BA8</Color>
    <SolidColorBrush x:Key="AiAccentBrush" Color="#765886" />
    <SolidColorBrush x:Key="AiAccentHoverBrush" Color="#896A99" />
    <SolidColorBrush x:Key="AiAccentPressedBrush" Color="#5B4168" />
    <SolidColorBrush x:Key="AiAccentSoftBrush" Color="#F0E7F3" />
    <SolidColorBrush x:Key="AiAccentBorderBrush" Color="#C8B2CF" />
    <SolidColorBrush x:Key="OnAiAccentBrush" Color="#FFF9FF" />
    <SolidColorBrush x:Key="AiPanelTextBrush" Color="#553E61" />
    <SolidColorBrush x:Key="HoverBrush" Color="#EFE1E3" />
    <SolidColorBrush x:Key="HoverStrongBrush" Color="#D8C3C8" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#403638" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#79696D" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#95858A" />
    <SolidColorBrush x:Key="TextSubtleBrush" Color="#B09FA4" />
    <SolidColorBrush x:Key="NarrativeTextBrush" Color="#625257" />
    <SolidColorBrush x:Key="PersonGroupBrush" Color="#FFF9F9" />
    <SolidColorBrush x:Key="PersonGroupAltBrush" Color="#F3E9ED" />
    <Color x:Key="SurfaceAltColor">#FFF5E9EA</Color>
    <Color x:Key="SurfaceRaisedColor">#FFFFFBFA</Color>
    <Color x:Key="TextSubtleColor">#FFB09FA4</Color>
</ResourceDictionary>
