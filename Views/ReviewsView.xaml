<UserControl x:Class="Sati.Views.ReviewsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:Sati.Converters"
             xmlns:local="clr-namespace:Sati"
             Background="{DynamicResource WindowBackgroundBrush}">

    <UserControl.Resources>
        <converters:ReviewStageToBrushConverter x:Key="StageToBrush" />

        <!-- Strips the built-in "Select a date" watermark. DatePicker renders it
             from DatePickerTextBox's template, so the only way to remove it is to
             supply a template without the watermark part. PART_ContentHost must
             keep its name — DatePickerTextBox looks it up by name to host the
             editable text. Scoped to this view's resources so app-wide DatePickers
             keep their watermark. -->
        <Style TargetType="DatePickerTextBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePickerTextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LabelStyle"
               TargetType="TextBlock">
            <Setter Property="FontSize"
                    Value="11" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="Foreground"
                    Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Margin"
                    Value="0,0,0,5" />
        </Style>

        <Style x:Key="SectionHeader"
               TargetType="TextBlock">
            <Setter Property="FontSize"
                    Value="13" />
            <Setter Property="FontWeight"
                    Value="Bold" />
            <Setter Property="Foreground"
                    Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Margin"
                    Value="0,0,0,8" />
        </Style>

        <!-- One block per review item. Fill encodes stage; the letter names the
             category. Foreground flips light on the two dark fills so the label
             stays legible without a second converter. -->
        <DataTemplate x:Key="CellBlockTemplate">
            <Border Height="22"
                    Margin="1"
                    Padding="7,0"
                    CornerRadius="3"
                    Background="{Binding Stage, Converter={StaticResource StageToBrush}}"
                    ToolTip="{Binding Tooltip}">
                <TextBlock Text="{Binding ShortLabel}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource NarrativeTextBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Stage}"
                                             Value="Received">
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource WindowBackgroundBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Stage}"
                                             Value="Logged">
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource WindowBackgroundBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>
        </DataTemplate>

        <!-- Current-quarter outline. One style per quarter because a DataTrigger
             can only test equality against a literal — it can't compare two
             bindings — so each needs its own IsQnCurrent binding. The shared
             geometry lives on the base style; only the trigger differs.
             Border sits outside the Button so it can't interfere with the
             QuarterCellButton style's IsMouseOver trigger. -->
        <Style x:Key="QuarterOutlineBase"
               TargetType="Border">
            <Setter Property="BorderBrush"
                    Value="Transparent" />
            <Setter Property="BorderThickness"
                    Value="2" />
            <Setter Property="CornerRadius"
                    Value="5" />
            <Setter Property="Margin"
                    Value="2" />
        </Style>

        <Style x:Key="Q1Outline"
               TargetType="Border"
               BasedOn="{StaticResource QuarterOutlineBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsQ1Current}"
                             Value="True">
                    <Setter Property="BorderBrush"
                            Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Q2Outline"
               TargetType="Border"
               BasedOn="{StaticResource QuarterOutlineBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsQ2Current}"
                             Value="True">
                    <Setter Property="BorderBrush"
                            Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Q3Outline"
               TargetType="Border"
               BasedOn="{StaticResource QuarterOutlineBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsQ3Current}"
                             Value="True">
                    <Setter Property="BorderBrush"
                            Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Q4Outline"
               TargetType="Border"
               BasedOn="{StaticResource QuarterOutlineBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsQ4Current}"
                             Value="True">
                    <Setter Property="BorderBrush"
                            Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A quarter cell: the blocks for that quarter, wrapped, inside a button
             so the whole cell is the click target for selection. -->
        <Style x:Key="QuarterCellButton"
               TargetType="Button">
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="BorderThickness"
                    Value="0" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="HorizontalContentAlignment"
                    Value="Left" />
            <Setter Property="Padding"
                    Value="4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter Property="Background"
                                        Value="{DynamicResource SurfaceAltBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══ HEADER ═══ -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="0,0,0,12">
            <TextBlock Text="REVIEWS"
                       FontSize="13"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0" />

                <Button Command="{Binding RefreshCommand}"
                        AutomationProperties.Name="Refresh reviews"
                    ToolTip="Reload and generate any missing review items"
                    Width="32"
                    Height="32"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand">
                <TextBlock Text="&#xE72C;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="14"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </Button>

            <!-- View toggle. Unchecked = relative (current quarter only, with the
                 explainer); checked = all four quarters. Glyph swaps to signal the
                 mode: a single column vs. a grid. The two layouts in Row 1 collapse
                 against IsChecked via the BoolToVisibility converter. -->
            <ToggleButton IsChecked="{Binding ShowAllQuarters}"
                          Width="32"
                          Height="32"
                          Background="Transparent"
                          BorderThickness="0"
                          Cursor="Hand"
                          Margin="4,0,0,0">
                <ToggleButton.Style>
                    <Style TargetType="ToggleButton">
                        <Setter Property="ToolTip"
                                Value="Showing each client's current quarter — click to show all four" />
                        <Style.Triggers>
                            <Trigger Property="IsChecked"
                                     Value="True">
                                <Setter Property="ToolTip"
                                        Value="Showing all four quarters — click to show current quarter only" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ToggleButton.Style>
                <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <!-- E71D: single column (relative) -->
                                        <Setter Property="Text"
                                                Value="&#xE71D;" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChecked,
                                                         RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                         Value="True">
                                                <!-- E80A: grid (absolute) -->
                                                <Setter Property="Text"
                                                        Value="&#xE80A;" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter Property="Background"
                                        Value="{DynamicResource SurfaceAltBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </ToggleButton.Template>
            </ToggleButton>

            <TextBlock Text="Loading…"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       FontSize="12"
                       VerticalAlignment="Center"
                       Margin="8,0,0,0"
                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" />
        </StackPanel>

        <!-- ═══ CASELOAD GRID — ABSOLUTE (all four quarters) ═══ -->
        <Border Grid.Row="1"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Visibility="{Binding ShowAllQuarters, Converter={StaticResource BoolToVisibilityConverter}}">
            <DataGrid AutomationProperties.Name="Review rows" ItemsSource="{Binding Rows}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserSortColumns="False"
                      HeadersVisibility="Column"
                      Background="Transparent"
                      BorderThickness="0"
                      RowBackground="{DynamicResource SurfaceBrush}"
                      AlternatingRowBackground="{DynamicResource WindowBackgroundBrush}"
                      GridLinesVisibility="All"
                      HorizontalGridLinesBrush="{DynamicResource DividerBrush}"
                      VerticalGridLinesBrush="{DynamicResource DividerBrush}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Client"
                                            Width="180">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="13"
                                           VerticalAlignment="Center"
                                           Margin="8,4"
                                           ToolTip="{Binding SurplusTooltip}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Q1"
                                            Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Q1Outline}">
                                <Button Style="{StaticResource QuarterCellButton}"
                                        AutomationProperties.Name="{Binding DisplayName, StringFormat={}Quarter 1 reviews for {0}}"
                                            Command="{Binding DataContext.SelectCellCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Q1Selection}">
                                        <ItemsControl ItemsSource="{Binding Q1Cells}"
                                                      ItemTemplate="{StaticResource CellBlockTemplate}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </Button>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Q2"
                                            Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Q2Outline}">
                                <Button Style="{StaticResource QuarterCellButton}"
                                        AutomationProperties.Name="{Binding DisplayName, StringFormat={}Quarter 2 reviews for {0}}"
                                            Command="{Binding DataContext.SelectCellCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Q2Selection}">
                                        <ItemsControl ItemsSource="{Binding Q2Cells}"
                                                      ItemTemplate="{StaticResource CellBlockTemplate}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </Button>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Q3"
                                            Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Q3Outline}">
                                <Button Style="{StaticResource QuarterCellButton}"
                                        AutomationProperties.Name="{Binding DisplayName, StringFormat={}Quarter 3 reviews for {0}}"
                                            Command="{Binding DataContext.SelectCellCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Q3Selection}">
                                        <ItemsControl ItemsSource="{Binding Q3Cells}"
                                                      ItemTemplate="{StaticResource CellBlockTemplate}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </Button>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Q4"
                                            Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Q4Outline}">
                                <Button Style="{StaticResource QuarterCellButton}"
                                        AutomationProperties.Name="{Binding DisplayName, StringFormat={}Quarter 4 reviews for {0}}"
                                            Command="{Binding DataContext.SelectCellCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Q4Selection}">
                                        <ItemsControl ItemsSource="{Binding Q4Cells}"
                                                      ItemTemplate="{StaticResource CellBlockTemplate}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </Button>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ═══ CASELOAD GRID — RELATIVE (current quarter only) + EXPLAINER ═══
             Same Row 1 as the absolute grid; the two are mutually exclusive on
             ShowAllQuarters. Left: one column, each client's current quarter.
             Right: fixed-width onboarding panel with a geometry backdrop and a
             legend pulled from the real stage brushes. -->
        <Grid Grid.Row="1"
              Visibility="{Binding ShowAllQuarters, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="540" />
            </Grid.ColumnDefinitions>

            <!-- Single-column grid -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Margin="0,0,12,0">
                <DataGrid AutomationProperties.Name="Review rows" ItemsSource="{Binding Rows}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserSortColumns="False"
                          HeadersVisibility="Column"
                          Background="Transparent"
                          BorderThickness="0"
                          RowBackground="{DynamicResource SurfaceBrush}"
                          AlternatingRowBackground="{DynamicResource WindowBackgroundBrush}"
                          GridLinesVisibility="All"
                          HorizontalGridLinesBrush="{DynamicResource DividerBrush}"
                          VerticalGridLinesBrush="{DynamicResource DividerBrush}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Client"
                                                Width="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontSize="13"
                                               VerticalAlignment="Center"
                                               Margin="8,4"
                                               ToolTip="{Binding SurplusTooltip}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- The window in which this client's current-quarter
                             review is actionable: ReviewOpenDaysBefore back from
                             the Q_R form's due date, through the due date. Amber
                             when today falls inside it; red when the due date has
                             passed with the form still incomplete. -->
                        <DataGridTemplateColumn Header="Window"
                                                Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding WindowDisplay}"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               Margin="8,4">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <!-- Default covers the no-cycle case,
                                                     where all three flags are false. -->
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource TextSecondaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsWindowUpcoming}"
                                                                 Value="True">
                                                        <Setter Property="Foreground"
                                                                Value="{DynamicResource AccentBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsWindowOpen}"
                                                                 Value="True">
                                                        <Setter Property="Foreground"
                                                                Value="{DynamicResource InfoBrush}" />
                                                        <Setter Property="FontWeight"
                                                                Value="SemiBold" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsWindowClosed}"
                                                                 Value="True">
                                                        <Setter Property="Foreground"
                                                                Value="{DynamicResource OverdueBrush}" />
                                                        <Setter Property="FontWeight"
                                                                Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- The one data column: the client's current quarter.
                             No outline style — "current" is the only thing shown,
                             so highlighting it would be redundant. -->
                        <DataGridTemplateColumn Header="Current Quarter"
                                                Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                            <Button Style="{StaticResource QuarterCellButton}"
                                    AutomationProperties.Name="{Binding DisplayName, StringFormat={}Current quarter reviews for {0}}"
                                            Command="{Binding DataContext.SelectCellCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding CurrentQuarterSelection}">
                                        <ItemsControl ItemsSource="{Binding CurrentQuarterCells}"
                                                      ItemTemplate="{StaticResource CellBlockTemplate}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Explainer panel -->
            <Border Grid.Column="1"
                    CornerRadius="6"
                    ClipToBounds="True"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1">
                <Grid>
                    <!-- Geometry backdrop: palette gradient + soft off-edge rings.
                         Pure shape, recolors with the theme, no image asset. -->
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0"
                                                 EndPoint="1,1">
                                <GradientStop Color="{DynamicResource SurfaceRaisedColor}"
                                              Offset="0" />
                                <GradientStop Color="{DynamicResource SurfaceAltColor}"
                                              Offset="1" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Canvas>
                        <Ellipse Canvas.Left="180"
                                 Canvas.Top="-90"
                                 Width="280"
                                 Height="280"
                                 Stroke="{DynamicResource BorderBrush}"
                                 StrokeThickness="18"
                                 Opacity="0.35" />
                        <Ellipse Canvas.Left="230"
                                 Canvas.Top="-40"
                                 Width="180"
                                 Height="180"
                                 Stroke="{DynamicResource InputBorderBrush}"
                                 StrokeThickness="14"
                                 Opacity="0.30" />
                        <Ellipse Canvas.Left="-70"
                                 Canvas.Top="420"
                                 Width="260"
                                 Height="260"
                                 Stroke="{DynamicResource InputBorderBrush}"
                                 StrokeThickness="16"
                                 Opacity="0.25" />
                    </Canvas>

                    <!-- Content -->
                    <StackPanel Margin="22,24,22,24">
                        <TextBlock Text="90-Day Reviews"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="Each client's quarterly reviews, tracked from request to completion."
                                   FontSize="12.5"
                                   Foreground="{DynamicResource NarrativeTextBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,18" />

                        <!-- Legend. Swatch colors come from the same hex values as
                             ReviewStageToBrushConverter; if that palette changes,
                             update these to match. -->
                        <StackPanel>
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,0,0,9">
                                <Border Width="26"
                                        Height="18"
                                        CornerRadius="3"
                                        Background="{DynamicResource SurfaceAltBrush}"
                                        Margin="0,0,10,0" />
                                <StackPanel>
                                    <TextBlock Text="Not Started"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="Nothing recorded yet for this item."
                                               FontSize="11"
                                               Foreground="{DynamicResource NarrativeTextBrush}" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        Margin="0,0,0,9">
                                <Border Width="26"
                                        Height="18"
                                        CornerRadius="3"
                                        Background="{DynamicResource AccentBrush}"
                                        Margin="0,0,10,0" />
                                <StackPanel>
                                    <TextBlock Text="Requested"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="You've asked the provider for the documentation."
                                               FontSize="11"
                                               Foreground="{DynamicResource NarrativeTextBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        Margin="0,0,0,9">
                                <Border Width="26"
                                        Height="18"
                                        CornerRadius="3"
                                        Background="{DynamicResource InfoFillBrush}"
                                        Margin="0,0,10,0" />
                                <StackPanel>
                                    <TextBlock Text="Received"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="The documentation has come back."
                                               FontSize="11"
                                               Foreground="{DynamicResource NarrativeTextBrush}" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        Margin="0,0,0,0">
                                <Border Width="26"
                                        Height="18"
                                        CornerRadius="3"
                                        Background="{DynamicResource CompliantBrush}"
                                        Margin="0,0,10,0" />
                                <StackPanel>
                                    <TextBlock Text="Logged"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="The date is entered; this quarter's 90-day review is complete."
                                               FontSize="11"
                                               Foreground="{DynamicResource NarrativeTextBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <Border Height="1"
                                Background="{DynamicResource BorderBrush}"
                                Margin="0,18,0,14" />

                        <TextBlock FontSize="11"
                                   Foreground="{DynamicResource NarrativeTextBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10">
                            <Run Text="By default, each client shows only their " />
                            <Run Text="current quarter"
                                 FontWeight="SemiBold" />
                            <Run Text=". Use the toggle above to see all four." />
                        </TextBlock>

                        <TextBlock FontSize="11"
                                   Foreground="{DynamicResource NarrativeTextBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10">
                            <Run Text="The items shown per client adjust with the services on that client's record, under the " />
                            <Run Text="Clients"
                                 FontWeight="SemiBold" />
                            <Run Text=" tab." />
                        </TextBlock>
                        
                        <TextBlock FontSize="11"
                                   Foreground="{DynamicResource NarrativeTextBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10">
    <Run Text="The Medical tile signifies doctor appointment dates.  The Dental tile, dentist appointments.  The Goals tile represents the Goals portion of a PCP revised for the 90-day review.  The Employment tab represents documentation required for consumers who work without work supports.  Additional tiles are for service provider notes required for quarterly reviews. " />
                            
                        </TextBlock>

                        <TextBlock FontSize="11"
                                   Foreground="{DynamicResource NarrativeTextBrush}"
                                   TextWrapping="Wrap">
<Run Text="When you select a row within the Current Quarter column, you'll be able to enter dates for when the items were requested, received, and logged." />

                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══ DETAIL PANE ═══ -->
        <Border Grid.Row="3"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="16"
                Visibility="{Binding HasSelectedCell, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="{Binding DetailHeader}"
                           Style="{StaticResource SectionHeader}" />

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="130" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1"
                               Text="REQUESTED"
                               Style="{StaticResource LabelStyle}" />
                    <TextBlock Grid.Column="2"
                               Text="RECEIVED"
                               Style="{StaticResource LabelStyle}" />
                    <TextBlock Grid.Column="3"
                               Text="LOGGED"
                               Style="{StaticResource LabelStyle}" />
                </Grid>

                <ItemsControl ItemsSource="{Binding DetailCells}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{Binding DisplayName}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="13"
                                           VerticalAlignment="Center" />

                                <DatePicker AutomationProperties.Name="Requested date" Grid.Column="1"
                                            SelectedDate="{Binding RequestedDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Margin="0,0,8,0" />
                                <DatePicker AutomationProperties.Name="Received date" Grid.Column="2"
                                            SelectedDate="{Binding ReceivedDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Margin="0,0,8,0" />
                                <DatePicker AutomationProperties.Name="Logged date" Grid.Column="3"
                                            SelectedDate="{Binding LoggedDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                <!-- Appointment capture — Medical and Dental only, now on
                                     the same row as the stage pickers, right of LOGGED.
                                     The date is the anchor: clearing it removes the
                                     appointment; a provider typed with no date won't
                                     persist on its own. Provider commits on LostFocus to
                                     avoid a write per keystroke. Cluster collapses whole
                                     on non-appointment categories, leaving the row as it
                                     was before. -->
                                <StackPanel Grid.Column="5"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding IsAppointmentCategory, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="Appointment"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0" />
                                    <DatePicker AutomationProperties.Name="Appointment date" Width="120"
                                                SelectedDate="{Binding AppointmentDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Margin="0,0,10,0" />
                                    <TextBlock Text="with"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0" />
                                    <TextBox AutomationProperties.Name="Provider Name" Width="180"
                                             VerticalAlignment="Center"
                                             Text="{Binding ProviderName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
