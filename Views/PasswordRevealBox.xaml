<UserControl x:Class="Sati.Views.PasswordRevealBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="36"
             Focusable="False">

    <!-- One bordered field containing the entry control and the reveal toggle,
         so the eye sits INSIDE the box the way people expect rather than
         floating beside it. The border lives here rather than on the inner
         controls because there are two of them and only one may be visible at a
         time — a border on each would jump as they swap. -->
    <Border x:Name="FieldSurface"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource HoverStrongBrush}"
            BorderThickness="1">
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <!-- The inner controls are borderless, so without this the
                         field would give no focus feedback at all. -->
                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Masked entry: the source of truth at all times. Even while the
                 plain-text box is showing, edits are written back here, so
                 SecurePassword and PasswordChanged behave exactly as they did
                 before this control existed. -->
            <PasswordBox x:Name="Masked"
                         Grid.Column="0"
                         BorderThickness="0"
                         Background="Transparent"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         FontSize="14"
                         Padding="10,0"
                         VerticalContentAlignment="Center"
                         PasswordChanged="OnMaskedPasswordChanged" />

            <!-- Shown only while revealed. Collapsed rather than hidden so it
                 takes no space and cannot be tabbed into while invisible. -->
            <TextBox x:Name="Revealed"
                     Grid.Column="0"
                     Visibility="Collapsed"
                     BorderThickness="0"
                     Background="Transparent"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     FontSize="14"
                     Padding="10,0"
                     VerticalContentAlignment="Center"
                     TextChanged="OnRevealedTextChanged" />

            <ToggleButton x:Name="RevealToggle"
                          Grid.Column="1"
                          Width="34"
                          Background="Transparent"
                          BorderThickness="0"
                          Cursor="Hand"
                          Focusable="True"
                          AutomationProperties.Name="Show password"
                          ToolTip="Show password"
                          Checked="OnRevealToggled"
                          Unchecked="OnRevealToggled">
                <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ToggleSurface"
                                Background="Transparent"
                                SnapsToDevicePixels="True">
                            <TextBlock x:Name="Glyph"
                                       FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE7B3;"
                                       FontSize="15"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Revealed state is carried by the GLYPH as well as
                                 by colour, so it reads for someone who cannot
                                 distinguish the accent hue. -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Glyph" Property="Text" Value="&#xED1A;" />
                                <Setter TargetName="Glyph" Property="Foreground"
                                        Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleSurface" Property="Background"
                                        Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ToggleSurface" Property="Background"
                                        Value="{DynamicResource HoverBrush}" />
                                <Setter TargetName="Glyph" Property="Foreground"
                                        Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </ToggleButton.Template>
            </ToggleButton>
        </Grid>
    </Border>
</UserControl>
