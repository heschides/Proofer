<UserControl x:Class="Sati.Views.HelpersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FDF6EC"
             TextElement.FontFamily="{StaticResource AppFont}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- SUB-NAV BAR -->
        <Border Grid.Row="0"
                Background="#F5EAD8"
                BorderBrush="#E8D0B8"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <StackPanel Orientation="Horizontal">

                <!-- Reference -->
                <Border Cursor="Hand"
                        CornerRadius="4"
                        Padding="10,4"
                        Margin="0,0,4,0">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick"
                                      Command="{Binding NavigateToReferenceCommand}" />
                    </Border.InputBindings>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background"
                                    Value="Transparent" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsReferenceActive}"
                                             Value="True">
                                    <Setter Property="Background"
                                            Value="#3D2B1F" />
                                </DataTrigger>
                                <Trigger Property="IsMouseOver"
                                         Value="True">
                                    <Setter Property="Background"
                                            Value="#EDD9C0" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="Reference"
                               FontSize="13">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground"
                                        Value="#9C7A5C" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsReferenceActive}"
                                                 Value="True">
                                        <Setter Property="Foreground"
                                                Value="#FDF6EC" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <!-- AT Requests -->
                <Border Cursor="Hand"
                        CornerRadius="4"
                        Padding="10,4"
                        Margin="0,0,4,0">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick"
                                      Command="{Binding NavigateToATRequestsCommand}" />
                    </Border.InputBindings>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background"
                                    Value="Transparent" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsATRequestsActive}"
                                             Value="True">
                                    <Setter Property="Background"
                                            Value="#3D2B1F" />
                                </DataTrigger>
                                <Trigger Property="IsMouseOver"
                                         Value="True">
                                    <Setter Property="Background"
                                            Value="#EDD9C0" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="AT Requests"
                               FontSize="13">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground"
                                        Value="#9C7A5C" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsATRequestsActive}"
                                                 Value="True">
                                        <Setter Property="Foreground"
                                                Value="#FDF6EC" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

            </StackPanel>
        </Border>

        <!-- ACTIVE SUB-VIEW -->
        <ContentControl Grid.Row="1"
                        Content="{Binding CurrentSubViewModel}" />
    </Grid>
</UserControl>