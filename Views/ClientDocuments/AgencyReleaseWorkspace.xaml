<UserControl x:Class="Sati.Views.ClientDocuments.AgencyReleaseWorkspace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource WindowBackgroundBrush}"
             DataContextChanged="OnDataContextChanged">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="ReleaseCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="ReleaseField" TargetType="TextBox">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0,2,0,8" />
        </Style>
        <Style x:Key="ReleaseCombo" TargetType="ComboBox">
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="Margin" Value="0,2,0,8" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource ReleaseCard}" Margin="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding WorkspaceTitle}"
                               FontSize="11" FontWeight="Bold"
                               Foreground="{DynamicResource AccentPressedBrush}" />
                    <TextBlock Text="{Binding PersonName}"
                               Margin="0,4,0,4" FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock Text="{Binding WorkspaceDescription}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="Release type" Style="{StaticResource LabelStyle}" Margin="0,7,0,0" />
                    <ComboBox ItemsSource="{Binding ReleaseKindChoices}"
                              SelectedItem="{Binding SelectedReleaseKind}"
                              DisplayMemberPath="DisplayName"
                              Width="220" HorizontalAlignment="Left"
                              AutomationProperties.Name="Release document type" />
                </StackPanel>
                <Border Grid.Column="2"
                        Padding="12" CornerRadius="6"
                        Background="{DynamicResource WarningSoftBrush}"
                        BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="AUTHORIZATION, NOT A PROFILE INFERENCE"
                                   FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Margin="0,4,0,0"
                                   Text="Every permission below must reflect the consumer's direction. The generated PDF includes consumer signature lines. A staff attestation records who prepared it, but is not the consumer's electronic signature."
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                      AutomationProperties.Name="Agency release entry form">
            <StackPanel>
                <Border Style="{StaticResource ReleaseCard}">
                    <StackPanel>
                        <TextBlock Text="1  AUTHORIZATION STATUS" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="Did the consumer or legally responsible person authorize the agency to use and disclose the information described below?"
                                   Margin="0,4,0,8" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="Authorization granted *" Style="{StaticResource LabelStyle}" />
                        <ComboBox ItemsSource="{Binding YesNoChoices}"
                                  SelectedItem="{Binding AuthorizationChoice}"
                                  DisplayMemberPath="DisplayName"
                                  Style="{StaticResource ReleaseCombo}"
                                  Width="180" HorizontalAlignment="Left"
                                  AutomationProperties.Name="Whether authorization was granted" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ReleaseCard}">
                    <StackPanel>
                        <TextBlock Text="2  RECIPIENT / CONTACT" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="Who will receive the information, or from whom will the agency obtain it?"
                                   Margin="0,4,0,10" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="Contact type *" Style="{StaticResource LabelStyle}" />
                                <ComboBox ItemsSource="{Binding ContactTypeChoices}" Text="{Binding ContactType, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="True" Style="{StaticResource ReleaseCombo}"
                                          AutomationProperties.Name="Release contact type" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="Contact name *" Style="{StaticResource LabelStyle}" />
                                <TextBox Text="{Binding ContactName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ReleaseField}"
                                         AutomationProperties.Name="Release contact name" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0">
                                <TextBlock Text="Relationship" Style="{StaticResource LabelStyle}" />
                                <TextBox Text="{Binding Relationship, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ReleaseField}"
                                         AutomationProperties.Name="Relationship to consumer" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2">
                                <TextBlock Text="Telephone *" Style="{StaticResource LabelStyle}" />
                                <TextBox Text="{Binding ContactPhone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ReleaseField}"
                                         AutomationProperties.Name="Release contact telephone" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
                                <TextBlock Text="Street address *" Style="{StaticResource LabelStyle}" />
                                <TextBox Text="{Binding ContactAddress, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ReleaseField}"
                                         AutomationProperties.Name="Release contact street address" />
                            </StackPanel>
                            <StackPanel Grid.Row="3" Grid.Column="0">
                                <TextBlock Text="City" Style="{StaticResource LabelStyle}" />
                                <TextBox Text="{Binding ContactCity, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ReleaseField}"
                                         AutomationProperties.Name="Release contact city" />
                            </StackPanel>
                            <StackPanel Grid.Row="3" Grid.Column="2">
                                <TextBlock Text="State" Style="{StaticResource LabelStyle}" />
                                <TextBox Text="{Binding ContactState, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ReleaseField}"
                                         MaxLength="2" AutomationProperties.Name="Release contact state" />
                            </StackPanel>
                            <StackPanel Grid.Row="4" Grid.Column="0">
                                <TextBlock Text="Fax" Style="{StaticResource LabelStyle}" />
                                <TextBox Text="{Binding ContactFax, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ReleaseField}"
                                         AutomationProperties.Name="Release contact fax" />
                            </StackPanel>
                            <StackPanel Grid.Row="4" Grid.Column="2">
                                <TextBlock Text="Email" Style="{StaticResource LabelStyle}" />
                                <TextBox Text="{Binding ContactEmail, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ReleaseField}"
                                         AutomationProperties.Name="Release contact email" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ReleaseCard}">
                    <StackPanel>
                        <TextBlock Text="3  INFORMATION COVERED" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="Choose every category the consumer authorized."
                                   Margin="0,4,0,9" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <ItemsControl ItemsSource="{Binding InformationCategories}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsSelected}"
                                              Width="260" Margin="0,4,12,4" Padding="2"
                                              AutomationProperties.Name="{Binding DisplayName}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Other information description" Style="{StaticResource LabelStyle}" Margin="0,8,0,0" />
                        <TextBox Text="{Binding OtherInformation, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ReleaseField}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="58"
                                 AutomationProperties.Name="Other information covered by release" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ReleaseCard}">
                    <StackPanel>
                        <TextBlock Text="4  DATES AND DISCLOSURE SCOPE" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="Sati enforces the reference form's maximums: 90 days for one-time disclosure and one year for multiple disclosures."
                                   Margin="0,4,0,10" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Disclosure scope *" Style="{StaticResource LabelStyle}" />
                                <ComboBox ItemsSource="{Binding ScopeChoices}" SelectedItem="{Binding SelectedScope}"
                                          DisplayMemberPath="DisplayName" Style="{StaticResource ReleaseCombo}"
                                          AutomationProperties.Name="One-time or multiple disclosures" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Start date *" Style="{StaticResource LabelStyle}" />
                                <DatePicker SelectedDate="{Binding StartDate}" Padding="6,4"
                                            AutomationProperties.Name="Release start date" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Expiration date *" Style="{StaticResource LabelStyle}" />
                                <DatePicker SelectedDate="{Binding ExpirationDate}" Padding="6,4"
                                            AutomationProperties.Name="Release expiration date" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ReleaseCard}">
                    <StackPanel>
                        <TextBlock Text="5  SPECIAL PERMISSIONS" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="Each answer is required and is printed separately from the general record categories."
                                   Margin="0,4,0,10" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="170" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Include drug/alcohol treatment or diagnosis information?" TextWrapping="Wrap" Margin="0,7,12,8" />
                            <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding YesNoChoices}" SelectedItem="{Binding DrugAlcoholChoice}"
                                      DisplayMemberPath="DisplayName" Style="{StaticResource ReleaseCombo}"
                                      AutomationProperties.Name="Drug and alcohol information permission" />
                            <TextBlock Grid.Row="1" Text="Include mental/behavioral health treatment information?" TextWrapping="Wrap" Margin="0,7,12,8" />
                            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding YesNoChoices}" SelectedItem="{Binding MentalHealthChoice}"
                                      DisplayMemberPath="DisplayName" Style="{StaticResource ReleaseCombo}"
                                      AutomationProperties.Name="Mental health information permission" />
                            <TextBlock Grid.Row="2" Text="Include HIV/AIDS status, testing, or diagnosis information?" TextWrapping="Wrap" Margin="0,7,12,8" />
                            <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding YesNoChoices}" SelectedItem="{Binding HivAidsChoice}"
                                      DisplayMemberPath="DisplayName" Style="{StaticResource ReleaseCombo}"
                                      AutomationProperties.Name="HIV and AIDS information permission" />
                            <TextBlock Grid.Row="3" Text="May the agency release authorized information without the consumer's prior review?" TextWrapping="Wrap" Margin="0,7,12,8" />
                            <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding YesNoChoices}" SelectedItem="{Binding ReleaseWithoutReviewChoice}"
                                      DisplayMemberPath="DisplayName" Style="{StaticResource ReleaseCombo}"
                                      AutomationProperties.Name="Release without prior review permission" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ReleaseCard}">
                    <StackPanel>
                        <TextBlock Text="6  REVOCATION AND COMPLETION" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <CheckBox Content="This document revokes the authorization"
                                  IsChecked="{Binding IsRevocation}" Margin="0,8,0,6"
                                  AutomationProperties.Name="Generate as a revocation" />
                        <StackPanel Visibility="{Binding IsRevocation, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="Revocation effective date *" Style="{StaticResource LabelStyle}" />
                            <DatePicker SelectedDate="{Binding RevokedOn}" Width="220" HorizontalAlignment="Left"
                                        Padding="6,4" Margin="0,2,0,8"
                                        AutomationProperties.Name="Release revocation date" />
                        </StackPanel>
                        <Border Margin="0,8,0,0" Padding="12" CornerRadius="6"
                                Background="{DynamicResource PersonGroupAltBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <CheckBox Content="I obtained the consumer's authorization and want to attach my staff attestation"
                                          IsChecked="{Binding DidObtainRoi}" FontWeight="SemiBold"
                                          AutomationProperties.Name="Attach staff attestation that authorization was obtained" />
                                <TextBlock Margin="24,5,0,0" TextWrapping="Wrap"
                                           Text="If unchecked, Sati generates a draft. If checked, Sati asks for confirmation and records the authenticated user and generation time. It does not sign for the consumer."
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="4" Padding="12" CornerRadius="7"
                Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding ValidationMessage}" TextWrapping="Wrap"
                               Foreground="{DynamicResource DangerStrongBrush}" AutomationProperties.LiveSetting="Assertive" />
                    <TextBlock Text="{Binding StatusMessage}" Margin="0,3,12,0" TextWrapping="Wrap" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" AutomationProperties.LiveSetting="Polite" />
                    <ProgressBar Height="3" Margin="0,8,12,0" IsIndeterminate="True"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Clear" Command="{Binding ClearCommand}" Padding="13,7" Margin="0,0,8,0"
                            Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" />
                    <Button Content="{Binding GenerateButtonText}" Command="{Binding GenerateCommand}"
                            IsEnabled="{Binding CanGenerate}" Padding="16,7" FontWeight="SemiBold"
                            AutomationProperties.Name="Generate and save agency release PDF" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
