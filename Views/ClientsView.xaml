<UserControl x:Class="Sati.Views.ClientsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Sati"
        xmlns:converters="clr-namespace:Sati.Converters"
        xmlns:helpers="clr-namespace:Sati.Helpers"
        Background="#FDF6EC">

    <UserControl.Resources>
        <converters:BoolToWidthConverter x:Key="BoolToWidthConverter" />
        <converters:BoolToWidthConverter x:Key="SpacerWidthConverter"
                                         TrueWidth="16"
                                         FalseWidth="0" />
        <helpers:BindingProxy x:Key="LayoutProxy"
                              Data="{Binding}" />

        <converters:BoolToGridLengthConverter x:Key="RosterRowHeight"
                                              TrueLength="260"
                                              TrueUnit="Pixel"
                                              FalseLength="1"
                                              FalseUnit="Star" />
        <converters:BoolToGridLengthConverter x:Key="SpacerRowHeight"
                                              TrueLength="12"
                                              TrueUnit="Pixel"
                                              FalseLength="0"
                                              FalseUnit="Pixel" />
        <converters:BoolToGridLengthConverter x:Key="DetailRowHeight"
                                              TrueLength="1"
                                              TrueUnit="Star"
                                              FalseLength="0"
                                              FalseUnit="Pixel" />
        <!-- Dot-grid fill for the Journal. A DrawingBrush tiling a single 2px dot in
             the palette's border tone at a 16px pitch. Viewport is absolute (Viewport
             + ViewportUnits=Absolute), so the dot stays a fixed size and the grid
             density doesn't stretch with the box. TileMode=Tile repeats it. Faint by
             color choice, not opacity, so it doesn't dim text drawn over it. -->
        <DrawingBrush x:Key="JournalDotBrush"
                      TileMode="Tile"
                      Viewport="0,0,16,16"
                      ViewportUnits="Absolute"
                      Stretch="None">
            <DrawingBrush.Drawing>
                <GeometryDrawing Brush="#E8D0B8">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="8,8"
                                         RadiusX="1"
                                         RadiusY="1" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <Style x:Key="LabelStyle"
               TargetType="TextBlock">
            <Setter Property="FontSize"
                    Value="11" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="Foreground"
                    Value="#9C7A5C" />
            <Setter Property="Margin"
                    Value="0,0,0,5" />
        </Style>

        <Style x:Key="SectionHeader"
               TargetType="TextBlock">
            <Setter Property="FontSize"
                    Value="13" />
            <Setter Property="FontWeight"
                    Value="Bold" />
            <Setter Property="Foreground"
                    Value="#3D2B1F" />
            <Setter Property="Margin"
                    Value="0,0,0,8" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground"
                    Value="#3D2B1F" />
            <Setter Property="Margin"
                    Value="0,0,0,6" />
        </Style>


        <Style x:Key="IconButton"
               TargetType="Button">
            <Setter Property="Width"
                    Value="32" />
            <Setter Property="Height"
                    Value="32" />
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="BorderThickness"
                    Value="0" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter Property="Background"
                                        Value="#E8D0B8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding IsEntryPanelOpen, Converter={StaticResource BoolToWidthConverter}}" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ═══ ENTRY FORM (left) ═══ -->
        <Border Grid.Column="0"
                Background="White"
                BorderBrush="#E8D0B8"
                BorderThickness="1"
                CornerRadius="6"
                Padding="16"
                Visibility="{Binding IsEntryPanelOpen, 
  Converter={StaticResource BoolToVisibilityConverter}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{Binding EntryPanelHeader}"
                               FontSize="13"
                               FontWeight="Bold"
                           Foreground="#3D2B1F"
                           Margin="0,0,0,16" />

                <TextBlock Text="FIRST NAME"
                           Style="{StaticResource LabelStyle}" />
                <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="LAST NAME"
                           Style="{StaticResource LabelStyle}" />
                <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="BIRTHDAY"
                           Style="{StaticResource LabelStyle}" />
                <DatePicker SelectedDate="{Binding BirthDate, Mode=TwoWay}" />

                <TextBlock Text="WAIVER"
                           Style="{StaticResource LabelStyle}" />
                <ComboBox ItemsSource="{Binding Waivers}"
                          SelectedItem="{Binding Waiver, Mode=TwoWay}" />

                <TextBlock Text="EFFECTIVE DATE"
                           Style="{StaticResource LabelStyle}" />
                <Grid Margin="0,0,0,10"
                      IsEnabled="{Binding HasWaiver}">
                    <TextBox Text="{Binding EffectiveDateText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="MM/DD"
                               Foreground="#C0A898"
                               FontSize="13"
                               Margin="9,4"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility"
                                        Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EffectiveDateText}"
                                                 Value="">
                                        <Setter Property="Visibility"
                                                Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    </Grid>

                    <TextBlock Text="BIO"
                               Style="{StaticResource LabelStyle}" />
                    <TextBox Text="{Binding Bio, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Height="100" />

                    <TextBlock Text="EVERGREEN ID"
                               Style="{StaticResource LabelStyle}" />
                    <TextBox Text="{Binding EvergreenId, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="PHONE"
                               Style="{StaticResource LabelStyle}" />
                    <TextBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="ADDRESS"
                           Style="{StaticResource LabelStyle}" />
                <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="PRIMARY CARE PROVIDER"
                           Style="{StaticResource LabelStyle}" />
                <TextBox Text="{Binding PrimaryCareProvider, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="HEALTHCARE SYSTEM"
                           Style="{StaticResource LabelStyle}" />
                <ComboBox ItemsSource="{Binding HealthcareSystems}"
                          DisplayMemberPath="Name"
                          SelectedValuePath="Name"
                          SelectedValue="{Binding HealthcareSystemName, Mode=TwoWay}" />

                <CheckBox Content="Open with VR"
                          IsChecked="{Binding OpenWithVR}"
                          Margin="0,12,0,6" />

                    <CheckBox Content="Has guardian"
                              IsChecked="{Binding HasGuardian}" />
                    <TextBox Text="{Binding GuardianName, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding HasGuardian, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <TextBlock Text="WAIVER SERVICES"
                               Style="{StaticResource LabelStyle}"
                               Margin="0,16,0,6" />

                    <CheckBox Content="Home support"
                              IsChecked="{Binding HasHomeSupport}" />
                    <CheckBox Content="Self-directed home support"
                              IsChecked="{Binding HasSelfDirectedHomeSupport}" />
                    <CheckBox Content="Shared living"
                              IsChecked="{Binding HasSharedLiving}" />
                    <CheckBox Content="Community support 1:1"
                              IsChecked="{Binding HasCommunitySupport1To1}" />
                    <CheckBox Content="Community support self-directed"
                              IsChecked="{Binding HasCommunitySupportSelfDirected}" />
                    <CheckBox Content="Day program"
                              IsChecked="{Binding HasCommunitySupportDayProgram}" />

                    <!-- Reveal pattern borrowed from HasGuardian/GuardianName. Bound
                     LostFocus rather than PropertyChanged: the VM clamps values
                     below 1 up to 1, and clamping on every keystroke makes the
                     field impossible to clear and retype. -->
                    <StackPanel Orientation="Horizontal"
                                Margin="20,0,0,6"
                                Visibility="{Binding HasCommunitySupportDayProgram, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="How many?"
                                   Foreground="#3D2B1F"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <TextBox Text="{Binding DayProgramCount, UpdateSourceTrigger=LostFocus}"
                                 Width="48" />
                    </StackPanel>

                    <CheckBox Content="Employed"
                              IsChecked="{Binding IsEmployed}"
                              Margin="0,12,0,6" />

                    <CheckBox Content="Employment specialist"
                              IsChecked="{Binding HasEmploymentSpecialist}"
                              IsEnabled="{Binding IsEmployed}"
                              Margin="20,0,0,6" />
                    <CheckBox Content="Work supports"
                              IsChecked="{Binding HasWorkSupports}"
                              IsEnabled="{Binding IsEmployed}"
                              Margin="20,0,0,6" />

                    <Button Content="{Binding SubmitButtonLabel}"
                            Style="{StaticResource PrimaryButton}"
                        Command="{Binding SubmitCommand}" 
                            Margin="0,0,0,10"/>

                <Button Content="Remove Selected"
                        Style="{StaticResource DangerButton}"
                        Command="{Binding RemoveSelectedPersonCommand}" />
            </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Chevron rail — always visible; toggles the entry panel. Mirrors the
             Today's Work rail in ShellWindow, but sits to the right of its panel
             rather than the left, so the chevron directions are reversed: the arrow
             points the way the panel's outer edge will move. -->
        <Border Grid.Column="1"
                BorderThickness="1,0,1,0"
                Margin="0,0,8,0">
            <Button Command="{Binding ToggleEntryPanelCommand}"
                    Width="24"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    VerticalAlignment="Center"
                    ToolTip="Show or hide the client form">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <TextBlock FontFamily="Segoe MDL2 Assets"
                           FontSize="14"
                           Foreground="#9C7A5C">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <!-- Closed: points right = expand outward from the edge -->
                            <Setter Property="Text"
                                    Value="&#xE76C;" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEntryPanelOpen}"
                                             Value="True">
                                    <!-- Open: points left = collapse toward the edge -->
                                    <Setter Property="Text"
                                            Value="&#xE76B;" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Button>
        </Border>

        <!-- ═══ RIGHT PANEL ═══ -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="{Binding Data.HasSelectedPerson, Source={StaticResource LayoutProxy}, Converter={StaticResource RosterRowHeight}}" />
                <RowDefinition Height="{Binding Data.HasSelectedPerson, Source={StaticResource LayoutProxy}, Converter={StaticResource SpacerRowHeight}}" />
                <RowDefinition Height="{Binding Data.HasSelectedPerson, Source={StaticResource LayoutProxy}, Converter={StaticResource DetailRowHeight}}" />
            </Grid.RowDefinitions>

            <!-- ═══ CLIENT ROSTER ═══ -->
            <Border Grid.Row="0"
                    Background="White"
                    BorderBrush="#E8D0B8"
                    BorderThickness="1"
                    CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal"
                                Margin="16,12,16,8">
                        <TextBlock Text="CLIENTS"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="#3D2B1F"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0" />
                        <Button Style="{StaticResource IconButton}"
                                Command="{Binding OpenEntryPanelCommand}"
                                ToolTip="Clear the form to add a new client">
                            <TextBlock Text="&#xE72C;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"
                                       Foreground="#9C7A5C" />
                        </Button>
                    </StackPanel>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding People}"
                              SelectedItem="{Binding SelectedPerson, Mode=TwoWay}"
                              MouseDoubleClick="DataGrid_MouseDoubleClick"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              Background="Transparent"
                              BorderThickness="0"
                              RowBackground="White"
                              AlternatingRowBackground="#FDF6EC"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#F0E0D0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="First Name"
                                                Binding="{Binding FirstName}"
                                                Width="*" />
                            <DataGridTextColumn Header="Last Name"
                                                Binding="{Binding LastName}"
                                                Width="*" />
                            <DataGridTextColumn Header="Waiver"
                                                Binding="{Binding Waiver}"
                                                Width="*" />
                            <DataGridTextColumn Header="Effective Date"
                                                Binding="{Binding EffectiveDate, StringFormat={}{0:MM/dd/yyyy}}"
                                                Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- ═══ CLIENT DETAIL PANEL ═══ -->
            <Border Grid.Row="2"
                    Background="White"
                    BorderBrush="#E8D0B8"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="16"
                    Visibility="{Binding HasSelectedPerson,
                        Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- CLIENT INFO -->
                    <StackPanel Grid.Column="0"
                                Grid.Row="0"
                                Grid.RowSpan="3">
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,12">
                            <TextBlock Text="{Binding SelectedPerson.FullName}"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="#3D2B1F" />
                        </StackPanel>

                        <TextBlock Text="WAIVER"
                                   Style="{StaticResource LabelStyle}" />
                        <TextBlock Text="{Binding SelectedPerson.Waiver}"
                                   Foreground="#3D2B1F"
                                   FontSize="13"
                                   Margin="0,0,0,10" />

                        <TextBlock Text="EFFECTIVE DATE"
                                   Style="{StaticResource LabelStyle}" />
                        <TextBlock Text="{Binding SelectedPerson.EffectiveDate, StringFormat={}{0:MM/dd/yyyy}}"
                                   Foreground="#3D2B1F"
                                   FontSize="13"
                                   Margin="0,0,0,10" />

                        <TextBlock Text="DATE OF BIRTH"
                                   Style="{StaticResource LabelStyle}" />
                        <TextBlock Text="{Binding SelectedPerson.BirthDate, StringFormat={}{0:MM/dd/yyyy}}"
                                   Foreground="#3D2B1F"
                                   FontSize="13"
                                   Margin="0,0,0,10" />

                        <TextBlock Text="LAST CONTACT"
                                   Style="{StaticResource LabelStyle}" />
                        <TextBlock Text="{Binding LastContact, StringFormat={}{0:MM/dd/yyyy}, TargetNullValue=—}"
                                   Foreground="#3D2B1F"
                                   FontSize="13"
                                   Margin="0,0,0,10" />

                        <TextBlock Text="EVERGREEN ID"
                                   Style="{StaticResource LabelStyle}" />
                        <TextBlock Text="{Binding SelectedPerson.EvergreenId}"
                                   Foreground="#3D2B1F"
                                   FontSize="13"
                                   Margin="0,0,0,10" />

                        <TextBlock Text="PHONE"
                                   Style="{StaticResource LabelStyle}" />
                        <TextBlock Text="{Binding SelectedPerson.PhoneNumber}"
                                   Foreground="#3D2B1F"
                                   FontSize="13"
                                   Margin="0,0,0,10" />
                        
                        <TextBlock Text="ADDRESS"
                                   Style="{StaticResource LabelStyle}" />
                        <TextBlock Text="{Binding SelectedPerson.Address}"
                                   Foreground="#3D2B1F"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10" />

                        <TextBlock Text="PRIMARY CARE PROVIDER"
                                   Style="{StaticResource LabelStyle}" />
                        <TextBlock Text="{Binding SelectedPerson.PrimaryCareProvider}"
                                   Foreground="#3D2B1F"
                                   FontSize="13"
                                   Margin="0,0,0,10" />

                        <TextBlock Text="HEALTHCARE SYSTEM"
                                   Style="{StaticResource LabelStyle}" />
                        <TextBlock Text="{Binding SelectedPerson.HealthcareSystemName}"
                                   Foreground="#3D2B1F"
                                   FontSize="13"
                                   Margin="0,0,0,10" />

                        <TextBlock Text="GUARDIAN"
                                   Style="{StaticResource LabelStyle}"
                                   Visibility="{Binding SelectedPerson.HasGuardian, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <TextBlock Text="{Binding SelectedPerson.GuardianName}"
                                   Foreground="#3D2B1F"
                                   FontSize="13"
                                   Margin="0,0,0,10"
                                   Visibility="{Binding SelectedPerson.HasGuardian, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <TextBlock Text="Open with VR"
                                   Foreground="#3D2B1F"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,10"
                                   Visibility="{Binding SelectedPerson.OpenWithVR, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <TextBlock Text="SERVICES"
                                   Style="{StaticResource LabelStyle}"
                                   Visibility="{Binding HasSelectedPersonServices, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <TextBlock Text="{Binding SelectedPersonServices}"
                                   Foreground="#3D2B1F"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10"
                                   Visibility="{Binding HasSelectedPersonServices, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <TextBlock Text="Employment tracking required"
                                   Foreground="#3D2B1F"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10"
                                   Visibility="{Binding ShowsEmploymentTracking, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <TextBlock Text="BIO"
                                   Style="{StaticResource LabelStyle}" />
                        <TextBlock Text="{Binding SelectedPerson.Bio}"
                                   Foreground="#3D2B1F"
                                   FontSize="13"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- FORMS COMPLIANCE -->
                    <Grid Grid.Column="2"
                          Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0"
                                    Orientation="Horizontal"
                                    Margin="0,0,0,8">
                            <TextBlock Text="FORMS"
                                       Style="{StaticResource SectionHeader}"
                                       Margin="0,0,12,0"
                                       VerticalAlignment="Center" />
                            <Button Style="{StaticResource IconButton}"
                                    Command="{Binding ToggleComplianceOverrideCommand}"
                                    ToolTip="Toggle compliance editing">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           FontSize="14"
                                           Foreground="#9C7A5C">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text"
                                                    Value="&#xE72E;" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AllowComplianceOverride}"
                                                             Value="True">
                                                    <Setter Property="Text"
                                                            Value="&#xE785;" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                        </StackPanel>

                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           Text="90-Day Reviews"
                                           Style="{StaticResource SectionHeader}" />
                                <StackPanel Grid.Row="1"
                                            Grid.Column="0">
                                    <CheckBox Content="Quarter 1"
                                              IsChecked="{Binding Q1RCompliant, Mode=OneWay}"
                                              IsEnabled="{Binding AllowComplianceOverride}"
                                              Command="{Binding ToggleFormCommand}"
                                              CommandParameter="{x:Static local:FormType.Q1R}" />
                                    <TextBlock Text="{Binding Q1RDueDate, StringFormat={}{0:MM/dd/yy}}"
                                               Foreground="#9C7A5C"
                                               FontSize="11"
                                               Margin="20,1,0,4" />
                                </StackPanel>
                                <StackPanel Grid.Row="2"
                                            Grid.Column="0">
                                    <CheckBox Content="Quarter 2"
                                              IsChecked="{Binding Q2RCompliant, Mode=OneWay}"
                                              IsEnabled="{Binding AllowComplianceOverride}"
                                              Command="{Binding ToggleFormCommand}"
                                              CommandParameter="{x:Static local:FormType.Q2R}" />
                                    <TextBlock Text="{Binding Q2RDueDate, StringFormat={}{0:MM/dd/yy}}"
                                               Foreground="#9C7A5C"
                                               FontSize="11"
                                               Margin="20,1,0,4" />
                                </StackPanel>
                                <StackPanel Grid.Row="3"
                                            Grid.Column="0">
                                    <CheckBox Content="Quarter 3"
                                              IsChecked="{Binding Q3RCompliant, Mode=OneWay}"
                                              IsEnabled="{Binding AllowComplianceOverride}"
                                              Command="{Binding ToggleFormCommand}"
                                              CommandParameter="{x:Static local:FormType.Q3R}" />
                                    <TextBlock Text="{Binding Q3RDueDate, StringFormat={}{0:MM/dd/yy}}"
                                               Foreground="#9C7A5C"
                                               FontSize="11"
                                               Margin="20,1,0,4" />
                                </StackPanel>
                                <StackPanel Grid.Row="4"
                                            Grid.Column="0">
                                    <CheckBox Content="Quarter 4"
                                              IsChecked="{Binding Q4RCompliant, Mode=OneWay}"
                                              IsEnabled="{Binding AllowComplianceOverride}"
                                              Command="{Binding ToggleFormCommand}"
                                              CommandParameter="{x:Static local:FormType.Q4R}" />
                                    <TextBlock Text="{Binding Q4RDueDate, StringFormat={}{0:MM/dd/yy}}"
                                               Foreground="#9C7A5C"
                                               FontSize="11"
                                               Margin="20,1,0,4" />
                                </StackPanel>

                                <TextBlock Grid.Row="0"
                                           Grid.Column="2"
                                           Text="Annual Forms"
                                           Style="{StaticResource SectionHeader}" />
                                <StackPanel Grid.Row="1"
                                            Grid.Column="2">
                                    <CheckBox Content="PCP"
                                              IsChecked="{Binding PcpCompliant, Mode=OneWay}"
                                              IsEnabled="{Binding AllowComplianceOverride}"
                                              Command="{Binding ToggleFormCommand}"
                                              CommandParameter="{x:Static local:FormType.PCP}" />
                                    <TextBlock Text="{Binding PcpDueDate, StringFormat={}{0:MM/dd/yy}}"
                                               Foreground="#9C7A5C"
                                               FontSize="11"
                                               Margin="20,1,0,4" />
                                </StackPanel>
                                <StackPanel Grid.Row="2"
                                            Grid.Column="2">
                                    <CheckBox Content="Comp Assessment"
                                              IsChecked="{Binding CompAssessmentCompliant, Mode=OneWay}"
                                              IsEnabled="{Binding AllowComplianceOverride}"
                                              Command="{Binding ToggleFormCommand}"
                                              CommandParameter="{x:Static local:FormType.ComprehensiveAssessment}" />
                                    <TextBlock Text="{Binding CompAssessmentDueDate, StringFormat={}{0:MM/dd/yy}}"
                                               Foreground="#9C7A5C"
                                               FontSize="11"
                                               Margin="20,1,0,4" />
                                </StackPanel>
                                <StackPanel Grid.Row="3"
                                            Grid.Column="2">
                                    <CheckBox Content="Reclassification"
                                              IsChecked="{Binding ReclassificationCompliant, Mode=OneWay}"
                                              IsEnabled="{Binding AllowComplianceOverride}"
                                              Command="{Binding ToggleFormCommand}"
                                              CommandParameter="{x:Static local:FormType.Reclassification}" />
                                    <TextBlock Text="{Binding ReclassificationDueDate, StringFormat={}{0:MM/dd/yy}}"
                                               Foreground="#9C7A5C"
                                               FontSize="11"
                                               Margin="20,1,0,4" />
                                </StackPanel>
                                <StackPanel Grid.Row="4"
                                            Grid.Column="2">
                                    <CheckBox Content="Safety Plan"
                                              IsChecked="{Binding SafetyPlanCompliant, Mode=OneWay}"
                                              IsEnabled="{Binding AllowComplianceOverride}"
                                              Command="{Binding ToggleFormCommand}"
                                              CommandParameter="{x:Static local:FormType.SafetyPlan}" />
                                    <TextBlock Text="{Binding SafetyPlanDueDate, StringFormat={}{0:MM/dd/yy}}"
                                               Foreground="#9C7A5C"
                                               FontSize="11"
                                               Margin="20,1,0,4" />
                                </StackPanel>
                                <StackPanel Grid.Row="5"
                                            Grid.Column="2">
                                    <CheckBox Content="Privacy Practices"
                                              IsChecked="{Binding PrivacyPracticesCompliant, Mode=OneWay}"
                                              IsEnabled="{Binding AllowComplianceOverride}"
                                              Command="{Binding ToggleFormCommand}"
                                              CommandParameter="{x:Static local:FormType.PrivacyPractices}" />
                                    <TextBlock Text="{Binding PrivacyPracticesDueDate, StringFormat={}{0:MM/dd/yy}}"
                                               Foreground="#9C7A5C"
                                               FontSize="11"
                                               Margin="20,1,0,4" />
                                </StackPanel>

                                <TextBlock Grid.Row="0"
                                           Grid.Column="4"
                                           Text="Releases"
                                           Style="{StaticResource SectionHeader}" />
                                <StackPanel Grid.Row="1"
                                            Grid.Column="4">
                                    <CheckBox Content="DHHS"
                                              IsChecked="{Binding ReleaseDhhsCompliant, Mode=OneWay}"
                                              IsEnabled="{Binding AllowComplianceOverride}"
                                              Command="{Binding ToggleFormCommand}"
                                              CommandParameter="{x:Static local:FormType.Release_DHHS}" />
                                    <TextBlock Text="{Binding ReleaseDhhsDueDate, StringFormat={}{0:MM/dd/yy}}"
                                               Foreground="#9C7A5C"
                                               FontSize="11"
                                               Margin="20,1,0,4" />
                                </StackPanel>
                                <StackPanel Grid.Row="2"
                                            Grid.Column="4">
                                    <CheckBox Content="Agency"
                                              IsChecked="{Binding ReleaseAgencyCompliant, Mode=OneWay}"
                                              IsEnabled="{Binding AllowComplianceOverride}"
                                              Command="{Binding ToggleFormCommand}"
                                              CommandParameter="{x:Static local:FormType.Release_Agency}" />
                                    <TextBlock Text="{Binding ReleaseAgencyDueDate, StringFormat={}{0:MM/dd/yy}}"
                                               Foreground="#9C7A5C"
                                               FontSize="11"
                                               Margin="20,1,0,4" />
                                </StackPanel>
                                <StackPanel Grid.Row="3"
                                            Grid.Column="4">
                                    <CheckBox Content="Medical"
                                              IsChecked="{Binding ReleaseMedicalCompliant, Mode=OneWay}"
                                              IsEnabled="{Binding AllowComplianceOverride}"
                                              Command="{Binding ToggleFormCommand}"
                                              CommandParameter="{x:Static local:FormType.Release_Medical}" />
                                    <TextBlock Text="{Binding ReleaseMedicalDueDate, StringFormat={}{0:MM/dd/yy}}"
                                               Foreground="#9C7A5C"
                                               FontSize="11"
                                               Margin="20,1,0,4" />
                                </StackPanel>

                                <!-- Appointments: latest doctor/dentist for the
                                     selected client. Date tints #A33 when >365 days
                                     stale (per category); dash when none on record.
                                     Read on selection, not from the caseload load. -->
                                <TextBlock Grid.Row="0"
                                           Grid.Column="6"
                                           Text="Appointments"
                                           Style="{StaticResource SectionHeader}" />
                                <StackPanel Grid.Row="1"
                                            Grid.Column="6">
                                    <TextBlock Text="Doctor"
                                               Foreground="#3D2B1F"
                                               FontSize="13" />
                                    <TextBlock Text="{Binding LastDoctorDate, StringFormat={}{0:MM/dd/yy}, TargetNullValue=—}"
                                               FontSize="11"
                                               Margin="20,1,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#9C7A5C" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDoctorOverdue}" Value="True">
                                                        <Setter Property="Foreground" Value="#A33" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding DoctorName}"
                                               Foreground="#9C7A5C"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Margin="20,0,0,4" />
                                </StackPanel>
                                <StackPanel Grid.Row="2"
                                            Grid.Column="6">
                                    <TextBlock Text="Dentist"
                                               Foreground="#3D2B1F"
                                               FontSize="13" />
                                    <TextBlock Text="{Binding LastDentistDate, StringFormat={}{0:MM/dd/yy}, TargetNullValue=—}"
                                               FontSize="11"
                                               Margin="20,1,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#9C7A5C" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDentistOverdue}" Value="True">
                                                        <Setter Property="Foreground" Value="#A33" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding DentistName}"
                                               Foreground="#9C7A5C"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Margin="20,0,0,4" />
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </Grid>

                    <!-- NOTES HISTORY + JOURNAL — split the bottom-right cell so the
                         per-consumer journal sits beside the read-only notes list. The
                         3*/2* split gives notes the larger share; both scale with the
                         panel. Journal auto-saves 2s after typing stops (debounced in
                         the VM), plus on client-switch and shutdown — no Save button,
                         matching the app's auto-save-over-dialogs convention. -->
                    <Grid Grid.Column="2"
                          Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>

                        <!-- NOTES HISTORY -->
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="NOTES"
                                       Style="{StaticResource SectionHeader}" />

                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding SelectedPersonNotes}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      RowBackground="White"
                                      AlternatingRowBackground="#FDF6EC"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#F0E0D0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Date"
                                                        Binding="{Binding EventDate, StringFormat={}{0:MM/dd}}"
                                                        Width="60" />
                                    <DataGridTextColumn Header="Status"
                                                        Binding="{Binding Status}"
                                                        Width="80" />
                                    <DataGridTextColumn Header="Narrative"
                                                        Binding="{Binding Narrative}"
                                                        Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>

                        <!-- JOURNAL -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="JOURNAL"
                                       Style="{StaticResource SectionHeader}" />

                            <!-- Pattern layer sits UNDER the TextBox in the same cell:
                                 the dot brush fills a Border, the TextBox draws over it
                                 with a ~70%-opaque cream background (#B3FDF6EC) so the
                                 dots read faintly through the fill without dimming text.
                                 The Border carries the visible frame now, so the TextBox
                                 drops its own border to avoid a double edge. -->
                            <Border Grid.Row="1"
                                    Background="{StaticResource JournalDotBrush}"
                                    BorderBrush="#E8D0B8"
                                    BorderThickness="1"
                                    CornerRadius="2" />

                            <!-- UpdateSourceTrigger=PropertyChanged so the debounce
                                 timer sees each keystroke; without it the VM's Journal
                                 wouldn't update until focus loss and the 2s save
                                 wouldn't fire mid-typing. Indefinitely long: wraps and
                                 scrolls vertically, no height cap of its own — the row's
                                 * share bounds it and the ScrollViewer takes overflow. -->
                            <TextBox Grid.Row="1"
                                     Text="{Binding Journal, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     SpellCheck.IsEnabled="True"
                                     FontFamily="{StaticResource NarrativeFont}"
                                     Background="#40FDF6EC"
                                     BorderThickness="0"
                                     Padding="8" />
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>