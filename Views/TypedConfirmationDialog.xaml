<Window x:Class="Sati.Views.TypedConfirmationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        FocusManager.FocusedElement="{Binding ElementName=CancelButton}">

    <Window.Resources>
        <!-- Neutral button: the safe default, low-emphasis so the eye isn't pulled
             to it. Cancel lives here. -->
        <Style x:Key="NeutralButton"
               TargetType="Button">
            <Setter Property="Height"
                    Value="34" />
            <Setter Property="MinWidth"
                    Value="90" />
            <Setter Property="Margin"
                    Value="0,0,8,0" />
            <Setter Property="Background"
                    Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="Foreground"
                    Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize"
                    Value="13" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="14,0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Action button: the consequential one. Always destructive-red here — this
             dialog exists only for actions serious enough to need typed confirmation.
             Disabled (dimmed) until the typed text matches, so the button itself is
             evidence of intent, not just a click. -->
        <Style x:Key="ActionButton"
               TargetType="Button">
            <Setter Property="Height"
                    Value="34" />
            <Setter Property="MinWidth"
                    Value="90" />
            <Setter Property="Background"
                    Value="#7A3B3B" />
            <Setter Property="Foreground"
                    Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="FontSize"
                    Value="13" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="14,0"
                                Opacity="{TemplateBinding Tag}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled"
                         Value="False">
                    <Setter Property="Tag"
                            Value="0.45" />
                    <Setter Property="Cursor"
                            Value="Arrow" />
                </Trigger>
                <Trigger Property="IsEnabled"
                         Value="True">
                    <Setter Property="Tag"
                            Value="1" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Padding="24">
        <StackPanel>
            <TextBlock x:Name="HeadingText"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Margin="0,0,0,10" />

            <TextBlock x:Name="MessageText"
                       TextWrapping="Wrap"
                       FontSize="13"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Margin="0,0,0,16" />

            <TextBlock x:Name="PromptText"
                       TextWrapping="Wrap"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Margin="0,0,0,6" />

            <TextBox x:Name="ConfirmationTextBox"
                     AutomationProperties.Name="Type the consumer's name to confirm"
                     FontSize="13"
                     Padding="8,6"
                     Margin="0,0,0,20"
                     TextChanged="ConfirmationTextBox_TextChanged" />

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="CancelButton"
                        Content="Cancel"
                        Style="{StaticResource NeutralButton}"
                        IsCancel="True" />
                <Button x:Name="ConfirmButton"
                        AutomationProperties.Name="Confirm"
                        Style="{StaticResource ActionButton}"
                        IsEnabled="False"
                        Click="Confirm_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
