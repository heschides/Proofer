<UserControl x:Class="Sati.Views.Billing.BillingSubmissionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource WindowBackgroundBrush}"
             TextElement.FontFamily="{StaticResource AppFont}">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  AutomationProperties.Name="Billing submissions workflow">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   Text="837P CLAIM SUBMISSION"
                   FontSize="11"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Margin="0,0,0,16" />

        <!-- Draft submission and its exact frozen claim lines. Submitted periods leave this
             selector and remain available through the range and Submission Home below. -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="430" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="DRAFT PERIOD QUEUE"
                           Style="{StaticResource LabelStyle}" />
                <ComboBox AutomationProperties.Name="Billing period"
                          ItemsSource="{Binding DraftBillingPeriods}"
                          SelectedItem="{Binding SelectedPeriod, Mode=TwoWay}"
                          IsEnabled="{Binding IsGenerating, Converter={StaticResource InverseBoolConverter}}"
                          MaxDropDownHeight="360"
                          HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource BillingPeriodLabelConverter}}"
                                       TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="{Binding DraftPeriodSummary}"
                           FontSize="11"
                           Foreground="{DynamicResource TextSubtleBrush}"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0" />
                <TextBlock Text="{Binding SubmitAvailabilityMessage}"
                           AutomationProperties.LiveSetting="Polite"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Stretch"
                           Margin="0,6,0,0" />
                <Button Content="Submit &amp; Lock Selected Period"
                        Style="{StaticResource PrimaryButton}"
                        Width="220"
                        HorizontalAlignment="Left"
                        Command="{Binding SubmitPeriodCommand}"
                        IsEnabled="{Binding CanSubmitPeriod}"
                        ToolTip="{Binding SubmitAvailabilityMessage}"
                        Margin="0,10,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="SELECTED PERIOD CLAIM LINES"
                           Style="{StaticResource LabelStyle}" />
                <TextBlock Text="{Binding SelectedPeriodLineSummary}"
                           AutomationProperties.LiveSetting="Polite"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,0,6" />
                <Grid MinHeight="145">
                    <DataGrid ItemsSource="{Binding SelectedPeriodLines}"
                              AutomationProperties.Name="Claim lines in selected draft billing period"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              HeadersVisibility="Column"
                              MaxHeight="210"
                              Visibility="{Binding HasSelectedPeriodLines, Converter={StaticResource BoolToVisibilityConverter}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="CLIENT" Binding="{Binding ClientName}" Width="125" />
                            <DataGridTextColumn Header="SERVICE DATE"
                                                Binding="{Binding DateOfService, StringFormat={}{0:yyyy-MM-dd}}"
                                                Width="90" />
                            <DataGridTextColumn Header="UNITS" Binding="{Binding Units}" Width="52" />
                            <DataGridTextColumn Header="CHARGE"
                                                Binding="{Binding ChargeAmount, StringFormat={}{0:C}}"
                                                Width="72" />
                            <DataGridTextColumn Header="CODE" Binding="{Binding ProcedureDisplay}" Width="70" />
                            <DataGridTextColumn Header="DIAGNOSIS" Binding="{Binding DiagnosisCode}" Width="75" />
                            <DataGridTextColumn Header="READINESS" Binding="{Binding ReadinessStatus}" Width="105" />
                            <DataGridTextColumn Header="ISSUES" Binding="{Binding ReadinessSummary}" Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="No draft claim lines are waiting. Submitted periods are listed in the 837 workflow and Submission Home below."
                               AutomationProperties.Name="No draft billing periods waiting"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               MaxWidth="440"
                               Visibility="{Binding HasSelectedPeriodLines, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                </Grid>
            </StackPanel>
        </Grid>

        <!-- A submitted period is staged only while it is still valid and has not yet
             produced an 837. Historical invalid rows are isolated below, never offered
             to the generator as if they were ready. -->
        <StackPanel Grid.Row="2" Margin="0,0,0,16">
            <TextBlock Text="837 STAGING" Style="{StaticResource LabelStyle}" />
            <TextBlock Text="Submit &amp; Lock moves a period here. Select the ready periods to include in the next 837 generation."
                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap" Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="From billing month" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <DatePicker SelectedDate="{Binding RangeStart}"
                                AutomationProperties.Name="837 beginning billing month"
                                IsEnabled="{Binding IsGenerating, Converter={StaticResource InverseBoolConverter}}"
                                Width="160" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Through billing month" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <DatePicker SelectedDate="{Binding RangeEnd}"
                                AutomationProperties.Name="837 ending billing month"
                                IsEnabled="{Binding IsGenerating, Converter={StaticResource InverseBoolConverter}}"
                                Width="160" />
                </StackPanel>
            </StackPanel>
            <TextBlock Text="{Binding RangeSummary}" Margin="0,6,0,0" FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
            <TextBlock Text="Each matching locked monthly period is generated as its own 837P file; a period is not split by individual service day."
                       Margin="0,3,0,0" FontSize="11" Foreground="{DynamicResource TextSubtleBrush}"
                       TextWrapping="Wrap" />

            <Grid Margin="0,10,0,0" MinHeight="85">
                <DataGrid ItemsSource="{Binding StagedPeriods}"
                          AutomationProperties.Name="Billing periods staged for 837 generation"
                          AutoGenerateColumns="False"
                          IsReadOnly="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          MaxHeight="190"
                          Visibility="{Binding HasStagedPeriods, Converter={StaticResource BoolToVisibilityConverter}}">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="INCLUDE"
                                                Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Width="65" />
                        <DataGridTextColumn Header="BILLING MONTH" Binding="{Binding BillingMonth}" Width="115" IsReadOnly="True" />
                        <DataGridTextColumn Header="CASE MANAGER" Binding="{Binding CaseManagerName}" Width="170" IsReadOnly="True" />
                        <DataGridTextColumn Header="CLAIMS" Binding="{Binding ClaimCount}" Width="60" IsReadOnly="True" />
                        <DataGridTextColumn Header="READINESS" Binding="{Binding ReadinessSummary}" Width="*" IsReadOnly="True" />
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="No ready submitted periods are waiting in this date range."
                           AutomationProperties.Name="No billing periods ready in 837 staging"
                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding HasStagedPeriods, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
            </Grid>

            <StackPanel Margin="0,10,0,0"
                        Visibility="{Binding HasBlockedSubmittedPeriods, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="BLOCKED BEFORE 837" Style="{StaticResource LabelStyle}" />
                <TextBlock Text="These older submitted periods fail today's hard claim-readiness gate. They are not in staging. Return one to Draft so it can follow the correction workflow."
                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap" Margin="0,0,0,6" />
                <ItemsControl ItemsSource="{Binding BlockedSubmittedPeriods}"
                              AutomationProperties.Name="Submitted billing periods blocked before 837 generation">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    Padding="10" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="55" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="125" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding BillingMonth}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding CaseManagerName}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding ClaimCount}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{Binding ReadinessSummary}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                    <Button Grid.Column="4" Content="Return to Draft"
                                            Style="{StaticResource SmallButton}"
                                            Command="{Binding DataContext.ReturnToDraftCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.Name="Return blocked billing period to draft"
                                            Margin="10,0,0,0" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>

        <!-- 837 generation actions. Period locking belongs with the selector above. -->
        <StackPanel Grid.Row="3"
                    Margin="0,0,0,16">
            <CheckBox Content="Test mode (OATEST in filename — safe to upload to Office Ally)"
                      IsChecked="{Binding IsTestMode}"
                      IsEnabled="{Binding IsGenerating, Converter={StaticResource InverseBoolConverter}}"
                      AutomationProperties.Name="Generate test 837P files"
                      FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"
                      Margin="0,0,0,12" />
            <StackPanel Orientation="Horizontal">
                <Button Content="Generate 837P for Selected"
                        Style="{StaticResource PrimaryButton}"
                        Width="220"
                        Command="{Binding GenerateEdiCommand}"
                        IsEnabled="{Binding CanGenerateEdi}"
                        Margin="0,0,12,0" />
                <Button Content="Open Output Folder"
                        Style="{StaticResource SmallButton}"
                        Width="150"
                        Command="{Binding OpenOutputFolderCommand}"
                        IsEnabled="{Binding HasGeneratedFile}"
                        VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>

        <!-- Demo-only exchange simulator. It is hidden completely from Local Production. -->
        <StackPanel Grid.Row="4"
                    Visibility="{Binding ShowsMockClearinghouse, Converter={StaticResource BoolToVisibilityConverter}}"
                    Margin="0,0,0,16"
                    MaxWidth="760"
                    HorizontalAlignment="Left">
            <TextBlock Text="MOCK CLEARINGHOUSE — DEMO ONLY" Style="{StaticResource LabelStyle}" />
            <TextBlock Text="Choose what the test clearinghouse and payer should return. Sati will record the simulated 999, 277CA, and 835 responses through the same ingestion path intended for real responses."
                       FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8" />
            <WrapPanel>
                <ComboBox ItemsSource="{Binding MockClearinghouseScenarios}"
                          SelectedItem="{Binding SelectedMockClearinghouseScenario}"
                          AutomationProperties.Name="Mock clearinghouse outcome"
                          IsEnabled="{Binding IsGenerating, Converter={StaticResource InverseBoolConverter}}"
                          Width="235"
                          Margin="0,0,12,0">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Label}" ToolTip="{Binding Explanation}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Content="Submit Generated 837P Files"
                        Style="{StaticResource PrimaryButton}"
                        Width="220"
                        Command="{Binding SubmitToMockClearinghouseCommand}"
                        IsEnabled="{Binding CanSubmitToMockClearinghouse}"
                        ToolTip="{Binding MockClearinghouseAvailabilityMessage}"
                        AutomationProperties.Name="Submit generated 837P files to mock clearinghouse" />
            </WrapPanel>
            <TextBlock Text="{Binding SelectedMockClearinghouseScenario.Explanation}"
                       FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,6,0,0" />
            <TextBlock Text="{Binding MockClearinghouseAvailabilityMessage}"
                       AutomationProperties.LiveSetting="Polite"
                       FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,3,0,0" />
        </StackPanel>

        <!-- Status message -->
        <TextBlock Grid.Row="5"
                   Text="{Binding StatusMessage}"
                   AutomationProperties.LiveSetting="Polite"
                   FontSize="12"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,18" />

        <StackPanel Grid.Row="6" Margin="0,0,0,8">
            <TextBlock Text="SUBMISSION HOME" Style="{StaticResource SectionHeader}" />
            <TextBlock Text="Demo rows are explicitly marked synthetic. They exercise generated, transmitted, failed, accepted, rejected, and partial-acceptance states without contacting a clearinghouse."
                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap" Margin="0,4,0,0" />
            <WrapPanel Margin="0,8,0,0">
                <TextBox Text="{Binding SubmissionSearchText, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Search billing submissions"
                         ToolTip="Search by case manager, month, control/reference, or status"
                         Width="240" Margin="0,0,12,0" />
                <ComboBox ItemsSource="{Binding SubmissionStatusFilters}"
                          SelectedItem="{Binding SelectedSubmissionStatus}"
                          AutomationProperties.Name="Submission status filter"
                          Width="155" Margin="0,0,12,0" />
                <CheckBox Content="Hide settled" IsChecked="{Binding OutstandingOnly}"
                          AutomationProperties.Name="Hide settled submissions"
                          ToolTip="Hides batches that have been paid, leaving what needs work and what is still awaiting the payer"
                          VerticalAlignment="Center" />
            </WrapPanel>
            <!--
                Counts describe the filtered list, so the header can never disagree with the
                rows beneath it. Announced assertively because the numbers change under the
                reader when a filter is applied.
            -->
            <TextBlock Text="{Binding SubmissionSummary}"
                       AutomationProperties.LiveSetting="Assertive"
                       AutomationProperties.Name="Submission counts by stage"
                       FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,8,0,0" />
        </StackPanel>

        <DataGrid Grid.Row="7"
                  ItemsSource="{Binding SubmissionBatches}"
                  AutomationProperties.Name="Billing submission batches and current status"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  HeadersVisibility="Column"
                  MinHeight="160"
                  MaxHeight="360">
            <DataGrid.Columns>
                <!--
                    Stage first, because the list is ordered by it: everything needing work,
                    then everything merely waiting, then everything done. The old OUTSTANDING
                    column is gone; it was true on every row, because it meant "not
                    Reconciled" and nothing has ever set Reconciled.
                -->
                <DataGridTextColumn Header="STAGE" Binding="{Binding ProgressName}" Width="115" />
                <!-- One column rather than YEAR and MONTH, which said the same thing twice. -->
                <DataGridTextColumn Header="BILLING MONTH" Binding="{Binding BillingMonth}" Width="100" />
                <DataGridTextColumn Header="CASE MANAGER" Binding="{Binding CaseManagerName}" Width="125" />
                <DataGridTextColumn Header="CLAIMS" Binding="{Binding ClaimCount}" Width="55" />
                <DataGridTextColumn Header="VALUE" Binding="{Binding DollarValue, StringFormat={}{0:C}}" Width="80" />
                <!-- Local time. A biller reads these against a calendar, not against UTC. -->
                <DataGridTextColumn Header="SENT" Width="95"
                                    Binding="{Binding SentAtUtc, StringFormat={}{0:yyyy-MM-dd},
                                              ConverterCulture=en-US}" />
                <DataGridTextColumn Header="LAST ACTIVITY" Width="105"
                                    Binding="{Binding ActivityLocal, StringFormat={}{0:yyyy-MM-dd HH:mm}}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <!-- What that timestamp means differs by stage, so each row says so. -->
                            <Setter Property="ToolTip" Value="{Binding ActivityLabel}" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <!-- Age is what makes a stuck batch visible; the timestamp alone does not. -->
                <DataGridTextColumn Header="DAYS" Binding="{Binding DaysSinceActivity}" Width="55" />
                <DataGridTextColumn Header="STATUS" Binding="{Binding CurrentStatus}" Width="120" />
                <DataGridTextColumn Header="RESPONSE" Binding="{Binding ResponseType}" Width="70" />
                <DataGridTextColumn Header="DETAIL" Binding="{Binding Explanation}" Width="2*" />
                <DataGridCheckBoxColumn Header="SYNTHETIC" Binding="{Binding IsSynthetic}" Width="75" />
            </DataGrid.Columns>
        </DataGrid>

    </Grid>
    </ScrollViewer>
</UserControl>
