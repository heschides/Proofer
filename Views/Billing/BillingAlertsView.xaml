<UserControl x:Class="Sati.Views.Billing.BillingAlertsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource WindowBackgroundBrush}"
             TextElement.FontFamily="{StaticResource AppFont}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="DENIAL &amp; UNPAID WORKLIST" Style="{StaticResource SectionHeader}" />
        <TextBlock Grid.Row="1" Margin="0,5,0,10" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="This is an actionable queue of remittance outcomes that are not cleanly paid. A claim rejection happens before adjudication; a denial is reported after adjudication. Synthetic rows are clearly marked." />
        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <WrapPanel>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Search denial worklist"
                         ToolTip="Search claim control number, payer, date, or reason"
                         Width="250" Margin="0,0,12,0" />
                <ComboBox ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding SelectedStatus}"
                          AutomationProperties.Name="Worklist status filter" Width="145" Margin="0,0,12,0" />
                <ComboBox ItemsSource="{Binding AgingFilters}" SelectedItem="{Binding SelectedAging}"
                          AutomationProperties.Name="Worklist aging filter" Width="120" />
            </WrapPanel>
            <TextBlock Text="{Binding StatusMessage}" AutomationProperties.LiveSetting="Polite"
                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,7,0,0" />
        </StackPanel>
        <DataGrid Grid.Row="3" ItemsSource="{Binding Items}"
                  AutomationProperties.Name="Denied and unpaid claims worklist"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  HeadersVisibility="Column" SelectionMode="Single" MinHeight="200">
            <DataGrid.Columns>
                <DataGridTextColumn Header="CLAIM" Binding="{Binding ClaimReference}" Width="105" />
                <DataGridTextColumn Header="PAYER" Binding="{Binding PayerName}" Width="115" />
                <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="100" />
                <DataGridTextColumn Header="AGE" Binding="{Binding AgeDays}" Width="50" />
                <DataGridTextColumn Header="BUCKET" Binding="{Binding AgingBucket}" Width="65" />
                <DataGridTextColumn Header="BILLED" Binding="{Binding BilledAmount, StringFormat={}{0:C}}" Width="75" />
                <DataGridTextColumn Header="PAID" Binding="{Binding PaidAmount, StringFormat={}{0:C}}" Width="75" />
                <DataGridTextColumn Header="CODE" Binding="{Binding ReasonCode}" Width="60" />
                <DataGridTextColumn Header="WHAT IT MEANS" Binding="{Binding HumanReason}" Width="2*" />
                <DataGridCheckBoxColumn Header="SYNTHETIC" Binding="{Binding IsSynthetic}" Width="75" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
