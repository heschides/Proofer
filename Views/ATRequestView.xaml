<UserControl x:Class="Sati.Views.ATRequestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Sati.Views"
             Background="#FDF6EC"
             TextElement.FontFamily="{StaticResource AppFont}">

    <Grid>

        <!-- QUEUE REGION — visible when not editing -->
        <Grid Margin="24,20"
              Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- New-request bar -->
            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        Margin="0,0,0,16">
                <TextBlock Text="Client:"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           Foreground="#3D2B1F" />
                <ComboBox Width="240"
                          VerticalAlignment="Center"
                          ItemsSource="{Binding Clients}"
                          SelectedItem="{Binding SelectedClient}"
                          DisplayMemberPath="FullName" />
                <Button Content="New Request"
                        Style="{StaticResource PrimaryButton}"
                        Width="120"
                        Margin="12,0,0,0"
                        Command="{Binding NewRequestCommand}" />
            </StackPanel>

            <!-- Queue list -->
            <Border Grid.Row="1"
                    Background="White"
                    BorderBrush="#E8D0B8"
                    BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Requests}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,8"
                                        BorderBrush="#F0E4D4"
                                        BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="2*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding ClientName}"
                                                   Foreground="#3D2B1F" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Status}"
                                                   Foreground="#9C7A5C" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding TotalCost, StringFormat=C}"
                                                   Foreground="#3D2B1F" />
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding CaseManagerName}"
                                                   Foreground="#9C7A5C" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- EDITOR REGION — inputs left, live-preview right. Visible when editing. -->
        <Grid Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"
                                  MinWidth="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: input pane -->
            <Border Grid.Column="0"
                    Background="#F5EAD8"
                    BorderBrush="#E8D0B8"
                    BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Padding="20,16">
                    <StackPanel>

                        <Button Content="← Back to list"
                                Style="{StaticResource SmallButton}"
                                Width="120"
                                HorizontalAlignment="Left"
                                Command="{Binding CloseEditorCommand}" />

                        <TextBlock Margin="0,16,0,16"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#3D2B1F"
                                   TextWrapping="Wrap"
                                   Text="{Binding CurrentEditor.ClientName, StringFormat='Request for {0}'}" />

                        <TextBlock Text="VENDOR / PROVIDER"
                                   Style="{StaticResource SectionHeader}" />

                        <TextBlock Text="Name (not program name)"
                                   Style="{StaticResource LabelStyle}" />
                        <TextBox Text="{Binding CurrentEditor.VendorName, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Billing Location (EIS Location)"
                                   Style="{StaticResource LabelStyle}" />
                        <TextBox Text="{Binding CurrentEditor.VendorBillingLocation, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Program Contact (Name &amp; Email)"
                                   Style="{StaticResource LabelStyle}" />
                        <TextBox Text="{Binding CurrentEditor.VendorProgramContact, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Billing Contact (Name &amp; Email)"
                                   Style="{StaticResource LabelStyle}" />
                        <TextBox Text="{Binding CurrentEditor.VendorBillingContact, UpdateSourceTrigger=PropertyChanged}" />

                        <Separator />

                        <TextBlock Text="TOTALS"
                                   Style="{StaticResource SectionHeader}" />

                        <TextBlock Text="Sales Tax"
                                   Style="{StaticResource LabelStyle}" />
                        <!-- Decimal: default LostFocus trigger, not PropertyChanged —
                             per-keystroke parsing chokes on partial input ("1."). Preview
                             tax updates on focus-loss, which is fine. -->
                        <TextBox Text="{Binding CurrentEditor.SalesTax, StringFormat=F2}" />

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- RIGHT: live form preview -->
            <Border Grid.Column="1"
                    Background="#EFE7DA"
                    Padding="24">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                    <views:ATFormDocument DataContext="{Binding CurrentEditor}"
                                          VerticalAlignment="Top"
                                          HorizontalAlignment="Center" />
                </ScrollViewer>
            </Border>
        </Grid>

    </Grid>
</UserControl>