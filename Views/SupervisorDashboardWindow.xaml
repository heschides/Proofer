<UserControl x:Class="Sati.Views.SupervisorDashboardWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sati="clr-namespace:Sati"
             Background="{DynamicResource WindowBackgroundBrush}"
             TextElement.FontFamily="{StaticResource AppFont}">

    <UserControl.Resources>

        <Style x:Key="MetricCard"
               TargetType="Border">
            <Setter Property="Background"
                    Value="{DynamicResource SurfaceMutedBrush}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="CornerRadius"
                    Value="6" />
            <Setter Property="Padding"
                    Value="12,10" />
            <Setter Property="Margin"
                    Value="0,0,10,0" />
        </Style>

        <Style x:Key="MetricLabel"
               TargetType="TextBlock">
            <Setter Property="FontSize"
                    Value="10" />
            <Setter Property="Foreground"
                    Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Margin"
                    Value="0,0,0,4" />
        </Style>

        <Style x:Key="SectionHeading"
               TargetType="TextBlock">
            <Setter Property="FontSize"
                    Value="11" />
            <Setter Property="Foreground"
                    Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="Margin"
                    Value="0,0,0,6" />
        </Style>

        <Style x:Key="SidebarHeading"
               TargetType="TextBlock">
            <Setter Property="FontSize"
                    Value="10" />
            <Setter Property="Foreground"
                    Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="Margin"
                    Value="12,12,12,4" />
        </Style>

        <Style x:Key="QuickFilter"
               TargetType="TextBlock">
            <Setter Property="FontSize"
                    Value="11" />
            <Setter Property="Foreground"
                    Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Margin"
                    Value="0,3" />
            <Setter Property="Cursor"
                    Value="Hand" />
        </Style>

        <Style x:Key="TeamProgressBar"
               TargetType="ProgressBar">
            <Setter Property="Height"
                    Value="6" />
            <Setter Property="Width"
                    Value="80" />
            <Setter Property="Background"
                    Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness"
                    Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Height="6">
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    CornerRadius="3"
                                    Background="{TemplateBinding Foreground}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="Foreground"
                    Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize"
                    Value="10" />
            <Setter Property="FontWeight"
                    Value="Normal" />
            <Setter Property="Padding"
                    Value="8,6" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness"
                    Value="0,0,0,1" />
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness"
                    Value="0" />
            <Setter Property="Foreground"
                    Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize"
                    Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="8,0"
                                Background="{TemplateBinding Background}"
                                VerticalAlignment="Stretch">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected"
                         Value="True">
                    <Setter Property="Background"
                            Value="{DynamicResource SurfaceAltBrush}" />
                    <Setter Property="Foreground"
                            Value="{DynamicResource TextPrimaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridRow">
            <Style.Triggers>
                <Trigger Property="IsMouseOver"
                         Value="True">
                    <Setter Property="Background"
                            Value="{DynamicResource SurfaceAltBrush}" />
                </Trigger>
                <Trigger Property="IsSelected"
                         Value="True">
                    <Setter Property="Background"
                            Value="{DynamicResource SurfaceAltBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ================================================================ -->
        <!-- TOOLBAR                                                           -->
        <!-- ================================================================ -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceMutedBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,8">
            <!-- A bare horizontal StackPanel clips silently once its children exceed the window
                 width: the entries past the edge are laid out, never drawn, and nothing reports
                 it. The case manager dashboard already carries this ScrollViewer for the same
                 reason. This toolbar gained two entries in 1.2.38 and had no such guard. -->
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          CanContentScroll="True">
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        KeyboardNavigation.TabNavigation="Local">

                <!-- Team overview -->
                <Border Cursor="Hand"
                        CornerRadius="4"
                        Padding="12,4"
                        Margin="0,0,4,0">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick"
                                      Command="{Binding NavigateToTeamOverviewCommand}" />
                    </Border.InputBindings>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background"
                                    Value="Transparent" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTeamOverviewActive}"
                                             Value="True">
                                    <Setter Property="Background"
                                            Value="{DynamicResource AccentBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="Team overview"
                               FontSize="12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource TextSecondaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTeamOverviewActive}"
                                                 Value="True">
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource OnAccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <!-- Overdue items -->
                <Border Cursor="Hand"
                        CornerRadius="4"
                        Padding="12,4"
                        Margin="0,0,4,0">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick"
                                      Command="{Binding NavigateToOverdueItemsCommand}" />
                    </Border.InputBindings>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background"
                                    Value="Transparent" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOverdueItemsActive}"
                                             Value="True">
                                    <Setter Property="Background"
                                            Value="{DynamicResource AccentBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="Overdue items"
                               FontSize="12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource TextSecondaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOverdueItemsActive}"
                                                 Value="True">
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource OnAccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
                <Border Cursor="Hand"
                        CornerRadius="4"
                        Padding="12,4"
                        Margin="0,0,4,0">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick"
                                      Command="{Binding NavigateToPendingApprovalsCommand}" />
                    </Border.InputBindings>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background"
                                    Value="Transparent" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPendingApprovalsActive}"
                                             Value="True">
                                    <Setter Property="Background"
                                            Value="{DynamicResource AccentBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="Pending approvals"
                               FontSize="12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource TextSecondaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPendingApprovalsActive}"
                                                 Value="True">
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource OnAccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
                <!-- Monthly productivity -->
                <Border Cursor="Hand"
                        CornerRadius="4"
                        Padding="12,4"
                        Margin="0,0,16,0">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick"
                                      Command="{Binding NavigateToMonthlyProductivityCommand}" />
                    </Border.InputBindings>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background"
                                    Value="Transparent" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMonthlyProductivityActive}"
                                             Value="True">
                                    <Setter Property="Background"
                                            Value="{DynamicResource AccentBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="Monthly productivity"
                               FontSize="12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource TextSecondaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMonthlyProductivityActive}"
                                                 Value="True">
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource OnAccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <!-- Import a caseload from Credible -->
                <Border Cursor="Hand" CornerRadius="4" Padding="12,4" Margin="0,0,16,0">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick"
                                      Command="{Binding NavigateToCaseloadImportCommand}" />
                    </Border.InputBindings>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="Transparent" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCaseloadImportActive}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="Import from Credible" FontSize="12"
                               AutomationProperties.Name="Import a caseload from Credible">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCaseloadImportActive}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <!-- Distribute caseload -->
                <Border Cursor="Hand"
                        CornerRadius="4"
                        Padding="12,4"
                        Margin="0,0,16,0">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick"
                                      Command="{Binding NavigateToCaseloadDistributionCommand}" />
                    </Border.InputBindings>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background"
                                    Value="Transparent" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCaseloadDistributionActive}"
                                             Value="True">
                                    <Setter Property="Background"
                                            Value="{DynamicResource AccentBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="Distribute caseload"
                               FontSize="12"
                               AutomationProperties.Name="Distribute caseload">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource TextSecondaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCaseloadDistributionActive}"
                                                 Value="True">
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource OnAccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <Border Width="1"
                        Background="{DynamicResource BorderBrush}"
                        Margin="0,2,16,2" />

                <TextBlock Text="MONTH"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0" />
                <TextBlock Text="{Binding CurrentMonth, Mode=OneWay}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0" />

                <Border Width="1"
                        Background="{DynamicResource BorderBrush}"
                        Margin="0,2,16,2" />

                <TextBlock Text="TEAM SIZE"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0" />
                <TextBlock Text="{Binding TeamSizeLabel}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center" />

            </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ================================================================ -->
        <!-- SUMMARY METRICS                                                   -->
        <!-- ================================================================ -->
        <UniformGrid Grid.Row="1"
                     Rows="1"
                     Columns="4"
                     Margin="16,12,16,0">

            <Border Style="{StaticResource MetricCard}">
                <StackPanel>
                    <TextBlock Text="TOTAL CLIENTS"
                               Style="{StaticResource MetricLabel}" />
                    <TextBlock Text="{Binding TotalClients}"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource MetricCard}">
                <StackPanel>
                    <TextBlock Text="OVERDUE ITEMS"
                               Style="{StaticResource MetricLabel}" />
                    <TextBlock Text="{Binding TotalOverdue}"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource OverdueBrush}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource MetricCard}">
                <StackPanel>
                    <TextBlock Text="NOTES THIS MONTH"
                               Style="{StaticResource MetricLabel}" />
                    <TextBlock Text="{Binding TotalNotesThisMonth}"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource MetricCard}"
                    Margin="0">
                <StackPanel>
                    <TextBlock Text="AVG COMPLIANCE"
                               Style="{StaticResource MetricLabel}" />
                    <TextBlock Text="{Binding AvgComplianceLabel}"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SuccessStrongBrush}" />
                </StackPanel>
            </Border>

        </UniformGrid>

        <!-- ================================================================ -->
        <!-- BODY                                                              -->
        <!-- ================================================================ -->
        <Grid Grid.Row="2"
              Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============================================================ -->
            <!-- SIDEBAR                                                       -->
            <!-- ============================================================ -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SurfaceAltBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <StackPanel>

                    <!-- Case managers header — clickable, navigates to user management -->
                    <Border Cursor="Hand"
                            Padding="0">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick"
                                          Command="{Binding NavigateToUserManagementCommand}" />
                        </Border.InputBindings>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background"
                                        Value="Transparent" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsUserManagementActive}"
                                                 Value="True">
                                        <Setter Property="Background"
                                                Value="{DynamicResource HoverBrush}" />
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver"
                                             Value="True">
                                        <Setter Property="Background"
                                                Value="{DynamicResource HoverBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal"
                                    Margin="12,12,12,4">
                            <TextBlock Text="CASE MANAGERS"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text=" ›"
                                       FontSize="10"
                                       Foreground="{DynamicResource AccentBrush}"
                                       Margin="4,0,0,0" />
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding CaseManagers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Cursor="Hand"
                                        Padding="0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background"
                                                    Value="Transparent" />
                                            <Setter Property="BorderThickness"
                                                    Value="0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}"
                                                             Value="True">
                                                    <Setter Property="Background"
                                                            Value="{DynamicResource HoverBrush}" />
                                                    <Setter Property="BorderThickness"
                                                            Value="3,0,0,0" />
                                                    <Setter Property="BorderBrush"
                                                            Value="{DynamicResource AccentBrush}" />
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver"
                                                         Value="True">
                                                    <Setter Property="Background"
                                                            Value="{DynamicResource HoverBrush}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid Margin="12,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Width="28"
                                                Height="28"
                                                CornerRadius="14"
                                                Background="{DynamicResource AccentBrush}"
                                                Margin="0,0,8,0">
                                            <TextBlock Text="{Binding Initials}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource OnAccentBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="1"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding ClientCountLabel}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </StackPanel>

                                        <Border Grid.Column="2"
                                                Background="{DynamicResource OverdueBrush}"
                                                CornerRadius="10"
                                                Padding="6,1"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding HasOverdue,
                                                    Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="{Binding OverdueCount}"
                                                       FontSize="10"
                                                       Foreground="White" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="QUICK FILTERS"
                               Style="{StaticResource SidebarHeading}"
                               Margin="12,16,12,4" />

                    <StackPanel Margin="12,0">
                        <TextBlock Text="▶ Has overdue items"
                                   Style="{StaticResource QuickFilter}" />
                        <TextBlock Text="▶ Below threshold"
                                   Style="{StaticResource QuickFilter}" />
                        <TextBlock Text="▶ Missing this month"
                                   Style="{StaticResource QuickFilter}" />
                    </StackPanel>

                </StackPanel>
            </Border>

            <!-- ============================================================ -->
            <!-- MAIN CONTENT — sub-view ContentControl                        -->
            <!-- ============================================================ -->
            <ContentControl Grid.Column="1"
                            Content="{Binding CurrentSubView}" />

        </Grid>
    </Grid>
</UserControl>
