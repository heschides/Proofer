<Window x:Class="Sati.Views.SplashScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        SizeToContent="WidthAndHeight"
        ShowInTaskbar="False">

    <Border Width="760"
            Height="480"
            Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="18">
        <Grid Margin="48,34,48,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="42" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Image Grid.Row="0"
                   Grid.Column="0"
                   Source="pack://application:,,,/images/sati-watercolor-leaf.png"
                   Width="240"
                   Height="330"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />

            <StackPanel Grid.Row="0"
                        Grid.Column="2"
                        VerticalAlignment="Center">
                <TextBlock Text="Sati"
                           FontFamily="Palatino Linotype"
                           FontSize="64"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="Case Management"
                           Margin="3,-4,0,0"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <Border Width="76"
                        Height="3"
                        Margin="3,24,0,22"
                        HorizontalAlignment="Left"
                        Background="{DynamicResource AccentBrush}"
                        CornerRadius="2" />
                <TextBlock Text="by Robin-Bradley AMS"
                           Margin="3,0,0,0"
                           FontSize="12"
                           FontStyle="Italic"
                           Foreground="{DynamicResource TextMutedBrush}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        Grid.Row="1"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Ellipse x:Name="Dot1"
                         Width="10"
                         Height="10"
                         Margin="6,0"
                         Fill="{DynamicResource AccentBrush}" />
                <Ellipse x:Name="Dot2"
                         Width="10"
                         Height="10"
                         Margin="6,0"
                         Fill="{DynamicResource HoverStrongBrush}" />
                <Ellipse x:Name="Dot3"
                         Width="10"
                         Height="10"
                         Margin="6,0"
                         Fill="{DynamicResource HoverStrongBrush}" />
                <Ellipse x:Name="Dot4"
                         Width="10"
                         Height="10"
                         Margin="6,0"
                         Fill="{DynamicResource HoverStrongBrush}" />
                <Ellipse x:Name="Dot5"
                         Width="10"
                         Height="10"
                         Margin="6,0"
                         Fill="{DynamicResource HoverStrongBrush}" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
